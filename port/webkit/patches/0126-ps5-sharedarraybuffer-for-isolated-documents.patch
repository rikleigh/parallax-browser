+#if defined(PS5_PAYLOAD_SDK)
+// PS5: upstream exposes the SharedArrayBuffer constructor to every global object of a
+// WebProcess launched in CrossOriginMode::Isolated (JSDOMGlobalObject::addBuiltinGlobals), and
+// gets such a process by swapping processes on navigation. This port has one WebProcess
+// (patch 0018), so that never happens: a page served with COOP same-origin and COEP
+// require-corp had crossOriginIsolated == true, could make shared WebAssembly memories and
+// post them to workers, and still had no SharedArrayBuffer global. Emscripten's
+// pthread_create tests exactly that global and fails with EAGAIN. The constructor adds
+// nothing such a page could not already reach (new WebAssembly.Memory({shared: true})
+// .buffer.constructor). Called when the window's global object is made and again when the
+// document's opener policy is known (FrameLoader::didBeginDocument), whichever is later.
+void ScriptController::ps5ExposeSharedArrayBufferIfCrossOriginIsolated()
+{
+    RefPtr document = m_frame->document();
+    if (!document || !document->crossOriginIsolated())
+        return;
+    for (auto& jsWindowProxy : protect(windowProxy())->jsWindowProxiesAsVector()) {
+        JSC::JSLockHolder lock(jsWindowProxy->world().vm());
+        if (auto* window = jsWindowProxy->window())
+            window->exposeSharedArrayBuffer();
+    }
+}
+#endif
