+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+void* tryAllocateZeroedVirtualPagesWithRoomToGrow(Kind kind, size_t size)
+{
+    if (size < ps5OwnMappingBytes)
+        return tryAllocateZeroedVirtualPages(kind, size);
+    // High up, 8 GB apart, where nothing else maps: the kernel's own placement put other mappings
+    // right after a WebAssembly heap, which then had to move (and copy hundreds of MB) to grow.
+    // A hint, not MAP_FIXED: anywhere else if that range isn't free.
+    constexpr uintptr_t first = 0x2000000000; // 128 GB
+    constexpr uintptr_t spacing = 8ull << 30;
+    constexpr uintptr_t last = first + 63 * spacing;
+    static std::atomic<uintptr_t> next { first };
+    uintptr_t hint = next.fetch_add(spacing, std::memory_order_relaxed);
+    if (hint <= last) {
+        void* result = mmap(reinterpret_cast<void*>(hint), size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (result != MAP_FAILED)
+            return result;
+    }
+    return tryAllocateZeroedVirtualPages(kind, size);
+}
+
+bool tryExtendVirtualPagesInPlace(Kind, void* basePtr, size_t oldSize, size_t newSize)
+{
+    RELEASE_ASSERT(oldSize >= ps5OwnMappingBytes && newSize > oldSize);
+    size_t pageSize = WTF::pageSize();
+    if (oldSize % pageSize || newSize % pageSize)
+        return false;
+    // A hint, not MAP_FIXED: the kernel uses the address only if nothing is mapped there.
+    auto* end = static_cast<uint8_t*>(basePtr) + oldSize;
+    size_t extra = newSize - oldSize;
+    void* result = mmap(end, extra, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (result == MAP_FAILED)
+        return false;
+    if (result != end) {
+        munmap(result, extra);
+        return false;
+    }
+    return true;
+}
+#endif
