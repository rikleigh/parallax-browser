+// ahead of it, from the bottom up as heaps grow, so that the page's main thread doesn't take the
+// first-touch faults (192 MB took it 226 ms; no shorter load measured with it yet). Each touch adds 0
+// atomically (lock xadd), so it never changes a byte the page is writing at the same moment.
+// ps5CancelPrefault, before a mapping is unmapped, waits for the chunk in flight (<= 256 KB).
+// WasmMemory.cpp calls ps5PrefaultMemory.
+namespace {
+
+class Prefaulter {
+public:
+    static Prefaulter& singleton()
+    {
+        static LazyNeverDestroyed<Prefaulter> prefaulter;
+        static std::once_flag once;
+        std::call_once(once, [] { prefaulter.construct(); });
+        return prefaulter.get();
+    }
+
+    void add(uint8_t* base, size_t from, size_t to)
+    {
+        static int enabled = -1;
+        if (enabled < 0)
+            enabled = access("/data/ps5webkit/wasm-prefault", F_OK) ? 0 : 1;
+        if (!enabled || from >= to)
+            return;
+        Locker locker { m_lock };
+        if (!m_thread)
+            m_thread = Thread::create("WasmPrefault"_s, [this] { run(); });
+        m_jobs.append({ base, from, to, from, MonotonicTime::now() });
+        m_condition.notifyOne();
+    }
+
+    void cancel(uint8_t* base)
+    {
+        // The worker holds m_lock while it touches a chunk: once we have it, no chunk of base is in flight.
+        Locker locker { m_lock };
+        m_jobs.removeAllMatching([&](auto& job) { return job.base == base; });
+    }
+
+private:
+    struct Job {
+        uint8_t* base;
+        size_t from;
+        size_t to;
+        size_t start;
+        MonotonicTime started;
+    };
+
+    void run()
+    {
+        constexpr size_t chunk = 256 * 1024;
+        Locker locker { m_lock };
+        for (;;) {
+            while (m_jobs.isEmpty())
+                m_condition.wait(m_lock);
+            auto& job = m_jobs.first();
+            size_t end = std::min(job.to, job.from + chunk);
+            for (size_t offset = job.from; offset < end; offset += 4096)
