             if (Options::logExecutableAllocation())
                 dataLog("Allocation failed because bytes allocated ", bytesAllocated,  " > ", bytesAvailable, " bytes available.\n");
+#if defined(PS5_PAYLOAD_SDK)
+            ps5JITCounters[4]++;
+#endif
             return nullptr;
         }
     }
@@ -1205,8 +1266,14 @@ RefPtr<ExecutableMemoryHandle> ExecutableAllocator::allocate(size_t sizeInBytes,
             dataLog("Ran out of executable memory while allocating ", sizeInBytes, " bytes.\n");
             CRASH();
         }
+#if defined(PS5_PAYLOAD_SDK)
+        ps5JITCounters[4]++;
+#endif
         return nullptr;
     }
+#if defined(PS5_PAYLOAD_SDK)
+    ps5NoteJITAllocation(result->start().untaggedPtr(), result->end().untaggedPtr());
+#endif
 
     void* start = allocator->memoryStart();
     void* end = allocator->memoryEnd();
@@ -1249,6 +1316,19 @@ extern "C" void ps5wk_jit_memory(void** start, void** end, size_t* allocated, si
     if (committed)
         *committed = valid ? allocator->bytesCommitted() : 0;
 }
+
+// JIT counters for the profiler and the [mem] line: [0..3] executable
+// allocations by tier (other, Baseline, DFG, FTL), [4] failed allocations,
+// [5..9] compilations finished by path (fail, Baseline, DFG, FTL, cancelled),
+// [10..12] compile milliseconds by tier (Baseline, DFG, FTL), [13] the
+// threshold multiplier from executable memory pressure, times 1000.
+extern "C" void ps5wk_jit_counts(unsigned long long* counts, size_t n)
+{
+    for (size_t i = 0; i < n && i < 16; i++)
+        counts[i] = ps5JITCounters[i].load(std::memory_order_relaxed);
+    if (n > 13 && g_jscConfig.fixedVMPoolExecutableAllocator)
+        counts[13] = static_cast<unsigned long long>(ExecutableAllocator::memoryPressureMultiplier(0) * 1000);
+}
 #endif
 
