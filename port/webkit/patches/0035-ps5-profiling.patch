+#if defined(PS5_PAYLOAD_SDK)
+// Profiling (apps/common/profiler.c): which tier made the code at a JIT pc.
+// Every allocation from the pool is noted with the tier of the compiler
+// thread that made it (JITPlan::compileInThread sets ps5CurrentJITTier);
+// anything else (thunks, inline caches, the regexp JIT, made on the main
+// thread) is tier 0. A ring of the last 64k allocations, searched newest
+// first, so reused memory maps to its newest owner.
+thread_local int ps5CurrentJITTier;
+static constexpr unsigned ps5JITRangeCount = 1 << 16;
+struct PS5JITRange {
+    std::atomic<uintptr_t> start;
+    std::atomic<uintptr_t> end;
+    std::atomic<int> tier;
+};
+static PS5JITRange* ps5JITRanges;
+static std::atomic<unsigned> ps5JITRangeNext;
+// Counters: [0..3] allocations by tier (other, Baseline, DFG, FTL), [4] failed
+// "can fail" allocations (the pool's reserve reached or exhausted).
+std::atomic<unsigned long long> ps5JITCounters[16];
+
+static void ps5NoteJITAllocation(void* start, void* end)
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        ps5JITRanges = static_cast<PS5JITRange*>(calloc(ps5JITRangeCount, sizeof(PS5JITRange)));
+    });
+    int tier = ps5CurrentJITTier;
+    ps5JITCounters[tier & 3]++;
+    if (!ps5JITRanges)
+        return;
+    auto& range = ps5JITRanges[ps5JITRangeNext.fetch_add(1, std::memory_order_relaxed) & (ps5JITRangeCount - 1)];
+    range.start.store(0, std::memory_order_relaxed);
+    range.tier.store(tier, std::memory_order_relaxed);
+    range.end.store(reinterpret_cast<uintptr_t>(end), std::memory_order_relaxed);
+    range.start.store(reinterpret_cast<uintptr_t>(start), std::memory_order_release);
+}
+
+// The tier that made the code at pc: 0 other, 1 Baseline, 2 DFG, 3 FTL, -1 unknown.
+extern "C" int ps5wk_jit_tier(const void* pc)
+{
+    if (!ps5JITRanges)
+        return -1;
+    uintptr_t address = reinterpret_cast<uintptr_t>(pc);
+    unsigned next = ps5JITRangeNext.load(std::memory_order_acquire);
+    unsigned count = std::min(next, ps5JITRangeCount);
+    for (unsigned i = 1; i <= count; i++) {
+        auto& range = ps5JITRanges[(next - i) & (ps5JITRangeCount - 1)];
+        uintptr_t start = range.start.load(std::memory_order_acquire);
+        if (start && address >= start && address < range.end.load(std::memory_order_relaxed))
+            return range.tier.load(std::memory_order_relaxed);
+    }
+    return -1;
+}
+#endif
+
