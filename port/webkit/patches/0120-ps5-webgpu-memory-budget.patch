diff --git a/Source/WebGPU/WebGPUDawn/MemoryBudget.cpp b/Source/WebGPU/WebGPUDawn/MemoryBudget.cpp
new file mode 100644
index 0000000000..2d361d6a88
--- /dev/null
+++ b/Source/WebGPU/WebGPUDawn/MemoryBudget.cpp
@@ -0,0 +1,146 @@
+/*
+ * PS5 (spikes/12-webgpu): see MemoryBudget.h.
+ */
+
+#include "config.h"
+#include "MemoryBudget.h"
+
+#include <atomic>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <wtf/Assertions.h>
+#include <wtf/CheckedArithmetic.h>
+
+namespace WebGPU::Dawn {
+
+namespace {
+
+std::atomic<uint64_t> s_used;
+std::atomic<uint64_t> s_peak;
+std::atomic<unsigned> s_refused;
+
+// 1536 MiB, or the number of MiB in /data/ps5webkit/webgpu-budget-mb (read once; 64 at least).
+uint64_t budgetBytes()
+{
+    static const uint64_t budget = [] {
+        uint64_t megabytes = 1536;
+        int fd = open("/data/ps5webkit/webgpu-budget-mb", O_RDONLY);
+        if (fd >= 0) {
+            char text[16] = { };
+            if (read(fd, text, sizeof(text) - 1) > 0) {
+                unsigned long value = strtoul(text, nullptr, 10);
+                if (value >= 64 && value <= 16384)
+                    megabytes = value;
+            }
+            close(fd);
+        }
+        WTFLogAlways("[webgpu] title: buffers and textures may take %llu MB (webgpu-budget-mb)", static_cast<unsigned long long>(megabytes));
+        return megabytes << 20;
+    }();
+    return budget;
+}
+
+uint64_t bytesPerTexel(TextureFormat format)
+{
+    // Compressed formats: a byte a texel is the most any of them takes.
+    if (format >= TextureFormat::Bc1RgbaUnorm)
+        return 1;
+    switch (format) {
+    case TextureFormat::R8unorm:
+    case TextureFormat::R8snorm:
+    case TextureFormat::R8uint:
+    case TextureFormat::R8sint:
+    case TextureFormat::Stencil8:
+        return 1;
+    case TextureFormat::R16unorm:
+    case TextureFormat::R16snorm:
+    case TextureFormat::R16uint:
+    case TextureFormat::R16sint:
+    case TextureFormat::R16float:
+    case TextureFormat::Rg8unorm:
+    case TextureFormat::Rg8snorm:
+    case TextureFormat::Rg8uint:
+    case TextureFormat::Rg8sint:
+    case TextureFormat::Depth16unorm:
+        return 2;
+    case TextureFormat::Rg32uint:
+    case TextureFormat::Rg32sint:
+    case TextureFormat::Rg32float:
+    case TextureFormat::Rgba16unorm:
+    case TextureFormat::Rgba16snorm:
+    case TextureFormat::Rgba16uint:
+    case TextureFormat::Rgba16sint:
+    case TextureFormat::Rgba16float:
+    case TextureFormat::Depth24plusStencil8:
+    case TextureFormat::Depth32floatStencil8:
+        return 8;
+    case TextureFormat::Rgba32uint:
+    case TextureFormat::Rgba32sint:
+    case TextureFormat::Rgba32float:
+        return 16;
+    default:
+        return 4;
+    }
+}
+
+} // namespace
+
+std::optional<MemoryCharge> MemoryCharge::tryTake(uint64_t bytes)
+{
+    uint64_t budget = budgetBytes();
+    uint64_t used = s_used.load();
+    do {
+        if (bytes > budget || used > budget - bytes) {
+            unsigned refused = ++s_refused;
+            // The first few, then every hundredth: a page can ask in a loop.
+            if (refused <= 5 || !(refused % 100))
+                WTFLogAlways("[webgpu] title: %.1f MB refused, %.1f of %llu MB in use (%u refused so far)", bytes / 1048576.0, used / 1048576.0, static_cast<unsigned long long>(budget >> 20), refused);
+            return std::nullopt;
+        }
+    } while (!s_used.compare_exchange_weak(used, used + bytes));
+    uint64_t now = used + bytes;
+    uint64_t peak = s_peak.load();
+    while (now > peak && !s_peak.compare_exchange_weak(peak, now)) { }
+    return MemoryCharge { bytes };
+}
+
+void MemoryCharge::release()
+{
+    if (uint64_t bytes = std::exchange(m_bytes, 0))
+        s_used -= bytes;
+}
+
+uint64_t estimatedTextureBytes(TextureFormat format, uint64_t width, uint64_t height, uint64_t depthOrArrayLayers, uint32_t mipLevelCount, uint32_t sampleCount)
+{
+    CheckedUint64 bytes = width;
+    bytes *= height;
+    bytes *= std::max<uint64_t>(depthOrArrayLayers, 1);
+    bytes *= bytesPerTexel(format);
+    bytes *= std::max<uint32_t>(sampleCount, 1);
+    if (bytes.hasOverflowed())
+        return UINT64_MAX;
+    uint64_t result = bytes.value();
+    if (mipLevelCount > 1)
+        result += result / 3;
+    return result;
+}
+
+uint64_t estimatedTextureBytes(const TextureDescriptor& descriptor)
+{
+    return estimatedTextureBytes(descriptor.format, descriptor.size.width, descriptor.size.height, descriptor.size.depthOrArrayLayers, descriptor.mipLevelCount, descriptor.sampleCount);
+}
+
+} // namespace WebGPU::Dawn
+
+// The title's [mem] line (port/webkit/apps/title/titlemem.c, weak there).
+extern "C" void ps5wk_webgpu_mem_stats(double* usedMB, double* peakMB, double* budgetMB, unsigned* refused);
+extern "C" void ps5wk_webgpu_mem_stats(double* usedMB, double* peakMB, double* budgetMB, unsigned* refused)
+{
+    using namespace WebGPU::Dawn;
+    *usedMB = s_used.load() / 1048576.0;
+    *peakMB = s_peak.load() / 1048576.0;
+    // Not budgetBytes(): that reads the file and logs, which is for the first WebGPU use.
+    *budgetMB = s_peak.load() ? budgetBytes() / 1048576.0 : 0;
+    *refused = s_refused.load();
+}
diff --git a/Source/WebGPU/WebGPUDawn/MemoryBudget.h b/Source/WebGPU/WebGPUDawn/MemoryBudget.h
new file mode 100644
index 0000000000..de6798a6a1
--- /dev/null
+++ b/Source/WebGPU/WebGPUDawn/MemoryBudget.h
@@ -0,0 +1,60 @@
+/*
+ * PS5 (spikes/12-webgpu): how much GPU memory the pages' WebGPU buffers and textures may take.
+ *
+ * The driver allocates them from the title's direct memory, which every tab, the compositor and
+ * video share, and a failed allocation deep in the driver is not something the title survives
+ * reliably. So the sizes are counted here, per title, and a buffer or texture that would go over
+ * the budget is not asked of the driver at all: the page gets an invalid object and a
+ * GPUOutOfMemoryError, as the specification has it for an allocation that fails.
+ *
+ * Texture sizes are estimates (texels x bytes per texel, a third more with mip levels, times the
+ * sample count); what the driver adds for alignment and metadata is not known here.
+ */
+
+#pragma once
+
+#include <WebGPU/WebGPUCpp.h>
+#include <cstdint>
+#include <optional>
+#include <wtf/Noncopyable.h>
+
+namespace WebGPU::Dawn {
+
+// Bytes counted against the budget for as long as this lives.
+class MemoryCharge {
+    WTF_MAKE_NONCOPYABLE(MemoryCharge);
+public:
+    MemoryCharge() = default;
+    MemoryCharge(MemoryCharge&& other)
+        : m_bytes(std::exchange(other.m_bytes, 0))
+    {
+    }
+    MemoryCharge& operator=(MemoryCharge&& other)
+    {
+        if (this != &other) {
+            release();
+            m_bytes = std::exchange(other.m_bytes, 0);
+        }
+        return *this;
+    }
+    ~MemoryCharge() { release(); }
+
+    // Nothing when the budget has no room for `bytes` more. Any thread.
+    static std::optional<MemoryCharge> tryTake(uint64_t bytes);
+    void release();
+    uint64_t bytes() const { return m_bytes; }
+
+private:
+    explicit MemoryCharge(uint64_t bytes)
+        : m_bytes(bytes)
+    {
+    }
+
+    uint64_t m_bytes { 0 };
+};
+
+// What a texture takes, more or less. UINT64_MAX when the product overflows.
+uint64_t estimatedTextureBytes(const TextureDescriptor&);
+uint64_t estimatedTextureBytes(TextureFormat, uint64_t width, uint64_t height, uint64_t depthOrArrayLayers, uint32_t mipLevelCount, uint32_t sampleCount);
+
+} // namespace WebGPU::Dawn
