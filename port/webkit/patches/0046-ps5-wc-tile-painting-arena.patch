+void DrawingAreaProxyWCPS5::resolveTileArena(WCUpdateInfo& info)
+{
+    using ChunkMap = decltype(m_tileArenaChunks);
+    for (auto& chunk : info.tileArenaChunks) {
+        if (!ChunkMap::isValidKey(chunk.id()))
+            continue;
+        if (auto* memory = chunk.memory())
+            m_tileArenaChunks.set(chunk.id(), Ref { *memory });
+        else {
+            WTFLogAlways("[wc] tile arena chunk %llu could not be mapped", static_cast<unsigned long long>(chunk.id())); // NOLINT
+            m_tileArenaChunks.remove(chunk.id());
+        }
+    }
+    info.tileArenaChunks.clear();
+    for (auto& layer : info.changedLayers) {
+        for (auto& tile : layer.background.tileUpdates) {
+            auto& slot = tile.backingStore.arenaSlot();
+            if (!slot)
+                continue;
+            RefPtr<WebCore::SharedMemory> memory;
+            if (ChunkMap::isValidKey(slot->chunk))
+                memory = m_tileArenaChunks.get(slot->chunk);
+            if (memory && slot->fits(memory->size()))
+                tile.backingStore.setArenaMemory(WTF::move(memory));
+            else if (!m_badTileArenaSlots++)
+                WTFLogAlways("[wc] tile arena slot in chunk %llu (offset %llu, %dx%d) is not mapped or out of range: tile skipped", // NOLINT
+                    static_cast<unsigned long long>(slot->chunk), static_cast<unsigned long long>(slot->offset), slot->size.width(), slot->size.height());
+        }
+    }
+    for (auto id : info.removedTileArenaChunks) {
+        if (ChunkMap::isValidKey(id))
+            m_tileArenaChunks.remove(id);
+    }
+}
