+bool WCTileArenaSlot::fits(size_t chunkSize) const
+{
+    if (size.isEmpty() || size.width() > 8192 || size.height() > 8192)
+        return false;
+    uint64_t minimumBytesPerRow = static_cast<uint64_t>(size.width()) * 4;
+    if (bytesPerRow < minimumBytesPerRow)
+        return false;
+    uint64_t bytes = static_cast<uint64_t>(bytesPerRow) * (size.height() - 1) + minimumBytesPerRow;
+    return offset <= chunkSize && bytes <= chunkSize - offset;
+}
+
+WCTileArenaChunk::WCTileArenaChunk(uint64_t id, std::optional<WebCore::SharedMemoryHandle>&& handle)
+    : m_id(id)
+{
+    if (handle)
+        m_memory = WebCore::SharedMemory::map(WTF::move(*handle), WebCore::SharedMemory::Protection::ReadOnly);
+}
+
+std::optional<WebCore::SharedMemoryHandle> WCTileArenaChunk::createHandle() const
+{
+    if (!m_memory)
+        return std::nullopt;
+    return m_memory->createHandle(WebCore::SharedMemory::Protection::ReadOnly);
