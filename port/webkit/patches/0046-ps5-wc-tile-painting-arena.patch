+
+static unsigned envUnsigned(const char* name, unsigned fallback, unsigned minimum, unsigned maximum)
+{
+    const char* text = getenv(name);
+    if (!text || !*text)
+        return fallback;
+    auto value = parseInteger<unsigned>(StringView::fromLatin1(text));
+    return value ? std::clamp(*value, minimum, maximum) : fallback;
+}
+
+bool WCTilePainter::isEnabled()
+{
+    static bool enabled = envUnsigned("PS5WK_WC_TILE_PAINT", 1, 0, 1);
+    return enabled;
+}
+
+// The same knob as the CPU path's band painting (0032): threads that replay,
+// the main thread included unless asynchronous.
+static unsigned paintThreads()
+{
+    static unsigned threads = envUnsigned("PS5WK_PAINT_THREADS", 4, 1, 8);
+    return threads;
+}
+
+static bool paintAsync()
+{
+    static bool enabled = envUnsigned("PS5WK_WC_PAINT_ASYNC", 0, 0, 1);
+    return enabled;
+}
+
+// A layer whose dirty parts are smaller than this is painted directly into
+// the arena on the main thread (recording would cost more than it saves).
+static uint64_t recordMinPixels()
+{
+    static uint64_t pixels = envUnsigned("PS5WK_WC_RECORD_MIN_PX", 65536, 0, 1u << 30);
+    return pixels;
+}
+
+static WorkerPool& paintPool()
+{
+    static NeverDestroyed<Ref<WorkerPool>> pool = WorkerPool::create("WCPaint"_s, std::max(1u, paintThreads() - (paintAsync() ? 0 : 1)));
+    return pool.get();
+}
+
+static sk_sp<SkColorSpace> tileColorSpace()
+{
+    // As ImageBufferShareableBitmapBackend's bitmaps (ColorSpace::SRGB()).
+    return ColorSpace::SRGB().platformColorSpace();
+}
+
+// ---- The arena ----
+
+// Chunks of shared memory, mapped once here and once in the UI process
+// (each 2 MB of a mapping costs a page table, so chunks are few and large).
+// A slot is any 64-byte aligned range; first fit. Main thread only.
+class WCTileArena {
+public:
+    static WCTileArena& singleton()
+    {
+        static NeverDestroyed<WCTileArena> arena;
+        return arena.get();
+    }
+
+    struct Slot {
+        WCTileArenaSlot slot;
+        uint8_t* pixels;
+    };
+    std::optional<Slot> allocate(const IntSize&, WCTileArenaUse&);
+    void release(const Vector<WCTileArenaUse::Allocation>&);
+
+    template<typename Functor> void forEachChunk(const Functor& functor) const
+    {
+        for (auto& chunk : m_chunks)
+            functor(chunk->id, chunk->memory.get());
+    }
+    bool hasChunk(uint64_t id) const
+    {
+        return m_chunks.containsIf([&](auto& chunk) { return chunk->id == id; });
+    }
+
+    WCTileArena()
+        : m_trimTimer(Ref { RunLoop::mainSingleton() }, "WCTileArena::trim"_s, [this] { trim(); }) // never destroyed
+    {
+    }
+
+private:
+    struct Chunk {
+        WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(Chunk);
+        uint64_t id;
+        Ref<SharedMemory> memory;
+        std::map<uint64_t, uint64_t> free; // offset -> size
+        uint64_t used { 0 };
+        MonotonicTime lastAllocation;
+    };
+    static std::optional<uint64_t> allocateIn(Chunk&, uint64_t size);
+    bool addChunk(uint64_t minimumSize);
+    void trim();
+
+    Vector<std::unique_ptr<Chunk>> m_chunks;
+    uint64_t m_nextChunkID { 1 };
+    uint64_t m_totalSize { 0 };
+    RunLoop::Timer m_trimTimer;
+};
+
+static uint64_t arenaChunkSize()
+{
+    static uint64_t bytes = static_cast<uint64_t>(envUnsigned("PS5WK_WC_ARENA_CHUNK_MB", 8, 2, 64)) << 20;
+    return bytes;
+}
+
+static uint64_t arenaMaxSize()
+{
+    static uint64_t bytes = static_cast<uint64_t>(envUnsigned("PS5WK_WC_ARENA_MB", 64, 8, 512)) << 20;
+    return bytes;
+}
+
+std::optional<uint64_t> WCTileArena::allocateIn(Chunk& chunk, uint64_t size)
+{
+    for (auto it = chunk.free.begin(); it != chunk.free.end(); ++it) {
+        if (it->second < size)
+            continue;
+        uint64_t offset = it->first;
+        uint64_t left = it->second - size;
+        chunk.free.erase(it);
+        if (left)
+            chunk.free.emplace(offset + size, left);
+        chunk.used += size;
+        chunk.lastAllocation = MonotonicTime::now();
+        return offset;
+    }
+    return std::nullopt;
+}
+
+bool WCTileArena::addChunk(uint64_t minimumSize)
+{
+    uint64_t size = std::max(arenaChunkSize(), (minimumSize + (2 << 20) - 1) & ~static_cast<uint64_t>((2 << 20) - 1));
+    if (m_totalSize + size > arenaMaxSize())
+        return false;
+    RefPtr memory = SharedMemory::allocate(size);
+#if defined(PS5_PAYLOAD_SDK)
+    wcTilePaintStats().shmAllocations++;
+#endif
+    if (!memory)
+        return false;
+    auto chunk = makeUnique<Chunk>(Chunk { m_nextChunkID++, memory.releaseNonNull(), { }, 0, { } });
+    chunk->free.emplace(0, size);
+    m_totalSize += size;
+#if defined(PS5_PAYLOAD_SDK)
+    WTFLogAlways("[wc] tile arena: chunk %llu of %.0f MB (%.0f MB in %zu chunks)", static_cast<unsigned long long>(chunk->id), size / 1048576.0, m_totalSize / 1048576.0, m_chunks.size() + 1); // NOLINT
+#endif
+    m_chunks.append(WTF::move(chunk));
+    return true;
+}
+
+std::optional<WCTileArena::Slot> WCTileArena::allocate(const IntSize& size, WCTileArenaUse& use)
+{
+    if (size.isEmpty())
+        return std::nullopt;
+    uint32_t bytesPerRow = static_cast<uint32_t>(size.width()) * 4;
+    uint64_t bytes = (static_cast<uint64_t>(bytesPerRow) * size.height() + 63) & ~static_cast<uint64_t>(63);
+    for (int attempt = 0; attempt < 2; attempt++) {
+        for (auto& chunk : m_chunks) {
+            if (auto offset = allocateIn(*chunk, bytes)) {
+                use.add({ chunk->id, *offset, bytes });
+                return Slot { { chunk->id, *offset, bytesPerRow, size }, chunk->memory->mutableSpan().subspan(*offset).data() };
+            }
+        }
+        if (attempt || !addChunk(bytes))
+            break;
+    }
+    return std::nullopt;
+}
+
+void WCTileArena::release(const Vector<WCTileArenaUse::Allocation>& allocations)
+{
+    for (auto& allocation : allocations) {
+        auto index = m_chunks.findIf([&](auto& chunk) { return chunk->id == allocation.chunk; });
+        if (index == notFound)
+            continue;
+        auto& chunk = *m_chunks[index];
+        chunk.used -= std::min(chunk.used, allocation.size);
+        auto it = chunk.free.emplace(allocation.offset, allocation.size).first;
+        // Coalesce with the neighbours.
+        if (auto next = std::next(it); next != chunk.free.end() && it->first + it->second == next->first) {
+            it->second += next->second;
+            chunk.free.erase(next);
+        }
+        if (it != chunk.free.begin()) {
+            auto previous = std::prev(it);
+            if (previous->first + previous->second == it->first) {
+                previous->second += it->second;
+                chunk.free.erase(it);
+            }
+        }
+    }
+    if (m_chunks.size() > 1 && !m_trimTimer.isActive())
+        m_trimTimer.startOneShot(5_s);
+}
+
+// Chunks beyond the first go when they have been empty and unused for 5 s
+// (a page load or a big repaint needs more than scrolling does).
+void WCTileArena::trim()
+{
+    auto now = MonotonicTime::now();
+    bool keptSpare = false;
+    for (size_t i = m_chunks.size(); i-- > 1;) {
+        auto& chunk = *m_chunks[i];
+        if (chunk.used) {
+            keptSpare = true;
+            continue;
+        }
+        if (now - chunk.lastAllocation < 5_s) {
+            keptSpare = true;
+            continue;
+        }
+        m_totalSize -= chunk.memory->size();
+#if defined(PS5_PAYLOAD_SDK)
+        WTFLogAlways("[wc] tile arena: chunk %llu released (%.0f MB in %zu chunks)", static_cast<unsigned long long>(chunk.id), m_totalSize / 1048576.0, m_chunks.size() - 1); // NOLINT
+#endif
+        m_chunks.removeAt(i);
+    }
+    if (keptSpare)
+        m_trimTimer.startOneShot(5_s);
+}
+
+WCTileArenaUse::~WCTileArenaUse()
+{
+    if (m_allocations.isEmpty())
+        return;
+    if (isMainRunLoop()) {
+        WCTileArena::singleton().release(m_allocations);
+        return;
+    }
+    RunLoop::mainSingleton().dispatch([allocations = WTF::move(m_allocations)] {
+        WCTileArena::singleton().release(allocations);
+    });
+}
+
+// ---- Recording and replay ----
+
+struct RasterItem {
+    sk_sp<SkPicture> picture;
+    uint8_t* pixels; // the part's slot
+    uint32_t bytesPerRow;
+    IntRect deviceRect; // the part, in the layer's device pixels
+    int y0, y1; // rows of the part this item paints
+};
+
+class WCTilePainter::Batch : public ThreadSafeRefCounted<Batch> {
+public:
+    static Ref<Batch> create() { return adoptRef(*new Batch); }
+
+    Ref<WCTileArenaUse> use { WCTileArenaUse::create() };
+    Vector<RasterItem> items;
+    uint64_t pixels { 0 };
+
+    // Raster.
+    SkSurfaceProps props { FontRenderOptions::singleton().createSurfaceProps() };
+    std::atomic<unsigned> nextItem { 0 };
+    std::atomic<unsigned> itemsLeft { 0 };
+    MonotonicTime start;
+    SendFunction send;
+
+    void runItems()
+    {
+        for (unsigned index; (index = nextItem.fetch_add(1, std::memory_order_relaxed)) < items.size();)
+            paint(items[index]);
+    }
+
+    void paint(const RasterItem& item) const
+    {
+        int rows = item.y1 - item.y0;
+        auto info = SkImageInfo::MakeN32Premul(item.deviceRect.width(), rows, tileColorSpace());
+        auto canvas = SkCanvas::MakeRasterDirect(info, item.pixels + static_cast<size_t>(item.y0) * item.bytesPerRow, item.bytesPerRow, &props);
+        if (!canvas)
+            return;
+        canvas->clear(SK_ColorTRANSPARENT);
+        canvas->translate(-item.deviceRect.x(), -(item.deviceRect.y() + item.y0));
+        item.picture->playback(canvas.get());
+    }
+
+private:
+    Batch() = default;
+};
+
+WCTilePainter::WCTilePainter()
+    : m_batch(Batch::create())
+{
+}
+
+WCTilePainter::~WCTilePainter() = default;
+
+static void paintDirect(GraphicsLayerWC& layer, const IntRect& layerRect, const IntSize& deviceSize, float deviceScaleFactor, uint8_t* pixels, uint32_t bytesPerRow)
+{
+    // As the old path's ImageBuffer (ImageBufferShareableBitmapBackend,
+    // ShareableBitmap::createGraphicsContext).
+    auto info = SkImageInfo::MakeN32Premul(deviceSize.width(), deviceSize.height(), tileColorSpace());
+    SkSurfaceProps props = FontRenderOptions::singleton().createSurfaceProps();
+    auto surface = SkSurfaces::WrapPixels(info, pixels, bytesPerRow, &props);
+    if (!surface)
+        return;
+    auto* canvas = surface->getCanvas();
+    canvas->clear(SK_ColorTRANSPARENT);
+    GraphicsContextSkia context(*canvas, RenderingMode::Unaccelerated, RenderingPurpose::ShareableSnapshot);
+    context.applyDeviceScaleFactor(deviceScaleFactor);
+    context.translate(-layerRect.x(), -layerRect.y());
+    layer.paintGraphicsLayerContents(context, layerRect);
+}
+
+Vector<WCTilePainter::Part> WCTilePainter::paintLayer(GraphicsLayerWC& layer, const Vector<Part>& parts, float deviceScaleFactor, Vector<WCTileUpdate>& tileUpdates)
+{
+    auto start = MonotonicTime::now();
+    auto& arena = WCTileArena::singleton();
+    Vector<Part> unplaced;
+
+    struct Placed {
+        const Part* part;
+        IntRect deviceRect;
+        WCTileArena::Slot slot;
+    };
+    Vector<Placed> placed;
+    uint64_t pixels = 0;
+    IntRect deviceBounds;
+    Region region; // layer coordinates
+    for (auto& part : parts) {
+        IntRect deviceRect = part.rect;
+        deviceRect.scale(deviceScaleFactor);
+        if (deviceRect.isEmpty())
+            continue;
+        auto slot = arena.allocate(deviceRect.size(), m_batch->use.get());
+        if (!slot) {
+            unplaced.append(part);
+            continue;
+        }
+        placed.append({ &part, deviceRect, *slot });
+        pixels += static_cast<uint64_t>(deviceRect.width()) * deviceRect.height();
+        deviceBounds.unite(deviceRect);
+        region.unite(part.rect);
+    }
+    if (placed.isEmpty())
+        return unplaced;
+
+    sk_sp<SkPicture> picture;
+    double recordMS = 0;
+    if (paintThreads() > 1 && pixels >= recordMinPixels()) {
+        // Recorded in the layer's device pixels, with a bounding box
+        // hierarchy so each band's replay visits only its own operations.
+        SkPictureRecorder recorder;
+        SkRTreeFactory rtreeFactory;
+        auto* recordingCanvas = recorder.beginRecording(SkRect::Make(SkIRect::MakeXYWH(deviceBounds.x(), deviceBounds.y(), deviceBounds.width(), deviceBounds.height())), &rtreeFactory);
+        {
+            GraphicsContextSkia context(*recordingCanvas, RenderingMode::Unaccelerated, RenderingPurpose::DOM);
+            context.beginRecording(GraphicsContextSkia::RecordingMode::Tile);
+            context.applyDeviceScaleFactor(deviceScaleFactor);
+            for (auto& rect : region.rects()) {
+                GraphicsContextStateSaver saver(context);
+                context.clip(FloatRect(rect));
+                layer.paintGraphicsLayerContents(context, rect);
+            }
+            context.endRecording();
+        }
+        picture = recorder.finishRecordingAsPicture();
+        recordMS = (MonotonicTime::now() - start).milliseconds();
+    }
+
+    for (auto& entry : placed) {
+        auto& slot = entry.slot;
+        if (picture) {
+            // Bands of at least 64 rows (16k pixels), so the pool's threads
+            // share an expensive tile.
+            int width = entry.deviceRect.width();
+            int height = entry.deviceRect.height();
+            int bandRows = std::max(64, 16384 / std::max(1, width));
+            for (int y0 = 0; y0 < height; y0 += bandRows)
+                m_batch->items.append({ picture, slot.pixels, slot.slot.bytesPerRow, entry.deviceRect, y0, std::min(height, y0 + bandRows) });
+            m_batch->pixels += static_cast<uint64_t>(width) * height;
+        } else
+            paintDirect(layer, entry.part->rect, entry.deviceRect.size(), deviceScaleFactor, slot.pixels, slot.slot.bytesPerRow);
+
+        WCTileUpdate tileUpdate;
+        tileUpdate.index = entry.part->index;
+        tileUpdate.dirtyRect = entry.deviceRect;
+        tileUpdate.backingStore.setArenaSlot(slot.slot);
+        tileUpdates.append(WTF::move(tileUpdate));
+    }
+
+#if defined(PS5_PAYLOAD_SDK)
+    auto& stats = wcTilePaintStats();
+    stats.tiles += placed.size();
+    stats.pixels += pixels;
+    stats.milliseconds += (MonotonicTime::now() - start).milliseconds();
+    stats.recordMS += recordMS;
+    if (picture)
+        stats.recordedPixels += pixels;
+#else
+    UNUSED_VARIABLE(recordMS);
+#endif
+    return unplaced;
+}
+
+void WCTilePainter::addArenaChunks(WCUpdateInfo& info)
+{
+    auto& arena = WCTileArena::singleton();
+    Vector<uint64_t> removed;
+    for (auto id : m_chunksSent) {
+        if (!arena.hasChunk(id))
+            removed.append(id);
+    }
+    for (auto id : removed) {
+        m_chunksSent.remove(id);
+        info.removedTileArenaChunks.append(id);
+    }
+    arena.forEachChunk([&](uint64_t id, SharedMemory& memory) {
+        if (m_chunksSent.add(id).isNewEntry)
+            info.tileArenaChunks.append(WCTileArenaChunk { id, Ref { memory } });
+    });
+}
+
+void WCTilePainter::finish(SendFunction&& send)
+{
+    Ref batch = std::exchange(m_batch, Batch::create()).releaseNonNull();
+    if (batch->items.isEmpty()) {
+        send(WTF::move(batch->use));
+        return;
+    }
+
+    batch->start = MonotonicTime::now();
+    unsigned itemCount = batch->items.size();
+#if defined(PS5_PAYLOAD_SDK)
+    auto& stats = wcTilePaintStats();
+    stats.rasterItems += itemCount;
+    stats.rasterPixels += batch->pixels;
+#endif
+
+    if (!paintAsync()) {
+        // The main thread takes items too and waits for the helpers (they
+        // only touch the batch, which they keep alive).
+        struct Shared : ThreadSafeRefCounted<Shared> {
+            Lock lock;
+            Condition condition;
+            unsigned helpersDone WTF_GUARDED_BY_LOCK(lock) { 0 };
+        };
+        Ref shared = adoptRef(*new Shared);
+        unsigned helpers = std::min(paintThreads() - 1, itemCount - 1);
+        for (unsigned i = 0; i < helpers; i++) {
+            paintPool().postTask([batch, shared] {
+                batch->runItems();
+                Locker locker { shared->lock };
+                shared->helpersDone++;
+                shared->condition.notifyAll();
+            });
+        }
+        batch->runItems();
+        {
+            Locker locker { shared->lock };
+            while (shared->helpersDone < helpers)
+                shared->condition.wait(shared->lock);
+        }
+        double ms = (MonotonicTime::now() - batch->start).milliseconds();
+        batch->items.clear(); // the pictures go here, on the main thread
+#if defined(PS5_PAYLOAD_SDK)
+        stats.rasterMS += ms;
+        stats.milliseconds += ms; // the main thread waited for it
+#else
+        UNUSED_VARIABLE(ms);
+#endif
+        send(WTF::move(batch->use));
+        return;
+    }
+
+    // Asynchronous: pool threads take the items; the last one done hands the
+    // update back to the main thread, which sends it.
+    batch->send = WTF::move(send);
+    batch->itemsLeft = itemCount;
+    for (unsigned i = 0; i < std::min(paintThreads(), itemCount); i++) {
+        paintPool().postTask([batch] {
+            for (unsigned index; (index = batch->nextItem.fetch_add(1, std::memory_order_relaxed)) < batch->items.size();) {
+                batch->paint(batch->items[index]);
+                if (batch->itemsLeft.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+                    RunLoop::mainSingleton().dispatch([batch] {
+#if defined(PS5_PAYLOAD_SDK)
+                        wcTilePaintStats().rasterMS += (MonotonicTime::now() - batch->start).milliseconds();
+                        wcTilePaintStats().asyncBatches++;
+#endif
+                        batch->items.clear(); // the pictures go here, on the main thread
+                        auto send = std::exchange(batch->send, nullptr);
+                        send(Ref { batch->use });
+                    });
+                }
+            }
+        });
+    }
+}
+
+} // namespace WebKit
+
+#endif // USE(GRAPHICS_LAYER_WC) && USE(SKIA) && !ENABLE(GPU_PROCESS)
