+namespace WebKit {
+
+class GraphicsLayerWC;
+struct WCTileArenaSlot;
+struct WCTileUpdate;
+struct WCUpdateInfo;
+
+// The arena slots one update's tiles were painted into. They are free again
+// when the last reference goes: the update's reply, which the UI process
+// sends after the present, long after it uploaded them.
+class WCTileArenaUse : public ThreadSafeRefCounted<WCTileArenaUse> {
+public:
+    static Ref<WCTileArenaUse> create() { return adoptRef(*new WCTileArenaUse); }
+    ~WCTileArenaUse();
+
+    struct Allocation {
+        uint64_t chunk;
+        uint64_t offset;
+        uint64_t size;
+    };
+    void add(const Allocation& allocation) { m_allocations.append(allocation); }
+    bool isEmpty() const { return m_allocations.isEmpty(); }
+
+private:
+    WCTileArenaUse() = default;
+    Vector<Allocation> m_allocations;
+};
+
+// PS5 (COMPOSITING-PLAN.md, M5): the tiles of a rendering update are painted
+// into a persistent shared-memory arena (one per WebProcess, in chunks the UI
+// process maps once) instead of a new SharedMemory per tile. A layer's dirty
+// tiles are recorded once into an SkPicture on the main thread, and the
+// picture is replayed into each tile's slot, in bands, on a pool of painting
+// threads just before the update is sent (the main thread helps), or with
+// PS5WK_WC_PAINT_ASYNC=1 while the main thread goes on (the update is sent
+// when the bands are done). Small damage is painted directly into the arena.
+// PS5WK_WC_TILE_PAINT=0: the old path (a new ImageBuffer per tile, serial).
+class WCTilePainter {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(WCTilePainter);
+    WTF_MAKE_NONCOPYABLE(WCTilePainter);
+public:
+    WCTilePainter();
+    ~WCTilePainter();
+
+    static bool isEnabled();
+
+    struct Part {
+        WebCore::TextureMapperSparseBackingStore::TileIndex index;
+        WebCore::IntRect rect; // layer coordinates
+    };
+    // Main thread, while the layer tree is flushed: paints the parts into
+    // arena slots (or records them for the pool) and appends one tile
+    // update per part. Returns the parts that found no slot (arena full):
+    // the caller paints those the old way.
+    Vector<Part> paintLayer(GraphicsLayerWC&, const Vector<Part>&, float deviceScaleFactor, Vector<WCTileUpdate>&);
+
+    // Before the update is sent: the arena chunks this drawing area's proxy
+    // doesn't have yet (and those freed since) go with the first update.
+    void addArenaChunks(WCUpdateInfo&);
+
+    // Rasterizes what paintLayer recorded since the last call, then calls
+    // send on the main thread with the slots the update holds (synchronously
+    // unless PS5WK_WC_PAINT_ASYNC=1).
+    using SendFunction = Function<void(Ref<WCTileArenaUse>&&)>;
+    void finish(SendFunction&&);
+
+private:
+    class Batch;
+    RefPtr<Batch> m_batch;
+    HashSet<uint64_t, DefaultHash<uint64_t>, WTF::UnsignedWithZeroKeyHashTraits<uint64_t>> m_chunksSent;
+};
+
+} // namespace WebKit
