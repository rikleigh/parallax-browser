+#if !ENABLE(GPU_PROCESS)
+void DrawingAreaWC::sendUpdatesWC(Vector<PendingUpdate>&& updates)
+{
+    // WPE (PS5): the scene is hosted by the UI process (DrawingAreaProxyWCPS5,
+    // PS5WCHost). Its reply comes after the swap that presents this update,
+    // so with one update in flight (m_waitDidUpdate) rendering updates and
+    // rAF follow the display. The reply also comes (empty) if the message
+    // is cancelled, e.g. the UI-side proxy went away. Tiles in the shared
+    // arena (WCTilePainter) are painted by then and their slots are free
+    // again when every reply has come.
+    auto send = [weakThis = WeakPtr(*this), updates = WTF::move(updates)](RefPtr<WCTileArenaUse>&& arenaUse) mutable {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+#if USE(SKIA)
+        if (protectedThis->m_tilePainter && !updates.isEmpty())
+            protectedThis->m_tilePainter->addArenaChunks(updates[0].info);
+#endif
+        for (auto& update : updates) {
+            Ref { protectedThis->m_webPage.get() }->sendWithAsyncReply(Messages::DrawingAreaProxy::UpdateWC(WTF::move(update.info)), [weakThis, willCallDisplayDidRefresh = update.willCallDisplayDidRefresh, arenaUse] {
+                RefPtr protectedThis = weakThis.get();
+                if (protectedThis && willCallDisplayDidRefresh)
+                    protectedThis->displayDidRefresh();
+            }, protectedThis->m_identifier.toUInt64());
+        }
+#if defined(PS5_PAYLOAD_SDK)
+        protectedThis->m_lastUpdateSent = MonotonicTime::now();
 #endif
+    };
+#if USE(SKIA)
+    if (m_tilePainter) {
+        m_tilePainter->finish([send = WTF::move(send)](Ref<WCTileArenaUse>&& arenaUse) mutable {
+            send(WTF::move(arenaUse));
+        });
+        return;
     }
+#endif
+    send(nullptr);
 }
+#endif
 
