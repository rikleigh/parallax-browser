+/*
+ * PS5: WebGPU canvases over Dawn in the title (spikes/12-webgpu, P3).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ * Modelled on GPUCanvasContextCocoa.h (Copyright (C) 2021-2023 Apple Inc.).
+ */
+
+#pragma once
+
+#if USE(DAWN)
+
+#include "GPU.h"
+#include "GPUBasedCanvasRenderingContext.h"
+#include "GPUCanvasConfiguration.h"
+#include "GPUCanvasContext.h"
+#include "GPUCompositorIntegration.h"
+#include "GPUPresentationContext.h"
+#include "GPUTexture.h"
+#include "GraphicsLayerContentsDisplayDelegate.h"
+#include "HTMLCanvasElement.h"
+#include "OffscreenCanvas.h"
+#include <wtf/Ref.h>
+#include <wtf/RefPtr.h>
+
+namespace WebCore {
+
+class Document;
+
+// The canvas context where the WebGPU implementation shares no textures with the compositor
+// (Dawn on RADV in the title, the compositor on ps5-opengl).
+//
+// - One render buffer, index 0. Its size travels in the canvas configuration, so a canvas whose
+//   size changes is unconfigured and configured again with the same configuration.
+// - Display: prepareForDisplay() presents the frame in the title, which reads it back and shows
+//   it in the layer this context's display delegate names by key (ps5WebGLLayerKey; WebKit's
+//   PS5WebGPUCanvas.h). No pixels pass through this process for display.
+// - Reading (toDataURL, drawImage, createImageBitmap, toBlob): a synchronous read of the render
+//   buffer's texture, whose contents stay after the frame is presented, into an unaccelerated
+//   image buffer (GPUCompositorIntegration::ps5ReadPixels).
+class GPUCanvasContextPS5 final : public GPUCanvasContext {
+    WTF_MAKE_TZONE_ALLOCATED(GPUCanvasContextPS5);
+public:
+    static std::unique_ptr<GPUCanvasContextPS5> create(CanvasBase&, GPU&, Document*);
+
+    ~GPUCanvasContextPS5();
+
+    ColorSpace colorSpace() const override;
+    bool compositingResultsNeedUpdating() const override { return m_compositingResultsNeedsUpdating; }
+    RefPtr<GraphicsLayerContentsDisplayDelegate> layerContentsDisplayDelegate() override;
+    bool needsPreparationForDisplay() const override { return true; }
+    void prepareForDisplay() override;
+    bool isOpaque() const override;
+    void didUpdateCanvasSizeProperties(bool) override;
+
+    RefPtr<ImageBuffer> surfaceBufferToImageBuffer(SurfaceBuffer) override;
+    RefPtr<NativeImage> surfaceBufferToNativeImage(SurfaceBuffer) override;
+    bool isSurfaceBufferTransparentBlack(SurfaceBuffer) const final { return false; }
+
+    // GPUCanvasContext methods:
+    CanvasType canvas() override;
+    ExceptionOr<void> configure(GPUCanvasConfiguration&&) override;
+    void unconfigure() override;
+    std::optional<GPUCanvasConfiguration> getConfiguration() const override;
+    GPUDevice* device() const override { return m_configuration ? m_configuration->device.ptr() : nullptr; }
+    ExceptionOr<Ref<GPUTexture>> getCurrentTexture() override;
+    RefPtr<ImageBuffer> transferToImageBuffer() override;
+
+private:
+    GPUCanvasContextPS5(CanvasBase&, Ref<GPUCompositorIntegration>&&, Ref<GPUPresentationContext>&&);
+
+    // The only render buffer.
+    static constexpr uint32_t frameIndex = 0;
+
+    bool isConfigured() const { return static_cast<bool>(m_configuration); }
+
+    CanvasType htmlOrOffscreenCanvas() const;
+    ExceptionOr<void> configure(GPUCanvasConfiguration&&, bool dueToReshape);
+    void willUpdateDisplayBufferContents();
+    void expireCurrentTexture();
+    void present();
+    RefPtr<ImageBuffer> createReadBuffer() const;
+    void updateMemoryCost() const;
+
+    struct Configuration {
+        Ref<GPUDevice> device;
+        GPUTextureFormat format { GPUTextureFormat::R8unorm };
+        GPUTextureUsageFlags usage { GPUTextureUsage::RENDER_ATTACHMENT };
+        Vector<GPUTextureFormat> viewFormats;
+        PredefinedColorSpace colorSpace { PredefinedColorSpace::SRGB };
+        GPUCanvasToneMapping toneMapping;
+        GPUCanvasAlphaMode compositingAlphaMode { GPUCanvasAlphaMode::Opaque };
+        // A frame of this configuration has been presented: the title has, or will soon have, a
+        // frame of it to show.
+        bool hasPresentedFrame { false };
+    };
+    std::optional<Configuration> m_configuration;
+
+    const Ref<GPUCompositorIntegration> m_compositorIntegration;
+    const Ref<GPUPresentationContext> m_presentationContext;
+    const Ref<GraphicsLayerContentsDisplayDelegate> m_layerContentsDisplayDelegate;
+    RefPtr<GPUTexture> m_currentTexture;
+
+    GPUIntegerCoordinate m_width { 0 };
+    GPUIntegerCoordinate m_height { 0 };
+    // A frame was started (getCurrentTexture) and has not been presented.
+    bool m_compositingResultsNeedsUpdating { false };
+};
+
+} // namespace WebCore
+
