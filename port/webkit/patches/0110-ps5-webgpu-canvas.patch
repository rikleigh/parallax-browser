+bool RemoteCompositorIntegrationProxy::ps5ReadPixels(uint32_t bufferIndex, bool currentFrame, bool opaque, WebCore::ImageBuffer& destination)
+{
+    auto sendResult = sendSync(Messages::RemoteCompositorIntegration::ReadPixelsPS5(bufferIndex, currentFrame));
+    if (!sendResult.succeeded())
+        return false;
+    auto [handle, width, height, format, alphaMode] = sendResult.takeReply();
+    if (!handle)
+        return false;
+
+    // Frames of another size are of an earlier configuration of the canvas: it reads as cleared.
+    auto size = destination.backendSize();
+    if (size.isEmpty() || width != static_cast<uint32_t>(size.width()) || height != static_cast<uint32_t>(size.height()))
+        return false;
+
+    WebCore::PixelFormat pixelFormat;
+    switch (format) {
+    case ::WebGPU::TextureFormat::Bgra8unorm:
+    case ::WebGPU::TextureFormat::Bgra8unormSRGB:
+        pixelFormat = WebCore::PixelFormat::BGRA8;
+        break;
+    case ::WebGPU::TextureFormat::Rgba8unorm:
+    case ::WebGPU::TextureFormat::Rgba8unormSRGB:
+        pixelFormat = WebCore::PixelFormat::RGBA8;
+        break;
+    default:
+        return false;
+    }
+
+    RefPtr memory = WebCore::SharedMemory::map(WTF::move(*handle), WebCore::SharedMemory::Protection::ReadWrite);
+    auto byteCount = CheckedSize { width } * static_cast<size_t>(height) * static_cast<size_t>(4);
+    if (!memory || byteCount.hasOverflowed() || memory->size() < byteCount.value())
+        return false;
+    auto pixels = memory->mutableSpan().first(byteCount.value());
+
+    // A frame the title kept says what it was presented as; the texture is of the canvas's
+    // current configuration.
+    if (!currentFrame)
+        opaque = alphaMode == ::WebGPU::CanvasAlphaMode::Opaque;
+    // An opaque canvas's alpha channel is whatever the page drew, and reads as 1. A
+    // premultiplied canvas's pixels are premultiplied, as the image buffer's are.
+    if (opaque) {
+        for (size_t i = 3; i < pixels.size(); i += 4)
+            pixels[i] = 0xff;
+    }
+
+    WebCore::PixelBufferFormat sourceFormat { WebCore::AlphaPremultiplication::Premultiplied, pixelFormat, destination.colorSpace() };
+    auto source = WebCore::PixelBufferSourceView::create(sourceFormat, size, pixels);
+    if (!source)
+        return false;
+    destination.putPixelBuffer(*source, WebCore::IntRect { { }, size });
+    return true;
+}
 #endif
 
