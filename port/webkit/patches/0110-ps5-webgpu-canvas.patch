+bool WCScene::webGLLayersNeedPaint()
+{
+    bool needPaint = false;
+#if HAVE_PS5_WEBGL_LAYERS
+    for (auto& entry : m_layers) {
+        auto& layer = *entry.value;
+        if (!layer.webGLLayer)
+            continue;
+        // Once for each arrival, shown or not (a hidden canvas's frames stay pending).
+        if (uint64_t arrivals = layer.webGLLayer->arrivals(); arrivals != layer.webGLArrivalsSeen) {
+            layer.webGLArrivalsSeen = arrivals;
+            needPaint = true;
+        }
+    }
+#endif
+    return needPaint;
+}
