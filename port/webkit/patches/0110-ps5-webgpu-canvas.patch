diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.cpp b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.cpp
new file mode 100644
index 0000000000..fdb43db4b8
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.cpp
@@ -0,0 +1,122 @@
+/*
+ * PS5: WebGPU canvases as WC contents layers (spikes/12-webgpu).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ */
+
+#include "config.h"
+#include "PS5WebGPUCanvas.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(DAWN) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include "PS5WebGLLayers.h"
+#include <WebCore/BitmapTexture.h>
+#include <WebCore/CoordinatedPlatformLayerBuffer.h>
+#include <WebCore/PixelFormat.h>
+#include <WebCore/TextureMapper.h>
+#include <wtf/StdLibExtras.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+
+// One frame as the layer's buffer. The texture is made and filled on the
+// render thread at the first paint (BitmapTexture's PS5 upload path: a
+// staging ring, no glTexSubImage2D), and dies there with the buffer
+// (PS5WebGLLayers::collectGarbage).
+class FrameBuffer final : public CoordinatedPlatformLayerBuffer {
+public:
+    explicit FrameBuffer(Ref<PS5WebGPUCanvas::Frame>&& frame)
+        : CoordinatedPlatformLayerBuffer(Type::RGB, IntSize(frame->width, frame->height), { }, nullptr)
+        , m_frame(WTF::move(frame))
+    {
+    }
+
+private:
+    void paintToTextureMapper(TextureMapper& textureMapper, const FloatRect& targetRect, const TransformationMatrix& modelViewMatrix, float opacity) final
+    {
+        if (!m_texture) {
+            const bool opaque = m_frame->alphaMode == ::WebGPU::CanvasAlphaMode::Opaque;
+            const bool bgra = m_frame->format == ::WebGPU::TextureFormat::Bgra8unorm || m_frame->format == ::WebGPU::TextureFormat::Bgra8unormSRGB;
+            // An opaque canvas's alpha channel is whatever the page drew: X formats ignore it.
+            const PixelFormat pixelFormat = bgra ? (opaque ? PixelFormat::BGRX8 : PixelFormat::BGRA8) : (opaque ? PixelFormat::RGBX8 : PixelFormat::RGBA8);
+            OptionSet<BitmapTexture::Flags> flags;
+            if (!opaque)
+                flags.add(BitmapTexture::Flags::SupportsAlpha);
+            m_texture = BitmapTexture::create(size(), flags);
+            m_texture->updateContents(m_frame->pixels.span().data(), IntRect(IntPoint(), size()), IntPoint(), size().width() * 4, pixelFormat);
+        }
+        textureMapper.drawTexture(*m_texture, targetRect, modelViewMatrix, opacity);
+    }
+
+    const Ref<PS5WebGPUCanvas::Frame> m_frame;
+    RefPtr<BitmapTexture> m_texture;
+};
+
+} // namespace
+
+Ref<PS5WebGPUCanvas> PS5WebGPUCanvas::create(ProcessIdentifier webProcess, uint64_t key)
+{
+    return adoptRef(*new PS5WebGPUCanvas(webProcess, key));
+}
+
+PS5WebGPUCanvas::PS5WebGPUCanvas(ProcessIdentifier webProcess, uint64_t key)
+    : m_webProcess(webProcess)
+    , m_key(key)
+    , m_layer(PS5WebGLLayer::create())
+{
+    // Frames arrive when Dawn has read them back, after the page's layer update.
+    m_layer->setPaintsOnArrival();
+    PS5WebGLLayers::add(m_webProcess, m_key, m_layer);
+    WTFLogAlways("[webgpu] title: canvas %" PRIx64 " of WebProcess %" PRIu64, m_key & ~keyTag, m_webProcess.toUInt64());
+}
+
+PS5WebGPUCanvas::~PS5WebGPUCanvas()
+{
+    m_layer->detach();
+    PS5WebGLLayers::remove(m_webProcess, m_key);
+}
+
+void PS5WebGPUCanvas::frameWasPresented(std::span<const uint8_t> pixels, uint32_t width, uint32_t height, ::WebGPU::TextureFormat format, ::WebGPU::CanvasAlphaMode alphaMode)
+{
+    switch (format) {
+    case ::WebGPU::TextureFormat::Bgra8unorm:
+    case ::WebGPU::TextureFormat::Bgra8unormSRGB:
+    case ::WebGPU::TextureFormat::Rgba8unorm:
+    case ::WebGPU::TextureFormat::Rgba8unormSRGB:
+        break;
+    default:
+        if (!std::exchange(m_loggedFormat, true))
+            WTFLogAlways("[webgpu] title: canvas %" PRIx64 ": frames in texture format %u are not shown (8-bit BGRA and RGBA only)", m_key & ~keyTag, static_cast<unsigned>(format));
+        return;
+    }
+    const size_t bytes = static_cast<size_t>(width) * height * 4;
+    if (!width || !height || pixels.size() < bytes)
+        return;
+
+    Ref frame = adoptRef(*new Frame);
+    frame->pixels.append(pixels.first(bytes));
+    frame->width = width;
+    frame->height = height;
+    frame->format = format;
+    frame->alphaMode = alphaMode;
+    {
+        Locker locker { m_lock };
+        m_lastFrame = frame.ptr();
+    }
+    // The frame's pixels, and its texture once painted.
+    m_layer->setDrawingBufferBytes(2 * bytes);
+    m_layer->setBuffer(makeUnique<FrameBuffer>(WTF::move(frame)));
+    if (!std::exchange(m_loggedFirstFrame, true))
+        WTFLogAlways("[webgpu] title: canvas %" PRIx64 ": first frame, %ux%u, format %u, %s", m_key & ~keyTag, width, height, static_cast<unsigned>(format), alphaMode == ::WebGPU::CanvasAlphaMode::Opaque ? "opaque" : "premultiplied");
+}
+
+RefPtr<PS5WebGPUCanvas::Frame> PS5WebGPUCanvas::lastFrame() const
+{
+    Locker locker { m_lock };
+    return m_lastFrame;
+}
+
+} // namespace WebKit
+
+#endif
diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.h b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.h
new file mode 100644
index 0000000000..f3ac866f1f
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUCanvas.h
@@ -0,0 +1,74 @@
+/*
+ * PS5: WebGPU canvases as WC contents layers (spikes/12-webgpu).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ */
+
+#pragma once
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(DAWN) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/ProcessIdentifier.h>
+#include <WebCore/WebGPUCppAPI.h>
+#include <span>
+#include <wtf/Function.h>
+#include <wtf/Lock.h>
+#include <wtf/Ref.h>
+#include <wtf/RefPtr.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Vector.h>
+
+namespace WebKit {
+
+class PS5WebGLLayer;
+
+// A WebGPU canvas in the title: the frames Dawn hands over as pixels
+// (WebGPU::PresentationContextDescriptor::presentFrame; Dawn on RADV shares
+// no textures with ps5-opengl), shown through the same layer registry as
+// WebGL's drawing buffers (PS5WebGLLayers.h; the page's WC scene finds the
+// layer by key and draws it). The newest frame's pixels are kept for
+// readback (toDataURL, drawImage).
+//
+// One per RemoteCompositorIntegration. Frames arrive on RemoteGPU's work
+// queue; the texture upload happens on the compositor's render thread, when
+// the layer is painted (TextureMapper's PS5 upload path).
+class PS5WebGPUCanvas final : public ThreadSafeRefCounted<PS5WebGPUCanvas> {
+public:
+    // The pixels of one frame: tightly packed 8-bit rows, top row first.
+    struct Frame : public ThreadSafeRefCounted<Frame> {
+        Vector<uint8_t> pixels;
+        uint32_t width { 0 };
+        uint32_t height { 0 };
+        ::WebGPU::TextureFormat format { ::WebGPU::TextureFormat::Bgra8unorm };
+        ::WebGPU::CanvasAlphaMode alphaMode { ::WebGPU::CanvasAlphaMode::Opaque };
+    };
+
+    // key: what the WebProcess's GraphicsLayerContentsDisplayDelegate::ps5WebGLLayerKey()
+    // returns for this canvas (layerKey() of its compositor integration's identifier).
+    static Ref<PS5WebGPUCanvas> create(WebCore::ProcessIdentifier, uint64_t key);
+    ~PS5WebGPUCanvas();
+
+    // WebGPU layer keys carry this bit; WebGL's are small context numbers.
+    static constexpr uint64_t keyTag = 1ull << 63;
+    static constexpr uint64_t layerKey(uint64_t compositorIntegrationIdentifier) { return compositorIntegrationIdentifier | keyTag; }
+
+    // Work queue: a presented frame, borrowed for the call. Formats other than
+    // the 8-bit BGRA and RGBA ones are not shown (logged once).
+    void frameWasPresented(std::span<const uint8_t>, uint32_t width, uint32_t height, ::WebGPU::TextureFormat, ::WebGPU::CanvasAlphaMode);
+    // Any thread: the newest frame, or null before the first.
+    RefPtr<Frame> lastFrame() const;
+
+private:
+    PS5WebGPUCanvas(WebCore::ProcessIdentifier, uint64_t key);
+
+    const WebCore::ProcessIdentifier m_webProcess;
+    const uint64_t m_key;
+    const Ref<PS5WebGLLayer> m_layer;
+    mutable Lock m_lock;
+    RefPtr<Frame> m_lastFrame WTF_GUARDED_BY_LOCK(m_lock);
+    bool m_loggedFormat { false };
+    bool m_loggedFirstFrame { false };
+};
+
+} // namespace WebKit
+
+#endif
diff --git a/Source/WebKit/GPUProcess/graphics/ps5/RemoteCompositorIntegrationPS5.cpp b/Source/WebKit/GPUProcess/graphics/ps5/RemoteCompositorIntegrationPS5.cpp
new file mode 100644
index 0000000000..f5dd923879
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/RemoteCompositorIntegrationPS5.cpp
@@ -0,0 +1,243 @@
+/*
+ * PS5: a WebGPU canvas's compositor integration in the title (spikes/12-webgpu, P3).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ *
+ * Dawn (on RADV) shares no textures with the compositor (ps5-opengl), so the
+ * implementation's presentation context reads each presented frame back and
+ * hands it to the frame sink set here, which gives it to the canvas's
+ * PS5WebGPUCanvas: a layer in the registry the WC scene looks contents up in,
+ * under the key the WebProcess's display delegate names
+ * (WebCore::WebGPUCompositorIntegration::ps5LayerKeyForIdentifier of this
+ * integration's identifier).
+ *
+ * Reading a canvas (ReadPixelsPS5, synchronous): the texture's contents now,
+ * through the presentation context's readPixels (asynchronous in Dawn; the
+ * reply is sent from its callback, on this work queue), or the newest frame
+ * the canvas was handed. Either way as 8-bit pixels in shared memory made
+ * here, of a size that comes from the implementation, never from the message.
+ *
+ * Everything here runs on RemoteGPU's work queue.
+ */
+
+#include "config.h"
+#include "RemoteCompositorIntegration.h"
+
+#if ENABLE(GPU_PROCESS) && USE(DAWN)
+
+#include "GPUConnectionToWebProcess.h"
+#include "Logging.h"
+#include "PS5WebGPUCanvas.h"
+#include "RemoteGPU.h"
+#include "StreamServerConnection.h"
+#include <WebCore/SharedMemory.h>
+#include <WebCore/WebGPUCompositorIntegrationImpl.h>
+#include <wtf/CheckedArithmetic.h>
+#include <wtf/StdLibExtras.h>
+
+#define MESSAGE_CHECK_COMPLETION(assertion, completion) MESSAGE_CHECK_COMPLETION_BASE(assertion, m_streamConnection, completion)
+
+namespace WebKit {
+
+static_assert(PS5WebGPUCanvas::layerKey(1) == WebCore::WebGPUCompositorIntegration::ps5LayerKeyForIdentifier(1), "the title and the WebProcess name a canvas's layer by the same key");
+
+namespace {
+
+// As many render buffers as the implementation has (PresentationContextImpl::maximumRenderBuffers).
+constexpr uint32_t maximumRenderBuffers = 3;
+// The implementation's bound on a canvas's render buffer (PresentationContextImpl::maximumRenderBufferBytes).
+constexpr size_t maximumReadbackBytes = 256 * MB;
+
+bool is8BitFormat(::WebGPU::TextureFormat format)
+{
+    switch (format) {
+    case ::WebGPU::TextureFormat::Bgra8unorm:
+    case ::WebGPU::TextureFormat::Bgra8unormSRGB:
+    case ::WebGPU::TextureFormat::Rgba8unorm:
+    case ::WebGPU::TextureFormat::Rgba8unormSRGB:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// width * height * bytesPerPixel, or nothing when that is zero, overflows or is over the bound.
+std::optional<size_t> frameBytes(uint32_t width, uint32_t height, unsigned bytesPerPixel)
+{
+    auto bytes = CheckedSize { width } * height * bytesPerPixel;
+    if (bytes.hasOverflowed() || !bytes.value() || bytes.value() > maximumReadbackBytes)
+        return std::nullopt;
+    return bytes.value();
+}
+
+// A half float, clamped to [0, 1], as a byte. No HDR output: an rgba16float canvas is shown and
+// read as 8-bit RGBA, its values taken as they are (the canvas's colour space encoding).
+const std::array<uint8_t, 65536>& halfToByteTable()
+{
+    static const std::array<uint8_t, 65536>* table = [] {
+        auto* bytes = new std::array<uint8_t, 65536>;
+        for (unsigned half = 0; half < 65536; ++half) {
+            unsigned exponent = (half >> 10) & 0x1f;
+            unsigned mantissa = half & 0x3ff;
+            double value;
+            if (!exponent)
+                value = std::ldexp(static_cast<double>(mantissa), -24);
+            else if (exponent == 31)
+                value = mantissa ? 0 : 1; // NaN: 0; infinity: clamped (the sign is below)
+            else
+                value = std::ldexp(static_cast<double>(mantissa | 0x400), static_cast<int>(exponent) - 25);
+            if (half & 0x8000)
+                value = 0;
+            (*bytes)[half] = static_cast<uint8_t>(std::lround(std::clamp(value, 0.0, 1.0) * 255));
+        }
+        return bytes;
+    }();
+    return *table;
+}
+
+// source: width * height RGBA half floats; destination: as many RGBA bytes.
+void convertRGBA16FloatToRGBA8(std::span<const uint8_t> source, std::span<uint8_t> destination)
+{
+    auto& table = halfToByteTable();
+    size_t components = std::min(source.size() / 2, destination.size());
+    for (size_t i = 0; i < components; ++i) {
+        uint16_t half = static_cast<uint16_t>(source[2 * i] | (source[2 * i + 1] << 8));
+        destination[i] = table[half];
+    }
+}
+
+// 8-bit pixels for a frame in one of the formats a canvas has, with the format they are in:
+// the frame's own pixels, or `storage` for a converted rgba16float frame. Nothing for a frame
+// whose size and pixels do not agree, or of another format.
+struct Pixels8 {
+    std::span<const uint8_t> pixels;
+    ::WebGPU::TextureFormat format;
+};
+std::optional<Pixels8> pixelsAs8Bit(std::span<const uint8_t> pixels, uint32_t width, uint32_t height, ::WebGPU::TextureFormat format, Vector<uint8_t>& storage)
+{
+    if (is8BitFormat(format)) {
+        auto bytes = frameBytes(width, height, 4);
+        if (!bytes || pixels.size() < *bytes)
+            return std::nullopt;
+        return Pixels8 { pixels.first(*bytes), format };
+    }
+    if (format == ::WebGPU::TextureFormat::Rgba16float) {
+        auto sourceBytes = frameBytes(width, height, 8);
+        if (!sourceBytes || pixels.size() < *sourceBytes)
+            return std::nullopt;
+        if (!storage.tryReserveCapacity(*sourceBytes / 2))
+            return std::nullopt;
+        storage.resize(*sourceBytes / 2);
+        convertRGBA16FloatToRGBA8(pixels.first(*sourceBytes), storage.mutableSpan());
+        return Pixels8 { storage.span(), ::WebGPU::TextureFormat::Rgba8unorm };
+    }
+    return std::nullopt;
+}
+
+// The reply to ReadPixelsPS5, which is sent exactly once: with pixels, or, when this is
+// destroyed unanswered (the implementation dropped its callback: its instance or device went),
+// with none, so that the WebProcess is not left waiting.
+class PendingRead {
+    WTF_MAKE_NONCOPYABLE(PendingRead);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(PendingRead);
+public:
+    using Reply = CompletionHandler<void(std::optional<WebCore::SharedMemory::Handle>&&, uint32_t, uint32_t, ::WebGPU::TextureFormat, ::WebGPU::CanvasAlphaMode)>;
+
+    explicit PendingRead(Reply&& reply)
+        : m_reply(WTF::move(reply))
+    {
+    }
+
+    ~PendingRead()
+    {
+        if (m_reply)
+            fail();
+    }
+
+    void fail()
+    {
+        m_reply(std::nullopt, 0, 0, ::WebGPU::TextureFormat::Bgra8unorm, ::WebGPU::CanvasAlphaMode::Opaque);
+    }
+
+    // 8-bit pixels, checked by the caller: at least width * height * 4 bytes.
+    void succeed(std::span<const uint8_t> pixels, uint32_t width, uint32_t height, ::WebGPU::TextureFormat format, ::WebGPU::CanvasAlphaMode alphaMode)
+    {
+        auto bytes = frameBytes(width, height, 4);
+        if (!bytes || pixels.size() < *bytes)
+            return fail();
+        RefPtr memory = WebCore::SharedMemory::allocate(*bytes);
+        if (!memory)
+            return fail();
+        memcpySpan(memory->mutableSpan(), pixels.first(*bytes));
+        // Writable: the WebProcess sets the alpha channel of an opaque canvas in place. Nothing
+        // here looks at the memory again.
+        auto handle = memory->createHandle(WebCore::SharedMemory::Protection::ReadWrite);
+        if (!handle)
+            return fail();
+        m_reply(WTF::move(handle), width, height, format, alphaMode);
+    }
+
+private:
+    Reply m_reply;
+};
+
+} // namespace
+
+void RemoteCompositorIntegration::ps5CreateCanvas(RemoteGPU& gpu)
+{
+    RefPtr connection = gpu.gpuConnectionToWebProcess();
+    RefPtr implementation = dynamicDowncast<WebCore::WebGPUCompositorIntegrationImpl>(m_backing.get());
+    if (!connection || !implementation)
+        return;
+
+    Ref canvas = PS5WebGPUCanvas::create(connection->webProcessIdentifier(), PS5WebGPUCanvas::layerKey(m_identifier.toUInt64()));
+    m_ps5Canvas = canvas.ptr();
+    // The sink keeps the canvas, not this: frames can arrive for as long as the implementation's
+    // presentation context lives. ps5DestroyCanvas() takes the sink away again.
+    implementation->setFrameSink([canvas = WTF::move(canvas), storage = Vector<uint8_t> { }](uint32_t, std::span<const uint8_t> pixels, uint32_t width, uint32_t height, ::WebGPU::TextureFormat format, ::WebGPU::CanvasAlphaMode alphaMode) mutable {
+        if (auto frame = pixelsAs8Bit(pixels, width, height, format, storage))
+            canvas->frameWasPresented(frame->pixels, width, height, frame->format, alphaMode);
+    });
+}
+
+void RemoteCompositorIntegration::ps5DestroyCanvas()
+{
+    if (!m_ps5Canvas)
+        return;
+    if (RefPtr implementation = dynamicDowncast<WebCore::WebGPUCompositorIntegrationImpl>(m_backing.get()))
+        implementation->setFrameSink(nullptr);
+    // The last reference: its layer leaves the registry, and the scene draws nothing more of it.
+    m_ps5Canvas = nullptr;
+}
+
+void RemoteCompositorIntegration::readPixelsPS5(uint32_t bufferIndex, bool currentFrame, ReadPixelsPS5Reply&& completionHandler)
+{
+    auto pending = makeUnique<PendingRead>(WTF::move(completionHandler));
+    // The WebProcess only ever names a render buffer the implementation has.
+    MESSAGE_CHECK_COMPLETION(bufferIndex < maximumRenderBuffers, pending->fail());
+
+    if (!currentFrame) {
+        if (RefPtr frame = m_ps5Canvas ? m_ps5Canvas->lastFrame() : nullptr) {
+            if (is8BitFormat(frame->format))
+                return pending->succeed(frame->pixels.span(), frame->width, frame->height, frame->format, frame->alphaMode);
+        }
+        // No frame has arrived yet: what the texture holds is the frame on its way.
+    }
+
+    RefPtr implementation = dynamicDowncast<WebCore::WebGPUCompositorIntegrationImpl>(m_backing.get());
+    if (!implementation)
+        return pending->fail();
+    // The alpha mode of the texture's configuration is not known here: the WebProcess, which
+    // configured it, applies its own to a read of the current frame.
+    implementation->readPixels(bufferIndex, [pending = WTF::move(pending)](std::span<const uint8_t> pixels, uint32_t width, uint32_t height, ::WebGPU::TextureFormat format) {
+        Vector<uint8_t> storage;
+        if (auto frame = pixelsAs8Bit(pixels, width, height, format, storage))
+            return pending->succeed(frame->pixels, width, height, frame->format, ::WebGPU::CanvasAlphaMode::Opaque);
+        pending->fail();
+    });
+}
+
