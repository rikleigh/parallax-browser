@@ -0,0 +1,420 @@
+/*
+ * PS5: WebGPU canvases over Dawn in the title (spikes/12-webgpu, P3).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ * Modelled on GPUCanvasContextCocoa.mm (Copyright (C) 2021-2025 Apple Inc.).
+ */
+
+#include "config.h"
+#include "GPUCanvasContextPS5.h"
+
+#if USE(DAWN)
+
+#include "ContextDestructionObserverInlines.h"
+#include "Document.h"
+#include "EventLoop.h"
+#include "GPUAdapter.h"
+#include "GPUCanvasConfiguration.h"
+#include "GPUDevice.h"
+#include "GPUPresentationContext.h"
+#include "GPUPresentationContextDescriptor.h"
+#include "GPUTextureDescriptor.h"
+#include "ImageBuffer.h"
+#include "InspectorInstrumentation.h"
+#include "NativeImage.h"
+#include "PredefinedColorSpace.h"
+#include "ScriptExecutionContext.h"
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+namespace {
+
+// Only names the canvas: the title shows the frames it reads back itself, by this key.
+class GPULayerDelegatePS5 final : public GraphicsLayerContentsDisplayDelegate {
+public:
+    static Ref<GPULayerDelegatePS5> create(uint64_t key) { return adoptRef(*new GPULayerDelegatePS5(key)); }
+
+    void setDisplayBuffer(std::unique_ptr<CoordinatedPlatformLayerBuffer>&&) final { }
+    void display(CoordinatedPlatformLayer&, std::optional<Damage>&&) final { }
+#if defined(PS5_PAYLOAD_SDK)
+    uint64_t ps5WebGLLayerKey() const final { return m_key; }
+#endif
+
+private:
+    explicit GPULayerDelegatePS5(uint64_t key)
+        : m_key(key)
+    {
+    }
+
+    const uint64_t m_key;
+};
+
+} // namespace
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(GPUCanvasContextPS5);
+
+std::unique_ptr<GPUCanvasContext> GPUCanvasContext::create(CanvasBase& canvas, GPU& gpu, Document* document)
+{
+    auto context = GPUCanvasContextPS5::create(canvas, gpu, document);
+    if (context)
+        context->suspendIfNeeded();
+    return context;
+}
+
+std::unique_ptr<GPUCanvasContextPS5> GPUCanvasContextPS5::create(CanvasBase& canvas, GPU& gpu, Document*)
+{
+    RefPtr compositorIntegration = gpu.createCompositorIntegration();
+    if (!compositorIntegration)
+        return nullptr;
+    RefPtr presentationContext = gpu.createPresentationContext(GPUPresentationContextDescriptor { *compositorIntegration });
+    if (!presentationContext)
+        return nullptr;
+    return std::unique_ptr<GPUCanvasContextPS5>(new GPUCanvasContextPS5(canvas, compositorIntegration.releaseNonNull(), presentationContext.releaseNonNull()));
+}
+
+GPUCanvasContext::CanvasType GPUCanvasContextPS5::htmlOrOffscreenCanvas() const
+{
+    if (RefPtr canvas = htmlCanvas())
+        return canvas.releaseNonNull();
+#if ENABLE(OFFSCREEN_CANVAS)
+    return downcast<OffscreenCanvas>(canvasBase());
+#else
+    RELEASE_ASSERT_NOT_REACHED();
+#endif
+}
+
+GPUCanvasContextPS5::GPUCanvasContextPS5(CanvasBase& canvas, Ref<GPUCompositorIntegration>&& compositorIntegration, Ref<GPUPresentationContext>&& presentationContext)
+    : GPUCanvasContext(canvas)
+    , m_compositorIntegration(WTF::move(compositorIntegration))
+    , m_presentationContext(WTF::move(presentationContext))
+    , m_layerContentsDisplayDelegate(GPULayerDelegatePS5::create(m_compositorIntegration->ps5LayerKey()))
+    , m_width(static_cast<GPUIntegerCoordinate>(canvas.size().width()))
+    , m_height(static_cast<GPUIntegerCoordinate>(canvas.size().height()))
+{
+}
+
+GPUCanvasContextPS5::~GPUCanvasContextPS5()
+{
+    CanvasRenderingContext::updateMemoryCost(0);
+
+    if (auto configuration = std::exchange(m_configuration, std::nullopt))
+        InspectorInstrumentation::didChangeGPUDeviceClientNodes(configuration->device);
+}
+
+void GPUCanvasContextPS5::didUpdateCanvasSizeProperties(bool)
+{
+    if (RefPtr currentTexture = m_currentTexture) {
+        currentTexture->destroy();
+        m_currentTexture = nullptr;
+    }
+    updateMemoryCost();
+    auto newSize = canvasBase().size();
+    auto newWidth = static_cast<GPUIntegerCoordinate>(newSize.width());
+    auto newHeight = static_cast<GPUIntegerCoordinate>(newSize.height());
+    if (m_width == newWidth && m_height == newHeight)
+        return;
+
+    m_width = newWidth;
+    m_height = newHeight;
+
+    // The size is part of the configuration in the title: the same configuration again, with
+    // render buffers of the new size. The canvas reads as transparent black until it is drawn.
+    auto configuration = WTF::move(m_configuration);
+    m_configuration.reset();
+    unconfigure();
+    if (configuration) {
+        GPUCanvasConfiguration canvasConfiguration {
+            configuration->device,
+            configuration->format,
+            configuration->usage,
+            configuration->viewFormats,
+            configuration->colorSpace,
+            configuration->toneMapping,
+            configuration->compositingAlphaMode,
+        };
+        if (configure(WTF::move(canvasConfiguration), true).hasException())
+            InspectorInstrumentation::didChangeGPUDeviceClientNodes(configuration->device);
+    }
+}
+
+RefPtr<ImageBuffer> GPUCanvasContextPS5::createReadBuffer() const
+{
+    const auto size = canvasBase().size();
+    if (size.isEmpty())
+        return nullptr;
+    // In this process, on the CPU: the pixels arrive in shared memory and are put into it.
+    return ImageBuffer::create(size, RenderingMode::Unaccelerated, RenderingPurpose::Canvas, 1, colorSpace(), PixelFormat::BGRA8);
+}
+
+RefPtr<ImageBuffer> GPUCanvasContextPS5::surfaceBufferToImageBuffer(SurfaceBuffer sourceBuffer)
+{
+    RefPtr scriptExecutionContext = protect(canvasBase())->scriptExecutionContext();
+    if (!scriptExecutionContext)
+        return nullptr;
+    // A new buffer for every read, transparent black to start with. Nothing is cached: what the
+    // page has submitted to the texture since the last read is not known here.
+    RefPtr buffer = createReadBuffer();
+    if (!buffer || !m_configuration)
+        return buffer;
+
+    // The inspector reads what is on screen: the newest frame the title was handed. Everything
+    // else reads the texture, which holds the frame being drawn in this task, or else the last
+    // frame drawn (presenting and expiring a frame leave the contents of its texture, and the
+    // next frame starts by clearing it).
+    bool currentFrame = sourceBuffer != SurfaceBuffer::DisplayBufferForInspector;
+    if (!currentFrame && !m_configuration->hasPresentedFrame)
+        return buffer;
+    m_compositorIntegration->ps5ReadPixels(frameIndex, currentFrame, isOpaque(), *buffer);
+    return buffer;
+}
+
+RefPtr<NativeImage> GPUCanvasContextPS5::surfaceBufferToNativeImage(SurfaceBuffer sourceBuffer)
+{
+    return ImageBuffer::sinkIntoNativeImage(surfaceBufferToImageBuffer(sourceBuffer));
+}
+
+RefPtr<ImageBuffer> GPUCanvasContextPS5::transferToImageBuffer()
+{
+    RefPtr scriptExecutionContext = protect(canvasBase())->scriptExecutionContext();
+    if (!scriptExecutionContext)
+        return nullptr;
+    RefPtr buffer = createReadBuffer();
+    if (!buffer || !m_configuration)
+        return buffer;
+    m_compositorIntegration->ps5ReadPixels(frameIndex, true, isOpaque(), *buffer);
+    // Transferring a frame away ends it: the texture the page drew into expires, and the next
+    // getCurrentTexture() starts a new frame, cleared. The frame is not shown.
+    expireCurrentTexture();
+    m_compositingResultsNeedsUpdating = false;
+    m_presentationContext->present(frameIndex);
+    updateMemoryCost();
+    return buffer;
+}
+
+GPUCanvasContext::CanvasType GPUCanvasContextPS5::canvas()
+{
+    return htmlOrOffscreenCanvas();
+}
+
+static bool equalConfigurations(const auto& a, const auto& b)
+{
+    return a.device.ptr()   == b.device.ptr()
+        && a.format         == b.format
+        && a.usage          == b.usage
+        && a.viewFormats    == b.viewFormats
+        && a.colorSpace     == b.colorSpace;
+}
+
+static bool isSupportedContextFormat(GPUTextureFormat format)
+{
+    return format == GPUTextureFormat::Bgra8unorm || format == GPUTextureFormat::Rgba8unorm || format == GPUTextureFormat::Rgba16float;
+}
+
+ExceptionOr<void> GPUCanvasContextPS5::configure(GPUCanvasConfiguration&& configuration, bool dueToReshape)
+{
+    if (isConfigured()) {
+        if (dueToReshape && equalConfigurations(*m_configuration, configuration))
+            return { };
+
+        // The title's presentation context keeps its textures until it is unconfigured, and so
+        // does the proxy of it in this process: every configure() follows an unconfigure().
+        unconfigure();
+    }
+
+    if (configuration.usage & GPUTextureUsage::TRANSIENT_ATTACHMENT)
+        return Exception { ExceptionCode::TypeError, "GPUCanvasContext.configure: Can not configure a canvas with a transient backing"_s };
+
+    if (auto error = protect(configuration.device)->errorValidatingSupportedFormat(configuration.format))
+        return Exception { ExceptionCode::TypeError, makeString("GPUCanvasContext.configure: Unsupported texture format: "_s, *error) };
+
+    for (auto viewFormat : configuration.viewFormats) {
+        if (auto error = protect(configuration.device)->errorValidatingSupportedFormat(viewFormat))
+            return Exception { ExceptionCode::TypeError, makeString("Unsupported texture view format: "_s, *error) };
+    }
+
+    if (!isSupportedContextFormat(configuration.format))
+        return Exception { ExceptionCode::TypeError, "GPUCanvasContext.configure: Unsupported context format."_s };
+
+    // No HDR output: an rgba16float canvas is drawn in half floats, and shown and read back
+    // clamped to 8 bits (RemoteCompositorIntegration in the title converts each frame).
+    configuration.toneMapping.mode = GPUCanvasToneMappingMode::Standard;
+
+    bool reportValidationErrors = !dueToReshape;
+    if (!m_presentationContext->configure(configuration, m_width, m_height, reportValidationErrors))
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.configure: Unable to configure."_s };
+
+    m_configuration = {
+        configuration.device,
+        configuration.format,
+        configuration.usage,
+        configuration.viewFormats,
+        configuration.colorSpace,
+        configuration.toneMapping,
+        configuration.alphaMode,
+        false,
+    };
+    if (!dueToReshape)
+        InspectorInstrumentation::didChangeGPUDeviceClientNodes(m_configuration->device);
+    return { };
+}
+
+ExceptionOr<void> GPUCanvasContextPS5::configure(GPUCanvasConfiguration&& configuration)
+{
+    return configure(WTF::move(configuration), false);
+}
+
+void GPUCanvasContextPS5::unconfigure()
+{
+    m_presentationContext->unconfigure();
+    auto configuration = std::exchange(m_configuration, std::nullopt);
+    m_currentTexture = nullptr;
+    // The frame that was being drawn went with its texture.
+    m_compositingResultsNeedsUpdating = false;
+    updateMemoryCost();
+    ASSERT(!isConfigured());
+
+    if (configuration)
+        InspectorInstrumentation::didChangeGPUDeviceClientNodes(configuration->device);
+}
+
+std::optional<GPUCanvasConfiguration> GPUCanvasContextPS5::getConfiguration() const
+{
+    std::optional<GPUCanvasConfiguration> configuration;
+    if (m_configuration) {
+        configuration.emplace(GPUCanvasConfiguration {
+            m_configuration->device,
+            m_configuration->format,
+            m_configuration->usage,
+            m_configuration->viewFormats,
+            m_configuration->colorSpace,
+            m_configuration->toneMapping,
+            m_configuration->compositingAlphaMode,
+        });
+    }
+
+    return configuration;
+}
+
+ExceptionOr<Ref<GPUTexture>> GPUCanvasContextPS5::getCurrentTexture()
+{
+    if (!isConfigured())
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.getCurrentTexture: canvas is not configured"_s };
+
+    RefPtr currentTexture = m_currentTexture;
+    if (currentTexture)
+        return currentTexture.releaseNonNull();
+
+    willUpdateDisplayBufferContents();
+    // The first time after configure() this makes the texture in the title; every time after
+    // that it revives the same one, which starts the frame cleared to transparent black.
+    m_currentTexture = m_presentationContext->getCurrentTexture(frameIndex);
+    currentTexture = m_currentTexture;
+    if (!currentTexture)
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.getCurrentTexture: no texture"_s };
+    updateMemoryCost();
+
+    // The texture expires once the task it was handed out in has run to completion, so that the
+    // next task draws a new frame instead of drawing over the frame this one has finished.
+    // Presenting expires it too, but that happens later in the rendering update than the
+    // animation frame callbacks do (GPUCanvasContextCocoa.mm).
+    if (RefPtr scriptExecutionContext = protect(canvasBase())->scriptExecutionContext()) {
+        protect(scriptExecutionContext->eventLoop())->queueTask(TaskSource::WebGPU, [weakThis = WeakPtr { *this }, texture = currentTexture] {
+            RefPtr protectedThis = weakThis.get();
+            // Anything which expired the texture in the meantime, presenting above all, has already
+            // moved on to a new frame.
+            if (!protectedThis || protectedThis->m_currentTexture != texture)
+                return;
+            protectedThis->expireCurrentTexture();
+        });
+    }
+
+    return currentTexture.releaseNonNull();
+}
+
+bool GPUCanvasContextPS5::isOpaque() const
+{
+    if (m_configuration)
+        return m_configuration->compositingAlphaMode == GPUCanvasAlphaMode::Opaque;
+    return true;
+}
+
+ColorSpace GPUCanvasContextPS5::colorSpace() const
+{
+    if (!m_configuration)
+        return ColorSpace::SRGB();
+    return toColorSpace(m_configuration->colorSpace);
+}
+
+RefPtr<GraphicsLayerContentsDisplayDelegate> GPUCanvasContextPS5::layerContentsDisplayDelegate()
+{
+    return m_layerContentsDisplayDelegate.ptr();
+}
+
+void GPUCanvasContextPS5::expireCurrentTexture()
+{
+    // Only flags the texture in the title: its contents stay, for presenting and for reading.
+    if (RefPtr currentTexture = m_currentTexture)
+        currentTexture->destroy();
+    m_currentTexture = nullptr;
+}
+
+void GPUCanvasContextPS5::present()
+{
+    if (!m_configuration)
+        return;
+
+    m_compositingResultsNeedsUpdating = false;
+    m_configuration->hasPresentedFrame = true;
+    expireCurrentTexture();
+    m_presentationContext->present(frameIndex);
+    updateMemoryCost();
+}
+
+void GPUCanvasContextPS5::prepareForDisplay()
+{
+    // Presenting is a readback of the whole canvas in the title: only frames that were started
+    // since the last one are presented.
+    if (!isConfigured() || !m_compositingResultsNeedsUpdating)
+        return;
+
+#if ENABLE(OFFSCREEN_CANVAS)
+    // An OffscreenCanvas has no layer of its own. Its placeholder canvas, if it has one, is
+    // given an image buffer read from the texture (OffscreenCanvas::commitToPlaceholderCanvas),
+    // so the title is not asked to read the frame back for display.
+    if (is<OffscreenCanvas>(canvasBase())) {
+        present();
+        return;
+    }
+#endif
+
+    // A canvas that is in no document has no layer: the title is not asked to read back frames
+    // nobody sees (as WebGL does in HTMLCanvasElement::prepareForDisplay). The frame stays
+    // unpresented; once the canvas is back, the next frame drawn is shown.
+    if (RefPtr canvas = htmlCanvas(); canvas && !canvas->isInTreeScope())
+        return;
+
+    m_compositorIntegration->prepareForDisplay(frameIndex, [weakThis = WeakPtr { *this }] {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->present();
+    });
+}
+
+void GPUCanvasContextPS5::willUpdateDisplayBufferContents()
+{
+    m_compositingResultsNeedsUpdating = true;
+    willUpdateCanvasContents();
+}
+
+void GPUCanvasContextPS5::updateMemoryCost() const
+{
+    // Computes only a rough ballpark figure to drive garbage collection.
+    size_t newMemoryCost = 0;
+    if (m_currentTexture)
+        newMemoryCost += m_currentTexture->estimatedMemoryCost();
+    CanvasRenderingContext::updateMemoryCost(newMemoryCost);
+}
+
+} // namespace WebCore
+
+#endif // USE(DAWN)
