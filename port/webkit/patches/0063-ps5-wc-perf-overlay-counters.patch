+// The uploader's counters into the [wc] line's window and the overlay's totals.
+void SceneHost::takeUploadStats()
+{
+    auto uploads = BitmapTextureUploaderPS5::singleton().takeStats();
+    m_uploadWindow.uploads += uploads.uploads;
+    m_uploadWindow.draws += uploads.draws;
+    m_uploadWindow.bytes += uploads.bytes;
+    m_uploadWindow.milliseconds += uploads.milliseconds;
+    m_uploadWindow.fenceWaits += uploads.fenceWaits;
+    m_uploadWindow.finishes += uploads.finishes;
+    m_perf.tileUploads += uploads.uploads;
+    m_perf.tileUploadBytes += static_cast<uint64_t>(uploads.bytes);
+    m_perf.tileUploadUS += static_cast<uint64_t>(uploads.milliseconds * 1000);
+}
+
+// Render thread (PS5PerfOverlay, twice a second while it is on).
+bool SceneHost::perfSnapshot(PS5CompositorPerf& out)
+{
+    if (m_state.load() != State::Ready)
+        return false;
+    takeUploadStats();
+    out = m_perf;
+    out.wheelEvents = m_perfWheelEvents.load();
+    out.clampedEvents = m_perfClampedEvents.load();
+    out.scrollLatencyMaxMS = std::exchange(m_perfLatencyMaxMS, 0);
+    out.pages = m_scenes.size();
+    out.layers = out.videoLayers = 0;
+    for (auto& entry : m_scenes) {
+        out.layers += entry.second->layerCount();
+        out.videoLayers += entry.second->videoLayerCount();
+    }
+    out.glTextureMB = BitmapTextureUploaderPS5::textureBytes() / 1048576.0;
+    out.coverageReduced = m_glState != GLMemoryState::Normal;
+    return true;
+}
