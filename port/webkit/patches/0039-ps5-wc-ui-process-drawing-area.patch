--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/PS5WCNullHost.cpp
@@ -0,0 +1,143 @@
+/*
+ * PS5: the null WC scene host for the GL-free harness (PS5WCNullHost.h).
+ */
+
+#include "config.h"
+#include "PS5WCNullHost.h"
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include "WCUpdateInfo.h"
+#include <wtf/HashMap.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/Vector.h>
+
+namespace WebKit {
+namespace PS5WCNullHost {
+
+namespace {
+
+class Host {
+public:
+    Host()
+        : m_vsync(RunLoop::mainSingleton(), "PS5WCNullHost::vsync"_s, [this] { vsync(); }) // never destroyed
+    {
+    }
+
+    void update(uint64_t pageID, WCUpdateInfo&& info, CompletionHandler<void()>&& didPresent)
+    {
+        auto& live = m_liveLayers.add(pageID, 0).iterator->value;
+        live += info.addedLayers.size();
+        live -= std::min<size_t>(live, info.removedLayers.size());
+
+        m_updates++;
+        m_changedLayers += info.changedLayers.size();
+        for (auto& layer : info.changedLayers) {
+            if (!layer.changes.contains(WCLayerChange::Background))
+                continue;
+            for (auto& tile : layer.background.tileUpdates) {
+                if (tile.willRemove)
+                    continue;
+                m_tiles++;
+                m_paintedPixels += static_cast<uint64_t>(tile.dirtyRect.width()) * tile.dirtyRect.height();
+            }
+        }
+        // The update (and the tile bitmaps it maps) is dropped here.
+
+        m_pending.append(WTF::move(didPresent));
+        if (!m_vsync.isActive())
+            m_vsync.startRepeating(1_s / 60);
+    }
+
+    void removePage(uint64_t pageID)
+    {
+        m_liveLayers.remove(pageID);
+    }
+
+private:
+    // One display refresh: every update received since the last one is "presented".
+    void vsync()
+    {
+        auto pending = std::exchange(m_pending, { });
+        for (auto& didPresent : pending)
+            didPresent();
+        if (pending.isEmpty()) {
+            if (++m_idleTicks > 60) {
+                m_vsync.stop(); // Started again by the next update.
+                m_idleTicks = 0;
+            }
+        } else {
+            m_idleTicks = 0;
+            m_presents++;
+        }
+
+        auto now = MonotonicTime::now();
+        if (!m_periodStart)
+            m_periodStart = now;
+        if (now - m_periodStart < 1_s)
+            return;
+        if (m_updates) {
+            size_t liveLayers = 0;
+            for (auto count : m_liveLayers.values())
+                liveLayers += count;
+            WTFLogAlways("[wc-null] %.1fs: %u updates, %u presents, %llu layer changes, %zu live layers in %u page%s, %llu tiles, %.2f Mpx painted",
+                (now - m_periodStart).seconds(), m_updates, m_presents, static_cast<unsigned long long>(m_changedLayers), liveLayers,
+                m_liveLayers.size(), m_liveLayers.size() == 1 ? "" : "s", static_cast<unsigned long long>(m_tiles), m_paintedPixels / 1e6);
+        }
+        m_periodStart = now;
+        m_updates = 0;
+        m_presents = 0;
+        m_changedLayers = 0;
+        m_tiles = 0;
+        m_paintedPixels = 0;
+    }
+
+    RunLoop::Timer m_vsync;
+    Vector<CompletionHandler<void()>> m_pending;
+    HashMap<uint64_t, size_t> m_liveLayers;
+    unsigned m_idleTicks { 0 };
+    MonotonicTime m_periodStart;
+    unsigned m_updates { 0 };
+    unsigned m_presents { 0 };
+    uint64_t m_changedLayers { 0 };
+    uint64_t m_tiles { 0 };
+    uint64_t m_paintedPixels { 0 };
+};
+
+bool s_installed;
+
+Host& host()
+{
+    static NeverDestroyed<Host> host;
+    return host;
+}
+
+} // namespace
+
+bool isInstalled()
+{
+    return s_installed;
+}
+
+void update(uint64_t pageID, WCUpdateInfo&& info, CompletionHandler<void()>&& didPresent)
+{
+    host().update(pageID, WTF::move(info), WTF::move(didPresent));
+}
+
+void removePage(uint64_t pageID)
+{
+    host().removePage(pageID);
+}
+
+} // namespace PS5WCNullHost
+} // namespace WebKit
+
+// For the embedder (ps5wk-shot), before the first page is created.
+extern "C" __attribute__((visibility("default"))) void ps5wk_wc_null_host_install(void)
+{
+    WebKit::PS5WCNullHost::s_installed = true;
+}
+
+#endif // USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
