-        auto droppedUpdateInfo = std::exchange(m_updateInfo, { });
-        UNUSED_VARIABLE(droppedUpdateInfo);
-        if (willCallDisplayDidRefresh) {
-            RunLoop::mainSingleton().dispatch([weakThis = WeakPtr(*this)] {
-                if (RefPtr protectedThis = weakThis.get())
-                    protectedThis->displayDidRefresh();
-            });
-        }
+        // WPE (PS5): the scene is hosted by the UI process (DrawingAreaProxyWCPS5,
+        // PS5WCHost). Its reply comes after the swap that presents this update,
+        // so with one update in flight (m_waitDidUpdate) rendering updates and
+        // rAF follow the display. The reply also comes (empty) if the message
+        // is cancelled, e.g. the UI-side proxy went away.
+        Ref { m_webPage.get() }->sendWithAsyncReply(Messages::DrawingAreaProxy::UpdateWC(std::exchange(m_updateInfo, { })), [weakThis = WeakPtr(*this), willCallDisplayDidRefresh] {
+            RefPtr protectedThis = weakThis.get();
+            if (protectedThis && willCallDisplayDidRefresh)
+                protectedThis->displayDidRefresh();
+        }, m_identifier.toUInt64());
 #endif
     }
