+/*
+ * PS5: a scene host without GL, for the GL-free harness (ps5wk-shot). It
+ * takes the place of PS5WCHost once installed (ps5wk_wc_null_host_install,
+ * before the first page), counts what each update carries (layers, tiles,
+ * painted megapixels), drops the bitmaps and completes updates at 60 Hz,
+ * as a display would. One "[wc-null]" line per second while updates come.
+ *
+ * Main thread only.
+ */
+
+#pragma once
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include <wtf/CompletionHandler.h>
+
+namespace WebKit {
+
+struct WCUpdateInfo;
+
+namespace PS5WCNullHost {
+
+bool isInstalled();
+void update(uint64_t pageID, WCUpdateInfo&&, CompletionHandler<void()>&& didPresent);
+void removePage(uint64_t pageID);
+
+} // namespace PS5WCNullHost
+
+} // namespace WebKit
+
+#endif // USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
