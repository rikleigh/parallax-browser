diff --git a/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.cpp b/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.cpp
new file mode 100644
index 0000000000..73e2e838a4
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.cpp
@@ -0,0 +1,194 @@
+/*
+ * PS5: the UI-process side of DrawingAreaWC (DrawingAreaProxyWCPS5.h).
+ * Geometry and scale handling as in UIProcess/wc/DrawingAreaProxyWC.cpp,
+ * which can't build on WPE (it paints UpdateInfo into a BackingStore).
+ */
+
+#include "config.h"
+#include "DrawingAreaProxyWCPS5.h"
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include "DrawingAreaMessages.h"
+#include "DrawingAreaProxyMessages.h"
+#include "MessageSenderInlines.h"
+#include "PS5WCHost.h"
+#include "PS5WCNullHost.h"
+#include "WCUpdateInfo.h"
+#include "WebPageProxy.h"
+#include "WebPreferences.h"
+#include <fcntl.h>
+#include <unistd.h>
+#include <wtf/MainThread.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebKit {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(DrawingAreaProxyWCPS5);
+
+// -1: the flag file decides; 0/1: set by the embedder.
+static int s_compositingOverride = -1;
+
+bool DrawingAreaProxyWCPS5::compositingRequested()
+{
+    if (s_compositingOverride >= 0)
+        return s_compositingOverride;
+    // open(), not access(): access() reports existing files as missing in a title.
+    int fd = open("/data/ps5webkit/compositing", O_RDONLY);
+    if (fd < 0)
+        return false;
+    close(fd);
+    return true;
+}
+
+bool DrawingAreaProxyWCPS5::hostAvailable()
+{
+    return PS5WCNullHost::isInstalled() || PS5WCHost::singleton().available();
+}
+
+bool DrawingAreaProxyWCPS5::configurePreferencesForNewPage(WebPreferences& preferences)
+{
+    bool requested = compositingRequested();
+    bool useWC = requested && hostAvailable();
+    if (requested && !useWC)
+        WTFLogAlways("[wc] compositing is on but the scene host is not available: this page paints on the CPU");
+
+    // Only touched when it changes. A change also notifies the WebProcess's
+    // existing page, if any; a new page reads it from its creation parameters.
+    preferences.startBatchingUpdates();
+    if (preferences.acceleratedCompositingEnabled() != useWC)
+        preferences.setAcceleratedCompositingEnabled(useWC);
+    if (preferences.forceCompositingMode() != useWC)
+        preferences.setForceCompositingMode(useWC);
+    // No async scrolling in WC (DrawingArea.h); off on PS5 either way.
+    if (preferences.threadedScrollingEnabled())
+        preferences.setThreadedScrollingEnabled(false);
+    preferences.endBatchingUpdates();
+    return useWC;
+}
+
+Ref<DrawingAreaProxyWCPS5> DrawingAreaProxyWCPS5::create(WebPageProxy& page, WebProcessProxy& webProcessProxy)
+{
+    return adoptRef(*new DrawingAreaProxyWCPS5(page, webProcessProxy));
+}
+
+DrawingAreaProxyWCPS5::DrawingAreaProxyWCPS5(WebPageProxy& webPageProxy, WebProcessProxy& webProcessProxy)
+    : DrawingAreaProxy(webPageProxy, webProcessProxy)
+{
+    WTFLogAlways("[wc] page %llu: WC compositor (drawing area %llu, %s host)", static_cast<unsigned long long>(webPageProxy.identifier().toUInt64()),
+        static_cast<unsigned long long>(identifier().toUInt64()), PS5WCNullHost::isInstalled() ? "null" : "GL");
+}
+
+DrawingAreaProxyWCPS5::~DrawingAreaProxyWCPS5()
+{
+    // The scene is keyed by this drawing area, not the page: a page restart
+    // makes a new proxy, and the old one may go after the new one's first update.
+    if (PS5WCNullHost::isInstalled())
+        PS5WCNullHost::removePage(identifier().toUInt64());
+    else
+        PS5WCHost::singleton().removePage(identifier().toUInt64());
+}
+
+void DrawingAreaProxyWCPS5::deviceScaleFactorDidChange(CompletionHandler<void()>&& completionHandler)
+{
+    sizeDidChange();
+    completionHandler();
+}
+
+void DrawingAreaProxyWCPS5::sizeDidChange()
+{
+    sendUpdateGeometry();
+}
+
+void DrawingAreaProxyWCPS5::sendUpdateGeometry()
+{
+    // The first size is set before the WebPage exists (WebPageProxy::setDrawingArea);
+    // that message is dropped and the WebPage takes the size from its creation
+    // parameters. The state ID is only checked by the GPU-process path.
+    m_currentBackingStoreStateID++;
+    if (RefPtr page = this->page())
+        send(Messages::DrawingArea::UpdateGeometryWC(m_currentBackingStoreStateID, size(), page->deviceScaleFactor(), page->intrinsicDeviceScaleFactor()));
+}
+
+void DrawingAreaProxyWCPS5::dispatchPresentationCallbacksAfterFlushingLayers(IPC::Connection& connection, Vector<IPC::AsyncReplyID>&& callbackIDs)
+{
+    // DrawingAreaWC sends these from displayDidRefresh, i.e. after the host presented.
+    for (auto& callbackID : callbackIDs) {
+        if (auto callback = connection.takeAsyncReplyHandler(callbackID))
+            callback(nullptr, nullptr);
+    }
+}
+
+namespace {
+
+// The reply to UpdateWC. If the host drops the completion without calling
+// it, the reply is still sent (on the main thread): the WebProcess renders
+// nothing more until it gets one.
+class PresentReply {
+    WTF_MAKE_NONCOPYABLE(PresentReply);
+public:
+    explicit PresentReply(CompletionHandler<void()>&& reply)
+        : m_reply(WTF::move(reply))
+    {
+    }
+
+    PresentReply(PresentReply&& other)
+        : m_reply(std::exchange(other.m_reply, nullptr))
+    {
+    }
+
+    ~PresentReply()
+    {
+        if (!m_reply)
+            return;
+        if (isMainRunLoop())
+            m_reply();
+        else
+            RunLoop::mainSingleton().dispatch([reply = WTF::move(m_reply)]() mutable { reply(); });
+    }
+
+    void operator()()
+    {
+        if (auto reply = std::exchange(m_reply, nullptr))
+            reply();
+    }
+
+private:
+    CompletionHandler<void()> m_reply;
+};
+
+} // namespace
+
+void DrawingAreaProxyWCPS5::updateWC(WCUpdateInfo&& info, CompletionHandler<void()>&& completionHandler)
+{
+    uint64_t sceneID = identifier().toUInt64();
+    if (PS5WCNullHost::isInstalled()) {
+        PS5WCNullHost::update(sceneID, WTF::move(info), [reply = PresentReply(WTF::move(completionHandler))]() mutable {
+            reply();
+        });
+        return;
+    }
+
+    auto& host = PS5WCHost::singleton();
+    if (!host.available()) {
+        // The host went away (scene context failed after this page started):
+        // nothing to show, but the page keeps running. A page restart goes
+        // back to the CPU path.
+        completionHandler();
+        return;
+    }
+    host.update(sceneID, WTF::move(info), [reply = PresentReply(WTF::move(completionHandler))]() mutable {
+        reply();
+    });
+}
+
+} // namespace WebKit
+
+// For the embedder (ps5wk-shot): mode 1 turns compositing on, 0 off and -1
+// back to the flag file. Applies to pages that get a new WebProcess.
+extern "C" __attribute__((visibility("default"))) void ps5wk_compositing_set_override(int mode)
+{
+    WebKit::s_compositingOverride = mode < 0 ? -1 : !!mode;
+}
+
+#endif // USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
diff --git a/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.h b/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.h
new file mode 100644
index 0000000000..ba0fd6e867
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/DrawingAreaProxyWCPS5.h
@@ -0,0 +1,81 @@
+/*
+ * PS5: the UI-process side of DrawingAreaWC when the WC scene is hosted in
+ * the title (no GPU process). See port/webkit/COMPOSITING-PLAN.md.
+ *
+ * The WebProcess sends each layer-tree update (Messages::DrawingAreaProxy::
+ * UpdateWC); this proxy hands it to the scene host (PS5WCHost, or the null
+ * host of the GL-free harness) and replies once the host has presented it.
+ * One update is in flight per page (DrawingAreaWC waits for the reply), so
+ * the reply paces rendering updates and rAF to the display.
+ *
+ * Which drawing area a page gets is decided here, in the UI process, and
+ * carried to the WebProcess by the accelerated-compositing preference
+ * (DrawingArea::create picks DrawingAreaWC exactly when it is on):
+ * configurePreferencesForNewPage() sets the preference from the switch and
+ * the host's availability before the page's creation parameters are built.
+ */
+
+#pragma once
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include "DrawingAreaProxy.h"
+#include <wtf/RefCounted.h>
+#include <wtf/TZoneMalloc.h>
+
+namespace WebKit {
+
+class WebPreferences;
+struct WCUpdateInfo;
+
+class DrawingAreaProxyWCPS5 final : public DrawingAreaProxy, public RefCounted<DrawingAreaProxyWCPS5> {
+    WTF_MAKE_TZONE_ALLOCATED(DrawingAreaProxyWCPS5);
+    WTF_MAKE_NONCOPYABLE(DrawingAreaProxyWCPS5);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(DrawingAreaProxyWCPS5);
+public:
+    static Ref<DrawingAreaProxyWCPS5> create(WebPageProxy&, WebProcessProxy&);
+    virtual ~DrawingAreaProxyWCPS5();
+
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+    bool isDrawingAreaProxyWCPS5() const final { return true; }
+
+    // The run-time switch (opt-in): the flag file /data/ps5webkit/compositing,
+    // unless the embedder overrode it (ps5wk_compositing_set_override). Read
+    // each time a page gets a new WebProcess, so it applies on page restart.
+    static bool compositingRequested();
+
+    // A scene host is ready: PS5WCHost, or the null host if one is installed.
+    static bool hostAvailable();
+
+    // Before a page's drawing area and creation parameters are made for a
+    // new WebProcess: accelerated compositing and forced compositing on
+    // exactly when compositing is requested and a host is available, so the
+    // WebProcess picks the drawing area this process will create. Returns
+    // whether the page should get a DrawingAreaProxyWCPS5.
+    static bool configurePreferencesForNewPage(WebPreferences&);
+
+private:
+    DrawingAreaProxyWCPS5(WebPageProxy&, WebProcessProxy&);
+
+    // DrawingAreaProxy
+    void deviceScaleFactorDidChange(CompletionHandler<void()>&&) override;
+    void sizeDidChange() override;
+    bool shouldSendWheelEventsToEventDispatcher() const final { return true; }
+    void dispatchPresentationCallbacksAfterFlushingLayers(IPC::Connection&, Vector<IPC::AsyncReplyID>&&) override;
+
+    // Message handlers
+    void updateWC(WCUpdateInfo&&, CompletionHandler<void()>&&) override;
+
+    void sendUpdateGeometry();
+
+    uint64_t m_currentBackingStoreStateID { 0 };
+};
+
+} // namespace WebKit
+
+SPECIALIZE_TYPE_TRAITS_BEGIN(WebKit::DrawingAreaProxyWCPS5)
+    static bool isType(const WebKit::DrawingAreaProxy& proxy) { return proxy.isDrawingAreaProxyWCPS5(); }
+SPECIALIZE_TYPE_TRAITS_END()
+
+#endif // USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
diff --git a/Source/WebKit/UIProcess/wpe/ps5/PS5WCHost.h b/Source/WebKit/UIProcess/wpe/ps5/PS5WCHost.h
new file mode 100644
index 0000000000..971870f4d3
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/PS5WCHost.h
@@ -0,0 +1,45 @@
+/*
+ * PS5: the WC compositor host inside the title (UIProcess).
+ *
+ * DrawingAreaWC in the WebProcess sends each layer-tree update to its
+ * DrawingAreaProxyWCPS5, which hands it here. The host applies updates and
+ * paints the scene with TextureMapper on PS5Renderer's render thread, in
+ * PS5Renderer's own GL context, into a texture that PS5Renderer draws where
+ * the CPU-painted page goes otherwise. See port/webkit/COMPOSITING-PLAN.md.
+ *
+ * Threading: update()/removePage() are called on the main thread. The
+ * didPresent completion is called on the main thread after the swap that
+ * first shows the update (that pacing is what keeps rendering updates and
+ * rAF at the display rate).
+ */
+
+#pragma once
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include <wtf/CompletionHandler.h>
+#include <wtf/Noncopyable.h>
+
+namespace WebKit {
+
+struct WCUpdateInfo;
+
+class PS5WCHost {
+    WTF_MAKE_NONCOPYABLE(PS5WCHost);
+public:
+    static PS5WCHost& singleton();
+
+    // False until the render thread has set up the scene context, and for
+    // good if that failed (the caller then falls back to the CPU path).
+    bool available() const;
+
+    void update(uint64_t pageID, WCUpdateInfo&&, CompletionHandler<void()>&& didPresent);
+    void removePage(uint64_t pageID);
+
+private:
+    PS5WCHost();
+};
+
+} // namespace WebKit
+
+#endif
diff --git a/Source/WebKit/UIProcess/wpe/ps5/PS5WCHostStub.cpp b/Source/WebKit/UIProcess/wpe/ps5/PS5WCHostStub.cpp
new file mode 100644
index 0000000000..232c9f39c9
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/PS5WCHostStub.cpp
@@ -0,0 +1,46 @@
+/*
+ * TEMPORARY STUB: delete this file (and its block in Platform/WC.cmake) once
+ * PS5WCHost.cpp, the real scene host, is in the tree. WC.cmake builds it
+ * only while PS5WCHost.cpp does not exist.
+ *
+ * Never available, so pages stay on the CPU path (or use the null host of
+ * the GL-free harness); an update that arrives anyway completes on the next
+ * run-loop turn without being shown.
+ */
+
+#include "config.h"
+#include "PS5WCHost.h"
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include <wtf/RunLoop.h>
+
+namespace WebKit {
+
+PS5WCHost& PS5WCHost::singleton()
+{
+    static PS5WCHost* host = new PS5WCHost;
+    return *host;
+}
+
+PS5WCHost::PS5WCHost() = default;
+
+bool PS5WCHost::available() const
+{
+    return false;
+}
+
+void PS5WCHost::update(uint64_t, WCUpdateInfo&&, CompletionHandler<void()>&& didPresent)
+{
+    RunLoop::mainSingleton().dispatch([didPresent = WTF::move(didPresent)]() mutable {
+        didPresent();
+    });
+}
+
+void PS5WCHost::removePage(uint64_t)
+{
+}
+
+} // namespace WebKit
+
+#endif // USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
