+/**
+ * webkit_download_dup_original_uri:
+ * @download: a #WebKitDownload
+ *
+ * The address the download started from, before any redirect: for a
+ * navigation that became a download, the navigation's first URL (a link
+ * that redirects to an expiring signed URL gives the link). It is the
+ * address to ask again when the download is resumed later.
+ *
+ * Returns: (transfer full): the original URI, free with g_free()
+ */
+gchar* webkit_download_dup_original_uri(WebKitDownload* download)
+{
+    g_return_val_if_fail(WEBKIT_IS_DOWNLOAD(download), nullptr);
+
+    auto& chain = download->priv->download->redirectChain();
+    const URL& url = chain.isEmpty() ? download->priv->download->request().url() : chain.first();
+    return g_strdup(url.string().utf8().legacyCStringPointer());
+}
