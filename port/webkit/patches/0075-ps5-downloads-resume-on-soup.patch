+/**
+ * webkit_web_view_download_request:
+ * @web_view: a #WebKitWebView
+ * @request: the #WebKitURIRequest to download, with its HTTP headers
+ *
+ * Requests downloading of @request for @web_view, as webkit_web_view_download_uri()
+ * does, with the request's HTTP headers (for example a Range header to resume
+ * a download into the partial file it left: on soup, a 206 response whose
+ * Content-Range starts at the size of `<destination>.part` is appended to it).
+ *
+ * Returns: (transfer full): a new #WebKitDownload representing
+ *    the download operation.
+ */
+WebKitDownload* webkit_web_view_download_request(WebKitWebView* webView, WebKitURIRequest* request)
+{
+    g_return_val_if_fail(WEBKIT_IS_WEB_VIEW(webView), nullptr);
+    g_return_val_if_fail(WEBKIT_IS_URI_REQUEST(request), nullptr);
+
+    ResourceRequest resourceRequest;
+    webkitURIRequestGetResourceRequest(request, resourceRequest);
+    Ref page = getPage(webView);
+    auto downloadProxy = page->configuration().processPool().download(page->websiteDataStore(), page.ptr(), resourceRequest, { });
+    auto download = webkitDownloadCreate(downloadProxy, webView);
+#if ENABLE(2022_GLIB_API)
+    downloadProxy->setDidStartCallback([session = GRefPtr<WebKitNetworkSession> { webView->priv->networkSession }, download = download.get()](auto* downloadProxy) {
+#else
+    downloadProxy->setDidStartCallback([context = GRefPtr<WebKitWebContext> { webView->priv->context }, download = download.get()](auto* downloadProxy) {
+#endif
+        if (!downloadProxy)
+            return;
+
+        webkitDownloadStarted(download);
+#if ENABLE(2022_GLIB_API)
+        webkitNetworkSessionDownloadStarted(session.get(), download);
+#else
+        webkitWebContextDownloadStarted(context.get(), download);
+#endif
+    });
+
+    return download.leakRef();
+}
