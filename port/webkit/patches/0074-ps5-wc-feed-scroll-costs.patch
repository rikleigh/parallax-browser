+bool RenderLayer::ps5CanSkipPaintingOutsideDirtyRect(const LayerPaintingInfo& paintingInfo, OptionSet<PaintLayerFlag> paintFlags)
+{
+    static const bool enabled = !getenv("PS5WK_PAINT_CULL") || strcmp(getenv("PS5WK_PAINT_CULL"), "0");
+    if (!enabled)
+        return false;
+    if (paintingInfo.paintDirtyRect.isInfinite() || paintingInfo.regionContext || paintingInfo.overlapTestRequests || !paintingInfo.rootLayer || paintingInfo.rootLayer == this)
+        return false;
+    if (paintFlags.containsAny({ PaintLayerFlag::CollectingEventRegion, PaintLayerFlag::PaintingOverlayScrollbars, PaintLayerFlag::PaintingReflection, PaintLayerFlag::AppliedTransform }))
+        return false;
+    if (paintingInfo.paintBehavior.containsAny({ PaintBehavior::FlattenCompositingLayers, PaintBehavior::Snapshotting }))
+        return false;
+    s_ps5PaintCull[0]++;
+
+    // The answer and the bounds are kept for the rendering update: a
+    // composited layer's tiles are painted rect by rect, each pass over the
+    // whole list, and nothing moves or restyles while the update's tiles are
+    // painted (any layout or layer position update since makes a new entry).
+    auto& layoutContext = renderer().view().frameView().layoutContext();
+    auto update = page().lastRenderingUpdateTimestamp(); // set at the start of each update
+    auto& cache = m_ps5PaintCull;
+    if (cache.root != paintingInfo.rootLayer || cache.update != update || cache.layouts != layoutContext.layoutUpdateCount() || cache.positions != layoutContext.renderLayerPositionUpdateCount()) {
+        cache.root = paintingInfo.rootLayer;
+        cache.update = update;
+        cache.layouts = layoutContext.layoutUpdateCount();
+        cache.positions = layoutContext.renderLayerPositionUpdateCount();
+        cache.state = ps5PaintCullState(*paintingInfo.rootLayer, cache.bounds);
+    }
+    switch (cache.state) {
+    case PS5PaintCull::PaintsChildLayers:
+        s_ps5PaintCull[2]++;
+        return false;
+    case PS5PaintCull::NotEligible:
+        s_ps5PaintCull[3]++;
+        return false;
+    case PS5PaintCull::Eligible:
+        break;
+    }
+    if (cache.bounds.intersects(paintingInfo.paintDirtyRect))
+        return false;
+    s_ps5PaintCull[1]++;
+    return true;
+}
+
+auto RenderLayer::ps5PaintCullState(const RenderLayer& rootLayer, LayoutRect& bounds) -> PS5PaintCull
+{
+    if (hasSelfPaintingLayerDescendant()) {
+        // A layer that isn't a stacking context paints only its normal flow
+        // child layers; its other self-painting descendants are in its
+        // stacking context's z-order lists and painted from there.
+        if (isStackingContext())
+            return PS5PaintCull::PaintsChildLayers;
+        updateLayerListsIfNeeded();
+        for (auto* child : normalFlowLayers()) {
+            if (child->isSelfPaintingLayer() || child->hasSelfPaintingLayerDescendant())
+                return PS5PaintCull::PaintsChildLayers;
+        }
+    }
+    if (!isSelfPaintingLayer() || isRenderViewLayer())
+        return PS5PaintCull::NotEligible;
+    auto& renderer = this->renderer();
+    if (!renderer.isRenderBox() || renderer.isDocumentElementRenderer() || renderer.isSVGLayerAwareRenderer() || is<RenderTableRow>(renderer))
+        return PS5PaintCull::NotEligible;
+    if (renderer.hasTransformRelatedProperty() || renderer.hasFilter() || renderer.hasBackdropFilter() || renderer.hasReflection())
+        return PS5PaintCull::NotEligible;
+    if (enclosingPaginationLayer(IncludeCompositedPaginatedLayers))
+        return PS5PaintCull::NotEligible;
+    bounds = boundingBox(&rootLayer, offsetFromAncestor(&rootLayer));
+    bounds.inflate(LayoutUnit(4));
+    return PS5PaintCull::Eligible;
+}
