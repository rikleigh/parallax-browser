+#if defined(PS5_PAYLOAD_SDK)
+static Function<void(WebCore::ProcessIdentifier, IPC::MessageName)>& ps5TerminateWebProcessHandler()
+{
+    static NeverDestroyed<Function<void(WebCore::ProcessIdentifier, IPC::MessageName)>> handler;
+    return handler;
+}
+
+void GPUProcess::ps5SetTerminateWebProcessHandler(Function<void(WebCore::ProcessIdentifier, IPC::MessageName)>&& handler)
+{
+    RELEASE_ASSERT(RunLoop::isMain());
+    ps5TerminateWebProcessHandler() = WTF::move(handler);
+}
+#endif
+
 void GPUProcess::terminateWebProcess(WebCore::ProcessIdentifier identifier, IPC::MessageName invalidMessageName)
 {
+#if defined(PS5_PAYLOAD_SDK)
+    // PS5: in the title there is no GPUProcessProxy at the far end of the parent connection
+    // (AuxiliaryProcess::ps5InitializeInTitle), and a WebProcess whose message was refused
+    // would stay as it is: its connection closed, its main thread waiting on it for good.
+    // Any thread (message checks run on the work queues).
+    callOnMainRunLoop([identifier, invalidMessageName] {
+        if (auto& handler = ps5TerminateWebProcessHandler())
+            handler(identifier, invalidMessageName);
+    });
+#else
     protect(parentProcessConnection())->send(Messages::GPUProcessProxy::TerminateWebProcess(identifier, invalidMessageName), 0);
+#endif
 }
 
