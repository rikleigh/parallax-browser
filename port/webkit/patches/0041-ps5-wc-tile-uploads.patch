+#pragma once
+
+#if USE(TEXTURE_MAPPER) && defined(PS5_PAYLOAD_SDK)
+
+#include "IntRect.h"
+#include <wtf/Deque.h>
+
+typedef struct __GLsync* GLsync;
+
+namespace WebCore {
+
+class GLContextWrapper;
+
+// Tile uploads for the PS5 compositor (port/webkit/COMPOSITING-PLAN.md, S1a).
+// ps5-opengl's glTexSubImage2D into a tiled RGBA8 texture scatters texels on
+// the CPU (~5 ms per 512x512 tile). Instead the rows are memcpy'd into a slot
+// of a persistent, coherent staging ring and drawn into the texture with an
+// FBO pass that reads them as a shader storage buffer and swaps B and R
+// (~0.2 ms per tile). Textures stay ordinary RGBA8 render targets.
+//
+// A slot is reused only after the GPU passed it: frameDone() (after each
+// swap or headset submit) drops a fence; a full ring waits for the oldest
+// fence (glFinish if none). Used on one thread, in one context: the one
+// initialize() ran in. Elsewhere upload() returns false and BitmapTexture
+// falls back to glTexSubImage2D.
+class BitmapTextureUploaderPS5 {
+public:
+    WEBCORE_EXPORT static BitmapTextureUploaderPS5& singleton();
+
+    // In the compositor's context. False: unavailable for good.
+    WEBCORE_EXPORT bool initialize(size_t ringBytes = 16 << 20);
+    bool isActive() const;
+    // Off: upload() declines (BitmapTexture uses glTexSubImage2D); for comparisons.
+    WEBCORE_EXPORT void setEnabled(bool enabled) { m_enabled = enabled; }
+
+    // Draws targetRect's rows (from data at sourceOffset, bytesPerLine apart)
+    // into the 2D RGBA8 texture, swapping R and B when the source is BGRA.
+    bool upload(unsigned texture, const void* data, const IntRect& targetRect, const IntPoint& sourceOffset, int bytesPerLine, bool sourceIsBGRA);
+
+    WEBCORE_EXPORT void frameDone();
+
+    struct Stats {
+        unsigned uploads { 0 }; // upload() calls
+        unsigned draws { 0 };   // FBO passes (an upload larger than a quarter of the ring takes several)
+        double bytes { 0 };
+        double milliseconds { 0 }; // CPU wall time in upload(), waits included
+        unsigned fenceWaits { 0 };
+        unsigned finishes { 0 };
+    };
+    WEBCORE_EXPORT Stats takeStats();
+
+    // Bytes held by live BitmapTextures (any thread's), for the compositor's log.
+    WEBCORE_EXPORT static size_t textureBytes();
+    static void textureBytesChanged(long long delta);
+
+private:
+    size_t allocate(size_t bytes);
+
+    GLContextWrapper* m_context { nullptr };
+    bool m_failed { false };
+    bool m_enabled { true };
+    unsigned m_buffer { 0 };
+    uint8_t* m_map { nullptr };
+    size_t m_size { 0 };
+    size_t m_alignment { 256 };
+    unsigned m_program { 0 };
+    int m_rectLocation { -1 };
+    unsigned m_vao { 0 };
+    unsigned m_fbo { 0 };
+
+    // Ring positions as running byte counts (slot = position % m_size).
+    uint64_t m_head { 0 };
+    uint64_t m_tail { 0 };
+    uint64_t m_lastMarkHead { 0 };
+    struct Mark {
+        GLsync fence;
+        uint64_t head;
+    };
+    Deque<Mark> m_marks;
+
+    Stats m_stats;
+};
+
+} // namespace WebCore
+
+#endif // USE(TEXTURE_MAPPER) && defined(PS5_PAYLOAD_SDK)
