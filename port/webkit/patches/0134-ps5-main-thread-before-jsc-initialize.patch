@@ -39,6 +39,14 @@ namespace WebKit {
 
 void InitializeWebKit2()
 {
+#if defined(PS5_PAYLOAD_SDK)
+    // The PS5 browser title runs JSC with the JIT (the in-title WebProcess),
+    // so JSC::initialize() compiles thunks, and with JSC_useJITDump the first
+    // one starts PerfLog's WorkQueue thread. That thread would take WTF thread
+    // uid 1 and initializeMainThread's RELEASE_ASSERT would fail. Making the
+    // main thread's WTF::Thread first avoids that (spikes/14).
+    WTF::initializeMainThread();
+#endif
     JSC::initialize();
     WTF::initializeMainThread();
     WebCore::initializeCommonAtomStrings();
