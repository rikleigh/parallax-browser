diff --git a/Source/WebKit/WebProcess/GPU/graphics/ps5/RemoteGraphicsContextGLProxyPS5.cpp b/Source/WebKit/WebProcess/GPU/graphics/ps5/RemoteGraphicsContextGLProxyPS5.cpp
new file mode 100644
index 0000000000..31bc6eb1fc
--- /dev/null
+++ b/Source/WebKit/WebProcess/GPU/graphics/ps5/RemoteGraphicsContextGLProxyPS5.cpp
@@ -0,0 +1,62 @@
+/*
+ * PS5: the WebProcess side of remote WebGL (spikes/11-webgl). The context
+ * itself lives in the title, which draws with ANGLE over ps5-opengl; this
+ * proxy only completes the display round trip so far. Showing the drawing
+ * buffer as a WC content layer is milestone M2.
+ */
+
+#include "config.h"
+#include "RemoteGraphicsContextGLProxy.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && defined(PS5_PAYLOAD_SDK)
+
+#include "RemoteGraphicsContextGLMessages.h"
+#include <wtf/text/WTFString.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+class RemoteGraphicsContextGLProxyPS5 final : public RemoteGraphicsContextGLProxy {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(RemoteGraphicsContextGLProxyPS5);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(RemoteGraphicsContextGLProxyPS5);
+public:
+    virtual ~RemoteGraphicsContextGLProxyPS5() = default;
+
+private:
+    friend class RemoteGraphicsContextGLProxy;
+    RemoteGraphicsContextGLProxyPS5(const GraphicsContextGLAttributes& attributes, RemoteRenderingBackendProxy& renderingBackend)
+        : RemoteGraphicsContextGLProxy(attributes, renderingBackend)
+    {
+        WTFLogAlways("[webgl] remote context: WebGL %d, alpha %d", attributes.isWebGL2 ? 2 : 1, attributes.alpha);
+    }
+
+    // WebCore::GraphicsContextGL
+    RefPtr<GraphicsLayerContentsDisplayDelegate> layerContentsDisplayDelegate() final { return nullptr; }
+    void prepareForDisplay() final;
+
+    unsigned m_frames { 0 };
+};
+
+void RemoteGraphicsContextGLProxyPS5::prepareForDisplay()
+{
+    if (isContextLost())
+        return;
+    auto sendResult = sendSync(Messages::RemoteGraphicsContextGL::PrepareForDisplay());
+    if (!sendResult.succeeded()) {
+        WTFLogAlways("[webgl] PrepareForDisplay failed: the stream to the title is gone");
+        markContextLost();
+        return;
+    }
+    if (!m_frames++)
+        WTFLogAlways("[webgl] first frame prepared for display");
+    m_hasPreparedForDisplay = true;
+}
+
+Ref<RemoteGraphicsContextGLProxy> RemoteGraphicsContextGLProxy::platformCreate(const GraphicsContextGLAttributes& attributes, RemoteRenderingBackendProxy& renderingBackend)
+{
+    return adoptRef(*new RemoteGraphicsContextGLProxyPS5(attributes, renderingBackend));
+}
+
+} // namespace WebKit
