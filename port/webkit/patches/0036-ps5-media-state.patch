 {
     MediaPlayerPrivateGStreamer::didEnd();
+#if defined(PS5_PAYLOAD_SDK)
+    // A looping element seeks back to the start from the ended notification
+    // (timeChanged() at the end of didEnd() above), synchronously, on this
+    // pipeline. Tearing it down afterwards left that seek's promise
+    // unresolved: the element stayed "seeking" with currentTime held at the
+    // target for good while the pipeline rebuilt by play() played underneath
+    // (a spinner over a looping MSE video), and the decoder was reopened on
+    // every loop.
+    if (m_isSeeking || !m_isEndReached) {
+        GST_DEBUG_OBJECT(pipeline(), "A seek started from the ended notification: keeping the pipeline");
+        return;
+    }
+#endif
