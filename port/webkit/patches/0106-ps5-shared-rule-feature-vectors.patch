 using RuleFeatureVector = Vector<RuleFeature>;
 
+// A RuleFeatureVector that several RuleFeatureSets share: RuleFeatureSet::add
+// takes a reference to a vector the set doesn't have yet instead of copying
+// it (a large user style sheet, e.g. a content blocker's, otherwise copies
+// thousands of vectors for every new style resolver, shadow trees' too), and
+// a shared vector is copied before it is changed.
+struct SharedRuleFeatureVector : public RefCounted<SharedRuleFeatureVector> {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(SharedRuleFeatureVector);
+public:
+    static Ref<SharedRuleFeatureVector> create() { return adoptRef(*new SharedRuleFeatureVector); }
+    static Ref<SharedRuleFeatureVector> create(const RuleFeatureVector& features) { return adoptRef(*new SharedRuleFeatureVector(features)); }
+    RuleFeatureVector features;
+
+private:
+    SharedRuleFeatureVector() = default;
+    explicit SharedRuleFeatureVector(const RuleFeatureVector& features)
+        : features(features)
+    {
+    }
+};
