+constexpr GLuint outputBinding = 6;
+
+bool readWithCompute(Reader& state, int width, int height, std::span<uint8_t> rgba)
+{
+    if (state.computeFailed)
+        return false;
+    auto fail = [&](const char* why) {
+        WTFLogAlways("[webgpu] title: video frames are read with glReadPixels (%s, GL error 0x%x)", why, glGetError());
+        state.computeFailed = true;
+        return false;
+    };
+    if (!state.program) {
+        static const char* source = R"(#version 310 es
+precision highp float;
+precision highp int;
+layout(local_size_x = 8, local_size_y = 8) in;
+uniform highp sampler2D u_frame;
+uniform ivec2 u_size;
+layout(std430, binding = 6) writeonly buffer Output { uint px[]; };
+void main()
+{
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (p.x >= u_size.x || p.y >= u_size.y)
+        return;
+    px[p.y * u_size.x + p.x] = packUnorm4x8(texelFetch(u_frame, p, 0));
+}
+)";
