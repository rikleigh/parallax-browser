+// https://gpuweb.github.io/gpuweb/#dom-gpudevice-importexternaltexture, for one video frame the
+// title read back: an RGBA8 texture of its own as the external texture's only plane. The bytes
+// are sRGB-encoded and are sampled as they are (identity transfer functions and gamut matrix),
+// as a copy of the frame into an rgba8unorm texture would be.
+RefPtr<ExternalTexture> DeviceImpl::ps5ImportExternalTexture(std::span<const uint8_t> rgba, uint32_t width, uint32_t height)
+{
+    const uint64_t bytes = static_cast<uint64_t>(width) * height * 4;
+    if (!width || !height || width > 8192 || height > 8192 || rgba.size() < bytes)
+        return nullptr;
+    auto charge = MemoryCharge::tryTake(bytes);
+    if (!charge) {
+        // Over the title's WebGPU memory budget: an external texture that is not valid.
+        return ExternalTextureImpl::create();
+    }
+
+    wgpu::TextureDescriptor textureDescriptor;
+    textureDescriptor.size = { width, height, 1 };
+    textureDescriptor.format = wgpu::TextureFormat::RGBA8Unorm;
+    textureDescriptor.usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopyDst;
+    wgpu::Texture texture = m_device.CreateTexture(&textureDescriptor);
+    if (!texture)
+        return ExternalTextureImpl::create();
+
+    wgpu::TexelCopyTextureInfo destination;
+    destination.texture = texture;
+    wgpu::TexelCopyBufferLayout layout;
+    layout.bytesPerRow = width * 4;
+    layout.rowsPerImage = height;
+    wgpu::Extent3D extent { width, height, 1 };
+    m_device.GetQueue().WriteTexture(&destination, rgba.data(), static_cast<size_t>(bytes), &layout, &extent);
+
+    static const float identityTransfer[7] = { 1, 1, 0, 1, 0, 0, 0 }; // g, a, b, c, d, e, f: x
+    static const float identityGamut[9] = { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
+    wgpu::ExternalTextureDescriptor descriptor;
+    descriptor.plane0 = texture.CreateView();
+    descriptor.cropSize = { width, height };
+    descriptor.apparentSize = { width, height };
+    descriptor.srcTransferFunctionParameters = identityTransfer;
+    descriptor.dstTransferFunctionParameters = identityTransfer;
+    descriptor.gamutConversionMatrix = identityGamut;
+    wgpu::ExternalTexture externalTexture = m_device.CreateExternalTexture(&descriptor);
+    if (!externalTexture)
+        return ExternalTextureImpl::create();
+    return ExternalTextureImpl::create(WTF::move(externalTexture), WTF::move(texture), WTF::move(*charge));
+}
+
 } // namespace WebGPU::Dawn
