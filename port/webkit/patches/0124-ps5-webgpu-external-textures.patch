+    MESSAGE_CHECK(externalTexture);
+    Ref objectHeap = m_objectHeap.get();
+    auto remoteExternalTexture = RemoteExternalTexture::create(*externalTexture, objectHeap, protect(m_streamConnection), protect(m_gpu), identifier);
