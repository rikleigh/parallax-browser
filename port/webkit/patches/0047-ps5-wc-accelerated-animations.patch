+#if defined(PS5_PAYLOAD_SDK)
+// Accelerated animations (COMPOSITING-PLAN.md, M3): kept here as WCAnimations
+// and sent whole whenever they change; the scene (WCScene) runs them as
+// TextureMapperAnimations every frame, so they don't need the main thread.
+bool GraphicsLayerWC::addAnimation(const GraphicsLayerKeyframeValueList& valueList, const GraphicsLayerAnimation* animation, const String& animationName, double timeOffset)
+{
+    ASSERT(!animationName.isEmpty());
+    // PS5WK_WC_ANIMATIONS=0 (child.env): the main thread steps them, for A/B tests.
+    static const bool enabled = !getenv("PS5WK_WC_ANIMATIONS") || strcmp(getenv("PS5WK_WC_ANIMATIONS"), "0");
+    if (!enabled || !animation || animation->isZeroDuration() || valueList.size() < 2)
+        return false;
+    // As GraphicsLayerCoordinated: TextureMapperAnimation runs forwards at rate 1.
+    if (animation->playbackRate() != 1 || !animation->directionIsForwards())
+        return false;
+    auto property = valueList.property();
+    bool isOpacity = property == AnimatedProperty::Opacity;
+    if (!isOpacity && property != AnimatedProperty::Translate && property != AnimatedProperty::Rotate
+        && property != AnimatedProperty::Scale && property != AnimatedProperty::Transform)
+        return false; // filters stay on the main thread
+
+    WCAnimation newAnimation;
+    newAnimation.name = animationName;
+    newAnimation.property = static_cast<uint8_t>(property);
+    for (size_t i = 0; i < valueList.size(); ++i) {
+        auto& value = valueList.at(i);
+        WCAnimationKeyframe keyframe;
+        keyframe.keyTime = value.keyTime();
+        if (auto* timingFunction = value.timingFunction())
+            keyframe.timingFunction = timingFunction->clone();
+        if (isOpacity)
+            keyframe.opacity = static_cast<const GraphicsLayerFloatAnimationValue&>(value).value();
+        else
+            keyframe.transform = static_cast<const GraphicsLayerTransformAnimationValue&>(value).value().clone();
+        newAnimation.keyframes.append(WTF::move(keyframe));
+    }
+    if (auto timingFunction = animation->timingFunction())
+        newAnimation.timingFunction = timingFunction->clone();
+    if (auto timingFunction = animation->defaultTimingFunctionForKeyframes())
+        newAnimation.defaultTimingFunctionForKeyframes = timingFunction->clone();
+    newAnimation.duration = animation->duration().value_or(0);
+    newAnimation.iterationCount = animation->iterationCount();
+    newAnimation.direction = static_cast<uint8_t>(animation->direction());
+    newAnimation.fillsForwards = animation->fillsForwards();
+    newAnimation.startTime = MonotonicTime::now() - Seconds(timeOffset);
+
+    // Resuming a paused animation adds it again.
+    m_animations.removeAllMatching([&](auto& existing) {
+        return existing.name == animationName && existing.property == newAnimation.property;
+    });
+    m_animations.append(WTF::move(newAnimation));
+    noteLayerPropertyChanged(WCLayerChange::Animations);
+    return true;
+}
+
+void GraphicsLayerWC::pauseAnimation(const String& animationName, double timeOffset)
+{
+    for (auto& animation : m_animations) {
+        if (animation.name == animationName) {
+            animation.paused = true;
+            animation.pauseTime = Seconds(timeOffset);
+        }
+    }
+    noteLayerPropertyChanged(WCLayerChange::Animations);
+}
+
+void GraphicsLayerWC::removeAnimation(const String& animationName, std::optional<AnimatedProperty> property)
+{
+    bool removed = m_animations.removeAllMatching([&](auto& animation) {
+        return animation.name == animationName && (!property || animation.property == static_cast<uint8_t>(*property));
+    });
+    if (removed)
+        noteLayerPropertyChanged(WCLayerChange::Animations);
+}
+
+void GraphicsLayerWC::transformRelatedPropertyDidChange()
+{
+    // The non-animated transform parts go with the animations.
+    bool hasTransformAnimation = std::ranges::any_of(m_animations, [](auto& animation) {
+        return animation.property != static_cast<uint8_t>(AnimatedProperty::Opacity);
+    });
+    if (hasTransformAnimation)
+        noteLayerPropertyChanged(WCLayerChange::Animations);
+}
+
+Vector<GraphicsLayer::AcceleratedAnimationForTesting> GraphicsLayerWC::acceleratedAnimationsForTesting() const
+{
+    return WTF::map(m_animations, [](auto& animation) {
