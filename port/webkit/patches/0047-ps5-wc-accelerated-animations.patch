+// Accelerated animations sent by GraphicsLayerWC::addAnimation (WCUpdateInfo.h).
+static WebCore::TextureMapperAnimations textureMapperAnimations(const WCAnimations& update)
+{
+    using namespace WebCore;
+    TextureMapperAnimations animations;
+    animations.setTranslate(update.translate);
+    animations.setRotate(update.rotate);
+    animations.setScale(update.scale);
+    animations.setTransform(update.transform);
+    for (auto& animation : update.animations) {
+        auto property = static_cast<AnimatedProperty>(animation.property);
+        bool isOpacity = property == AnimatedProperty::Opacity;
+        if (!isOpacity && property != AnimatedProperty::Translate && property != AnimatedProperty::Rotate
+            && property != AnimatedProperty::Scale && property != AnimatedProperty::Transform)
+            continue;
+        if (animation.keyframes.size() < 2 || animation.direction > static_cast<uint8_t>(GraphicsLayerAnimation::Direction::AlternateReverse))
+            continue;
+        GraphicsLayerKeyframeValueList keyframes(property);
+        for (auto& keyframe : animation.keyframes) {
+            if (isOpacity)
+                keyframes.insert(makeUnique<GraphicsLayerFloatAnimationValue>(keyframe.keyTime, keyframe.opacity, keyframe.timingFunction.get()));
+            else
+                keyframes.insert(makeUnique<GraphicsLayerTransformAnimationValue>(keyframe.keyTime, keyframe.transform, keyframe.timingFunction.get()));
+        }
+        auto parameters = GraphicsLayerAnimation::create();
+        parameters->setDuration(animation.duration);
+        parameters->setIterationCount(animation.iterationCount);
+        parameters->setDirection(static_cast<GraphicsLayerAnimation::Direction>(animation.direction));
+        parameters->setFillMode(animation.fillsForwards ? GraphicsLayerAnimation::FillMode::Forwards : GraphicsLayerAnimation::FillMode::None);
+        parameters->setTimingFunction(animation.timingFunction ? RefPtr { animation.timingFunction } : RefPtr<TimingFunction> { LinearTimingFunction::create() });
+        parameters->setDefaultTimingFunctionForKeyframes(RefPtr { animation.defaultTimingFunctionForKeyframes });
+        animations.add(TextureMapperAnimation(animation.name, keyframes, parameters.get(), animation.startTime, animation.pauseTime,
+            animation.paused ? TextureMapperAnimation::State::Paused : TextureMapperAnimation::State::Playing));
+    }
+    return animations;
+}
