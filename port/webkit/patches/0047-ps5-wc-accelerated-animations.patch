+
+// A copy that shares no reference-counted objects with this layer's (the
+// update may be serialized and freed off the main thread).
+static WCAnimation isolatedCopy(const WCAnimation& animation)
+{
+    auto copyTimingFunction = [](const RefPtr<TimingFunction>& function) -> RefPtr<TimingFunction> {
+        return function ? RefPtr<TimingFunction> { function->clone() } : nullptr;
+    };
+    WCAnimation copy;
+    copy.name = animation.name.isolatedCopy();
+    copy.property = animation.property;
+    copy.keyframes = WTF::map(animation.keyframes, [&](auto& keyframe) {
+        return WCAnimationKeyframe { keyframe.keyTime, copyTimingFunction(keyframe.timingFunction), keyframe.opacity, keyframe.transform.clone(), { } };
+    });
+    copy.timingFunction = copyTimingFunction(animation.timingFunction);
+    copy.defaultTimingFunctionForKeyframes = copyTimingFunction(animation.defaultTimingFunctionForKeyframes);
+    copy.duration = animation.duration;
+    copy.iterationCount = animation.iterationCount;
+    copy.direction = animation.direction;
+    copy.fillsForwards = animation.fillsForwards;
+    copy.startTime = animation.startTime;
+    copy.pauseTime = animation.pauseTime;
+    copy.paused = animation.paused;
+    return copy;
+}
