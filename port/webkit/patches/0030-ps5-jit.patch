+#if defined(PS5_PAYLOAD_SDK)
+// For the PS5 payloads (apps/child: the [mem] line; the crash guard tells
+// JIT code from the image). Any pointer may be null.
+extern "C" void ps5wk_jit_memory(void** start, void** end, size_t* allocated, size_t* committed)
+{
+    FixedVMPoolExecutableAllocator* allocator = g_jscConfig.fixedVMPoolExecutableAllocator;
+    bool valid = allocator && allocator->isValid();
+    if (start)
+        *start = valid ? g_jscConfig.startExecutableMemory : nullptr;
+    if (end)
+        *end = valid ? g_jscConfig.endExecutableMemory : nullptr;
+    if (allocated)
+        *allocated = valid ? allocator->bytesAllocated() : 0;
+    if (committed)
+        *committed = valid ? allocator->bytesCommitted() : 0;
+}
