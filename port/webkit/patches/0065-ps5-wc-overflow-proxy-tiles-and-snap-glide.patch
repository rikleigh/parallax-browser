+#if defined(PS5_PAYLOAD_SDK)
+// PS5WK_WC_LAYER_LOG=2 (child.env): after each compositing update, one line
+// per layer inside a composited scroller whose compositing state changed
+// (composited or not, why, and whether it paints into a shared backing),
+// to find content that paints into a backing which doesn't move with its
+// scroller.
+static void ps5LogScrolledLayerCompositing(const RenderLayerCompositor& compositor, const RenderLayer& root)
+{
+    static const bool enabled = [] {
+        const char* value = getenv("PS5WK_WC_LAYER_LOG");
+        return value && strchr(value, '2');
+    }();
+    if (!enabled)
+        return;
+    static NeverDestroyed<HashMap<const RenderLayer*, String>> lastState;
+    Function<void(const RenderLayer&)> visit = [&](const RenderLayer& layer) {
+        if (layer.hasCompositedScrollingAncestor()) {
+            StringBuilder state;
+            if (layer.isComposited()) {
+                state.append("composited ("_s);
+                bool first = true;
+                for (auto reason : compositor.reasonsForCompositing(layer)) {
+                    state.append(first ? ""_s : ", "_s, compositingReasonToString(reason));
+                    first = false;
+                }
+                state.append(')');
+                if (layer.backing()->paintsIntoCompositedAncestor())
+                    state.append(" paints into ancestor"_s);
+                auto& graphicsLayer = *layer.backing()->graphicsLayer();
+                state.append(" draws "_s, graphicsLayer.drawsContent() ? 1 : 0, " visible "_s, graphicsLayer.contentsAreVisible() ? 1 : 0,
+                    " at "_s, static_cast<int>(graphicsLayer.position().x()), ',', static_cast<int>(graphicsLayer.position().y()),
+                    " size "_s, static_cast<int>(graphicsLayer.size().width()), 'x', static_cast<int>(graphicsLayer.size().height()),
+                    " parent "_s, graphicsLayer.parent() ? graphicsLayer.parent()->name() : "none"_str);
+                if (auto* parentLayer = graphicsLayer.parent())
+                    state.append(" (origin "_s, static_cast<int>(parentLayer->boundsOrigin().x()), ',', static_cast<int>(parentLayer->boundsOrigin().y()), ')');
+            } else if (auto* provider = layer.backingProviderLayer())
+                state.append("shares the backing of "_s, provider->name());
+            else
+                state.append("not composited"_s);
+            if (auto* parent = layer.paintOrderParent())
+                state.append("; paint-order parent "_s, parent->name());
+            auto& entry = lastState.get().add(&layer, String()).iterator->value;
+            if (entry != state.toString()) {
+                entry = state.toString();
+                WTFLogAlways("[wc-cl] %s: %s", layer.name().utf8().data(), entry.utf8().data()); // NOLINT
+            }
+        }
+        for (auto* child = layer.firstChild(); child; child = child->nextSibling())
+            visit(*child);
+    };
+    visit(root);
+}
+#endif
