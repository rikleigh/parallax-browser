+// The stick's speed when it let go: the node's movement over the last
+// 100 ms of wheel-driven scrolling (tree lock held).
+FloatSize PS5WCScrollingTree::releaseVelocity(ScrollingNodeID nodeID) const
+{
+    if (m_wheelTrailNode != nodeID || m_wheelTrail.size() < 2)
+        return { };
+    auto& last = m_wheelTrail.last();
+    const WheelTrailPoint* first = nullptr;
+    for (auto& point : m_wheelTrail) {
+        if (last.time - point.time <= 100_ms) {
+            first = &point;
+            break;
+        }
+    }
+    if (!first)
+        return { };
+    double seconds = (last.time - first->time).seconds();
+    if (seconds < 0.016)
+        return { };
+    return (last.position - first->position) * static_cast<float>(1 / seconds);
+}
+
+// Tree lock held. The gesture is over (ScrollingEffectsController is told,
+// without its own snap animation) and the node glides on from its current
+// position and speed to the snap position nearest where that speed would
+// take it in kGlideProjection, as browsers end a touchpad fling on a snap
+// container: no stop before the snap, no jump, no snapping back from a
+// standstill. False if there is nothing to glide (resting on a snap position).
+bool PS5WCScrollingTree::startSnapGlide(ScrollingTreeScrollingNode& node, const PlatformWheelEvent& lastEvent)
+{
+    constexpr float kGlideProjection = 0.2f; // s of the release speed
+    WheelGestureEndEvent endEvent { lastEvent };
+    auto velocity = releaseVelocity(node.scrollingNodeID());
+    auto current = node.currentScrollPosition();
+    auto target = current;
+    if (!withWCScrollingNode(node, [&](auto& wcNode) {
+        wcNode.endWheelGesture(endEvent);
+        // No speed against a limit the node already sits at.
+        auto [minimum, maximum] = wcNode.scrollLimits();
+        if ((current.x() <= minimum.x() && velocity.width() < 0) || (current.x() >= maximum.x() && velocity.width() > 0))
+            velocity.setWidth(0);
+        if ((current.y() <= minimum.y() && velocity.height() < 0) || (current.y() >= maximum.y() && velocity.height() > 0))
+            velocity.setHeight(0);
+        target = wcNode.snapPositionNear(current + velocity * kGlideProjection);
+    }))
+        return false;
+    auto distance = target - current;
+    if (distance.diagonalLength() < 0.5f)
+        return false;
+    // Duration: decelerating evenly from the release speed onto the target
+    // takes 2 x distance / speed (the curve below is then exactly that);
+    // kept to 0.25-0.7 s. Against the motion, or from rest: 0.4 s.
+    bool mainAxisX = std::abs(distance.width()) >= std::abs(distance.height());
+    float mainDistance = mainAxisX ? distance.width() : distance.height();
+    float mainSpeed = mainAxisX ? velocity.width() : velocity.height();
+    double duration = 0.4;
+    if (mainSpeed && (mainSpeed > 0) == (mainDistance > 0))
+        duration = std::clamp(2.0 * mainDistance / mainSpeed, 0.25, 0.7);
+    m_snapGlideState = SnapGlide { node.scrollingNodeID(), MonotonicTime { }, Seconds(duration), current, target, velocity, current };
+    m_snapGlideActive = true;
+    WTFLogAlways("[ascroll] glide node %llu: %.0f,%.0f at %.0f,%.0f px/s -> snap %.0f,%.0f in %.0f ms", // NOLINT
+        static_cast<unsigned long long>(node.scrollingNodeID().object().toUInt64()), current.x(), current.y(), velocity.width(), velocity.height(),
+        target.x(), target.y(), duration * 1000);
+    return true;
+}
+
+// Render thread, tree lock held: the glide's position at the frame's
+// display time. Per axis a cubic Hermite curve from the start position at
+// the release speed to the target at rest: with the default duration an
+// even deceleration (D (2s - s^2)); shorter or longer ones ease in or
+// overshoot a little and come back, without a jump in speed.
+void PS5WCScrollingTree::serviceSnapGlide(MonotonicTime time)
+{
+    if (!m_snapGlideState)
+        return;
+    auto& glide = *m_snapGlideState;
+    RefPtr node = dynamicDowncast<ScrollingTreeScrollingNode>(nodeForID(glide.nodeID));
+    // Gone, or moved by something else (a programmatic scroll, a commit).
+    if (!node || (node->currentScrollPosition() - glide.last).diagonalLength() > 2) {
+        m_snapGlideState = std::nullopt;
+        m_snapGlideActive = false;
+        return;
+    }
+    // The curve starts one frame before the first frame it moves: its first
+    // step is one frame of the release speed, not a catch-up jump for the
+    // time since the gesture ended.
+    if (!glide.start)
+        glide.start = time - 16667_us;
+    double duration = glide.duration.seconds();
+    double t = std::clamp((time - glide.start).seconds() / duration, 0.0, 1.0);
+    auto axis = [&](float from, float target, float speed) {
+        double s2 = t * t, s3 = s2 * t;
+        return static_cast<float>(from + (target - from) * (3 * s2 - 2 * s3) + speed * duration * (s3 - 2 * s2 + t));
+    };
+    bool done = t >= 1;
+    FloatPoint position = done ? glide.target : FloatPoint { axis(glide.from.x(), glide.target.x(), glide.velocity.width()), axis(glide.from.y(), glide.target.y(), glide.velocity.height()) };
+    node->scrollTo(position, ScrollType::User, ScrollClamping::Clamped);
+    glide.last = node->currentScrollPosition();
+    if (done) {
+        m_snapGlideState = std::nullopt;
+        m_snapGlideActive = false;
+    }
+}
