+static bool ps5_decommit_by_remap(void)
+{
+    static int state; /* 0 unknown, 1 remap, -1 zero only */
+    if (!state) {
+        const char* value = getenv("PS5WK_PAS_DECOMMIT");
+        state = value && value[0] == '0' ? -1 : 1;
+    }
+    return state > 0;
+}
