 {
 #if defined(PS5_PAYLOAD_SDK)
-    /* PS5 (see commit_impl): a 4 KiB granule is part of a 16 KiB page, so it
-     * cannot be madvised or mprotected on its own (libpas asserted on page
-     * alignment here on the console). Zero it, as a fresh commit would be,
-     * and keep it. TODO: 16 KiB granules, as libpas does on Apple arm64. */
+    /* PS5: pages are 16 KiB (granules are too, pas_internal_config.h). On
+     * the console madvise(MADV_FREE or MADV_DONTNEED) leaves the pages
+     * resident (mincore) and mprotect too; mapping fresh anonymous memory
+     * over the range drops them (port/webkit/test/memprobe). So: zero the
+     * parts that aren't whole pages, map over the rest. Executable memory
+     * and memory whose permissions the client owns are only zeroed, and so
+     * is everything with PS5WK_PAS_DECOMMIT=0 (the 0006 behaviour: libpas
+     * memory as a high-water mark). */
     PAS_UNUSED_PARAM(do_mprotect);
