+
+// WebProcessProxy::sharedPreferencesDidChange. There is no GPUProcessProxy in the title to carry
+// this, and without it a setting changed while a WebProcess runs (WebGPU switched on in
+// Settings) never reaches that process's GPUConnectionToWebProcess, whose message checks then
+// refuse what the page was just allowed to ask for.
+void sharedPreferencesForWebProcessDidChange(WebProcessProxy& webProcess, SharedPreferencesForWebProcess&& sharedPreferences)
+{
+    RELEASE_ASSERT(RunLoop::isMain());
+    if (!started || failed)
+        return;
+    GPUProcess::singleton().ps5SharedPreferencesForWebProcessDidChange(webProcess.coreProcessIdentifier(), WTF::move(sharedPreferences));
+}
