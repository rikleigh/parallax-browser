+// Reads the scene texture back (row 0 = top of the page) and checks probe
+// pixels against what the synthetic scene must show there.
+unsigned SceneHost::readbackAndCheck(const IntSize& size, uint32_t* checksum, unsigned* probesOK, unsigned* probes, char* firstBad, size_t firstBadSize, const char* dumpPath)
+{
+    Vector<uint8_t> pixels(static_cast<size_t>(size.width()) * size.height() * 4);
+    GLuint fbo = 0;
+    GLint previous = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_surface->id(), 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, size.width(), size.height(), GL_RGBA, GL_UNSIGNED_BYTE, pixels.mutableSpan().data());
+    glBindFramebuffer(GL_FRAMEBUFFER, previous);
+    glDeleteFramebuffers(1, &fbo);
+
+    uint32_t hash = 2166136261u;
+    for (auto byte : pixels)
+        hash = (hash ^ byte) * 16777619u;
+    *checksum = hash;
+
+    if (dumpPath) {
+        // Binary PPM, readback rows in order (row 0 = what the scene put at
+        // texture row 0, the top of the page), alpha dropped.
+        if (FILE* file = fopen(dumpPath, "wb")) {
+            fprintf(file, "P6\n%d %d\n255\n", size.width(), size.height());
+            Vector<uint8_t> row(size.width() * 3);
+            for (int y = 0; y < size.height(); ++y) {
+                const uint8_t* source = pixels.span().data() + static_cast<size_t>(y) * size.width() * 4;
+                for (int x = 0; x < size.width(); ++x) {
+                    row[x * 3] = source[x * 4];
+                    row[x * 3 + 1] = source[x * 4 + 1];
+                    row[x * 3 + 2] = source[x * 4 + 2];
+                }
+                fwrite(row.span().data(), 1, row.size(), file);
+            }
+            fclose(file);
+            WTFLogAlways("[wc] scene readback written to %s", dumpPath); // NOLINT
+        }
+    }
+
+    auto at = [&](int x, int y) {
+        const uint8_t* p = pixels.span().data() + (static_cast<size_t>(y) * size.width() + x) * 4;
+        return std::array<int, 4> { p[0], p[1], p[2], p[3] };
+    };
+    auto patternRGBA = [](unsigned seed, int x, int y) {
+        uint32_t v = patternPixel(seed, x, y);
+        return std::array<int, 4> { static_cast<int>((v >> 16) & 0xff), static_cast<int>((v >> 8) & 0xff), static_cast<int>(v & 0xff), 255 };
+    };
+    unsigned ok = 0, total = 0;
+    auto probe = [&](const char* what, int x, int y, std::array<int, 4> expected, int tolerance) {
+        if (x < 0 || y < 0 || x >= size.width() || y >= size.height())
+            return;
+        total++;
+        auto got = at(x, y);
+        bool good = true;
+        for (int c = 0; c < 4; ++c)
+            good &= std::abs(got[c] - expected[c]) <= tolerance;
+        if (good)
+            ok++;
+        else if (firstBad) {
+            size_t used = strlen(firstBad);
+            if (used + 1 < firstBadSize)
+                snprintf(firstBad + used, firstBadSize - used, "%s%s (%d,%d) RGBA %d,%d,%d,%d want %d,%d,%d,%d", used ? "; " : "", what, x, y, got[0], got[1], got[2], got[3], expected[0], expected[1], expected[2], expected[3]);
+        }
+    };
+    using S = SyntheticScene;
+    // Background alone, exact (bottom right; tile row 2 is partial at 1080).
+    probe("background", size.width() - 20, size.height() - 10, patternRGBA(S::Background, size.width() - 20, size.height() - 10), 0);
+    probe("background", 1100, 40, patternRGBA(S::Background, 1100, 40), 0);
+    // Green at opacity 0.5 over the background.
+    {
+        int x = S::solidPosition.x() + 150, y = S::solidPosition.y() + 100;
+        auto bg = patternRGBA(S::Background, x, y);
+        probe("solid 50%", x, y, { (bg[0] + 1) / 2, (bg[1] + 200 + 1) / 2, (bg[2] + 1) / 2, 255 }, 3);
+    }
+    // Rounded clip: the corner shows the background, the middle the child (offset -50,-50).
+    {
+        int x = S::clipPosition.x() + 4, y = S::clipPosition.y() + 4;
+        probe("rounded corner", x, y, patternRGBA(S::Background, x, y), 2);
+        int cx = S::clipPosition.x() + 200, cy = S::clipPosition.y() + 150;
+        probe("clipped child", cx, cy, patternRGBA(S::ClipChild, 250, 200), 2);
+    }
+    *probesOK = ok;
+    *probes = total;
+    return total - ok;
+}
+
+bool SceneHost::runS1b(bool verbose, IntSize viewport)
+{
+    auto glError = [] {
+        GLenum first = GL_NO_ERROR;
+        for (GLenum error; (error = glGetError()) != GL_NO_ERROR;) {
+            if (first == GL_NO_ERROR)
+                first = error;
+        }
+        return first;
+    };
+    auto finish = [] {
+        glFinish();
+    };
+    glError();
+    auto programsBefore = TextureMapperShaderProgram::compileStats();
+
+    auto t0 = MonotonicTime::now();
+    WCScene scene(Process::identifier(), false);
+    scene.initialize(*m_sceneContext);
+    double createMS = msSince(t0);
+
+    SyntheticScene synthetic(viewport);
+    bool bitmapsOK = false;
+    auto info = synthetic.initial(&bitmapsOK);
+    if (!bitmapsOK) {
+        WTFLogAlways("[wc] S1b: could not make the test tile bitmaps (shared memory)"); // NOLINT
+        return false;
+    }
+    BitmapTextureUploaderPS5::singleton().takeStats();
+    t0 = MonotonicTime::now();
+    bool applied = scene.apply(info);
+    finish();
+    double applyMS = msSince(t0);
+    auto uploadStats = BitmapTextureUploaderPS5::singleton().takeStats();
+    GLenum applyError = glError();
+
+    m_surface = BitmapTexture::create(viewport, { BitmapTexture::Flags::SupportsAlpha });
+    t0 = MonotonicTime::now();
+    scene.paint(*m_surface);
+    finish();
+    double coldMS = msSince(t0);
+    GLenum coldError = glError();
+    auto programsAfter = TextureMapperShaderProgram::compileStats();
+
+    const int warmRuns = verbose ? 20 : 3;
+    double warmCPU = 0, warmTotal = 0, warmMax = 0;
+    for (int i = 0; i < warmRuns; ++i) {
+        t0 = MonotonicTime::now();
+        scene.paint(*m_surface);
+        double cpu = msSince(t0);
+        finish();
+        double total = msSince(t0);
+        warmCPU += cpu;
+        warmTotal += total;
+        warmMax = std::max(warmMax, total);
+    }
+    GLenum warmError = glError();
+
+    uint32_t checksum = 0;
+    unsigned probesOK = 0, probes = 0;
+    char firstBad[600] = { };
+    unsigned bad = readbackAndCheck(viewport, &checksum, &probesOK, &probes, firstBad, sizeof(firstBad), verbose ? "/data/ps5webkit/wc-s1b.ppm" : nullptr);
+    GLenum readError = glError();
+
+    const bool programsOK = programsAfter.failures == programsBefore.failures || !strcmp(programsAfter.glslVersion, "330 core");
+    // Test mode goes on after wrong pixels (to see them on screen); a normal
+    // start only composites when the self-test drew the scene right.
+    const bool ok = applied && (!bad || verbose) && programsOK && coldError == GL_NO_ERROR && warmError == GL_NO_ERROR;
+    WTFLogAlways("[wc] S1b: %s %dx%d: TextureMapper %.1f ms; apply (%zu layers, %u tile uploads, %.1f MB) %.1f ms incl. GPU, uploads %.2f ms; " // NOLINT
+        "first paint %.1f ms incl. GPU (%u programs compiled in %.1f ms, %u failed, GLSL %s); warm paint %.2f ms CPU, %.2f ms incl. GPU avg, %.2f max (%d runs); "
+        "probes %u/%u%s%s; checksum %08x; GL errors apply 0x%x first paint 0x%x warm 0x%x readback 0x%x",
+        ok && !bad ? "PASS" : ok ? "WRONG PIXELS" : "FAIL", viewport.width(), viewport.height(), createMS, static_cast<size_t>(scene.layerCount()), uploadStats.uploads, uploadStats.bytes / 1048576.0,
+        applyMS, uploadStats.milliseconds, coldMS, programsAfter.programs - programsBefore.programs, programsAfter.milliseconds - programsBefore.milliseconds,
+        programsAfter.failures - programsBefore.failures, programsAfter.glslVersion, warmCPU / warmRuns, warmTotal / warmRuns, warmMax, warmRuns,
+        probesOK, probes, bad ? ", first bad: " : "", bad ? firstBad : "", checksum, applyError, coldError, warmError, readError);
+
+    if (verbose && ok) {
+        // Tile uploads inside TextureMapper: every background tile again
+        // (12 at 1080p), through the PS5 path and through glTexSubImage2D.
+        auto& uploader = BitmapTextureUploaderPS5::singleton();
+        for (int pass = 0; pass < 2; ++pass) {
+            const bool ps5Path = !pass;
+            uploader.setEnabled(ps5Path);
+            double total = 0;
+            unsigned tiles = 0;
+            for (int round = 0; round < 5; ++round) {
+                auto retile = synthetic.retile(SyntheticScene::Background, viewport, SyntheticScene::Background);
+                for (auto& layer : retile.changedLayers)
+                    tiles += layer.background.tileUpdates.size();
+                uploader.takeStats();
+                t0 = MonotonicTime::now();
+                scene.apply(retile);
+                double cpu = msSince(t0);
+                finish();
+                total += msSince(t0);
+                auto stats = uploader.takeStats();
+                if (!round || round == 4) {
+                    WTFLogAlways("[wc] S1b uploads (%s) round %d: %.2f ms CPU for %zu tiles (%.3f ms per tile, uploader %.3f ms per tile), %.2f ms incl. GPU", // NOLINT
+                        ps5Path ? "staging ring + FBO pass" : "glTexSubImage2D", round, cpu, retile.changedLayers[0].background.tileUpdates.size(),
+                        cpu / retile.changedLayers[0].background.tileUpdates.size(), stats.uploads ? stats.milliseconds / stats.uploads : 0.0, msSince(t0));
+                }
+                uploader.frameDone();
+            }
+            scene.paint(*m_surface);
+            finish();
+            uint32_t passChecksum = 0;
+            unsigned passOK = 0, passProbes = 0;
+            char passBad[600] = { };
+            unsigned passFailed = readbackAndCheck(viewport, &passChecksum, &passOK, &passProbes, passBad, sizeof(passBad));
+            WTFLogAlways("[wc] S1b uploads (%s): %u tiles, %.3f ms per tile incl. GPU; after: probes %u/%u%s%s, checksum %08x (%s the first paint's); GL error 0x%x", // NOLINT
+                ps5Path ? "staging ring + FBO pass" : "glTexSubImage2D", tiles, total / tiles, passOK, passProbes, passFailed ? ", first bad: " : "", passFailed ? passBad : "",
+                passChecksum, passChecksum == checksum ? "same as" : "DIFFERENT from", glError());
+        }
+        uploader.setEnabled(true);
+        uploader.frameDone();
+    }
+    m_surface = nullptr;
+    return ok;
+}
