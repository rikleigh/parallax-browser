+/*
+ * PS5: the WC compositor host inside the title (PS5WCHost.h).
+ *
+ * Main thread: update()/removePage() queue work and ask PS5Renderer for a
+ * frame. Render thread (PS5CompositorClient, port/webkit/wpe-ps5/
+ * PS5Compositor.h): in PS5Renderer's own GL context, adopted by a WebCore
+ * GLContext that is never destroyed, each frame applies the queued updates
+ * (WCScene::apply: layer changes, tile uploads through
+ * BitmapTextureUploaderPS5), paints the shown page's layer tree into the
+ * scene texture (WCScene::paint), which PS5Renderer draws where the CPU page
+ * goes; after the swap, the updates applied in that frame complete on the
+ * main thread.
+ *
+ * Test mode (/data/ps5webkit/wctest, log-only): spike S1b at set-up (the
+ * TextureMapper programs WCScene uses, a test layer tree painted and read
+ * back, tile uploads through the PS5 path and glTexSubImage2D), then a
+ * synthetic animated scene fed through update() for 20 s, as the drawing-area
+ * proxy would.
+ */
+
+#include "config.h"
+#include "PS5WCHost.h"
+
+#if USE(GRAPHICS_LAYER_WC) && !ENABLE(GPU_PROCESS)
+
+#include "WCScene.h"
+#include "WCSceneContext.h"
+#include "WCUpdateInfo.h"
+#include <WebCore/BitmapTexture.h>
+#include <WebCore/BitmapTextureUploaderPS5.h>
+#include <WebCore/Color.h>
+#include <WebCore/FilterOperation.h>
+#include <WebCore/FilterOperations.h>
+#include <WebCore/FloatRoundedRect.h>
+#include <WebCore/GLContext.h>
+#include <WebCore/GLDisplay.h>
+#include <WebCore/ProcessIdentifier.h>
+#include <WebCore/ShareableBitmap.h>
+#include <WebCore/TextureMapper.h>
+#include <WebCore/TextureMapperGLHeaders.h>
+#include <WebCore/TextureMapperShaderProgram.h>
+#include <atomic>
+#include <memory>
+#include <sys/stat.h>
+#include <unordered_map>
+#include <wpe/ps5/PS5Compositor.h>
+#include <glib.h>
