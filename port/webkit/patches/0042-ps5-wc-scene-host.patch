+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+
+constexpr const char* testFlagPath = "/data/ps5webkit/wctest";
+
+bool testModeRequested()
+{
+    struct stat st;
+    return !stat(testFlagPath, &st);
+}
+
+double msSince(MonotonicTime start)
+{
+    return (MonotonicTime::now() - start).milliseconds();
+}
+
+// ---- A synthetic layer tree, as DrawingAreaWC would send it ----
+
+// Premultiplied BGRA (Skia's N32), opaque; R = seed so a B/R mix-up shows.
+uint32_t patternPixel(unsigned seed, int x, int y)
+{
+    uint8_t b = static_cast<uint8_t>(x * 7 + (y >> 3));
+    uint8_t g = static_cast<uint8_t>(y * 5 + (x >> 4));
+    uint8_t r = static_cast<uint8_t>(seed * 37 + ((x ^ y) & 0x3f));
+    return b | (g << 8) | (r << 16) | (0xffu << 24);
+}
+
+RefPtr<ShareableBitmap> patternBitmap(unsigned seed, const IntRect& rect)
+{
+    auto bitmap = ShareableBitmap::create({ rect.size() });
+    if (!bitmap)
+        return nullptr;
+    auto span = bitmap->mutableSpan();
+    const size_t stride = bitmap->bytesPerRow();
+    for (int y = 0; y < rect.height(); ++y) {
+        auto* row = reinterpret_cast<uint32_t*>(span.data() + y * stride);
+        for (int x = 0; x < rect.width(); ++x)
+            row[x] = patternPixel(seed, rect.x() + x, rect.y() + y);
+    }
+    return bitmap;
+}
+
+class SyntheticScene {
+public:
+    explicit SyntheticScene(IntSize viewport)
+        : m_viewport(viewport)
+    {
+        auto process = Process::identifier();
+        for (unsigned i = 0; i < LayerCount; ++i)
+            m_ids.append(PlatformLayerIdentifier { ObjectIdentifier<PlatformLayerIdentifierType>::generate(), process });
+    }
+
+    enum Layer : unsigned { Root, Background, Solid, Card, CardChild, Clip, ClipChild, Blurred, Gray, LayerCount };
+    static constexpr IntPoint solidPosition { 100, 100 };
+    static constexpr IntSize solidSize { 300, 200 };
+    static constexpr IntPoint clipPosition { 1300, 100 };
+    static constexpr IntSize clipSize { 400, 300 };
+    static constexpr float clipRadius = 60;
+    static constexpr IntPoint cardPosition { 650, 150 };
+
+    WCUpdateInfo initial(bool* ok)
+    {
+        WCUpdateInfo info;
+        info.viewport = m_viewport;
+        info.rootLayer = m_ids[Root];
+        for (auto& id : m_ids)
+            info.addedLayers.append(id);
+
+        auto layer = [&](Layer which, FloatPoint position, FloatSize size) -> WCLayerUpdateInfo& {
+            WCLayerUpdateInfo update { m_ids[which] };
+            update.changes = { WCLayerChange::Position, WCLayerChange::AnchorPoint, WCLayerChange::Size, WCLayerChange::Opacity,
+                WCLayerChange::ContentsVisible, WCLayerChange::Transform, WCLayerChange::Background };
+            update.position = position;
+            update.anchorPoint = { 0, 0, 0 };
+            update.size = size;
+            update.opacity = 1;
+            update.contentsVisible = true;
+            update.background.color = Color { }; // none
+            update.background.hasBackingStore = false;
+            info.changedLayers.append(WTF::move(update));
+            return info.changedLayers.last();
+        };
+
+        auto& root = layer(Root, { }, m_viewport);
+        root.changes.add(WCLayerChange::Children);
+        root.children = { m_ids[Background], m_ids[Solid], m_ids[Card], m_ids[Clip], m_ids[Blurred], m_ids[Gray] };
+
+        bool allTiles = true;
+        auto& background = layer(Background, { }, m_viewport);
+        allTiles &= addTiles(background, Background, m_viewport);
+
+        auto& solid = layer(Solid, solidPosition, solidSize);
+        solid.background.color = Color(SRGBA<uint8_t> { 0, 200, 0, 255 });
+        solid.opacity = 0.5f;
+
+        auto& card = layer(Card, cardPosition, { 512, 512 });
+        card.anchorPoint = { 0.5f, 0.5f, 0 };
+        card.transform = TransformationMatrix().rotate(10);
+        card.changes.add({ WCLayerChange::Children, WCLayerChange::MasksToBounds });
+        card.masksToBounds = true; // rotated: a stencil clip for its child
+        card.children = { m_ids[CardChild] };
+        allTiles &= addTiles(card, Card, { 512, 512 });
+        auto& cardChild = layer(CardChild, { 350, 350 }, { 300, 300 });
+        cardChild.background.color = Color(SRGBA<uint8_t> { 220, 40, 40, 255 });
+
+        auto& clip = layer(Clip, clipPosition, clipSize);
+        clip.changes.add({ WCLayerChange::Children, WCLayerChange::ContentsRectClipsDescendants, WCLayerChange::ContentsClippingRect });
+        clip.contentsRectClipsDescendants = true;
+        clip.contentsClippingRect = FloatRoundedRect(FloatRect { { }, clipSize }, CornerRadii(clipRadius, clipRadius, clipRadius, clipRadius));
+        clip.children = { m_ids[ClipChild] };
+        auto& clipChild = layer(ClipChild, { -50, -50 }, { 512, 512 });
+        allTiles &= addTiles(clipChild, ClipChild, { 512, 512 });
+
+        auto& blurred = layer(Blurred, { 100, 600 }, { 384, 256 });
+        blurred.changes.add(WCLayerChange::Filters);
+        Vector<Ref<FilterOperation>> blur;
+        blur.append(BlurFilterOperation::create(6));
+        blurred.filters = FilterOperations { WTF::move(blur) };
+        allTiles &= addTiles(blurred, Blurred, { 384, 256 });
+
+        auto& gray = layer(Gray, { 600, 700 }, { 384, 256 });
+        gray.changes.add(WCLayerChange::Filters);
+        Vector<Ref<FilterOperation>> grayscale;
+        grayscale.append(BasicColorMatrixFilterOperation::create(1, FilterOperation::Type::Grayscale));
+        gray.filters = FilterOperations { WTF::move(grayscale) };
+        allTiles &= addTiles(gray, Gray, { 384, 256 });
+
+        if (ok)
+            *ok = allTiles;
+        return info;
+    }
+
+    // One animation step: the card turns, the solid layer's opacity breathes,
+    // a 200x200 patch of the background is repainted every frame (straddling
+    // two tiles: one bitmap, two tile updates, the second at a source offset)
+    // and four whole background tiles every 30th frame.
+    WCUpdateInfo next(unsigned frame)
+    {
+        WCUpdateInfo info;
+        info.viewport = m_viewport;
+        info.rootLayer = m_ids[Root];
+
+        WCLayerUpdateInfo card { m_ids[Card] };
+        card.changes = WCLayerChange::Transform;
+        card.transform = TransformationMatrix().rotate(10 + 2.0 * frame);
+        info.changedLayers.append(WTF::move(card));
+
+        WCLayerUpdateInfo solid { m_ids[Solid] };
+        solid.changes = WCLayerChange::Opacity;
+        solid.opacity = 0.5f + 0.4f * std::sin(frame * 0.1f);
+        info.changedLayers.append(WTF::move(solid));
+
+        WCLayerUpdateInfo background { m_ids[Background] };
+        background.changes = WCLayerChange::Background;
+        background.background.hasBackingStore = true;
+        background.background.backingStoreSize = m_viewport;
+        IntRect patch { 412 + static_cast<int>(frame % 50), 700, 200, 200 };
+        auto patchBitmap = patternBitmap(Background + frame, patch);
+        for (int column = 0; column < 2; ++column) {
+            WCTileUpdate tile;
+            tile.index = { column, 1 };
+            tile.dirtyRect = patch;
+            tile.backingStore.setBitmap(RefPtr { patchBitmap });
+            background.background.tileUpdates.append(WTF::move(tile));
+        }
+        if (!(frame % 30)) {
+            for (int i = 0; i < 4; ++i) {
+                IntRect rect { i * 512, 0, std::min(512, m_viewport.width() - i * 512), std::min(512, m_viewport.height()) };
+                WCTileUpdate tile;
+                tile.index = { i, 0 };
+                tile.dirtyRect = rect;
+                tile.backingStore.setBitmap(patternBitmap(Background + frame / 30, rect));
+                background.background.tileUpdates.append(WTF::move(tile));
+            }
+        }
+        info.changedLayers.append(WTF::move(background));
+        return info;
+    }
+
+    // Every tile of one layer again (upload benchmark).
+    WCUpdateInfo retile(Layer which, IntSize size, unsigned seed)
+    {
+        WCUpdateInfo info;
+        info.viewport = m_viewport;
+        info.rootLayer = m_ids[Root];
+        WCLayerUpdateInfo update { m_ids[which] };
+        update.changes = WCLayerChange::Background;
+        addTiles(update, seed, size);
+        info.changedLayers.append(WTF::move(update));
+        return info;
+    }
+
+    IntSize viewport() const { return m_viewport; }
+
+private:
+    bool addTiles(WCLayerUpdateInfo& update, unsigned seed, IntSize size)
+    {
+        update.changes.add(WCLayerChange::Background);
+        update.background.hasBackingStore = true;
+        update.background.backingStoreSize = size;
+        bool ok = true;
+        for (int y = 0; y < size.height(); y += 512) {
+            for (int x = 0; x < size.width(); x += 512) {
+                IntRect rect { x, y, std::min(512, size.width() - x), std::min(512, size.height() - y) };
+                WCTileUpdate tile;
+                tile.index = { x / 512, y / 512 };
+                tile.dirtyRect = rect;
+                auto bitmap = patternBitmap(seed, rect);
+                ok &= !!bitmap;
+                tile.backingStore.setBitmap(WTF::move(bitmap));
+                update.background.tileUpdates.append(WTF::move(tile));
+            }
+        }
+        return ok;
+    }
+
+    IntSize m_viewport;
+    Vector<PlatformLayerIdentifier> m_ids;
+};
+
+// ---- The host ----
+
+class SceneHost final : public PS5CompositorClient {
+public:
+    static SceneHost& singleton()
+    {
+        static SceneHost* host = new SceneHost; // never destroyed
+        return *host;
+    }
+
+    // Main thread.
+    bool available()
+    {
+        ensureSetUp();
+        return m_state.load() == State::Ready;
+    }
+    void ensureSetUp();
+    void enqueue(uint64_t pageID, std::unique_ptr<WCUpdateInfo>&&, CompletionHandler<void()>&&);
+    void startTestDriver();
+
+    // PS5CompositorClient.
+    void attach(void (*requestFrame)()) final { m_requestFrame = requestFrame; } // main thread, early
+    bool wantsSetUp() final { return m_setUpWanted.load(); }
+    bool setUp(const PS5CompositorContext&) final;
+    bool hasPending() final;
+    void applyPending() final;
+    unsigned paint(int64_t displayUS, int* width, int* height) final;
+    void didPresent() final;
+
+private:
+    enum class State : int { NotSetUp, Ready, Failed };
+    struct Job {
+        uint64_t pageID { 0 };
+        std::unique_ptr<WCUpdateInfo> info; // null: remove the page
+        CompletionHandler<void()> didPresent;
+    };
+
+    void fail(const char* why);
+    void completeOnMainThread(Vector<CompletionHandler<void()>>&&);
+    WCScene& ensureScene(uint64_t pageID);
+    void maybeLog();
+    bool runS1b(bool verbose, IntSize viewport);
+    unsigned readbackAndCheck(const IntSize&, uint32_t* checksum, unsigned* probesOK, unsigned* probes, char* firstBad, size_t firstBadSize, const char* dumpPath = nullptr);
+
+    Lock m_lock;
+    Condition m_stateChanged;
+    Deque<Job> m_queue WTF_GUARDED_BY_LOCK(m_lock);
+    std::atomic<State> m_state { State::NotSetUp };
+    std::atomic<bool> m_setUpWanted { false };
+    std::atomic<void (*)()> m_requestFrame { nullptr };
+    bool m_testMode { testModeRequested() };
+
+    // Render thread.
+    GLContext* m_glContext { nullptr }; // PS5Renderer's context, adopted; never destroyed
+    std::unique_ptr<WCSceneContext> m_sceneContext;
+    std::unique_ptr<TextureMapper> m_programHolder;
+    std::unordered_map<uint64_t, std::unique_ptr<WCScene>> m_scenes;
+    std::optional<uint64_t> m_shownPage; // the most recently updated scene
+    std::unordered_map<uint64_t, uint64_t> m_lastUpdate;
+    uint64_t m_updateSerial { 0 };
+    RefPtr<BitmapTexture> m_surface;
+    bool m_dirty { false };
+    Vector<CompletionHandler<void()>> m_frameCompletions;
+
+    struct {
+        MonotonicTime start;
+        unsigned updates { 0 }, paints { 0 }, presents { 0 };
+        double applyMS { 0 }, applyMaxMS { 0 }, paintMS { 0 }, paintMaxMS { 0 };
+    } m_stats;
+
+    // Test driver (main thread).
+    std::unique_ptr<SyntheticScene> m_testScene;
+    unsigned m_testFrame { 0 };
+    MonotonicTime m_testStart;
+    unsigned m_testCompleted { 0 };
+};
+
+constexpr uint64_t testPageID = 0x7e57000000000001ull;
+
+// The render thread sets the compositor up when asked, the first time the
+// main thread wants to know whether pages can composite (WebKit is up by
+// then); the main thread waits for it, so the answer is final.
+void SceneHost::ensureSetUp()
+{
+    if (m_state.load() != State::NotSetUp)
+        return;
+    auto requestFrame = m_requestFrame.load();
+    if (!requestFrame)
+        return; // No PS5Renderer in this process (the GL-free harness).
+    auto start = MonotonicTime::now();
+    m_setUpWanted = true;
+    requestFrame();
+    Locker locker { m_lock };
+    m_stateChanged.waitFor(m_lock, 10_s, [&] {
+        return m_state.load() != State::NotSetUp;
+    });
+    WTFLogAlways("[wc] main thread waited %.1f ms for the compositor's set-up: %s", msSince(start), // NOLINT
+        m_state.load() == State::Ready ? "ready" : m_state.load() == State::Failed ? "failed" : "STILL PENDING after 10 s");
+}
+
+void SceneHost::enqueue(uint64_t pageID, std::unique_ptr<WCUpdateInfo>&& info, CompletionHandler<void()>&& didPresent)
+{
+    ensureSetUp();
+    bool queued = false;
+    {
+        Locker locker { m_lock };
+        if (m_state.load() != State::Failed) {
+            m_queue.append({ pageID, WTF::move(info), WTF::move(didPresent) });
+            queued = true;
+        }
+    }
+    if (!queued) {
+        // Nothing will show it; don't stall the WebProcess.
+        RunLoop::mainSingleton().dispatch([didPresent = WTF::move(didPresent)]() mutable {
+            if (didPresent)
+                didPresent();
+        });
+        return;
+    }
+    if (auto requestFrame = m_requestFrame.load())
+        requestFrame();
+}
+
+void SceneHost::completeOnMainThread(Vector<CompletionHandler<void()>>&& handlers)
+{
+    if (handlers.isEmpty())
+        return;
+    RunLoop::mainSingleton().dispatch([handlers = WTF::move(handlers)]() mutable {
+        for (auto& handler : handlers) {
+            if (handler)
+                handler();
+        }
+    });
+}
+
+void SceneHost::fail(const char* why)
+{
+    WTFLogAlways("[wc] GPU compositor unavailable: %s; pages stay on the CPU path", why); // NOLINT
+    Deque<Job> jobs;
+    {
+        Locker locker { m_lock };
+        m_state = State::Failed;
+        jobs = std::exchange(m_queue, { });
+        m_stateChanged.notifyAll();
+    }
+    Vector<CompletionHandler<void()>> handlers;
+    for (auto& job : jobs)
+        handlers.append(WTF::move(job.didPresent));
+    completeOnMainThread(WTF::move(handlers));
+}
+
+bool SceneHost::setUp(const PS5CompositorContext& context)
+{
+    auto start = MonotonicTime::now();
+    auto display = GLDisplay::create(context.eglDisplay);
+    if (!display) {
+        fail("GLDisplay::create failed");
+        return false;
+    }
+    // Both live as long as the title: the EGL display and context are PS5Renderer's.
+    auto* glDisplay = display.leakRef();
+    m_glContext = new GLContext(*glDisplay, context.eglContext, context.eglSurface, context.eglConfig);
+    if (!m_glContext->makeContextCurrent() || GLContext::current() != m_glContext) {
+        fail("the adopted context did not become current");
+        return false;
+    }
+    while (glGetError() != GL_NO_ERROR) { }
+
+    // What WebCore sees of the context (GLContext::glExtensions() falls back
+    // to glGetStringi on core profiles).
+    GLint extensionCount = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &extensionCount);
+    const bool nullExtensionString = !glGetString(GL_EXTENSIONS);
+    while (glGetError() != GL_NO_ERROR) { }
+    auto& extensions = m_glContext->glExtensions();
+    GLint maxTextureSize = 0;
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTextureSize);
+    WTFLogAlways("[wc] context: GL %s (WebCore version %u, %s), %d extensions (GL_EXTENSIONS string %s), npot %d unpack_subimage %d packed_depth_stencil %d YUV_target %d, max texture %d", // NOLINT
+        reinterpret_cast<const char*>(glGetString(GL_VERSION)), m_glContext->version(), epoxy_is_desktop_gl() ? "desktop" : "GLES",
+        extensionCount, nullExtensionString ? "null: glGetStringi" : "present", extensions.OES_texture_npot, extensions.EXT_unpack_subimage,
+        extensions.OES_packed_depth_stencil, extensions.EXT_YUV_target, maxTextureSize);
+
+    m_sceneContext = makeUnique<WCSceneContext>(*m_glContext);
+    // Compiled programs belong to the context's TextureMappers together: keep
+    // one alive so they outlive the self-test's scene and any page's.
+    m_programHolder = TextureMapper::create();
+    BitmapTextureUploaderPS5::singleton().initialize();
+
+    // S1b: always a small check (a page that can't composite must stay on
+    // the CPU path); the full measurement in test mode.
+    bool ok = runS1b(m_testMode, m_testMode ? IntSize { context.width, context.height } : IntSize { 1920, 1080 });
+    while (glGetError() != GL_NO_ERROR) { }
+    if (!ok) {
+        fail("the S1b self-test failed");
+        return false;
+    }
+
+    m_stats.start = MonotonicTime::now();
+    {
+        Locker locker { m_lock };
+        m_state = State::Ready;
+        m_stateChanged.notifyAll();
+    }
+    WTFLogAlways("[wc] GPU compositor ready in %.1f ms%s", msSince(start), m_testMode ? " (test mode: synthetic scene for 20 s)" : ""); // NOLINT
+    if (hasPending())
+        context.requestFrame();
+    return true;
+}
+
+bool SceneHost::hasPending()
+{
+    Locker locker { m_lock };
+    return !m_queue.isEmpty();
+}
+
+WCScene& SceneHost::ensureScene(uint64_t pageID)
+{
+    auto& scene = m_scenes[pageID];
+    if (!scene) {
+        scene = makeUnique<WCScene>(Process::identifier(), false);
+        scene->initialize(*m_sceneContext);
+    }
+    return *scene;
+}
+
+void SceneHost::applyPending()
+{
+    Deque<Job> jobs;
+    {
+        Locker locker { m_lock };
+        jobs = std::exchange(m_queue, { });
+    }
+    for (auto& job : jobs) {
+        if (!job.info) {
+            m_scenes.erase(job.pageID);
+            m_lastUpdate.erase(job.pageID);
+            if (m_shownPage == job.pageID) {
+                // Show the most recently updated scene left, if any (an old
+                // drawing area can go after its successor's first update).
+                m_shownPage = std::nullopt;
+                uint64_t newest = 0;
+                for (auto& entry : m_lastUpdate) {
+                    if (entry.second > newest && m_scenes.count(entry.first) && m_scenes[entry.first]->hasRootLayer()) {
+                        newest = entry.second;
+                        m_shownPage = entry.first;
+                    }
+                }
+                if (!m_shownPage)
+                    m_surface = nullptr;
+            }
+        } else {
+            auto start = MonotonicTime::now();
+            auto& scene = ensureScene(job.pageID);
+            if (scene.apply(*job.info)) {
+                m_shownPage = job.pageID;
+                m_lastUpdate[job.pageID] = ++m_updateSerial;
+            }
+            job.info = nullptr; // tile bitmaps go now, on this thread
+            double ms = msSince(start);
+            m_stats.updates++;
+            m_stats.applyMS += ms;
+            m_stats.applyMaxMS = std::max(m_stats.applyMaxMS, ms);
+        }
+        m_dirty = true;
+        if (job.didPresent)
+            m_frameCompletions.append(WTF::move(job.didPresent));
+    }
+}
+
+unsigned SceneHost::paint(int64_t, int* width, int* height)
+{
+    *width = *height = 0;
+    if (!m_shownPage)
+        return 0;
+    auto it = m_scenes.find(*m_shownPage);
+    if (it == m_scenes.end() || !it->second->hasRootLayer())
+        return 0;
+    auto& scene = *it->second;
+    IntSize size = scene.viewport();
+    if (size.isEmpty())
+        return 0;
+    if (!m_surface || m_surface->size() != size) {
+        m_surface = BitmapTexture::create(size, { BitmapTexture::Flags::SupportsAlpha });
+        m_dirty = true;
+    }
+    if (m_dirty) {
+        auto start = MonotonicTime::now();
+        scene.paint(*m_surface);
+        m_dirty = false;
+        double ms = msSince(start);
+        m_stats.paints++;
+        m_stats.paintMS += ms;
+        m_stats.paintMaxMS = std::max(m_stats.paintMaxMS, ms);
+    }
+    *width = size.width();
+    *height = size.height();
+    return m_surface->id();
+}
+
+void SceneHost::didPresent()
+{
+    BitmapTextureUploaderPS5::singleton().frameDone();
+    if (!m_frameCompletions.isEmpty()) {
+        m_stats.presents++;
+        completeOnMainThread(std::exchange(m_frameCompletions, { }));
+    }
+    maybeLog();
+}
+
+void SceneHost::maybeLog()
+{
+    auto now = MonotonicTime::now();
+    double seconds = (now - m_stats.start).seconds();
+    if (seconds < 1)
+        return;
+    auto uploads = BitmapTextureUploaderPS5::singleton().takeStats();
+    if (m_stats.updates || m_stats.paints || uploads.uploads) {
+        unsigned layers = 0;
+        for (auto& entry : m_scenes)
+            layers += entry.second->layerCount();
+        auto programs = TextureMapperShaderProgram::compileStats();
+        WTFLogAlways("[wc] %.1f s: %u updates (apply %.2f ms avg, %.1f max), %u presents; %zu pages, %u layers; tiles uploaded %u (%u draws, %.1f MB, %.2f ms, %.3f ms per upload, %u fence waits, %u finishes); " // NOLINT
+            "%u paints (%.2f ms avg, %.1f max); GL textures %.1f MB; programs %u (%.0f ms, %u failed, GLSL %s)",
+            seconds, m_stats.updates, m_stats.updates ? m_stats.applyMS / m_stats.updates : 0.0, m_stats.applyMaxMS, m_stats.presents,
+            m_scenes.size(), layers, uploads.uploads, uploads.draws, uploads.bytes / 1048576.0, uploads.milliseconds,
+            uploads.uploads ? uploads.milliseconds / uploads.uploads : 0.0, uploads.fenceWaits, uploads.finishes,
+            m_stats.paints, m_stats.paints ? m_stats.paintMS / m_stats.paints : 0.0, m_stats.paintMaxMS,
+            BitmapTextureUploaderPS5::textureBytes() / 1048576.0, programs.programs, programs.milliseconds, programs.failures, programs.glslVersion);
+    }
+    auto start = now;
+    m_stats = { };
+    m_stats.start = start;
+}
