+// PS5Renderer::initialize(), possibly before WebKit is initialized (no
+// RunLoop yet): the test driver starts from the GLib main loop, 3 s in.
+PS5CompositorClient* ps5wkWCCompositorClient()
+{
+    auto& host = WebKit::SceneHost::singleton();
+    if (WebKit::testModeRequested()) {
+        g_timeout_add(3000, [](gpointer) -> gboolean {
+            WebKit::SceneHost::singleton().startTestDriver();
+            return G_SOURCE_REMOVE;
+        }, nullptr);
+    }
+    return &host;
