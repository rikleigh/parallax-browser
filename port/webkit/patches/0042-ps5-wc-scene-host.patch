+// ---- Test driver (main thread) ----
+
+void SceneHost::startTestDriver()
+{
+    if (!available()) {
+        WTFLogAlways("RESULT ps5browser wctest FAIL (compositor not available)"); // NOLINT
+        return;
+    }
+    m_testScene = std::make_unique<SyntheticScene>(IntSize { 1920, 1080 });
+    m_testStart = MonotonicTime::now();
+    m_testFrame = 0;
+    m_testCompleted = 0;
+    bool ok = false;
+    auto info = std::make_unique<WCUpdateInfo>(m_testScene->initial(&ok));
+    WTFLogAlways("[wc] test: synthetic scene started (%zu layers)", info->addedLayers.size()); // NOLINT
+
+    // As DrawingAreaWC: one update in flight, the next after its reply.
+    struct Driver {
+        static void sendNext(SceneHost& host)
+        {
+            double seconds = (MonotonicTime::now() - host.m_testStart).seconds();
+            if (seconds >= 20) {
+                WTFLogAlways("RESULT ps5browser wctest %s: %u updates presented in %.1f s (%.1f/s)", // NOLINT
+                    host.m_testCompleted > 600 ? "PASS" : "SLOW", host.m_testCompleted, seconds, host.m_testCompleted / seconds);
+                PS5WCHost::singleton().removePage(testPageID);
+                host.m_testScene = nullptr;
+                return;
+            }
+            auto next = std::make_unique<WCUpdateInfo>(host.m_testScene->next(++host.m_testFrame));
+            host.enqueue(testPageID, WTF::move(next), [&host] {
+                host.m_testCompleted++;
+                sendNext(host);
+            });
+        }
+    };
+    enqueue(testPageID, WTF::move(info), [this] {
+        m_testCompleted++;
+        Driver::sendNext(*this);
+    });
+}
