 namespace WebCore {
 
+#if defined(PS5_PAYLOAD_SDK)
+// "[render] image decodes" (every 5 s while images are decoded): frames decoded
+// synchronously on the main thread (in painting), asynchronous requests and
+// their results, and large decoded frames destroyed (memory cache pruning).
+enum class PS5DecodeEvent : uint8_t { Synchronous, AsyncRequest, AsyncDone, AsyncFailed, LargeFramesDestroyed, MetadataSkipped };
+static void ps5NoteImageDecode(PS5DecodeEvent event, bool large, double milliseconds = 0)
+{
+    static MonotonicTime windowStart;
+    static unsigned syncCount, largeCount, asyncCount, asyncDone, asyncFailed, destroyed, metadataSkipped;
+    static double syncMS, largeMS, maxMS;
+    auto now = MonotonicTime::now();
+    if (!windowStart)
+        windowStart = now;
+    switch (event) {
+    case PS5DecodeEvent::Synchronous:
+        syncCount++;
+        syncMS += milliseconds;
+        maxMS = std::max(maxMS, milliseconds);
+        if (large) {
+            largeCount++;
+            largeMS += milliseconds;
+        }
+        break;
+    case PS5DecodeEvent::AsyncRequest:
+        asyncCount++;
+        break;
+    case PS5DecodeEvent::AsyncDone:
+        asyncDone++;
+        break;
+    case PS5DecodeEvent::AsyncFailed:
+        asyncFailed++;
+        break;
+    case PS5DecodeEvent::LargeFramesDestroyed:
+        destroyed++;
+        break;
+    case PS5DecodeEvent::MetadataSkipped:
+        metadataSkipped++;
+        break;
+    }
+    if (now - windowStart < 5_s)
+        return;
+    WTFLogAlways("[render] image decodes: %u on the main thread (%.1f ms, max %.1f; %u large images %.1f ms), %u asynchronous requests (%u done, %u failed), %u large images' frames destroyed, %u metadata reads skipped while decoding, in %.1f s", // NOLINT
+        syncCount, syncMS, maxMS, largeCount, largeMS, asyncCount, asyncDone, asyncFailed, destroyed, metadataSkipped, (now - windowStart).seconds());
+    windowStart = now;
+    syncCount = largeCount = asyncCount = asyncDone = asyncFailed = destroyed = metadataSkipped = 0;
+    syncMS = largeMS = maxMS = 0;
+}
+#endif
