+// GL textures (a ~1 s average): logged above 128 MB; above the 160 MB cap the page keeps
+// tiles for the visible rect only (no margin, no whole-layer tiling of
+// animated layers), and back to normal once under 96 MB for 20 s; still over
+// the cap 5 s after that (or over 240 MB at any time), the page goes to the
+// CPU path in a new WebProcess. /data/ps5webkit/wc-gl-cap (MB, read once)
+// moves the cap (the other limits follow it); 0 = no cap.
+void SceneHost::checkGLMemory()
+{
+    static const double capMB = [] {
+        double mb = 160;
+        if (FILE* file = fopen("/data/ps5webkit/wc-gl-cap", "r")) {
+            if (fscanf(file, "%lf", &mb) != 1)
+                mb = 160;
+            fclose(file);
+            WTFLogAlways("[wc] GL texture cap %.0f MB (/data/ps5webkit/wc-gl-cap)", mb); // NOLINT
+        }
+        return mb;
+    }();
+    if (capMB <= 0)
+        return;
+    const double logMB = capMB * 0.8, restoreMB = capMB * 0.6, emergencyMB = capMB * 1.5;
+    double frameMB = BitmapTextureUploaderPS5::textureBytes() / 1048576.0;
+    auto now = MonotonicTime::now();
+    if (m_glPage != m_shownPage) {
+        // Another page shown (or a new drawing area after a restart): its own state.
+        m_glPage = m_shownPage;
+        m_glState = GLMemoryState::Normal;
+        m_glPeakMB = 0;
+        m_glSmoothedMB = frameMB;
+    }
+    m_glPeakMB = std::max(m_glPeakMB, frameMB);
+    // The texture pool's intermediate surfaces come and go within frames
+    // (wcfeed.html: 49-101 MB from one second to the next): decisions go by
+    // a ~1 s average (per presented frame), logs show both.
+    m_glSmoothedMB += (frameMB - m_glSmoothedMB) * 0.02;
+    double mb = m_glSmoothedMB;
+    if (mb > logMB && (!m_glOverLogCount || now - m_glLoggedAt >= 30_s)) {
+        unsigned layers = 0;
+        for (auto& entry : m_scenes)
+            layers += entry.second->layerCount();
+        WTFLogAlways("[wc] GL textures %.1f MB (%.1f this frame), over %.0f MB (cap %.0f MB, %s; %u layers in %zu scenes; peak %.1f MB)", mb, frameMB, logMB, capMB, // NOLINT
+            m_glState == GLMemoryState::Normal ? "normal coverage" : m_glState == GLMemoryState::Reduced ? "coverage reduced" : "CPU fallback asked",
+            layers, m_scenes.size(), m_glPeakMB);
+        m_glLoggedAt = now;
+        m_glOverLogCount++;
+    }
+    if (!m_shownPage || m_glState == GLMemoryState::Fallback)
+        return;
+    uint64_t page = *m_shownPage;
+    auto post = [page](DrawingAreaProxyWCPS5::GLMemoryAction action) {
+        RunLoop::mainSingleton().dispatch([page, action] {
+            DrawingAreaProxyWCPS5::glMemoryAction(page, action);
+        });
+    };
+    if (m_glState == GLMemoryState::Normal && mb > capMB) {
+        WTFLogAlways("[wc] GL textures %.1f MB over the %.0f MB cap: tiles for the visible rect only", mb, capMB); // NOLINT
+        m_glState = GLMemoryState::Reduced;
+        m_glReducedAt = now;
+        m_glUnderSince = { };
+        post(DrawingAreaProxyWCPS5::GLMemoryAction::ReduceCoverage);
+    }
+    if (m_glState == GLMemoryState::Reduced) {
+        if ((mb > capMB && now - m_glReducedAt >= 5_s) || mb > emergencyMB) {
+            WTFLogAlways("[wc] GL textures %.1f MB still over the %.0f MB cap %.1f s after reducing coverage: this page goes to the CPU path", mb, capMB, // NOLINT
+                (now - m_glReducedAt).seconds());
+            m_glState = GLMemoryState::Fallback;
+            post(DrawingAreaProxyWCPS5::GLMemoryAction::CPUFallback);
+        } else if (mb < restoreMB) {
+            if (!m_glUnderSince)
+                m_glUnderSince = now;
+            else if (now - m_glUnderSince >= 20_s) {
+                WTFLogAlways("[wc] GL textures %.1f MB, under %.0f MB for 20 s: normal tile coverage again", mb, restoreMB); // NOLINT
+                m_glState = GLMemoryState::Normal;
+                post(DrawingAreaProxyWCPS5::GLMemoryAction::RestoreCoverage);
+            }
+        } else
+            m_glUnderSince = { };
+    }
+}
