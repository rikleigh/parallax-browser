+void DrawingAreaProxyWCPS5::glMemoryAction(uint64_t sceneID, GLMemoryAction action)
+{
+    auto* drawingArea = liveDrawingAreas().get(sceneID);
+    if (!drawingArea)
+        return; // gone meanwhile (restarted or closed)
+    RefPtr page = drawingArea->page();
+    switch (action) {
+    case GLMemoryAction::ReduceCoverage:
+    case GLMemoryAction::RestoreCoverage:
+        drawingArea->send(Messages::DrawingArea::SetTileCoverageReducedWC(action == GLMemoryAction::ReduceCoverage));
+        break;
+    case GLMemoryAction::CPUFallback:
+        if (!page)
+            return;
+        // A new WebProcess that paints on the CPU; the embedder reloads the
+        // page when its process ends (web-process-terminated), as after a crash.
+        WTFLogAlways("[wc] page %llu: ending its WebProcess, the page reloads on the CPU path", // NOLINT
+            static_cast<unsigned long long>(page->identifier().toUInt64()));
+        s_cpuFallbackForNextProcess = true;
+        protect(page->legacyMainFrameProcess())->requestTermination(ProcessTerminationReason::RequestedByClient);
+        break;
+    }
 }
 
