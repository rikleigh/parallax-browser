+#if USE(DAWN)
+bool RemoteQueueProxy::ps5ReadVideoStreamFrame(uint64_t streamKey, Vector<uint8_t>& rgba, uint32_t& width, uint32_t& height)
+{
+    auto sendResult = sendSync(Messages::RemoteQueue::ReadVideoStreamFramePS5(streamKey));
+    if (!sendResult.succeeded())
+        return false;
+    auto [handle, frameWidth, frameHeight] = sendResult.takeReply();
+    if (!handle || !frameWidth || !frameHeight)
+        return false;
+    RefPtr memory = WebCore::SharedMemory::map(WTF::move(*handle), WebCore::SharedMemory::Protection::ReadOnly);
+    auto byteCount = CheckedSize { frameWidth } * static_cast<size_t>(frameHeight) * static_cast<size_t>(4);
+    if (!memory || byteCount.hasOverflowed() || memory->size() < byteCount.value())
+        return false;
+    rgba = memory->span().first(byteCount.value());
+    width = frameWidth;
+    height = frameHeight;
+    return true;
+}
+#endif
