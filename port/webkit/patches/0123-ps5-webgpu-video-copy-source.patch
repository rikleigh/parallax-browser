diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUVideoRead.cpp b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUVideoRead.cpp
new file mode 100644
index 0000000000..2b6f868687
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGPUVideoRead.cpp
@@ -0,0 +1,122 @@
+/*
+ * PS5: a video stream's current frame as pixels, for WebGPU (spikes/12-webgpu).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ */
+
+#include "config.h"
+#include "PS5WebGLLayers.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(DAWN) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/GLContext.h>
+#include <WebCore/PlatformDisplay.h>
+#include <epoxy/egl.h>
+#include <epoxy/gl.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/NeverDestroyed.h>
+
+// The title's GPU submission lock (port/webkit/apps/title/titleradv.c): this is GL work on
+// Dawn's thread.
+extern "C" void ps5wk_gpu_submit_lock(void) __attribute__((weak));
+extern "C" int ps5wk_gpu_submit_unlock(void) __attribute__((weak));
+
+namespace WebKit {
+namespace PS5WebGLLayers {
+
+namespace {
+
+// RemoteGPU's work queue only: a native ES context of the compositor's share group, current
+// there for the length of a read, and the texture the title's frame is copied into.
+struct Reader {
+    std::unique_ptr<WebCore::GLContext> context;
+    bool failed { false };
+    GLuint texture { 0 };
+    GLuint framebuffer { 0 };
+    int width { 0 };
+    int height { 0 };
+    unsigned reads { 0 };
+};
+
+Reader& reader()
+{
+    static NeverDestroyed<Reader> instance;
+    return instance;
+}
+
+} // namespace
+
+bool readVideoFramePixels(uint64_t key, Vector<uint8_t>& rgba, uint32_t& width, uint32_t& height)
+{
+    auto copy = copyVideoFrameFunction();
+    auto frameSize = videoFrameSizeFunction();
+    int frameWidth = 0, frameHeight = 0;
+    if (!key || !copy || !frameSize || !frameSize(key, &frameWidth, &frameHeight))
+        return false;
+    if (frameWidth <= 0 || frameHeight <= 0 || frameWidth > 8192 || frameHeight > 8192)
+        return false;
+
+    auto& state = reader();
+    if (!state.context && !state.failed) {
+        bindESAPI();
+        auto& display = WebCore::PlatformDisplay::sharedDisplay();
+        state.context = WebCore::GLContext::create(display.glDisplay(), WebCore::GLContext::Target::Surfaceless, display.sharingGLContext());
+        state.failed = !state.context;
+        WTFLogAlways("[webgpu] title: video read context %s", state.failed ? "could not be made: video sources stay black" : "ready");
+    }
+    if (!state.context)
+        return false;
+
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (ps5wk_gpu_submit_lock)
+        ps5wk_gpu_submit_lock();
+    bool ok = false;
+    auto start = MonotonicTime::now();
+    bindESAPI();
+    if (eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, static_cast<EGLContext>(state.context->platformContext()))) {
+        if (!state.texture || state.width != frameWidth || state.height != frameHeight) {
+            if (state.texture)
+                glDeleteTextures(1, &state.texture);
+            if (!state.framebuffer)
+                glGenFramebuffers(1, &state.framebuffer);
+            glGenTextures(1, &state.texture);
+            glBindTexture(GL_TEXTURE_2D, state.texture);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, frameWidth, frameHeight, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glBindTexture(GL_TEXTURE_2D, 0);
+            state.width = frameWidth;
+            state.height = frameHeight;
+        }
+        // Row 0 of the copy is the picture's top (flipY false), and so is the first row read.
+        if (void* done = copy(key, state.texture, false)) {
+            glDeleteSync(static_cast<GLsync>(done));
+            const size_t bytes = static_cast<size_t>(frameWidth) * frameHeight * 4;
+            if (rgba.tryGrow(bytes)) {
+                glBindFramebuffer(GL_FRAMEBUFFER, state.framebuffer);
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, state.texture, 0);
+                glPixelStorei(GL_PACK_ALIGNMENT, 4);
+                glReadPixels(0, 0, frameWidth, frameHeight, GL_RGBA, GL_UNSIGNED_BYTE, rgba.mutableSpan().data());
+                glBindFramebuffer(GL_FRAMEBUFFER, 0);
+                ok = glGetError() == GL_NO_ERROR;
+            }
+        }
+        glFlush();
+        eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+    if (ps5wk_gpu_submit_unlock)
+        ps5wk_gpu_submit_unlock();
+
+    if (ok) {
+        width = frameWidth;
+        height = frameHeight;
+        if (!state.reads++ || !(state.reads % 600))
+            WTFLogAlways("[webgpu] title: video frame %dx%d read for a WebGPU texture in %.2f ms (%u reads)", frameWidth, frameHeight, (MonotonicTime::now() - start).milliseconds(), state.reads);
+    } else if (!state.reads++)
+        WTFLogAlways("[webgpu] title: video frame %dx%d could not be read", frameWidth, frameHeight);
+    return ok;
+}
+
+} // namespace PS5WebGLLayers
+} // namespace WebKit
+
+#endif
