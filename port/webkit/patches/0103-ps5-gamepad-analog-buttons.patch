+/**
+ * wpe_gamepad_button_value_event:
+ * @gamepad: a #WPEGamepad
+ * @button: a #WPEGamepadButton
+ * @value: how far @button is pressed, 0 to 1
+ *
+ * Emit the signal #WPEGamepad::button-value-event (an analog button).
+ */
+void wpe_gamepad_button_value_event(WPEGamepad* gamepad, WPEGamepadButton button, gdouble value)
+{
+    g_return_if_fail(WPE_IS_GAMEPAD(gamepad));
+    g_return_if_fail(value >= 0. && value <= 1.);
+
+    g_signal_emit(gamepad, signals[BUTTON_VALUE_EVENT], 0, button, value);
+}
