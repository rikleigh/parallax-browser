+void PlatformGamepadWPE::buttonValueEvent(size_t button, double value)
+{
+    m_lastUpdateTime = MonotonicTime::now();
+    bool wasPressed = m_buttonValues[button].value() > 0.1;
+    m_buttonValues[button].setValue(value);
+    // A press (crossing GamepadButton's "pressed" threshold) makes the
+    // gamepads visible to pages, as a digital button's does.
+    bool pressed = value > 0.1;
+    GamepadProviderWPE::singleton().notifyInput(*this, pressed && !wasPressed ? GamepadProviderWPE::ShouldMakeGamepadsVisible::Yes : GamepadProviderWPE::ShouldMakeGamepadsVisible::No);
+}
