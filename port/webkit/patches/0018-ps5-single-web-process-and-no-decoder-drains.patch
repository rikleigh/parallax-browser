@@ -439,11 +439,29 @@ static void webkitWebContextConstructed(GObject* object)
 
     Ref configuration = API::ProcessPoolConfiguration::create();
     configuration->setInjectedBundlePath(FileSystem::stringFromFileSystemRepresentation(bundleFilename.utf8()));
+#if defined(PS5_PAYLOAD_SDK)
+    // PS5: every WebProcess is an elfldr payload (a 114 MB upload) costing
+    // ~300 of the system's 8192 CPU page tables. With process swaps, the
+    // WebProcess cache and prewarming, YouTube browsing kept several alive
+    // until elfldr could not spawn any more and allocations failed
+    // (2026-10-28). One WebProcess serves every navigation;
+    // PS5WK_PROCESS_SWAPS=1 restores upstream behaviour.
+    if (!g_strcmp0(g_getenv("PS5WK_PROCESS_SWAPS"), "1")) {
+        configuration->setUsesWebProcessCache(true);
+        configuration->setProcessSwapsOnNavigation(true);
+    } else {
+        configuration->setUsesSingleWebProcess(true);
+        configuration->setUsesWebProcessCache(false);
+        configuration->setProcessSwapsOnNavigation(false);
+        configuration->setIsAutomaticProcessWarmingEnabled(false);
+    }
+#else
     configuration->setUsesWebProcessCache(true);
 #if PLATFORM(GTK) && !USE(GTK4)
     configuration->setProcessSwapsOnNavigation(priv->psonEnabled);
 #else
     configuration->setProcessSwapsOnNavigation(true);
+#endif
 #endif
     if (priv->memoryPressureSettings) {
         configuration->setMemoryPressureHandlerConfiguration(webkitMemoryPressureSettingsGetMemoryPressureHandlerConfiguration(priv->memoryPressureSettings));
