+
 namespace IPC {
 
+#if defined(PS5_PAYLOAD_SDK)
+// The browser title's stall report (apps/title/ps5browser.c, ps5wk_stream_threads_report): which
+// stream message each work queue thread (WebGL's, WebGPU's) is in, and since when.
+namespace {
+struct PS5StreamThread {
+    std::atomic<uintptr_t> thread { 0 };
+    std::atomic<uint16_t> message { 0 };
+    std::atomic<double> since { 0 };
+    std::atomic<uint16_t> lastMessage { 0 };
+    std::atomic<double> lastEnd { 0 };
+};
+PS5StreamThread s_ps5StreamThreads[4];
+std::atomic<unsigned> s_ps5StreamThreadCount;
+
+PS5StreamThread* ps5StreamThread()
+{
+    static thread_local int slot = -1;
+    if (slot < 0) {
+        unsigned index = s_ps5StreamThreadCount.fetch_add(1);
+        if (index >= std::size(s_ps5StreamThreads))
+            return nullptr;
+        slot = static_cast<int>(index);
+        s_ps5StreamThreads[slot].thread = reinterpret_cast<uintptr_t>(pthread_self());
+    }
+    return &s_ps5StreamThreads[slot];
+}
+}
+#endif
