     s_ps5InTitleWebProcessConnection = this;
 }
 
+// StreamClientConnectionBuffer::tryAcquireAll: WebGL's and WebGPU's sync calls wait for their
+// reply there, on a semaphore, not in waitForSyncReply. From the in-title WebProcess on the title's
+// main thread that wait must still dispatch the main run loop's queued UI and GPU side messages (as
+// waitForMessage does above), or a reply that needs one of them only comes with the 15 s timeout,
+// with the whole browser frozen (2026-11-16: GetErrors, twice).
+bool ps5InTitleMainThreadWaits()
+{
+    return s_ps5InTitleWebProcessConnection.load() && RunLoop::isMain();
+}
+
+unsigned ps5DispatchMainRunLoopMessagesWhileWaiting(MessageName* first)
+{
+    return Connection::ps5DispatchMainRunLoopMessages(first);
+}
+
+unsigned Connection::ps5DispatchMainRunLoopMessages(MessageName* first)
+{
+    static NeverDestroyed<RefPtr<SyncMessageState>> mainState = SyncMessageState::getOrCreate(RunLoop::mainSingleton()).ptr();
+    unsigned count = 0;
+    RefPtr { mainState.get() }->dispatchMessages([&](MessageName name, uint64_t) {
+        if (!count++ && first)
+            *first = name;
+    });
+    return count;
+}
+
+// What the title's main thread waits for in a stream sync call (the stall report).
+static std::atomic<uint16_t> s_ps5MainThreadStreamWait;
+static std::atomic<double> s_ps5MainThreadStreamWaitSince;
+
+void ps5NoteMainThreadStreamWait(MessageName name, bool waiting)
+{
+    if (!ps5InTitleMainThreadWaits())
+        return;
+    s_ps5MainThreadStreamWaitSince = waiting ? MonotonicTime::now().secondsSinceEpoch().value() : 0;
+    s_ps5MainThreadStreamWait = waiting ? static_cast<uint16_t>(name) : 0;
+}
+
 bool Connection::ps5HasInTitleWebProcess()
 {
     return !!s_ps5InTitleWebProcessConnection.load();
 }
 
+} // namespace IPC
+
+// apps/title/ps5browser.c's stall report: the stream sync call the title's main thread waits in.
+extern "C" size_t ps5wk_main_thread_stream_wait(char* out, size_t size)
+{
+    double since = IPC::s_ps5MainThreadStreamWaitSince.load();
+    uint16_t name = IPC::s_ps5MainThreadStreamWait.load();
+    if (!size)
+        return 0;
+    int n = since > 0 && name
+        ? snprintf(out, size, "the main thread waits for the reply to %s (%.1f s)", IPC::description(static_cast<IPC::MessageName>(name)).characters(), MonotonicTime::now().secondsSinceEpoch().value() - since)
+        : snprintf(out, size, "the main thread is not in a WebGL/WebGPU sync call");
+    return n < 0 ? 0 : std::min<size_t>(static_cast<size_t>(n), size - 1);
+}
