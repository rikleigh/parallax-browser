+#if defined(PS5_PAYLOAD_SDK)
+extern "C" size_t ps5wk_stream_threads_report(char* out, size_t size)
+{
+    if (!size)
+        return 0;
+    size_t used = 0;
+    out[0] = 0;
+    double now = MonotonicTime::now().secondsSinceEpoch().value();
+    unsigned count = std::min<unsigned>(IPC::s_ps5StreamThreadCount.load(), std::size(IPC::s_ps5StreamThreads));
+    for (unsigned i = 0; i < count && used + 1 < size; i++) {
+        auto& t = IPC::s_ps5StreamThreads[i];
+        uint16_t message = t.message.load();
+        uint16_t last = t.lastMessage.load();
+        int n = message
+            ? snprintf(out + used, size - used, "%sstream thread %#lx: in %s for %.1f s", used ? "; " : "", static_cast<unsigned long>(t.thread.load()),
+                IPC::description(static_cast<IPC::MessageName>(message)).characters(), now - t.since.load())
+            : snprintf(out + used, size - used, "%sstream thread %#lx: idle for %.1f s (last %s)", used ? "; " : "", static_cast<unsigned long>(t.thread.load()),
+                t.lastEnd.load() > 0 ? now - t.lastEnd.load() : 0.0, last ? IPC::description(static_cast<IPC::MessageName>(last)).characters() : "none");
+        if (n < 0)
+            break;
+        used = std::min(size - 1, used + static_cast<size_t>(n));
+    }
+    if (!count)
+        used = static_cast<size_t>(std::max(0, snprintf(out, size, "no stream threads yet")));
+    return std::min(used, size - 1);
+}
+#endif
