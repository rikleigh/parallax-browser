@@ -34,8 +34,42 @@
 #include <mutex>
 #include <wtf/NeverDestroyed.h>
 
+#if defined(PS5_PAYLOAD_SDK)
+#include <pthread.h>
+#include <wtf/MonotonicTime.h>
