diff --git a/Source/WebCore/platform/graphics/gstreamer/GStreamerCommon.cpp b/Source/WebCore/platform/graphics/gstreamer/GStreamerCommon.cpp
index 290806b4fb..d6e2839cfd 100644
--- a/Source/WebCore/platform/graphics/gstreamer/GStreamerCommon.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/GStreamerCommon.cpp
@@ -606,6 +606,15 @@ void registerWebKitGStreamerElements()
         if (gst_check_version(1, 22, 0)) {
             std::array<ASCIILiteral, 3> elementNames = { "dashdemux2"_s, "hlsdemux2"_s, "mssdemux2"_s };
             for (auto& elementName : elementNames) {
+#if defined(PS5_PAYLOAD_SDK)
+                // PS5: the WebProcess is a payload with its own networking (libsoup and the
+                // NetworkProcess's TLS setup), so hlsdemux2 can download by itself. It is the
+                // only HLS demuxer playbin3 takes (urisourcebin wants a streams-aware one; the
+                // legacy hlsdemux fails there). It gets the User-Agent and Referer from
+                // webkitwebsrc's http-headers event, not the cookies.
+                if (elementName == "hlsdemux2"_s && hlsSupport == "1"_s)
+                    continue;
+#endif
                 if (GRefPtr factory = adoptGRef(gst_element_factory_find(elementName)))
                     gst_plugin_feature_set_rank(GST_PLUGIN_FEATURE_CAST(factory.get()), GST_RANK_NONE);
             }
