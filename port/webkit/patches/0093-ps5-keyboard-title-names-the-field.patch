@@ -231,6 +234,24 @@ static std::optional<InputMethodState> inputMethodStateForElement(Element* eleme
     if (element->isSpellCheckingEnabled())
         state.hints.add(InputMethodState::Hint::Spellcheck);
 
+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+    // PS5: the system keyboard covers much of the screen, so its title says
+    // which field it types into: the field's <label>, else its aria-label,
+    // else its placeholder (no value, so nothing typed).
+    if (RefPtr htmlElement = dynamicDowncast<HTMLElement>(*element)) {
+        auto clean = [](const String& text) {
+            auto simplified = text.trim(isASCIIWhitespace).simplifyWhiteSpace(isASCIIWhitespace);
+            return simplified.length() > 60 ? makeString(StringView(simplified).left(59), u'\u2026') : simplified;
+        };
+        if (RefPtr labels = htmlElement->labels(); labels && labels->length())
+            state.label = clean(protect(labels->item(0))->textContent());
+        if (state.label.isEmpty())
+            state.label = clean(htmlElement->attributeWithoutSynchronization(HTMLNames::aria_labelAttr));
+        if (state.label.isEmpty())
+            state.label = clean(htmlElement->attributeWithoutSynchronization(HTMLNames::placeholderAttr));
+    }
+#endif
+
     return state;
 }
 
