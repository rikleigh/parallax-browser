diff --git a/Source/WebKit/UIProcess/API/glib/InputMethodFilter.cpp b/Source/WebKit/UIProcess/API/glib/InputMethodFilter.cpp
index 213dea8b44..a6a57e9033 100644
--- a/Source/WebKit/UIProcess/API/glib/InputMethodFilter.cpp
+++ b/Source/WebKit/UIProcess/API/glib/InputMethodFilter.cpp
@@ -202,6 +202,14 @@ void InputMethodFilter::notifyContentType()
     g_object_freeze_notify(G_OBJECT(m_context.get()));
     webkit_input_method_context_set_input_purpose(m_context.get(), toWebKitPurpose(m_state->purpose));
     webkit_input_method_context_set_input_hints(m_context.get(), toWebKitHints(m_state->hints));
+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+    // PS5: the field's label for the on-screen keyboard's title, passed on to
+    // the platform context with the hints (WebKitInputMethodContextImplWPE).
+    auto labelUTF8 = m_state->label.utf8();
+    auto labelBytes = byteCast<char>(labelUTF8.span());
+    g_object_set_data_full(G_OBJECT(m_context.get()), "ps5-field-label", g_strndup(labelBytes.data(), labelBytes.size()), g_free);
+    g_object_notify(G_OBJECT(m_context.get()), "input-hints");
+#endif
     g_object_thaw_notify(G_OBJECT(m_context.get()));
 }
 
diff --git a/Source/WebKit/UIProcess/API/wpe/WebKitInputMethodContextImplWPE.cpp b/Source/WebKit/UIProcess/API/wpe/WebKitInputMethodContextImplWPE.cpp
