 static void inputHintsChangedCallback(WebKitInputMethodContextImplWPE* context)
 {
+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+    // PS5: the field's label (InputMethodFilter::notifyContentType).
+    auto* label = static_cast<const char*>(g_object_get_data(G_OBJECT(context), "ps5-field-label"));
+    g_object_set_data_full(G_OBJECT(context->priv->context.get()), "ps5-field-label", g_strdup(label ? label : ""), g_free);
+#endif
     wpe_input_method_context_set_input_hints(context->priv->context.get(), toWPEInputHints(webkit_input_method_context_get_input_hints(WEBKIT_INPUT_METHOD_CONTEXT(context))));
 }
 
