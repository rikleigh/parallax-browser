+// The current context's extensions as one space-separated list. Core profiles
+// (desktop GL 3.2+, e.g. the PS5's GL 4.6) have no GL_EXTENSIONS string:
+// glGetString(GL_EXTENSIONS) is an error there and returns null.
+static std::string currentGLExtensionsString()
+{
+    if (auto* extensions = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS)))
+        return extensions;
+    std::string result;
+#if USE(LIBEPOXY)
+    glGetError(); // GL_INVALID_ENUM from the query above.
+    GLint count = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    for (GLint i = 0; i < count; ++i) {
+        if (auto* extension = reinterpret_cast<const char*>(glGetStringi(GL_EXTENSIONS, i))) {
+            if (!result.empty())
+                result += ' ';
+            result += extension;
+        }
+    }
+#endif
+    return result;
+}
