+
+void DrawingAreaProxyWCPS5::sendPendingDOMWheelEventIfPaced()
+{
+    if (m_domWheelEventInFlight || !m_pendingDOMWheelEvent)
+        return;
+    if (m_paceDOMWheelEvents && m_updatesReceived == m_updatesAtDOMWheelSend) {
+        auto wait = 250_ms - (MonotonicTime::now() - m_domWheelSentAt);
+        if (wait > 0_s) {
+            // updateWC sends it when the update comes; the timer if none does.
+            if (!m_domWheelPaceTimer) {
+                m_domWheelPaceTimer = makeUnique<RunLoop::Timer>(RunLoop::mainSingleton(), "DrawingAreaProxyWCPS5::domWheelPace"_s, [this] { // owned by this
+                    m_updatesAtDOMWheelSend = m_updatesReceived - 1; // waited long enough
+                    sendPendingDOMWheelEventIfPaced();
+                });
+            }
+            if (!m_domWheelPaceTimer->isActive()) {
+                m_domWheelStats.heldForUpdate++;
+                m_domWheelPaceTimer->startOneShot(wait);
+            }
+            return;
+        }
+    }
+    if (m_domWheelPaceTimer)
+        m_domWheelPaceTimer->stop();
+    dispatchWheelEventToDOM(std::exchange(m_pendingDOMWheelEvent, nullptr).releaseNonNull());
+}
+
+void DrawingAreaProxyWCPS5::logDOMWheelStats()
+{
+    auto now = MonotonicTime::now();
+    auto& stats = m_domWheelStats;
+    if (!stats.windowStart)
+        stats.windowStart = now;
+    if (now - stats.windowStart < 5_s)
+        return;
+    if (stats.sent) {
+        WTFLogAlways("[ascroll] DOM wheel events: %u sent in %.1f s (round trip %.1f ms avg, %.1f max), %u replaced by a newer one, %u held for a WebProcess update%s; %u events the root couldn't take not sent (the WebProcess had nothing to scroll that way)", // NOLINT
+            stats.sent, (now - stats.windowStart).seconds(), stats.roundTripMS / stats.sent, stats.roundTripMaxMS, stats.replaced, stats.heldForUpdate,
+            m_paceDOMWheelEvents ? "" : " (wheelpace=0: not paced)", m_unconsumedDropped);
+        m_unconsumedDropped = 0;
+    }
+    stats = { };
+    stats.windowStart = now;
+}
 #endif
 
