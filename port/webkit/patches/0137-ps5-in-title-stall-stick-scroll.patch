     PS5WCHost::requestFrame();
 }
 
+bool PS5WCScrollingTree::queueStallStickScroll(FloatSize delta)
+{
+    std::optional<PlatformWheelEvent> event;
+    {
+        Locker locker { m_stickLock };
+        if (!m_frameLockedStick || !m_stickEvent || (MonotonicTime::now() - m_stickLastEvent).seconds() > 1)
+            return false;
+        event = m_stickEvent->copyWithDeltaAndVelocity(delta, m_stickVelocity);
+    }
+    queueFrameLockedScroll(*event);
+    return true;
+}
