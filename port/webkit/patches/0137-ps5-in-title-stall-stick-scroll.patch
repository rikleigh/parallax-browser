+// The scene whose tree the stick scrolled last (frame-locked), for
+// ps5wk_title_stall_scroll; 0: none (it went away or was hidden).
+static std::atomic<uint64_t> s_stallStickScene { 0 };
+
+// Pages in the title run their scripts, style and layout on the title's
+// main thread, which also reads the pad: while a page keeps it busy (a feed
+// adding posts: 0.3-1.2 s), no stick event reaches the tree and the page
+// stopped dead, where a page in a payload kept scrolling into what was
+// already painted. The pad's helper thread (wpe-ps5 WPEDisplayPS5.cpp)
+// calls this instead while the main thread is stuck: the stick's delta as
+// the WPE scroll event would carry it (precise, mouse: x 2.5 in
+// WebEventFactory), queued for the render thread like a main-thread one
+// (clamped at the painted edge there). Any thread. False if nothing took it.
+extern "C" __attribute__((visibility("default"))) bool ps5wk_title_stall_scroll(double wpeDeltaX, double wpeDeltaY)
+{
+    uint64_t sceneID = s_stallStickScene.load();
+    if (!sceneID)
+        return false;
+    RefPtr<PS5WCScrollingTree> tree;
+    {
+        Locker locker { scrollingTreesLock() };
+        auto it = scrollingTrees().find(sceneID);
+        if (it == scrollingTrees().end())
+            return false;
+        tree = it->value.ptr();
+    }
+    return tree->queueStallStickScroll(WebCore::FloatSize(wpeDeltaX * 2.5, wpeDeltaY * 2.5));
+}
