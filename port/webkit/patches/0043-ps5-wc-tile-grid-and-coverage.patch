 void WCTileGrid::Tile::addDirtyRect(const WebCore::IntRect& dirtyRect)
 {
     WebCore::IntRect rect { dirtyRect };
     rect.intersect(m_tileRect);
+    if (rect.isEmpty())
+        return;
+    if (m_dirtyRect.contains(rect) && m_dirtyRects.size() <= 1)
+        return;
     m_dirtyRect.unite(rect);
+    if (m_dirtyRects.size() > maxDirtyRects)
+        return; // too many: the bounds are painted
+    // Merge with a part it touches or overlaps; keep separate otherwise.
+    for (auto& part : m_dirtyRects) {
+        if (part.contains(rect))
+            return;
+        WebCore::IntRect inflated = part;
+        inflated.inflate(1);
+        if (inflated.intersects(rect)) {
+            part.unite(rect);
+            return;
+        }
+    }
+    m_dirtyRects.append(rect);
+}
+
+Vector<WebCore::IntRect, 1> WCTileGrid::Tile::rectsToPaint() const
+{
+    if (m_dirtyRects.size() <= 1 || m_dirtyRects.size() > maxDirtyRects)
+        return { m_dirtyRect };
+    uint64_t partsArea = 0;
+    for (auto& part : m_dirtyRects)
+        partsArea += static_cast<uint64_t>(part.width()) * part.height();
+    uint64_t boundsArea = static_cast<uint64_t>(m_dirtyRect.width()) * m_dirtyRect.height();
+    // Parts may overlap after merging; paint them separately only when that
+    // saves at least half of the bounding rect.
+    if (partsArea * 2 > boundsArea)
+        return { m_dirtyRect };
+    Vector<WebCore::IntRect, 1> rects;
+    for (auto& part : m_dirtyRects)
+        rects.append(part);
+    return rects;
 }
 
