+// texImage2D(video) for a hardware-decoded video (M3): the title's newest
+// converted frame of the stream, copied into the texture on the GPU.
+void RemoteGraphicsContextGL::copyTextureFromVideoStreamPS5(uint64_t streamKey, PlatformGLObject texture, bool flipY)
+{
+    assertIsCurrent(workQueue());
+    // The page's name for the texture (the WebProcess makes its own names).
+    if (!texture || !m_objectNames.isValidKey(texture) || !m_objectNames.contains(texture))
+        return;
+    texture = m_objectNames.get(texture);
+    RefPtr context = m_context;
+    auto frameSize = PS5WebGLLayers::videoFrameSizeFunction();
+    int width = 0, height = 0;
+    if (!context || !frameSize || !frameSize(streamKey, &width, &height))
+        return; // no frame yet: the texture keeps what it had
+    // Each GraphicsContextGL call below makes the context current (the ANGLE
+    // call and the native copy need it).
+    using GL = WebCore::GraphicsContextGL;
+    const bool webGL2 = context->contextAttributes().isWebGL2;
+    PlatformGLObject boundTexture = context->getInteger(GL::TEXTURE_BINDING_2D);
+    PlatformGLObject unpackBuffer = webGL2 ? context->getInteger(GL::PIXEL_UNPACK_BUFFER_BINDING) : 0;
+    if (unpackBuffer)
+        context->bindBuffer(GL::PIXEL_UNPACK_BUFFER, 0);
+    context->bindTexture(GL::TEXTURE_2D, texture);
+    unsigned nativeTexture = ANGLE_PS5PrepareExternalTexture2D(texture, width, height);
+    context->bindTexture(GL::TEXTURE_2D, boundTexture);
+    if (unpackBuffer)
+        context->bindBuffer(GL::PIXEL_UNPACK_BUFFER, unpackBuffer);
+    static unsigned copies, failures;
+    if (!nativeTexture || !PS5WebGLLayers::copyVideoFrameNative(streamKey, nativeTexture, flipY)) {
+        if (!failures++)
+            WTFLogAlways("[webgl] title: video frame copy failed (texture %u, %dx%d, native %u)", texture, width, height, nativeTexture);
+        return;
+    }
+    if (!copies++)
+        WTFLogAlways("[webgl] title: first video frame copied into a WebGL texture, %dx%d%s", width, height, flipY ? ", flipped" : "");
+}
+
