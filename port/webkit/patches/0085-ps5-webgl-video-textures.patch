diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/ps5/PS5ExternalTexture.cpp b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/ps5/PS5ExternalTexture.cpp
new file mode 100644
index 0000000000..5ab107397d
--- /dev/null
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/ps5/PS5ExternalTexture.cpp
@@ -0,0 +1,40 @@
+//
+// PS5 (Parallax Browser, spikes/11-webgl M3): a 2D texture whose contents
+// are written outside ANGLE. The title copies hardware-decoded video frames
+// into WebGL textures with ps5-opengl directly (WebKit's
+// RemoteGraphicsContextGLPS5.cpp), into the texture's native object, which
+// this returns. Without the initialized mark, robust resource init would
+// clear the copied frame at the texture's first use.
+//
+
+#include "libANGLE/Context.h"
+#include "libANGLE/Texture.h"
+#include "libANGLE/renderer/gl/TextureGL.h"
+#include "libGLESv2/entry_points_gles_2_0_autogen.h"
+#include "libGLESv2/global_state.h"
+
+// The texture must be bound to GL_TEXTURE_2D on the active unit, and no
+// pixel unpack buffer bound. Level 0 is (re)defined as width x height RGBA8
+// unless it already is; returns the native texture name, 0 if `name` is not
+// a mutable 2D texture of the current context.
+extern "C" ANGLE_EXPORT GLuint GL_APIENTRY ANGLE_PS5PrepareExternalTexture2D(GLuint name, GLsizei width, GLsizei height)
+{
+    gl::Context *context = gl::GetValidGlobalContext();
+    if (!context || !name || width <= 0 || height <= 0)
+        return 0;
+    gl::Texture *texture = context->getTexture(gl::TextureID{name});
+    if (!texture || texture->getType() != gl::TextureType::_2D || texture->getImmutableFormat())
+        return 0;
+
+    const gl::ImageDesc &desc = texture->getState().getImageDesc(gl::TextureTarget::_2D, 0);
+    if (desc.size.width != width || desc.size.height != height || !desc.format.valid() ||
+        desc.format.info->sizedInternalFormat != GL_RGBA8)
+    {
+        GL_TexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        const gl::ImageDesc &defined = texture->getState().getImageDesc(gl::TextureTarget::_2D, 0);
+        if (defined.size.width != width || defined.size.height != height)
+            return 0;
+    }
+    texture->setInitState(GL_NONE, gl::ImageIndex::Make2D(0), gl::InitState::Initialized);
+    return rx::GetImplAs<rx::TextureGL>(texture)->getTextureID();
+}
