diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLVideoCopy.cpp b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLVideoCopy.cpp
new file mode 100644
index 0000000000..5dd8911739
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLVideoCopy.cpp
@@ -0,0 +1,71 @@
+/*
+ * PS5: the native half of WebGL's video textures (M3, PS5WebGLLayers.h).
+ * ps5-opengl's EGL and GL through epoxy; ANGLE's headers can't be in the
+ * same file (RemoteGraphicsContextGLPS5.cpp has the ANGLE half).
+ */
+
+#include "config.h"
+#include "PS5WebGLLayers.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/GLContext.h>
+#include <WebCore/PlatformDisplay.h>
+#include <epoxy/egl.h>
+#include <epoxy/gl.h>
+#include <wtf/NeverDestroyed.h>
+
+namespace WebKit {
+namespace PS5WebGLLayers {
+
+void bindESAPI()
+{
+    eglBindAPI(EGL_OPENGL_ES_API);
+}
+
+// A native ES context of the compositor's share group, current only for a
+// copy (PS5Renderer::copyVideoFrame binds its own framebuffers), so ANGLE's
+// native context keeps the state ANGLE thinks it has. WebGL's work queue only.
+static EGLContext copyContext()
+{
+    static NeverDestroyed<std::unique_ptr<WebCore::GLContext>> context;
+    static bool failed;
+    if (!context.get() && !failed) {
+        auto& display = WebCore::PlatformDisplay::sharedDisplay();
+        context.get() = WebCore::GLContext::create(display.glDisplay(), WebCore::GLContext::Target::Surfaceless, display.sharingGLContext());
+        failed = !context.get();
+        WTFLogAlways("[webgl] title: video copy context %s", failed ? "could not be made: video textures stay empty" : "ready");
+    }
+    return context.get() ? static_cast<EGLContext>(context.get()->platformContext()) : EGL_NO_CONTEXT;
+}
+
+bool copyVideoFrameNative(uint64_t key, unsigned nativeTexture, bool flipY)
+{
+    auto copy = copyVideoFrameFunction();
+    EGLContext helper = copy ? copyContext() : EGL_NO_CONTEXT;
+    if (helper == EGL_NO_CONTEXT)
+        return false;
+    EGLDisplay display = eglGetCurrentDisplay();
+    EGLContext previous = eglGetCurrentContext();
+    EGLSurface draw = eglGetCurrentSurface(EGL_DRAW);
+    EGLSurface read = eglGetCurrentSurface(EGL_READ);
+    if (display == EGL_NO_DISPLAY || previous == EGL_NO_CONTEXT)
+        return false;
+    // ANGLE's (re)definition of the texture reaches the other context.
+    glFlush();
+    if (!eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, helper))
+        return false;
+    void* done = copy(key, nativeTexture, flipY);
+    eglMakeCurrent(display, draw, read, previous);
+    if (!done)
+        return false;
+    // ANGLE's next use of the texture comes after the copy (GPU side).
+    glWaitSync(static_cast<GLsync>(done), 0, GL_TIMEOUT_IGNORED);
+    glDeleteSync(static_cast<GLsync>(done));
+    return true;
+}
+
+} // namespace PS5WebGLLayers
+} // namespace WebKit
+
+#endif
