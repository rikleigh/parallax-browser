+// The rects one recording paints, from the rects of the dirty region. Each
+// rect painted is a pass over the layer's whole paint order (on a long feed
+// the root's z-order list has thousands of entries, about 0.7 ms per pass
+// whatever the rect's size), and a frame with a few thumbnails arriving and a
+// new tile row had 10 and more rects: the passes, not the pixels, were the
+// main thread's painting time. Rects are merged while the merged rect is not
+// much larger than the two together, and then down to at most 4 (what a
+// merged rect covers beyond the dirty region is recorded but never replayed:
+// each tile part replays only its own rect). PS5WK_WC_PAINT_PASSES=0
+// (child.env): one pass per region rect, as before.
+static Vector<IntRect, 1> paintPasses(const Region& region)
+{
+    auto rects = region.rects();
+    static const unsigned maxPasses = envUnsigned("PS5WK_WC_PAINT_PASSES", 4, 0, 64);
+    if (!maxPasses || rects.size() < 2)
+        return rects;
+    auto area = [](const IntRect& rect) {
+        return static_cast<int64_t>(rect.width()) * rect.height();
+    };
+    // The search below is cubic in the number of rects: a region of many
+    // (they come in bands, top to bottom) is first halved, neighbour with
+    // neighbour, until 32 are left.
+    while (rects.size() > 32) {
+        size_t kept = 0;
+        for (size_t i = 0; i < rects.size(); i += 2) {
+            auto merged = rects[i];
+            if (i + 1 < rects.size())
+                merged.unite(rects[i + 1]);
+            rects[kept++] = merged;
+        }
+        rects.shrink(kept);
+    }
+    while (rects.size() > 1) {
+        // The pair whose union wastes the least.
+        size_t bestA = 0, bestB = 0;
+        int64_t bestWaste = std::numeric_limits<int64_t>::max();
+        int64_t bestSum = 0;
+        for (size_t a = 0; a < rects.size(); ++a) {
+            for (size_t b = a + 1; b < rects.size(); ++b) {
+                int64_t sum = area(rects[a]) + area(rects[b]);
+                int64_t waste = area(unionRect(rects[a], rects[b])) - sum;
+                if (waste < bestWaste) {
+                    bestWaste = waste;
+                    bestSum = sum;
+                    bestA = a;
+                    bestB = b;
+                }
+            }
+        }
+        // Cheap enough to merge anyway: the extra area is under 128x128
+        // pixels or under half of what the two rects cover.
+        bool cheap = bestWaste <= 16384 || bestWaste * 2 <= bestSum;
+        if (!cheap && rects.size() <= maxPasses)
+            break;
+        rects[bestA].unite(rects[bestB]);
+        rects.removeAt(bestB);
+    }
+    // A merged rect may now cover part of another: what both cover would be
+    // painted twice into the recording (text and translucent fills darker on
+    // a layer without an opaque background). Rects that touch become one.
+    for (bool merged = true; merged;) {
+        merged = false;
+        for (size_t a = 0; a < rects.size() && !merged; ++a) {
+            for (size_t b = a + 1; b < rects.size(); ++b) {
+                if (rects[a].intersects(rects[b])) {
+                    rects[a].unite(rects[b]);
+                    rects.removeAt(b);
+                    merged = true;
+                    break;
+                }
+            }
+        }
+    }
+    return rects;
+}
