+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// PS5 (13.60, measured with payloads, test/memprobe/rvprobe*.c): a mapping costs CPU page tables when
+// it is made, one per 2 MB, no-access ones included, out of 8192 for the whole console; MAP_GUARD is
+// refused. A range reserved with sceKernelReserveVirtualRange costs none (10 GiB: +0). An access to
+// it is a SIGSEGV with its address, a later mmap is never placed in it, and mmap(MAP_FIXED) over a
+// part of it commits that part (mprotect does not: it returns 0 and the pages stay unreachable).
+// So a memory reserves its whole range, 4 GiB and the redzone for a fast one, and maps what it uses.
+// (Before this, 0127 put one shared memory below 0xFC00000000, where mmap refuses hints, as its
+// guard. A hinted mmap that finds the range below taken is placed above that address after all.)
+extern "C" int sceKernelReserveVirtualRange(void** address, size_t length, int flags, size_t alignment);
+extern "C" int sceKernelMunmap(void* address, size_t length);
+
+static size_t ps5ReservationBytes(size_t bytes)
+{
+    return std::max(roundUpToMultipleOf(WTF::pageSize(), bytes), WTF::pageSize());
+}
+
+static void* ps5TryReserve(size_t bytes)
+{
+    // Away from the low addresses where mmap places everything else, so that large mappings there
+    // can still be extended in place (Gigacage::tryAllocateZeroedVirtualPagesWithRoomToGrow).
+    constexpr size_t alignment = 2 * 1024 * 1024;
+    for (uintptr_t hint : { static_cast<uintptr_t>(0x8000000000ull), static_cast<uintptr_t>(0) }) {
+        void* address = std::bit_cast<void*>(hint);
+        if (!sceKernelReserveVirtualRange(&address, ps5ReservationBytes(bytes), 0, alignment) && address)
+            return address;
+    }
+    return nullptr;
+}
+
+static void ps5ReleaseReservation(void* base, size_t bytes)
+{
+    // The reservation and whatever was mapped over it.
+    int result = sceKernelMunmap(base, ps5ReservationBytes(bytes));
+    RELEASE_ASSERT(!result);
