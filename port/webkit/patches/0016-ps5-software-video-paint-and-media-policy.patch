+        cachedSource = sample;
+        cachedSize = size;
+        cachedImage = WTF::move(image);
+    }
+    FloatRect userRect = ctm.inverse().value_or(AffineTransform()).mapRect(FloatRect(snapped.location(), FloatSize(size)));
+    context.drawNativeImage(*cachedImage, userRect, FloatRect({ }, FloatSize(size)), { CompositeOperator::Copy });
