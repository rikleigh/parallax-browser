+    if (!ctm.preservesAxisAlignment() || ctm.b() || ctm.c() || ctm.a() <= 0 || ctm.d() <= 0)
+        return false;
+    IntRect snapped = enclosingIntRect(ctm.mapRect(rect));
+    IntSize size(std::clamp(snapped.width(), 1, 3840), std::clamp(snapped.height(), 1, 2160));
