+
+RefPtr<PS5RasterJob> NonCompositedFrameRenderer::ps5RecordBands(SkCanvas& canvas, const Vector<IntRect>& deviceRects)
+{
+    s_ps5RecordMS = s_ps5ReplayMS = 0;
+    if ((ps5PaintThreads() < 2 && !ps5PaintRecordAlways() && !ps5PaintAsync()) || m_context || m_surface->shouldPaintMirrored())
+        return nullptr;
+
+    SkPixmap pixmap;
+    if (!canvas.peekPixels(&pixmap))
+        return nullptr;
+    IntRect surfaceRect(0, 0, pixmap.width(), pixmap.height());
+
+    IntRect bounds;
+    uint64_t pixels = 0;
+    for (auto rect : deviceRects) {
+        rect.intersect(surfaceRect);
+        bounds.unite(rect);
+        pixels += static_cast<uint64_t>(rect.width()) * rect.height();
+    }
+    if (bounds.isEmpty() || pixels < ps5PaintMinPixels() || bounds.height() < 64)
+        return nullptr;
+
+    Ref webPage = m_webPage;
+    float scale = webPage->deviceScaleFactor();
+
+    auto recordStart = MonotonicTime::now();
+    // Record the frame in device pixels (the replay only offsets it), with a
+    // bounding box hierarchy so each band visits only its own operations.
+    SkPictureRecorder recorder;
+    SkRTreeFactory rtreeFactory;
+    auto* recordingCanvas = recorder.beginRecording(SkRect::MakeIWH(pixmap.width(), pixmap.height()), ps5PaintBBH() ? &rtreeFactory : nullptr);
+    {
+        GraphicsContextSkia recordingContext(*recordingCanvas, RenderingMode::Unaccelerated, RenderingPurpose::DOM);
+        recordingContext.beginRecording(GraphicsContextSkia::RecordingMode::Tile);
+        recordingContext.applyDeviceScaleFactor(scale);
+        for (const auto& rect : deviceRects) {
+            auto userRect = rect;
+            userRect.scale(1 / scale);
+            webPage->drawRect(recordingContext, userRect);
+        }
+        recordingContext.endRecording();
+    }
+    auto picture = recorder.finishRecordingAsPicture();
+    if (!picture)
+        return nullptr;
+    s_ps5RecordMS = (MonotonicTime::now() - recordStart).milliseconds();
+
+    Ref job = adoptRef(*new PS5RasterJob);
+    job->picture = WTF::move(picture);
+    job->pixmap = pixmap;
+    job->props = canvas.getBaseProps();
+    job->bounds = bounds;
+    job->rects = deviceRects;
+    // Bands of whole rows: several per thread, so an expensive band (a blur,
+    // a large image) doesn't leave the other threads idle.
+    job->bandCount = std::clamp<unsigned>(bounds.height() / 32, 1, ps5PaintThreads() * 3);
+    job->bandHeight = (bounds.height() + job->bandCount - 1) / job->bandCount;
+    return job;
+}
+
+bool NonCompositedFrameRenderer::ps5PaintInBands(SkCanvas& canvas, const Vector<IntRect>& deviceRects)
+{
+    RefPtr job = ps5RecordBands(canvas, deviceRects);
+    if (!job)
+        return false;
+    auto replayStart = MonotonicTime::now();
+    if (ps5PaintAsync()) {
+        // Every pool thread takes bands; the last one done hands the frame
+        // back to the main thread (ps5RasterDone).
+        job->renderer = this;
+        job->start = replayStart;
+        job->bandsLeft = job->bandCount;
+        m_ps5RasterJob = job;
+        for (unsigned i = 0; i < std::min(ps5PaintThreads(), job->bandCount); i++) {
+            ps5PaintPool().postTask([job] {
+                for (unsigned band; (band = job->nextBand.fetch_add(1, std::memory_order_relaxed)) < job->bandCount;) {
+                    job->paintBand(band);
+                    if (job->bandsLeft.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+                        job->rasterMS = (MonotonicTime::now() - job->start).milliseconds();
+                        {
+                            Locker locker { job->lock };
+                            job->done = true;
+                            job->condition.notifyAll();
+                        }
+                        RunLoop::mainSingleton().dispatch([job] {
+                            if (auto* renderer = job->renderer)
+                                renderer->ps5RasterDone();
+                        });
+                    }
+                }
+            });
+        }
+        return true;
+    }
+    ps5ParallelFor(job->bandCount, [&](unsigned band) {
+        job->paintBand(band);
+    });
+    s_ps5ReplayMS = (MonotonicTime::now() - replayStart).milliseconds();
+    return true;
+}
+
+// Main thread: blocks until the frame's bands are painted, then completes it.
+void NonCompositedFrameRenderer::ps5WaitForRaster()
+{
+    RefPtr job = m_ps5RasterJob;
+    if (!job)
+        return;
+    {
+        Locker locker { job->lock };
+        while (!job->done)
+            job->condition.wait(job->lock);
+    }
+    ps5RasterDone();
+}
+
+void NonCompositedFrameRenderer::ps5RasterDone()
+{
+    RefPtr job = std::exchange(m_ps5RasterJob, nullptr);
+    if (!job)
+        return;
+    job->renderer = nullptr;
+    ps5RenderStats().rasterMS += job->rasterMS;
+    ps5RenderStats().rasters++;
+    if (ps5RenderLog() >= 2)
+        WTFLogAlways("[render1] async raster %.1f ms, %u bands", job->rasterMS, job->bandCount);
+
+    // The rest of updateRendering().
+    Ref webPage = m_webPage;
+    RefPtr drawingArea = webPage->drawingArea();
+    m_surface->didRenderFrame();
+    webPage->didUpdateRendering();
+    if (drawingArea) {
+        drawingArea->didCompleteRenderingUpdateDisplay();
+        drawingArea->dispatchPendingCallbacksAfterEnsuringDrawing();
+    }
+    if (m_isWaitingForFrameComplete)
+        m_pendingNotifyFrame = true;
+    else
+        finishRenderingUpdate();
+}
