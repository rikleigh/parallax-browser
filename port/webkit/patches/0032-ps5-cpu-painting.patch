+bool NonCompositedFrameRenderer::ps5Scroll(const IntRect& scrollRect, const IntSize& scrollDelta)
+{
+    if (!ps5ScrollCopy() || m_context || !m_frameDamage || m_webPage->deviceScaleFactor() != 1 || m_surface->skiaClearColor({ })) {
+        if (ps5RenderLog() >= 3)
+            WTFLogAlways("[render1] scroll repaints (copy %d, damage %d, scale %.2f)", ps5ScrollCopy(), !!m_frameDamage, m_webPage->deviceScaleFactor());
+        return false;
+    }
+    IntRect rect = intersection(scrollRect, m_webPage->bounds());
+    if (rect.isEmpty() || scrollDelta.isZero())
+        return true;
+    if (!m_ps5ScrollRect.isEmpty() && m_ps5ScrollRect != rect)
+        return false; // a second scrolled rectangle in one frame: repaint
+
+    // What was damaged earlier in this frame moves with the content (the old
+    // place stays damaged too), and the strip the scroll uncovers is new.
+    auto damaged = m_frameDamage->rects();
+    if (ps5RenderLog() >= 3) {
+        StringBuilder text;
+        for (const auto& r : damaged)
+            text.append(' ', r.width(), 'x', r.height(), '+', r.x(), '+', r.y());
+        WTFLogAlways("[render1] damage before scroll:%s", text.toString().utf8().data());
+    }
+    for (auto moved : damaged) {
+        moved.move(scrollDelta);
+        moved.intersect(rect);
+        if (!moved.isEmpty())
+            m_frameDamage->add(moved);
+    }
+    IntRect kept = rect;
+    kept.move(scrollDelta);
+    kept.intersect(rect);
+    Region uncovered(rect);
+    uncovered.subtract(kept);
+    for (const auto& strip : uncovered.rects())
+        m_frameDamage->add(strip);
+
+    m_ps5ScrollRect = rect;
+    m_ps5ScrollDelta += scrollDelta;
+    if (ps5RenderLog() >= 3)
+        WTFLogAlways("[render1] scroll %dx%d+%d+%d by %d,%d; damage %zu rects, bounds %dx%d+%d+%d", rect.width(), rect.height(), rect.x(), rect.y(),
+            scrollDelta.width(), scrollDelta.height(), m_frameDamage->size(), m_frameDamage->bounds().width(), m_frameDamage->bounds().height(), m_frameDamage->bounds().x(), m_frameDamage->bounds().y());
