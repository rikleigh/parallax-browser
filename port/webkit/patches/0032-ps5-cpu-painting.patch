+void AcceleratedSurface::ps5CopyForward(const Damage& paintDamage, const IntRect& scrollRect, const IntSize& scrollDelta)
+{
+    if (!m_target || !m_useSkia || usesGL() || !m_ps5LastRenderedTargetID)
+        return;
+    RenderTarget* last = nullptr;
+    m_swapChain.forEachTarget([&](RenderTarget& target) {
+        if (target.id() == m_ps5LastRenderedTargetID)
+            last = &target;
+    });
+    SkPixmap dst, src;
+    if (!last || !m_target->skiaSurface() || !last->skiaSurface() || !m_target->skiaSurface()->peekPixels(&dst) || !last->skiaSurface()->peekPixels(&src))
+        return;
+    if (dst.width() != src.width() || dst.height() != src.height() || dst.colorType() != src.colorType() || dst.info().bytesPerPixel() != 4)
+        return;
+
+    IntRect surfaceRect(0, 0, dst.width(), dst.height());
+    IntRect scroll = intersection(scrollRect, surfaceRect);
+    Region painted;
+    for (const auto& rect : paintDamage)
+        painted.unite(rect);
+
+    if (last != m_target) {
+        // What this target missed since it was last current, outside the
+        // scrolled rectangle and what gets painted now: as in the last frame.
+        Region stale;
+        if (const auto& damage = m_target->damage()) {
+            for (const auto& rect : *damage)
+                stale.unite(intersection(rect, surfaceRect));
+        } else
+            stale = Region(surfaceRect);
+        if (!scroll.isEmpty())
+            stale.subtract(scroll);
+        stale.subtract(painted);
+        for (const auto& rect : stale.rects())
+            ps5CopyPixels(dst, src, rect, { });
+    }
+    if (!scroll.isEmpty()) {
+        IntRect kept = scroll;
+        kept.move(scrollDelta);
+        kept.intersect(scroll);
+        ps5CopyPixels(dst, src, kept, scrollDelta);
+    }
+    m_target->setDamage(paintDamage);
