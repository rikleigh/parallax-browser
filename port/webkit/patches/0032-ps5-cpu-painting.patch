+        if (y1 <= y0)
+            return;
+        SkRegion clip;
+        for (const auto& rect : rects) {
+            auto part = intersection(rect, IntRect(bounds.x(), y0, bounds.width(), y1 - y0));
+            if (!part.isEmpty())
+                clip.op(SkIRect::MakeXYWH(part.x(), part.y() - y0, part.width(), part.height()), SkRegion::kUnion_Op);
+        }
+        if (clip.isEmpty())
+            return;
+        auto bandCanvas = SkCanvas::MakeRasterDirect(pixmap.info().makeWH(pixmap.width(), y1 - y0), pixmap.writable_addr(0, y0), pixmap.rowBytes(), &props);
+        if (!bandCanvas)
+            return;
+        bandCanvas->clipRegion(clip);
+        bandCanvas->translate(0, -y0);
+        picture->playback(bandCanvas.get());
+    }
+};
