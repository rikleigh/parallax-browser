+// Runs work(0..count-1) on the calling thread and up to threads-1 pool
+// threads, and returns when every item is done.
+static void ps5ParallelFor(unsigned count, NOESCAPE const Function<void(unsigned)>& work)
+{
+    struct Shared : ThreadSafeRefCounted<Shared> {
+        std::atomic<unsigned> next { 0 };
+        Lock lock;
+        Condition condition;
+        unsigned helpersDone WTF_GUARDED_BY_LOCK(lock) { 0 };
+    };
+    Ref shared = adoptRef(*new Shared);
+    auto runItems = [&work, count](Shared& state) {
+        for (unsigned index; (index = state.next.fetch_add(1, std::memory_order_relaxed)) < count;)
+            work(index);
+    };
+    unsigned helpers = count > 1 ? std::min(ps5PaintThreads() - 1, count - 1) : 0;
+    for (unsigned i = 0; i < helpers; i++) {
+        ps5PaintPool().postTask([shared, &runItems] {
+            runItems(shared.get());
+            Locker locker { shared->lock };
+            shared->helpersDone++;
+            shared->condition.notifyAll();
+        });
+    }
+    runItems(shared.get());
+    // The helpers reference this frame's stack: wait until all have finished.
+    Locker locker { shared->lock };
+    while (shared->helpersDone < helpers)
+        shared->condition.wait(shared->lock);
