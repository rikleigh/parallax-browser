+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// PS5: the next field Return moves to (see defaultEventHandler): a later
+// text field of the same form that a person can see and reach. Fields a
+// page hides from people (bot traps: display none, invisible, transparent,
+// no size, out of the tab order) are skipped, so they stay empty.
+static RefPtr<HTMLElement> nextTextFieldInFormForPS5(HTMLInputElement& input)
+{
+    RefPtr form = input.form();
+    if (!form)
+        return nullptr;
+    protect(input.document())->updateLayoutIgnorePendingStylesheets();
+    bool afterInput = false;
+    for (auto& listed : form->copyListedElementsVector()) {
+        Ref element = listed->asHTMLElement();
+        if (element.ptr() == &input) {
+            afterInput = true;
+            continue;
+        }
+        if (!afterInput)
+            continue;
+        RefPtr control = dynamicDowncast<HTMLTextFormControlElement>(element);
+        if (!control)
+            continue;
+        if (RefPtr field = dynamicDowncast<HTMLInputElement>(*control); field && !field->isTextField())
+            continue;
+        if (control->isDisabledFormControl() || control->isReadOnly() || !control->isFocusable())
+            continue;
+        if (auto tabIndex = control->tabIndexSetExplicitly(); tabIndex && *tabIndex < 0)
+            continue;
+        CheckVisibilityOptions visibility;
+        visibility.opacityProperty = true;
+        visibility.visibilityProperty = true;
+        if (!control->checkVisibility(visibility))
+            continue;
+        auto* renderer = control->renderer();
+        if (!renderer)
+            continue;
+        auto box = renderer->absoluteBoundingBoxRect();
+        if (box.width() < 2 || box.height() < 2 || box.maxX() <= 0 || box.maxY() <= 0)
+            continue;
+        return control;
+    }
+    return nullptr;
+}
+#endif
