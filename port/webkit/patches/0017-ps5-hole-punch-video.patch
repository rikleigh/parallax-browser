+// The video's rectangle (in page-buffer pixels) becomes transparent; the
+// title draws the frame there, under the page. Whatever the page paints
+// over the video afterwards (controls, captions) stays on top of it.
+bool MediaPlayerPrivateGStreamer::ps5PunchHole(GraphicsContext& context, const FloatRect& rect)
+{
+    {
+        Locker sampleLocker { m_sampleMutex };
+        if (!GST_IS_SAMPLE(m_sample.get()))
+            return true; // no frame yet: no hole (the element's background shows)
+    }
+    auto ctm = context.getCTM();
+    if (!ctm.preservesAxisAlignment() || ctm.b() || ctm.c() || ctm.a() <= 0 || ctm.d() <= 0)
+        return false; // rotated or mirrored: paint the frame into the page
+    IntRect device = enclosingIntRect(ctm.mapRect(rect));
+    if (device.isEmpty())
+        return true;
+    FloatRect userRect = ctm.inverse().value_or(AffineTransform()).mapRect(FloatRect(device));
+    context.clearRect(userRect);
+    ps5_video_sink_set_geometry(m_videoSink.get(), device.x(), device.y(), device.width(), device.height());
+    return true;
+}
