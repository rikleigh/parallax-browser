+// Hardware decoding (Milestone 2 step 2b): ps5vdecproxy's samples carry a
+// placeholder that names a picture decoded in the browser title
+// (video/x-raw(memory:PS5Remote)); the pixels never reach this process.
+static bool ps5IsRemoteSample(GstSample* sample)
+{
+    GstCaps* caps = sample ? gst_sample_get_caps(sample) : nullptr;
+    GstCapsFeatures* features = caps && gst_caps_get_size(caps) ? gst_caps_get_features(caps, 0) : nullptr;
+    return features && gst_caps_features_contains(features, "memory:PS5Remote");
+}
