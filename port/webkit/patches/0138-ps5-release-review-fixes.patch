+// ps5-opengl (WebGL, the compositor) and RADV (WebGPU) both set GPU state in one submission and
+// rely on it in the next. A RADV submission between two of WebGL's lost WebGL's blending in
+// about 2% of frames (test/webgpu/webgl-and-webgpu.html, 2026-11-17). The compositor holds the
+// lock around a frame's GL work (PS5Renderer.cpp); WebGL's queue holds it around each batch and
+// flushes before letting go, so RADV only ever runs between whole batches. Only while a WebGPU
+// device exists: with none, nothing of RADV's runs and a WebGL-only page pays nothing.
+static std::atomic<unsigned> s_webGPUDevices;
+
+void webGPUDeviceAdded()
+{
+    if (!s_webGPUDevices++)
+        WTFLogAlways("[webgl] a WebGPU device exists: WebGL's work takes the GPU submission lock");
+}
+
+void webGPUDeviceRemoved()
+{
+    if (!--s_webGPUDevices)
+        WTFLogAlways("[webgl] no WebGPU device left: WebGL's work without the GPU submission lock");
+}
+
+static bool batchBegin()
+{
+    if (!ps5wk_gpu_submit_lock || !s_webGPUDevices.load(std::memory_order_relaxed))
+        return false;
+    ps5wk_gpu_submit_lock();
+    return true;
+}
+
+static void batchEnd()
+{
+    flushNative();
+    ps5wk_gpu_submit_unlock();
+}
