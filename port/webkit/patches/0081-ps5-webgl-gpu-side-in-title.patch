diff --git a/Source/WebKit/GPUProcess/graphics/ps5/RemoteGraphicsContextGLPS5.cpp b/Source/WebKit/GPUProcess/graphics/ps5/RemoteGraphicsContextGLPS5.cpp
new file mode 100644
index 0000000000..a414986690
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/RemoteGraphicsContextGLPS5.cpp
@@ -0,0 +1,77 @@
+/*
+ * PS5: the title's side of remote WebGL (spikes/11-webgl). The title stands
+ * in for the GPU process (UIProcess/wpe/ps5/PS5GPUProcessInTitle.cpp). Each
+ * context is ANGLE over ps5-opengl, made on the RemoteGraphicsContextGL work
+ * queue's thread. Its drawing buffers aren't shown yet: putting them in a WC
+ * content layer is milestone M2.
+ */
+
+#include "config.h"
+#include "RemoteGraphicsContextGL.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/GraphicsContextGLCoordinated.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebKit {
+
+class RemoteGraphicsContextGLPS5 final : public RemoteGraphicsContextGL {
+    WTF_MAKE_TZONE_ALLOCATED(RemoteGraphicsContextGLPS5);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(RemoteGraphicsContextGLPS5);
+public:
+    RemoteGraphicsContextGLPS5(GPUConnectionToWebProcess& connection, RemoteGraphicsContextGLIdentifier identifier, RemoteRenderingBackend& renderingBackend, Ref<IPC::StreamServerConnection>&& streamConnection)
+        : RemoteGraphicsContextGL(connection, identifier, renderingBackend, WTF::move(streamConnection))
+    {
+    }
+
+private:
+    void platformWorkQueueInitialize(WebCore::GraphicsContextGLAttributes&&) final;
+    void didRunOutOfMessages() final;
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(RemoteGraphicsContextGLPS5);
+
+void RemoteGraphicsContextGLPS5::platformWorkQueueInitialize(WebCore::GraphicsContextGLAttributes&& attributes)
+{
+    assertIsCurrent(workQueue());
+    const bool webGL2 = attributes.isWebGL2;
+    m_context = WebCore::GraphicsContextGLCoordinated::create(WTF::move(attributes));
+    if (!m_context) {
+        WTFLogAlways("[webgl] title: no ANGLE context for a WebGL %d page (it gets a lost context)", webGL2 ? 2 : 1);
+        return;
+    }
+    WTFLogAlways("[webgl] title: ANGLE context for WebGL %d, max texture %d", webGL2 ? 2 : 1, m_context->maxTextureSize());
+}
+
+void RemoteGraphicsContextGLPS5::didRunOutOfMessages()
+{
+    assertIsCurrent(workQueue());
+    if (RefPtr context = m_context)
+        context->flush();
+}
+
+// The display round trip (RemoteGraphicsContextGLProxyPS5): the frame is
+// finished in the drawing buffer, which nothing shows yet.
+void RemoteGraphicsContextGL::prepareForDisplay(CompletionHandler<void()>&& completionHandler)
+{
+    assertIsCurrent(workQueue());
+    static unsigned frames;
+    if (RefPtr context = m_context) {
+        context->prepareForDisplay();
+        if (!frames++)
+            WTFLogAlways("[webgl] title: first frame finished");
+    }
+    completionHandler();
+}
+
+Ref<RemoteGraphicsContextGL> RemoteGraphicsContextGL::create(GPUConnectionToWebProcess& connection, WebCore::GraphicsContextGLAttributes&& attributes, RemoteGraphicsContextGLIdentifier identifier, RemoteRenderingBackend& renderingBackend, Ref<IPC::StreamServerConnection>&& streamConnection)
+{
+    auto instance = adoptRef(*new RemoteGraphicsContextGLPS5(connection, identifier, renderingBackend, WTF::move(streamConnection)));
+    instance->initialize(WTF::move(attributes));
+    return instance;
+}
+
+} // namespace WebKit
+
+#endif // ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && defined(PS5_PAYLOAD_SDK)
