+#if defined(PS5_PAYLOAD_SDK)
+namespace {
+// The far end of an in-title process's parent connection: messages meant
+// for its UI process proxy (GPUProcessProxy) end here, logged and dropped.
+class PS5InTitleParentSink final : public IPC::Connection::Client {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(PS5InTitleParentSink);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(PS5InTitleParentSink);
+public:
+    // Never destroyed (NeverDestroyed in ps5InitializeInTitle).
+    void ref() const final { }
+    void deref() const final { }
+
+    void didReceiveMessage(IPC::Connection&, IPC::Decoder& decoder) final { dropped(decoder); }
+    void didReceiveSyncMessage(IPC::Connection&, IPC::Decoder& decoder, UniqueRef<IPC::Encoder>&) final { dropped(decoder); }
+    void didClose(IPC::Connection&) final { }
+    void didReceiveInvalidMessage(IPC::Connection&, IPC::MessageName, const Vector<uint32_t>&) final { }
+
+private:
+    static void dropped(IPC::Decoder& decoder)
+    {
+        WTFLogAlways("[ps5-gpu] in-title GPU process: dropped %s (no GPUProcessProxy)", IPC::description(decoder.messageName()).characters());
+    }
+};
+}
+
+void AuxiliaryProcess::ps5InitializeInTitle()
+{
+    RELEASE_ASSERT(RunLoop::isMain());
+    if (m_connection)
+        return;
+    auto pair = IPC::Connection::createConnectionIdentifierPair();
+    RELEASE_ASSERT(pair);
+    // Both ends live as long as the title: didClose() on this side would end it.
+    static NeverDestroyed<PS5InTitleParentSink> sinkClient;
+    static NeverDestroyed<Ref<IPC::Connection>> sink = IPC::Connection::createClientConnection(IPC::Connection::Identifier { WTF::move(pair->client) });
+    sink.get()->open(sinkClient.get());
+
+    Ref connection = IPC::Connection::createServerConnection(WTF::move(pair->server));
+    lazyInitialize(m_connection, connection.copyRef());
+    connection->open(*this);
+}
+#endif
