diff --git a/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.cpp b/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.cpp
new file mode 100644
index 0000000000..b85ca03d88
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.cpp
@@ -0,0 +1,59 @@
+/*
+ * PS5: the GPU process's WebGL side, in the title (PS5GPUProcessInTitle.h).
+ */
+
+#include "config.h"
+#include "PS5GPUProcessInTitle.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && defined(PS5_PAYLOAD_SDK)
+
+#include "GPUProcess.h"
+#include "GPUProcessConnectionParameters.h"
+#include "WebProcessProxy.h"
+#include <WebCore/PlatformDisplaySurfaceless.h>
+
+namespace WebKit {
+namespace PS5GPUProcessInTitle {
+
+// The GL display WebGL's contexts use (PlatformDisplay::sharedDisplay()):
+// the title's UI process has none of its own; the compositor uses
+// ps5-opengl's EGL directly (PS5Renderer).
+static bool ensureDisplay()
+{
+    if (WebCore::PlatformDisplay::sharedDisplayIfExists())
+        return true;
+    auto display = WebCore::PlatformDisplaySurfaceless::create();
+    if (!display)
+        return false;
+    WebCore::PlatformDisplay::setSharedDisplay(WTF::move(display));
+    return true;
+}
+
+void createGPUProcessConnection(WebProcessProxy& webProcess, IPC::Connection::Handle&& connectionHandle, GPUProcessConnectionParameters&& parameters)
+{
+    RELEASE_ASSERT(RunLoop::isMain());
+    static bool started;
+    static bool failed;
+    if (!started) {
+        started = true;
+        if (!ensureDisplay()) {
+            failed = true;
+            WTFLogAlways("[webgl] title: no EGL display, so no WebGL");
+        } else {
+            GPUProcess::singleton().ps5InitializeInTitle();
+            WTFLogAlways("[webgl] title: GPU process side started (WebGL only)");
+        }
+    }
+    // Dropping the handle closes the connection: the WebProcess takes the
+    // GPU process as gone and its WebGL contexts as lost.
+    if (failed)
+        return;
+
+    WTFLogAlways("[webgl] title: GPU connection for WebProcess %" PRIu64, webProcess.coreProcessIdentifier().toUInt64());
+    GPUProcess::singleton().ps5CreateGPUConnectionToWebProcess(webProcess.coreProcessIdentifier(), webProcess.sessionID(), WTF::move(connectionHandle), WTF::move(parameters));
+}
+
+} // namespace PS5GPUProcessInTitle
+} // namespace WebKit
+
+#endif
diff --git a/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.h b/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.h
new file mode 100644
index 0000000000..38dfb4b5d9
--- /dev/null
+++ b/Source/WebKit/UIProcess/wpe/ps5/PS5GPUProcessInTitle.h
@@ -0,0 +1,32 @@
+/*
+ * PS5: the GPU process's WebGL side, in the title (spikes/11-webgl).
+ *
+ * GL works only in the title (a registered app), not in elfldr payloads, so
+ * there is no GPU process to launch. A WebProcess's request for a GPU process
+ * connection is answered here instead: WebKit's GPUProcess object, made in
+ * the title without its process start-up, takes the connection, and its
+ * WebGL contexts are ANGLE over ps5-opengl (RemoteGraphicsContextGLPS5.cpp).
+ * Canvas, page painting and media stay in the WebProcess
+ * (WebPreferencesWPE.cpp), so only remote WebGL comes here.
+ */
+
+#pragma once
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && defined(PS5_PAYLOAD_SDK)
+
+#include "Connection.h"
+
+namespace WebKit {
+
+class WebProcessProxy;
+struct GPUProcessConnectionParameters;
+
+namespace PS5GPUProcessInTitle {
+
+// WebProcessPool::createGPUProcessConnection. Main run loop.
+void createGPUProcessConnection(WebProcessProxy&, IPC::Connection::Handle&&, GPUProcessConnectionParameters&&);
+
+} // namespace PS5GPUProcessInTitle
+} // namespace WebKit
+
+#endif
