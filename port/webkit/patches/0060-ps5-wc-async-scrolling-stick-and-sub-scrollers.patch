+PlatformWheelEvent PS5WCScrollingTree::clampAtPaintedEdge(const PlatformWheelEvent& wheelEvent)
+{
+    auto rootPosition = this->rootScrollPosition();
+    auto webProcessPosition = this->webProcessScrollPosition();
+    if (!rootPosition || !webProcessPosition)
+        return wheelEvent;
+    // The margins the WebProcess reported with that update (its coverage,
+    // further ahead in the scroll direction: GraphicsLayerWC::coverageMargins).
+    auto [above, below] = webProcessPaintedMargins();
+    bool reduced = PS5WCHost::tileCoverageReduced();
+    float checkerboard = m_checkerboardPx.load();
+    float limitAbove = (reduced ? 0 : above) + checkerboard, limitBelow = (reduced ? 0 : below) + checkerboard;
+    float limitX = (reduced ? 0.f : 512.f) + checkerboard;
+    auto delta = wheelEvent.delta();
+    auto clampAxis = [&](float current, float webProcess, float d, float limitBefore, float limitAfter) {
+        float wanted = current - d;
+        float low = std::min(webProcess - limitBefore, current), high = std::max(webProcess + limitAfter, current);
+        float allowed = std::clamp(wanted, low, high);
+        if (allowed != wanted)
+            PS5WCHost::noteScrollClamped(wanted - allowed);
+        return current - allowed;
+    };
+    FloatSize clamped { clampAxis(rootPosition->x(), webProcessPosition->x(), delta.width(), limitX, limitX), clampAxis(rootPosition->y(), webProcessPosition->y(), delta.height(), limitAbove, limitBelow) };
+    if (clamped == delta)
+        return wheelEvent;
+    return wheelEvent.copyWithDeltaAndVelocity(clamped, wheelEvent.scrollingVelocity());
+}
+
+void PS5WCScrollingTree::queueFrameLockedScroll(const PlatformWheelEvent& wheelEvent)
+{
+    {
+        Locker locker { m_stickLock };
+        auto now = MonotonicTime::now();
+        double interval = std::clamp((now - m_stickLastEvent).seconds(), 0.004, 0.033);
+        bool resumed = (now - m_stickLastEvent).seconds() > 0.05;
+        FloatSize instant = wheelEvent.delta() * static_cast<float>(1 / interval);
+        m_stickVelocity = resumed ? instant : m_stickVelocity * 0.5f + instant * 0.5f;
+        m_stickPending += wheelEvent.delta();
+        m_stickLastEvent = now;
+        m_stickEvent = wheelEvent;
+    }
+    PS5WCHost::requestFrame();
+}
+
+// Render thread, at the start of a frame: move by velocity x frame interval,
+// within what is queued (and all of it once the stick has stopped), catching
+// up if more than ~3 frames' worth is waiting.
+void PS5WCScrollingTree::applyFrameLockedScroll(MonotonicTime displayTime)
+{
+    std::optional<PlatformWheelEvent> event;
+    {
+        Locker locker { m_stickLock };
+        double dt = m_stickLastFrame ? std::clamp((displayTime - m_stickLastFrame).seconds(), 0.0, 0.05) : 1 / 60.0;
+        m_stickLastFrame = displayTime;
+        if (m_stickPending.isZero() || !m_stickEvent)
+            return;
+        bool stopped = (MonotonicTime::now() - m_stickLastEvent).seconds() > 0.03;
+        auto axis = [&](float pending, float velocity) {
+            if (stopped || !velocity || (pending > 0) != (velocity > 0))
+                return pending;
+            float step = velocity * static_cast<float>(dt);
+            if (std::abs(pending) > 3 * std::abs(step))
+                step = pending - 2 * step;
+            return std::abs(step) > std::abs(pending) ? pending : step;
+        };
+        FloatSize step { axis(m_stickPending.width(), m_stickVelocity.width()), axis(m_stickPending.height(), m_stickVelocity.height()) };
+        m_stickPending -= step;
+        event = m_stickEvent->copyWithDeltaAndVelocity(step, m_stickVelocity);
+    }
+    willProcessWheelEvent();
+    handleWheelEvent(clampAtPaintedEdge(*event), { WheelEventProcessingSteps::AsyncScrolling });
+}
