+class FrameScrollingNodeWC final : public ScrollingTreeFrameScrollingNode {
+public:
+    static Ref<FrameScrollingNodeWC> create(ScrollingTree& tree, ScrollingNodeType type, ScrollingNodeID nodeID) { return adoptRef(*new FrameScrollingNodeWC(tree, type, nodeID)); }
+
+private:
+    FrameScrollingNodeWC(ScrollingTree& tree, ScrollingNodeType type, ScrollingNodeID nodeID)
+        : ScrollingTreeFrameScrollingNode(tree, type, nodeID)
+    {
+        m_delegate = makeUnique<WCScrollingNodeDelegate>(*this);
+    }
+
+    WCScrollingNodeDelegate& delegate() const { return *static_cast<WCScrollingNodeDelegate*>(m_delegate.get()); }
+
+    bool commitStateBeforeChildren(const ScrollingStateNode& stateNode) final
+    {
+        if (!ScrollingTreeFrameScrollingNode::commitStateBeforeChildren(stateNode))
+            return false;
+        auto* frameStateNode = dynamicDowncast<ScrollingStateFrameScrollingNode>(stateNode);
+        if (!frameStateNode)
+            return false;
+        if (frameStateNode->hasChangedProperty(ScrollingStateNode::Property::RootContentsLayer))
+            m_rootContentsLayer = frameStateNode->rootContentsLayer().layerID();
+        if (frameStateNode->hasChangedProperty(ScrollingStateNode::Property::CounterScrollingLayer))
+            m_counterScrollingLayer = frameStateNode->counterScrollingLayer().layerID();
+        if (frameStateNode->hasChangedProperty(ScrollingStateNode::Property::InsetClipLayer))
+            m_insetClipLayer = frameStateNode->insetClipLayer().layerID();
+        if (frameStateNode->hasChangedProperty(ScrollingStateNode::Property::ContentShadowLayer))
+            m_contentShadowLayer = frameStateNode->contentShadowLayer().layerID();
+        if (!isRootNode())
+            wcTree(scrollingTree().get()).setSubScrollerLayer(scrollingNodeID(), scrollContainerLayer().layerID());
+        delegate().updateFromStateNode(*frameStateNode);
+        return true;
+    }
+
+    void willBeDestroyed() final
+    {
+        if (!isRootNode())
+            wcTree(scrollingTree().get()).removeSubScrollerLayer(scrollingNodeID());
+    }
+
+    WheelEventHandlingResult handleWheelEvent(const PlatformWheelEvent& wheelEvent, EventTargeting eventTargeting) final
+    {
+        if (!canHandleWheelEvent(wheelEvent, eventTargeting))
+            return WheelEventHandlingResult::unhandled();
+        bool handled = delegate().handleWheelEvent(wheelEvent);
+        delegate().updateSnapScrollState();
+        return WheelEventHandlingResult::result(handled);
+    }
+
+    void currentScrollPositionChanged(ScrollType scrollType, ScrollingLayerPositionAction action) final
+    {
+        ScrollingTreeFrameScrollingNode::currentScrollPositionChanged(scrollType, hasSynchronousScrollingReasons() ? ScrollingLayerPositionAction::Set : action);
+    }
+
+    // As RenderLayerCompositor::updateScrollLayerPosition() and the
+    // coordinated frame node: the scrolled contents layer at -position.
+    void repositionScrollingLayers() final
+    {
+        auto scrollPosition = currentScrollPosition();
+        wcTree(scrollingTree().get()).setLayerPosition(scrolledContentsLayer().layerID(), -scrollPosition);
+    }
+
+    void repositionRelatedLayers() final
+    {
+        auto& tree = wcTree(scrollingTree().get());
+        auto scrollPosition = currentScrollPosition();
+        auto layoutViewport = this->layoutViewport();
+        if (m_counterScrollingLayer)
+            tree.setLayerPosition(m_counterScrollingLayer, layoutViewport.location());
+        auto contentInsets = obscuredContentInsets();
+        if (m_insetClipLayer && m_rootContentsLayer) {
+            tree.setLayerPosition(m_insetClipLayer, LocalFrameView::insetClipLayerRect(scrollPosition, totalContentsSize(), contentInsets, sizeForVisibleContent()).location());
+            auto rootContentsPosition = LocalFrameView::positionForRootContentLayer(scrollPosition, scrollOrigin(), contentInsets, headerHeight());
+            tree.setLayerPosition(m_rootContentsLayer, rootContentsPosition);
+            if (m_contentShadowLayer)
+                tree.setLayerPosition(m_contentShadowLayer, rootContentsPosition);
+        }
+        delegate().updateVisibleLengths();
+    }
+
+    std::optional<PlatformLayerIdentifier> m_rootContentsLayer;
+    std::optional<PlatformLayerIdentifier> m_counterScrollingLayer;
+    std::optional<PlatformLayerIdentifier> m_insetClipLayer;
+    std::optional<PlatformLayerIdentifier> m_contentShadowLayer;
+};
+
+class OverflowScrollingNodeWC final : public ScrollingTreeOverflowScrollingNode {
+public:
+    static Ref<OverflowScrollingNodeWC> create(ScrollingTree& tree, ScrollingNodeID nodeID) { return adoptRef(*new OverflowScrollingNodeWC(tree, nodeID)); }
+
+private:
+    OverflowScrollingNodeWC(ScrollingTree& tree, ScrollingNodeID nodeID)
+        : ScrollingTreeOverflowScrollingNode(tree, nodeID)
+    {
+        m_delegate = makeUnique<WCScrollingNodeDelegate>(*this);
+    }
+
+    WCScrollingNodeDelegate& delegate() const { return *static_cast<WCScrollingNodeDelegate*>(m_delegate.get()); }
+
+    bool commitStateBeforeChildren(const ScrollingStateNode& stateNode) final
+    {
+        if (!ScrollingTreeOverflowScrollingNode::commitStateBeforeChildren(stateNode))
+            return false;
+        wcTree(scrollingTree().get()).setSubScrollerLayer(scrollingNodeID(), scrollContainerLayer().layerID());
+        delegate().updateFromStateNode(downcast<ScrollingStateScrollingNode>(stateNode));
+        return true;
+    }
+
+    void willBeDestroyed() final
+    {
+        wcTree(scrollingTree().get()).removeSubScrollerLayer(scrollingNodeID());
+    }
+
+    // As RenderLayerBacking::updateScrollOffset(): the offset is the scroll
+    // container's bounds origin.
+    void repositionScrollingLayers() final
+    {
+        wcTree(scrollingTree().get()).setLayerBoundsOrigin(scrollContainerLayer().layerID(), currentScrollOffset());
+        delegate().updateVisibleLengths();
+    }
+
+    WheelEventHandlingResult handleWheelEvent(const PlatformWheelEvent& wheelEvent, EventTargeting eventTargeting) final
+    {
+        if (!canHandleWheelEvent(wheelEvent, eventTargeting))
+            return WheelEventHandlingResult::unhandled();
+        return WheelEventHandlingResult::result(delegate().handleWheelEvent(wheelEvent));
+    }
+};
