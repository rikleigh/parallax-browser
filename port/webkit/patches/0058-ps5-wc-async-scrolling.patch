+
+// A number from the flag file's content ("checkerboard=200"), or fallback.
+static float asyncScrollingOption(const char* name, float fallback)
+{
+    int fd = open("/data/ps5webkit/wc-async-scroll", O_RDONLY);
+    if (fd < 0)
+        return fallback;
+    char buffer[256] = { };
+    ssize_t length = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (length <= 0)
+        return fallback;
+    size_t nameLength = strlen(name);
+    for (char* token = strtok(buffer, " \t\r\n"); token; token = strtok(nullptr, " \t\r\n")) {
+        if (!strncmp(token, name, nameLength) && token[nameLength] == '=')
+            return static_cast<float>(atof(token + nameLength + 1));
+    }
+    return fallback;
+}
