+#include <wtf/HashMap.h>
+#include <wtf/TZoneMalloc.h>
+#include <wtf/WeakPtr.h>
+
+namespace WebKit {
+
+class WebPage;
+
+// PS5 async scrolling (COMPOSITING-PLAN.md, "Async scrolling"): the WC
+// compositor lives in the title (the UI process), so the scrolling tree does
+// too, as with Cocoa's RemoteScrollingCoordinator. This side keeps the
+// scrolling state tree, sends its commits with each UpdateWC (main frame)
+// and applies the scroll positions the title reports back.
+class WCScrollingCoordinator final : public WebCore::AsyncScrollingCoordinator {
+    WTF_MAKE_TZONE_ALLOCATED(WCScrollingCoordinator);
+public:
+    static Ref<WCScrollingCoordinator> create(WebPage* page)
+    {
+        return adoptRef(*new WCScrollingCoordinator(page));
+    }
+
+    // The page's coordinator when async scrolling is on for it (WebChromeClient
+    // makes one for DrawingAreaWC pages with threaded scrolling enabled).
+    static WCScrollingCoordinator* forPage(const WebPage&);
+
+    // DrawingAreaWC::sendUpdateAC, for the main frame's update.
+    RemoteScrollingCoordinatorTransaction buildTransaction(WebCore::FrameIdentifier rootFrameID);
+
+    // From the title (DrawingArea::ScrollUpdatesWC).
+    void applyScrollUpdatesFromTitle(Vector<WebCore::ScrollUpdate>&&);
+
+    struct NodeAndGestureState {
+        std::optional<WebCore::ScrollingNodeID> wheelGestureNode;
+        std::optional<WebCore::WheelScrollGestureState> wheelGestureState;
+    };
+    // WebPage::handleWheelEvent: which node the main thread chose to scroll
+    // (the title's tree scrolls it after the reply).
+    NodeAndGestureState takeCurrentWheelGestureInfo() { return std::exchange(m_currentWheelGestureInfo, { }); }
+
+private:
+    explicit WCScrollingCoordinator(WebPage*);
+    virtual ~WCScrollingCoordinator();
+
+    // ScrollingCoordinator
+    bool coordinatesScrollingForFrameView(const WebCore::LocalFrameView&) const override;
+    void scheduleTreeStateCommit() override;
+    void willSendScrollPositionRequest(WebCore::ScrollingNodeID, WebCore::RequestedScrollData&) override;
+    WebCore::WheelEventHandlingResult handleWheelEventForScrolling(const WebCore::PlatformWheelEvent&, WebCore::ScrollingNodeID, std::optional<WebCore::WheelScrollGestureState>) override;
+    void startMonitoringWheelEvents(bool clearLatchingState) final;
+    // AsyncScrollingCoordinator's version talks to a local tree (there is none here).
+    void setScrollPinningBehavior(WebCore::ScrollPinningBehavior) final { }
+
+    void scrollUpdateForNode(WebCore::ScrollUpdate&&);
+
+    WeakPtr<WebPage> m_webPage;
+    std::optional<WebCore::PageIdentifier> m_pageIdentifier;
+
+    struct PendingScrollResponseInfo {
+        Markable<WebCore::ScrollRequestIdentifier> identifier;
+        bool pendingScrollEnd { false };
+    };
+    HashMap<WebCore::ScrollingNodeID, PendingScrollResponseInfo> m_scrollRequestsPendingResponse;
+    NodeAndGestureState m_currentWheelGestureInfo;
+    bool m_clearScrollLatchingInNextTransaction { false };
+};
+
