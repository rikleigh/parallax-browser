+
+// One message in flight: a WebProcess whose main thread is busy gets the
+// newest positions (merged per node by the tree) when it answers.
+void DrawingAreaProxyWCPS5::sendScrollUpdatesNow()
+{
+    if (!m_scrollingTree || m_waitingForScrollUpdateReply)
+        return;
+    auto updates = m_scrollingTree->takePendingScrollUpdates();
+    if (updates.isEmpty())
+        return;
+    m_waitingForScrollUpdateReply = true;
+    sendWithAsyncReply(Messages::DrawingArea::ScrollUpdatesWC(WTF::move(updates), m_scrollingTree->scrollVelocity()), [sceneID = identifier().toUInt64()] {
+        RefPtr protectedThis = liveDrawingAreas().get(sceneID);
+        if (!protectedThis)
+            return;
+        protectedThis->m_waitingForScrollUpdateReply = false;
+        if (protectedThis->m_scrollingTree && protectedThis->m_scrollingTree->hasPendingScrollUpdates())
+            protectedThis->sendScrollUpdatesNow();
+    });
+}
+
+// The wheel event (the pad's right stick) is handled here when nothing on the
+// page has to see it first: the title's tree scrolls, the frame shows it at
+// the next vsync, and the WebProcess hears about the new position after.
+// Blocking wheel listeners, synchronous scrolling reasons and sub-scrollers
+// (overflow boxes, iframes: their node is picked by the WebProcess's hit
+// test) go to the WebProcess first, whose default handling names the node
+// this tree then scrolls (wheelEventHandlingCompleted).
+bool DrawingAreaProxyWCPS5::handleWheelEvent(Ref<WebWheelEvent>&& wheelEvent)
+{
+    if (!m_scrollingTree)
+        return false;
+    RefPtr page = this->page();
+    if (!page)
+        return false;
+
+    auto platformWheelEvent = platform(wheelEvent.get());
+    OptionSet<WebCore::WheelEventProcessingSteps> steps;
+    if (m_scrollingTree->pointIsInSubScroller(platformWheelEvent.position()) || m_scrollingTree->rootHasSynchronousScrollingReasons())
+        steps = { WebCore::WheelEventProcessingSteps::SynchronousScrolling, WebCore::WheelEventProcessingSteps::BlockingDOMEventDispatch };
+    else
+        steps = m_scrollingTree->determineWheelEventProcessing(platformWheelEvent);
+
+    if (!steps.contains(WebCore::WheelEventProcessingSteps::AsyncScrolling)) {
+        PS5WCHost::noteWheelEventRouting(false);
+        page->continueWheelEventHandling(WTF::move(wheelEvent), { steps, false }, std::nullopt);
+        return true;
+    }
+
+    // Never past what is painted: the WebProcess has tiles for its visible
+    // rect plus max(one tile row, half the view) (GraphicsLayerWC's coverage
+    // margin; none while coverage is reduced) around its own scroll position.
+    // Scrolling stops at that edge until it catches up (checkerboard=<px> in
+    // the flag file lets it go that much further, showing the background).
+    if (auto rootPosition = m_scrollingTree->rootScrollPosition()) {
+        if (auto webProcessPosition = m_scrollingTree->webProcessScrollPosition()) {
+            // The margins the WebProcess reported with that update (its
+            // coverage, more ahead in the scroll direction since AS3).
+            auto [above, below] = m_scrollingTree->webProcessPaintedMargins();
+            if (PS5WCHost::tileCoverageReduced())
+                above = below = 0;
+            float limitAbove = above + m_checkerboardPx, limitBelow = below + m_checkerboardPx;
+            float limitX = (PS5WCHost::tileCoverageReduced() ? 0.f : 512.f) + m_checkerboardPx;
+            auto delta = platformWheelEvent.delta();
+            auto clampAxis = [&](float current, float webProcess, float d, float limitBefore, float limitAfter) {
+                float wanted = current - d;
+                float low = std::min(webProcess - limitBefore, current), high = std::max(webProcess + limitAfter, current);
+                float allowed = std::clamp(wanted, low, high);
+                if (allowed != wanted)
+                    PS5WCHost::noteScrollClamped(wanted - allowed);
+                return current - allowed;
+            };
+            WebCore::FloatSize clamped { clampAxis(rootPosition->x(), webProcessPosition->x(), delta.width(), limitX, limitX), clampAxis(rootPosition->y(), webProcessPosition->y(), delta.height(), limitAbove, limitBelow) };
+            if (clamped != delta)
+                platformWheelEvent = platformWheelEvent.copyWithDeltaAndVelocity(clamped, platformWheelEvent.scrollingVelocity());
+        }
+    }
+
+    m_scrollingTree->willProcessWheelEvent();
+    auto result = m_scrollingTree->handleWheelEvent(platformWheelEvent, steps);
+    PS5WCHost::noteWheelEventRouting(true);
+    if (PS5WCHost::sceneHasWheelEventListeners(identifier().toUInt64()))
+        dispatchWheelEventToDOM(wheelEvent.copyRef());
+    // Done for the coalescer: the next event is handled at once, whatever the
+    // WebProcess is doing.
+    page->continueWheelEventHandling(WTF::move(wheelEvent), { { }, result.wasHandled }, std::nullopt);
+    return true;
+}
