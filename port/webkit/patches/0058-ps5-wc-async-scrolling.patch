+Region Document::ps5AbsoluteRegionForNonPassiveWheelEventTargets()
+{
+    LayoutDisallowedScope layoutDisallowedScope(LayoutDisallowedScope::Reason::ReentrancyAvoidance);
+
+    Region targetRegion;
+    for (auto keyValuePair : m_wheelEventTargets) {
+        Ref node = keyValuePair.key;
+        bool nonPassive = ps5HasNonPassiveWheelListener(node);
+        if (!nonPassive) {
+            // Listeners on the window are tracked with the document as target.
+            if (RefPtr document = dynamicDowncast<Document>(node)) {
+                if (RefPtr window = document->window())
+                    nonPassive = ps5HasNonPassiveWheelListener(*window);
+            }
+        }
+        if (nonPassive)
+            targetRegion.unite(absoluteEventRegionForNode(node).first);
+    }
+    return targetRegion;
+}
+#endif
