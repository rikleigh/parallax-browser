+        return { 0, 0 };
+    // As WCTiledBacking::updateCoverageRect for the frame's contents layer
+    // (its visible rect is the viewport inflated by 20 px).
+    int height = viewportHeight + 40;
+    int margin = std::max(512, height / 2) + 20;
+    int ahead = scrollAhead(height);
+    return { margin + std::max(0, -ahead), margin + std::max(0, ahead) };
