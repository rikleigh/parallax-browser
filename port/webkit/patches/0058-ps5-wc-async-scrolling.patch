+class PositionedNodeWC final : public ScrollingTreePositionedNode {
+public:
+    static Ref<PositionedNodeWC> create(ScrollingTree& tree, ScrollingNodeID nodeID) { return adoptRef(*new PositionedNodeWC(tree, nodeID)); }
+
+private:
+    PositionedNodeWC(ScrollingTree& tree, ScrollingNodeID nodeID)
