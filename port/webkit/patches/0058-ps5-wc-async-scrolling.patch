+// Render thread, after a swap: a frame that moved the shown page ends the
+// latency of the oldest pad input not yet shown.
+void SceneHost::noteScrollPresent()
+{
+    bool movedByUpdate = std::exchange(m_scrollMovedByUpdate, false);
+    bool movedByTitle = std::exchange(m_scrollMovedByTitle, false);
+    if (movedByUpdate || movedByTitle) {
+        m_scrollStats.movedFrames++;
+        if (movedByUpdate)
+            m_scrollStats.movedByUpdate++;
+        int64_t oldest = m_oldestScrollInputUS.exchange(0);
+        if (oldest) {
+            double ms = (MonotonicTime::now().secondsSinceEpoch().microseconds() - oldest) / 1000.0;
+            if (ms >= 0 && ms < 1000)
+                m_scrollStats.latenciesMS.append(ms);
+            else
+                m_scrollStats.staleInputs++;
+        }
+    }
+    maybeLogScroll();
+}
+
+void SceneHost::maybeLogScroll()
+{
+    auto now = MonotonicTime::now();
+    double seconds = (now - m_scrollStats.start).seconds();
+    if (seconds < 1)
+        return;
+    unsigned inputs = m_scrollInputs.exchange(0);
+    unsigned asyncEvents = m_asyncWheelEvents.exchange(0), syncEvents = m_syncWheelEvents.exchange(0), clampedEvents = m_clampedWheelEvents.exchange(0);
+    uint64_t clampedPx = m_clampedPx.exchange(0);
+    if (asyncEvents || syncEvents || m_scrollStats.commits) {
+        WTFLogAlways("[ascroll] %.1f s: wheel events in the title %u, sent to the WebProcess first %u; clamped at the painted edge %u (%llu px); " // NOLINT
+            "lead over the WebProcess %.0f px avg, %.0f max; %u tree commits",
+            seconds, asyncEvents, syncEvents, clampedEvents, static_cast<unsigned long long>(clampedPx),
+            m_scrollStats.leadSamples ? m_scrollStats.leadPx / m_scrollStats.leadSamples : 0.0, m_scrollStats.leadMaxPx, m_scrollStats.commits);
+    }
+    if (m_scrollStats.movedFrames || inputs) {
+        auto& latencies = m_scrollStats.latenciesMS;
+        std::sort(latencies.begin(), latencies.end());
+        double sum = 0;
+        for (double ms : latencies)
+            sum += ms;
+        auto at = [&](double q) { return latencies.isEmpty() ? 0.0 : latencies[std::min<size_t>(latencies.size() - 1, static_cast<size_t>(q * latencies.size()))]; };
+        WTFLogAlways("[ascroll] %.1f s: %u frames moved the page (%u by WebProcess updates, %u by the title); %u pad wheel events; " // NOLINT
+            "pad -> present %.1f ms avg, p50 %.1f, p95 %.1f, max %.1f (%zu, %u stale); step %.1f px avg, %.0f max",
+            seconds, m_scrollStats.movedFrames, m_scrollStats.movedByUpdate, m_scrollStats.movedFrames - m_scrollStats.movedByUpdate, inputs,
+            latencies.isEmpty() ? 0.0 : sum / latencies.size(), at(0.5), at(0.95), latencies.isEmpty() ? 0.0 : latencies.last(), latencies.size(), m_scrollStats.staleInputs,
+            m_scrollStats.updatesWithScroll ? m_scrollStats.stepPx / m_scrollStats.updatesWithScroll : 0.0, m_scrollStats.stepMaxPx);
+    }
+    m_scrollStats = { };
+    m_scrollStats.start = now;
+}
