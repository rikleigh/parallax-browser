+void DrawingAreaProxyWCPS5::wheelEventHandlingCompleted(const WebCore::PlatformWheelEvent& wheelEvent, std::optional<WebCore::ScrollingNodeID> nodeID, std::optional<WebCore::WheelScrollGestureState> gestureState, bool wasHandled)
+{
