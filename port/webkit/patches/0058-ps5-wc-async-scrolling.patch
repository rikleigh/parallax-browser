+void PS5WCScrollingTree::commit(RemoteScrollingCoordinatorTransaction&& transaction)
+{
+    auto& stateTree = transaction.scrollingStateTree();
+    if (stateTree && stateTree->hasChangedProperties()) {
+        stateTree->setRootFrameIdentifier(transaction.rootFrameIdentifier());
+        commitTreeState(WTF::move(stateTree));
+    }
+    if (transaction.clearScrollLatching())
+        clearLatchedNode();
+    // Every node writes its layer's place again: the table then holds
+    // exactly the layers of the nodes there are now.
+    {
+        Locker locker { treeLock() };
+        m_layerPositions.clear();
+        m_layerPositionsVersion++;
+    }
+    setNeedsApplyLayerPositions();
+    applyLayerPositions();
+}
+
+bool PS5WCScrollingTree::copyLayerPositionsIfChanged(LayerPositions& positions, uint64_t& version)
+{
+    Locker locker { treeLock() };
+    if (version == m_layerPositionsVersion)
+        return false;
+    positions = m_layerPositions;
+    version = m_layerPositionsVersion;
+    return true;
+}
