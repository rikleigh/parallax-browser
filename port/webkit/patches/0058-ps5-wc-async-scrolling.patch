+    SceneHost::singleton().requestFrameNow();
+}
+
+void PS5WCHost::noteScrollInput(MonotonicTime eventTime)
+{
+    auto& host = SceneHost::singleton();
+    host.m_scrollInputs++;
+    int64_t expected = 0;
+    host.m_oldestScrollInputUS.compare_exchange_strong(expected, static_cast<int64_t>(eventTime.secondsSinceEpoch().microseconds()));
+}
