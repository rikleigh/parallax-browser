+WCScrollingCoordinator::~WCScrollingCoordinator()
+{
+    auto it = coordinatorsByPage().find(*m_pageIdentifier);
+    if (it != coordinatorsByPage().end() && it->value == this)
+        coordinatorsByPage().remove(it);
+}
