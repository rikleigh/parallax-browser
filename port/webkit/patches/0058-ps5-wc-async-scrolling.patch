+// ScrollingEffectsController's work for a node (wheel deltas, snapping,
+// animated scrolls). Its snap timer runs on the main run loop whatever
+// thread asks for it (the render thread has no run loop).
+class WCScrollingNodeDelegate final : public ThreadedScrollingTreeScrollingNodeDelegate {
+public:
+    explicit WCScrollingNodeDelegate(ScrollingTreeScrollingNode& node)
+        : ThreadedScrollingTreeScrollingNodeDelegate(node)
+    {
+    }
+
+    void updateVisibleLengths() { m_scrollController.contentsSizeChanged(); }
+
+    bool handleWheelEvent(const PlatformWheelEvent& wheelEvent)
+    {
+        updateUserScrollInProgressForEvent(wheelEvent);
+        return m_scrollController.handleWheelEvent(wheelEvent);
+    }
+
+    using ThreadedScrollingTreeScrollingNodeDelegate::updateFromStateNode;
+
+private:
+    bool scrollAnimationEnabled() const final { return true; }
+
+    std::unique_ptr<ScrollingEffectsControllerTimer> createTimer(Function<void()>&& function) final
+    {
+        return makeUnique<ScrollingEffectsControllerTimer>(RunLoop::mainSingleton(), [function = WTF::move(function), tree = scrollingTree()] {
+            if (!tree)
+                return;
+            Locker locker { tree->treeLock() };
+            function();
+        });
+    }
+
+    void destroyTimer(std::unique_ptr<ScrollingEffectsControllerTimer> timer) final
+    {
+        if (isMainRunLoop())
+            return;
+        RunLoop::mainSingleton().dispatch([timer = WTF::move(timer)] { });
+    }
+};
