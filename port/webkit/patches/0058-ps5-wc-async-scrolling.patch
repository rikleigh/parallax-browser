+static int scrollAhead(int visibleHeight)
+{
+    static const double lookahead = [] {
+        const char* value = getenv("PS5WK_WC_LOOKAHEAD_MS");
+        return (value ? atof(value) : 350.0) / 1000.0;
+    }();
+    if (GraphicsLayerWC::tileCoverageReduced() || visibleHeight <= 0)
+        return 0;
+    double velocity = GraphicsLayerWC::scrollVelocity().height();
+    double ahead = std::min(std::abs(velocity) * lookahead, 2.0 * visibleHeight);
+    if (ahead < 64)
+        return 0;
+    return velocity > 0 ? static_cast<int>(ahead) : -static_cast<int>(ahead);
+}
