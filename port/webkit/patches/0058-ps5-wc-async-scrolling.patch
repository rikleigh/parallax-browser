+static bool ps5HasNonPassiveWheelListener(EventTarget& target)
+{
+    for (auto& type : { eventNames().wheelEvent, eventNames().mousewheelEvent }) {
+        for (auto& listener : target.eventListeners(type)) {
+            if (!listener->isPassive())
