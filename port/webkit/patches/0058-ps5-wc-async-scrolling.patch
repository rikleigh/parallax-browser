+// Render thread, each frame: animations at the frame's display time, then
+// the layer positions of everything that scrolled since the last frame (the
+// tree only marks them on a scroll: ScrollingTree::scrollingTreeNodeDidScroll).
+void PS5WCScrollingTree::serviceAnimations(MonotonicTime time)
+{
+    {
+        Locker locker { treeLock() };
+        serviceScrollAnimations(time);
+    }
+    applyLayerPositions();
+}
