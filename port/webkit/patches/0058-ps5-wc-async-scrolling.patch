+class StickyNodeWC final : public ScrollingTreeStickyNode {
+public:
+    static Ref<StickyNodeWC> create(ScrollingTree& tree, ScrollingNodeID nodeID) { return adoptRef(*new StickyNodeWC(tree, nodeID)); }
+
+private:
+    StickyNodeWC(ScrollingTree& tree, ScrollingNodeID nodeID)
+        : ScrollingTreeStickyNode(tree, nodeID)
+    {
+    }
+
+    ScrollingPlatformLayer* layer() const final { return nullptr; }
+
+    bool commitStateBeforeChildren(const ScrollingStateNode& stateNode) final
