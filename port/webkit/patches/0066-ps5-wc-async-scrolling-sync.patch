+void SceneHost::syncWithWebProcess(uint64_t sceneID, int64_t displayUS)
+{
+    m_syncRanThisFrame = true;
+    auto tree = DrawingAreaProxyWCPS5::scrollingTreeForScene(sceneID);
+    if (!tree || !DrawingAreaProxyWCPS5::syncForScene(sceneID)) {
+        releaseHeldReplies();
+        return;
+    }
+    // This frame's scroll positions: the tree posts them to the main thread,
+    // which sends them on (ScrollUpdatesWC). The replies go after them on the
+    // same queue and connection, so the rendering update they start sees
+    // this frame's position.
+    tree->serviceAnimations(MonotonicTime::now() + Seconds::fromMicroseconds(displayUS - g_get_monotonic_time()));
+    m_treeServicedThisFrame = true;
+    releaseHeldReplies();
+
+    auto target = tree->rootScrollPosition();
+    if (!target || m_treePositionsScene != sceneID || !m_lastPaintedTreePosition || samePosition(*m_lastPaintedTreePosition, *target))
+        return; // the root doesn't move this frame: nothing to keep in step
+    if (auto webProcess = tree->webProcessScrollPosition(); webProcess && samePosition(*webProcess, *target)) {
+        m_scrollStats.syncAlready++;
+        return;
+    }
+    // Wait for it until the scene must be painted to make the vsync.
+    double reserveMS = s_syncReserveMS.load();
+    int64_t deadlineUS = displayUS - static_cast<int64_t>(std::max(reserveMS, m_paintEstimateMS + reserveMS - 3) * 1000);
+    int64_t startUS = g_get_monotonic_time();
+    if (deadlineUS - startUS <= 500)
+        return;
+    m_scrollStats.syncWaits++;
+    bool inTime = false;
+    for (;;) {
+        int64_t waitUS = std::min<int64_t>(deadlineUS - g_get_monotonic_time(), 14000);
+        if (waitUS > 0 && !hasPending()) {
+            Locker locker { m_lock };
+            m_stateChanged.waitFor(m_lock, Seconds::fromMicroseconds(waitUS), [&] {
+                return !m_queue.isEmpty();
+            });
+        }
+        if (!hasPending())
+            break;
+        applyPending();
+        auto webProcess = tree->webProcessScrollPosition();
+        if (webProcess && samePosition(*webProcess, *target)) {
+            // Its reply stays held: it goes with the next frame's position.
+            inTime = true;
+            break;
+        }
+        // An update made before this position came: answer it, so the
+        // WebProcess makes the next one at the position it has now.
+        m_scrollStats.syncStale++;
+        releaseHeldReplies();
+        if (!m_shownPage || *m_shownPage != sceneID)
+            break;
+    }
+    double waitedMS = (g_get_monotonic_time() - startUS) / 1000.0;
+    m_scrollStats.syncWaitMS += waitedMS;
+    m_scrollStats.syncWaitMaxMS = std::max(m_scrollStats.syncWaitMaxMS, waitedMS);
+    if (inTime)
+        m_scrollStats.syncInTime++;
+    else
+        m_scrollStats.syncMissed++;
+}
