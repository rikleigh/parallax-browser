+
+static bool samePosition(FloatPoint a, FloatPoint b)
+{
+    // The WebProcess's frame view has integer scroll positions; the title's
+    // frame-locked steps have fractions.
+    return std::abs(a.x() - b.x()) < 1 && std::abs(a.y() - b.y()) < 1;
+}
