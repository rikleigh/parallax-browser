+namespace WebKit {
+
+// The in-title WebProcess's pages, for closing them when the UI process lets
+// go of it: "Restart page", Safer browsing, a crash test. A payload exits
+// then; this one stays (one per title) and would keep its pages, their
+// scripts and workers (a game's emulator, its sound) running unseen.
+static HashSet<WebCore::PageIdentifier>& inTitlePages()
+{
+    static NeverDestroyed<HashSet<WebCore::PageIdentifier>> pages;
+    return pages;
+}
+
+// The page's scripts run on the title's main thread, beside the browser's
+// own UI. A script that doesn't return (a loop, a hung page) would freeze
+// the menu, the address bar and the controller: JSC's watchdog stops a
+// script after PS5WK_SCRIPT_LIMIT_S seconds of CPU time per entry (default
+// 10, 0 for none), as JSContextGroupSetExecutionTimeLimit does. The script
+// ends with an uncatchable termination; the page and its later scripts go on.
+static bool scriptTimeLimitReached(JSC::JSGlobalObject*, void*, void*)
+{
+    WTFLogAlways("[web-in-title] a page script ran on the title's main thread past its time limit (PS5WK_SCRIPT_LIMIT_S): stopped it");
+    return true;
+}
+
+static void installScriptTimeLimit()
+{
+    static bool installed;
+    if (installed)
+        return;
+    installed = true;
+    const char* value = getenv("PS5WK_SCRIPT_LIMIT_S");
+    double seconds = value && *value ? atof(value) : 10;
+    if (seconds <= 0) {
+        WTFLogAlways("[web-in-title] no script time limit (PS5WK_SCRIPT_LIMIT_S=%s)", value);
+        return;
+    }
+    auto& vm = WebCore::commonVM();
+    JSC::JSLockHolder lock(vm);
+    vm.ensureWatchdog().setTimeLimit(Seconds(seconds), scriptTimeLimitReached);
+    WTFLogAlways("[web-in-title] page scripts on the main thread stop after %.0f s of CPU time (PS5WK_SCRIPT_LIMIT_S)", seconds);
+}
+
+void ps5InTitlePageCreated(WebCore::PageIdentifier identifier)
+{
+    inTitlePages().add(identifier);
+    installScriptTimeLimit();
+}
+
+void ps5InTitlePageRemoved(WebCore::PageIdentifier identifier)
+{
+    inTitlePages().remove(identifier);
+}
+
+void ps5InTitleWebProcessConnectionClosed()
+{
+    auto pages = copyToVector(inTitlePages());
+    unsigned closed = 0;
+    for (auto identifier : pages) {
+        if (RefPtr page = WebProcess::singleton().webPage(identifier)) {
+            page->close([] { });
+            closed++;
+        }
+    }
+    inTitlePages().clear();
+    WTFLogAlways("[web-in-title] closed %u page(s) of the in-title WebProcess; new pages run in payload WebProcesses until the browser restarts", closed);
+}
+
+} // namespace WebKit
