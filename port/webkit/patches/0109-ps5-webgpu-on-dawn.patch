+#include "Device.h"
+#include "ProgrammableStage.h"
+
+namespace WebGPU::Dawn {
+
+namespace {
+
+// A wgpu::ComputePipelineDescriptor and what it points to. It points into itself, so it stays
+// where it is made.
+struct ConvertedDescriptor {
+    WTF_MAKE_NONCOPYABLE(ConvertedDescriptor);
+public:
+    ConvertedDescriptor(const ComputePipelineDescriptor& descriptor, const wgpu::PipelineLayout* layoutOverride)
+        : label(descriptor.label.utf8())
+        , compute(descriptor.compute)
+    {
+        dawnDescriptor.label = stringView(label);
+        dawnDescriptor.layout = pipelineLayout(descriptor.layout, layoutOverride);
+        compute.apply(dawnDescriptor.compute);
+    }
+
+    UTF8CString label;
+    ProgrammableStageConverter compute;
+    wgpu::ComputePipelineDescriptor dawnDescriptor;
+};
+
+} // namespace
+
+RefPtr<ComputePipeline> DeviceImpl::createComputePipeline(const ComputePipelineDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createcomputepipeline
+    ConvertedDescriptor converted { descriptor, nullptr };
+    return ComputePipelineImpl::create(m_device.CreateComputePipeline(&converted.dawnDescriptor), wgpu::PipelineLayout { converted.dawnDescriptor.layout });
+}
+
+void DeviceImpl::createComputePipelineAsync(const ComputePipelineDescriptor& descriptor, const wgpu::PipelineLayout* layoutOverride, ComputePipelineCallback&& callback)
+{
+    // Without the instance nothing calls Dawn's callbacks, and the device is destroyed.
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        callback(std::unexpected(PipelineError { PipelineErrorReason::Internal, "The device is lost."_s }));
+        return;
+    }
+
+    ConvertedDescriptor converted { descriptor, layoutOverride };
+    m_device.CreateComputePipelineAsync(&converted.dawnDescriptor, wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback)), layout = converted.dawnDescriptor.layout](wgpu::CreatePipelineAsyncStatus status, wgpu::ComputePipeline pipeline, wgpu::StringView message) {
+        if (status != wgpu::CreatePipelineAsyncStatus::Success || !pipeline) {
+            pending->handler()(std::unexpected(pipelineError(status, message)));
+            return;
+        }
+        pending->handler()(Ref<ComputePipeline> { ComputePipelineImpl::create(WTF::move(pipeline), wgpu::PipelineLayout { layout }) });
+    });
+}
+
+void DeviceImpl::createComputePipelineAsync(const ComputePipelineDescriptor& descriptor, CompletionHandler<void(std::expected<Ref<ComputePipeline>, PipelineError>&&)>&& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createcomputepipelineasync
+    createComputePipelineAsync(descriptor, nullptr, WTF::move(callback));
+}
+
+void DeviceImpl::createComputePipelineWithPipelineLayoutFromPipelineAsync(const ComputePipelineDescriptor& descriptor, const ComputePipeline& pipelineToReplace, CompletionHandler<void(std::expected<Ref<ComputePipeline>, PipelineError>&&)>&& callback)
+{
+    // This is how a shader that Web Inspector edits replaces the pipeline that uses it. The Metal
+    // implementation creates the new pipeline with the layout object of the old one, so that
+    // the bind groups that were made for the old one stay usable, and reports no errors.
+    //
+    // Dawn has no way to hand a pipeline the layout that another one generated ("auto"): each
+    // pipeline that generates its layout gets bind group layouts that only it accepts. So a
+    // pipeline that was created with a layout is replaced by one with the same layout, and one
+    // that generated its layout is replaced by one that generates it again. For the latter the
+    // page's existing bind groups do not validate against the new pipeline.
+    bool wasErrorReportingPaused = m_errorReportingPaused;
+    pauseAllErrorReporting(true);
+    createComputePipelineAsync(descriptor, &fromAPI(pipelineToReplace).layout(), WTF::move(callback));
+    pauseAllErrorReporting(wasErrorReportingPaused);
+}
+
+Ref<BindGroupLayout> ComputePipelineImpl::getBindGroupLayout(uint32_t index)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpupipelinebase-getbindgrouplayout
+    // An index that is out of range is a validation error and an invalid layout.
+    return BindGroupLayoutImpl::create(m_pipeline.GetBindGroupLayout(index));
+}
+
+void ComputePipelineImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_pipeline.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
