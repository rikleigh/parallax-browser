+#include "config.h"
+#include "Queue.h"
+
+#include "Buffer.h"
+#include "CommandBuffer.h"
+#include "Conversions.h"
+#include "Texture.h"
+
+namespace WebGPU::Dawn {
+
+void QueueImpl::submit(Vector<Ref<CommandBuffer>>&& commandBuffers)
+{
+    auto dawnCommandBuffers = commandBuffers.map([](auto& commandBuffer) {
+        return fromAPI(commandBuffer.get()).dawnCommandBuffer();
+    });
+    m_queue.Submit(dawnCommandBuffers.size(), dawnCommandBuffers.span().data());
+
+    // A submit is where a failing driver loses the device, and Dawn frees what the submitted
+    // work kept alive only when its events are processed.
+    if (RefPtr instance = m_instance.get())
+        instance->pumpSoon();
+}
+
+void QueueImpl::onSubmittedWorkDone(CompletionHandler<void()>&& callback)
+{
+    // Without the instance nothing calls Dawn's callbacks, and the device is destroyed.
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        callback();
+        return;
+    }
+
+    // The status is not reported: the work is done, or the device is gone and it never will be.
+    m_queue.OnSubmittedWorkDone(wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback))](wgpu::QueueWorkDoneStatus, wgpu::StringView) {
+        pending->handler()();
+    });
+}
+
+void QueueImpl::writeBuffer(Buffer& buffer, uint64_t bufferOffset, std::span<const uint8_t> data)
+{
+    // Dawn copies the data into its own staging memory before this returns, whatever its size.
+    m_queue.WriteBuffer(fromAPI(buffer).dawnBuffer(), bufferOffset, data.data(), data.size());
+}
+
+void QueueImpl::writeTexture(const TexelCopyTextureInfo& destination, std::span<const uint8_t> data, const TexelCopyBufferLayout& dataLayout, const Extent3D& writeSize)
+{
+    auto dawnDestination = toDawn(destination);
+    auto dawnDataLayout = toDawn(dataLayout);
+    auto dawnWriteSize = toDawn(writeSize);
+    m_queue.WriteTexture(&dawnDestination, data.data(), data.size(), &dawnDataLayout, &dawnWriteSize);
+}
+
+void QueueImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_queue.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
