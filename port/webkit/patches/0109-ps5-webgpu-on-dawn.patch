+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "Buffer.h"
+
+#include "Conversions.h"
+#include <wtf/CheckedArithmetic.h>
+#include <wtf/StdLibExtras.h>
+
+namespace WebGPU::Dawn {
+
+RefPtr<Buffer> DeviceImpl::createBuffer(const BufferDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createbuffer
+    auto label = descriptor.label.utf8();
+
+    wgpu::BufferDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.usage = toDawn(descriptor.usage);
+    dawnDescriptor.size = descriptor.size;
+    dawnDescriptor.mappedAtCreation = descriptor.mappedAtCreation;
+
+    bool mappedAtCreation = descriptor.mappedAtCreation;
+    wgpu::Buffer buffer = m_device.CreateBuffer(&dawnDescriptor);
+    if (!buffer) {
+        // Dawn returns no buffer at all when it cannot allocate the mapping of a buffer that is
+        // mapped at creation (the RangeError of createBuffer()). The caller needs an object, so
+        // this is an invalid buffer and an out-of-memory error.
+        m_device.InjectError(wgpu::ErrorType::OutOfMemory, "GPUDevice.createBuffer: the mapping could not be allocated");
+        dawnDescriptor.mappedAtCreation = false;
+        mappedAtCreation = false;
+        buffer = m_device.CreateErrorBuffer(&dawnDescriptor);
+    }
+    return BufferImpl::create(WTF::move(buffer), descriptor.size, mappedAtCreation, *this);
+}
+
+BufferImpl::BufferImpl(wgpu::Buffer&& buffer, uint64_t size, bool mappedAtCreation, DeviceImpl& device)
+    : m_buffer(WTF::move(buffer))
+    , m_device(device)
+    , m_size(size)
+{
+    if (mappedAtCreation && isInBounds<size_t>(size)) {
+        m_state = State::MappedForWriting;
+        m_mappingSize = static_cast<size_t>(size);
+    }
+}
+
+void BufferImpl::mapAsync(OptionSet<MapMode> mode, uint64_t offset, std::optional<uint64_t> size, CompletionHandler<void(bool)>&& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpubuffer-mapasync
+    // Dawn validates the mode, the range, the usage and the state. A failure is a validation
+    // error on the device and a callback with an error status.
+    uint64_t rangeSize = size ? *size : (offset <= m_size ? m_size - offset : 0);
+    if (!isInBounds<size_t>(offset) || !isInBounds<size_t>(rangeSize)) {
+        m_device->generateAValidationError("GPUBuffer.mapAsync: the range is not in the buffer"_s);
+        callback(false);
+        return;
+    }
+
+    // Without the instance nothing calls Dawn's callbacks, and the device is destroyed.
+    RefPtr instance = m_device->instance();
+    if (!instance) {
+        callback(false);
+        return;
+    }
+
+    bool canStartMapping = m_state == State::Unmapped;
+    uint64_t generation = m_mappingGeneration;
+    if (canStartMapping) {
+        generation = ++m_mappingGeneration;
+        m_state = State::MappingPending;
+    }
+
+    // A std::nullopt size is passed on as such: Dawn then reports a range that starts after the
+    // end of the buffer.
+    m_buffer.MapAsync(toDawn(mode), static_cast<size_t>(offset), size ? static_cast<size_t>(rangeSize) : wgpu::kWholeMapSize, wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback)), protectedThis = Ref { *this }, canStartMapping, generation, mode, offset, rangeSize](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        bool success = status == wgpu::MapAsyncStatus::Success;
+        // The buffer was unmapped or destroyed in the meantime when the generations differ. Dawn
+        // aborts the mapping then, so this is for the order of the callbacks only.
+        if (canStartMapping && protectedThis->m_mappingGeneration == generation && protectedThis->m_state == State::MappingPending) {
+            if (success) {
+                protectedThis->m_state = mode.contains(MapMode::Write) ? State::MappedForWriting : State::MappedForReading;
+                protectedThis->m_mappingOffset = static_cast<size_t>(offset);
+                protectedThis->m_mappingSize = static_cast<size_t>(rangeSize);
+            } else
+                protectedThis->m_state = State::Unmapped;
+        }
+        pending->handler()(success);
+    });
+}
+
+std::span<uint8_t> BufferImpl::mappedSpan(size_t offset, size_t size)
+{
+    // Dawn checks the alignment of the range (the offset to 8 bytes, the size to 4) and that it
+    // lies in the mapping, and returns null otherwise. A mapping for reading has no writable
+    // range, and the callers of getMappedRange() only read from one.
+    void* data = nullptr;
+    if (m_state == State::MappedForWriting)
+        data = m_buffer.GetMappedRange(offset, size);
+    else if (m_state == State::MappedForReading)
+        data = const_cast<void*>(m_buffer.GetConstMappedRange(offset, size));
+    if (!data)
+        return { };
+    return unsafeMakeSpan(static_cast<uint8_t*>(data), size);
+}
+
+void BufferImpl::getMappedRange(uint64_t offset, std::optional<uint64_t> size, NOESCAPE const Function<void(std::span<uint8_t>)>& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpubuffer-getmappedrange
+    uint64_t rangeSize = size ? *size : (offset <= m_size ? m_size - offset : 0);
+    if (!isInBounds<size_t>(offset) || !isInBounds<size_t>(rangeSize)) {
+        callback({ });
+        return;
+    }
+
+    auto range = mappedSpan(static_cast<size_t>(offset), static_cast<size_t>(rangeSize));
+    // Once getBufferContents() has made the shadow copy, that is where the writes are.
+    if (!range.empty() && !m_shadowContents.isEmpty())
+        range = m_shadowContents.mutableSpan().subspan(static_cast<size_t>(offset), static_cast<size_t>(rangeSize));
+    callback(range);
+}
+
+std::span<uint8_t> BufferImpl::getBufferContents()
+{
+    // The caller indexes the result by the offset in the buffer, and checks its writes against
+    // the size of the result. So the result starts at the start of the buffer and ends at the
+    // end of the mapping. Only a mapping for writing has contents that can be written.
+    if (m_state != State::MappedForWriting)
+        return { };
+
+    if (!m_shadowContents.isEmpty())
+        return m_shadowContents.mutableSpan();
+
+    auto mapping = mappedSpan(m_mappingOffset, m_mappingSize);
+    if (!m_mappingOffset || mapping.empty())
+        return mapping;
+
+    // Dawn maps only the range that was asked for, so for a mapping that does not start at the
+    // start of the buffer there is nothing to return a span of. Writes go to a copy that
+    // covers the buffer up to the end of the mapping, and unmap() copies the mapped part back.
+    // Mappings that start elsewhere are rare, and small in practice.
+    auto shadowSize = checkedSum<size_t>(m_mappingOffset, m_mappingSize);
+    if (shadowSize.hasOverflowed() || !m_shadowContents.tryGrow(shadowSize.value())) {
+        m_shadowContents.clear();
+        return { };
+    }
+    zeroSpan(m_shadowContents.mutableSpan().first(m_mappingOffset));
+    memcpySpan(m_shadowContents.mutableSpan().subspan(m_mappingOffset), mapping);
+    return m_shadowContents.mutableSpan();
+}
+
+void BufferImpl::copyFrom(std::span<const uint8_t> data, size_t offset)
+{
+    auto contents = getBufferContents();
+    auto endOffset = checkedSum<size_t>(offset, data.size());
+    if (endOffset.hasOverflowed() || endOffset.value() > contents.size())
+        return;
+    // Writes below the mapping, which only the shadow copy has room for, are dropped by unmap().
+    memcpySpan(contents.subspan(offset), data);
+}
+
+void BufferImpl::flushShadowContents()
+{
+    if (m_shadowContents.isEmpty())
+        return;
+
+    auto mapping = mappedSpan(m_mappingOffset, m_mappingSize);
+    if (!mapping.empty())
+        memcpySpan(mapping, m_shadowContents.span().subspan(m_mappingOffset, m_mappingSize));
+    m_shadowContents.clear();
+}
+
+void BufferImpl::unmap()
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpubuffer-unmap
+    flushShadowContents();
+    m_state = State::Unmapped;
+    m_mappingOffset = 0;
+    m_mappingSize = 0;
+    // Aborts a pending mapping: its callback is called with an error status.
+    m_buffer.Unmap();
+}
+
+void BufferImpl::destroy()
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpubuffer-destroy
+    // Destroying unmaps, and what was written to a mapping is no longer of use to anyone.
+    m_shadowContents.clear();
+    m_state = State::Unmapped;
+    m_mappingOffset = 0;
+    m_mappingSize = 0;
+    m_buffer.Destroy();
+}
+
+void BufferImpl::generateAValidationError()
+{
+    m_device->generateAValidationError("GPUBuffer.mapAsync: the buffer is not unmapped"_s);
+}
+
+void BufferImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_buffer.SetLabel(stringView(labelUTF8));
+}
+
+wgpu::TexelCopyBufferInfo toDawn(const TexelCopyBufferInfo& info)
+{
+    wgpu::TexelCopyBufferInfo result;
+    result.layout = toDawn(info.layout);
+    result.buffer = fromAPI(info.buffer.get()).dawnBuffer();
+    return result;
+}
+
+} // namespace WebGPU::Dawn
