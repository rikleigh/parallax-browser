+namespace WebGPU::Dawn {
+
+RefPtr<PipelineLayout> DeviceImpl::createPipelineLayout(const PipelineLayoutDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createpipelinelayout
+    if (!descriptor.bindGroupLayouts)
+        return PipelineLayoutImpl::createAuto();
+
+    auto label = descriptor.label.utf8();
+    auto bindGroupLayouts = WTF::map(*descriptor.bindGroupLayouts, [](auto& bindGroupLayout) {
+        return fromAPI(bindGroupLayout.get()).dawnBindGroupLayout();
+    });
+
+    wgpu::PipelineLayoutDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.bindGroupLayoutCount = bindGroupLayouts.size();
+    dawnDescriptor.bindGroupLayouts = bindGroupLayouts.span().data();
+    return PipelineLayoutImpl::create(m_device.CreatePipelineLayout(&dawnDescriptor));
+}
+
+void PipelineLayoutImpl::setLabel(String&& label)
+{
+    if (!m_pipelineLayout)
+        return;
+    auto labelUTF8 = label.utf8();
+    m_pipelineLayout.SetLabel(stringView(labelUTF8));
+}
+
