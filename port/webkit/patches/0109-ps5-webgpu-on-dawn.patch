+RefPtr<RenderBundleEncoder> DeviceImpl::createRenderBundleEncoder(const RenderBundleEncoderDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createrenderbundleencoder
+    auto label = descriptor.label.utf8();
+    // A slot with no color attachment has the undefined format.
+    auto colorFormats = WTF::map(descriptor.colorFormats, [](auto& format) {
+        return format ? toDawn(*format) : wgpu::TextureFormat::Undefined;
+    });
+
+    wgpu::RenderBundleEncoderDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.colorFormatCount = colorFormats.size();
+    dawnDescriptor.colorFormats = colorFormats.span().data();
+    if (descriptor.depthStencilFormat)
+        dawnDescriptor.depthStencilFormat = toDawn(*descriptor.depthStencilFormat);
+    dawnDescriptor.sampleCount = descriptor.sampleCount;
+    dawnDescriptor.depthReadOnly = descriptor.depthReadOnly;
+    dawnDescriptor.stencilReadOnly = descriptor.stencilReadOnly;
+    return RenderBundleEncoderImpl::create(m_device.CreateRenderBundleEncoder(&dawnDescriptor));
+}
+
+void RenderBundleEncoderImpl::setPipeline(const RenderPipeline& pipeline)
+{
+    m_encoder.SetPipeline(fromAPI(pipeline).dawnRenderPipeline());
+}
+
+void RenderBundleEncoderImpl::setIndexBuffer(Buffer& buffer, IndexFormat format, uint64_t offset, std::optional<uint64_t> size)
+{
+    m_encoder.SetIndexBuffer(fromAPI(buffer).dawnBuffer(), toDawn(format), offset, size.value_or(wgpu::kWholeSize));
+}
+
+void RenderBundleEncoderImpl::setVertexBuffer(uint32_t slot, Buffer* buffer, uint64_t offset, std::optional<uint64_t> size)
+{
+    // No buffer unsets the slot.
+    m_encoder.SetVertexBuffer(slot, buffer ? fromAPI(*buffer).dawnBuffer() : wgpu::Buffer { }, offset, size.value_or(wgpu::kWholeSize));
+}
+
+void RenderBundleEncoderImpl::draw(uint32_t vertexCount, uint32_t instanceCount, uint32_t firstVertex, uint32_t firstInstance)
+{
+    m_encoder.Draw(vertexCount, instanceCount, firstVertex, firstInstance);
+}
+
+void RenderBundleEncoderImpl::drawIndexed(uint32_t indexCount, uint32_t instanceCount, uint32_t firstIndex, int32_t baseVertex, uint32_t firstInstance)
+{
+    m_encoder.DrawIndexed(indexCount, instanceCount, firstIndex, baseVertex, firstInstance);
+}
+
+void RenderBundleEncoderImpl::drawIndirect(Buffer& indirectBuffer, uint64_t indirectOffset)
+{
+    m_encoder.DrawIndirect(fromAPI(indirectBuffer).dawnBuffer(), indirectOffset);
+}
+
+void RenderBundleEncoderImpl::drawIndexedIndirect(Buffer& indirectBuffer, uint64_t indirectOffset)
+{
+    m_encoder.DrawIndexedIndirect(fromAPI(indirectBuffer).dawnBuffer(), indirectOffset);
+}
+
+RefPtr<RenderBundle> RenderBundleEncoderImpl::finish(const RenderBundleDescriptor& descriptor)
+{
+    auto label = descriptor.label.utf8();
+
+    wgpu::RenderBundleDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    return RenderBundleImpl::create(m_encoder.Finish(&dawnDescriptor));
+}
+
+void RenderBundleEncoderImpl::setBindGroup(uint32_t index, const BindGroup* bindGroup, std::optional<std::span<const uint32_t>> dynamicOffsets)
+{
+    // No bind group unsets the slot. Dawn always checks the number of dynamic offsets against the
+    // layout, so no offsets are zero offsets.
+    auto offsets = dynamicOffsets.value_or(std::span<const uint32_t> { });
+    m_encoder.SetBindGroup(index, bindGroup ? fromAPI(*bindGroup).dawnBindGroup() : wgpu::BindGroup { }, offsets.size(), offsets.data());
+}
+
+void RenderBundleEncoderImpl::pushDebugGroup(String&& groupLabel)
+{
+    auto label = groupLabel.utf8();
+    m_encoder.PushDebugGroup(definedStringView(label));
+}
+
+void RenderBundleEncoderImpl::popDebugGroup()
+{
+    m_encoder.PopDebugGroup();
+}
+
+void RenderBundleEncoderImpl::insertDebugMarker(String&& markerLabel)
+{
+    auto label = markerLabel.utf8();
+    m_encoder.InsertDebugMarker(definedStringView(label));
+}
+
+void RenderBundleEncoderImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_encoder.SetLabel(stringView(labelUTF8));
+}
