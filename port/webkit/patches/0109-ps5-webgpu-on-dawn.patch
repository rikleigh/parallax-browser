+{
+    // Once, on the thread Dawn and the driver run on (RemoteGPU's work queue): how much stack
+    // shader compilers have there.
+    static bool logged;
+    if (!logged) {
+        logged = true;
+        pthread_attr_t attributes;
+        size_t stackSize = 0;
+        pthread_attr_init(&attributes);
+        if (!pthread_attr_get_np(pthread_self(), &attributes))
+            pthread_attr_getstacksize(&attributes, &stackSize);
+        pthread_attr_destroy(&attributes);
+        WTFLogAlways("[webgpu] title: Dawn asks for the Vulkan driver (%s) on a thread with %zu KiB of stack", &vk_icdGetInstanceProcAddr ? "RADV" : "none", stackSize / 1024);
+    }
+    return reinterpret_cast<void*>(&vk_icdGetInstanceProcAddr);
+}
