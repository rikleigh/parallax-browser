+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CommandEncoder.h"
+
+#include "Buffer.h"
+#include "CommandBuffer.h"
+#include "ComputePassEncoder.h"
+#include "Conversions.h"
+#include "Device.h"
+#include "QuerySet.h"
+#include "RenderPassEncoder.h"
+#include "Texture.h"
+#include "TextureView.h"
+
+namespace WebGPU::Dawn {
+
+RefPtr<CommandEncoder> DeviceImpl::createCommandEncoder(const CommandEncoderDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createcommandencoder
+    auto label = descriptor.label.utf8();
+
+    wgpu::CommandEncoderDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    return CommandEncoderImpl::create(m_device.CreateCommandEncoder(&dawnDescriptor));
+}
+
+static wgpu::TextureView attachmentView(const RenderPassAttachmentView& attachment)
+{
+    // A texture as an attachment is its default view.
+    if (auto* textureView = std::get_if<Ref<TextureView>>(&attachment))
+        return fromAPI(textureView->get()).dawnTextureView();
+    return defaultView(std::get<Ref<Texture>>(attachment).get());
+}
+
+static wgpu::PassTimestampWrites toDawn(const PassTimestampWrites& timestampWrites)
+{
+    wgpu::PassTimestampWrites result;
+    result.querySet = fromAPI(timestampWrites.querySet.get()).dawnQuerySet();
+    result.beginningOfPassWriteIndex = timestampWrites.beginningOfPassWriteIndex.value_or(wgpu::kQuerySetIndexUndefined);
+    result.endOfPassWriteIndex = timestampWrites.endOfPassWriteIndex.value_or(wgpu::kQuerySetIndexUndefined);
+    return result;
+}
+
+RefPtr<RenderPassEncoder> CommandEncoderImpl::beginRenderPass(const RenderPassDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucommandencoder-beginrenderpass
+    // An invalid descriptor makes an invalid pass and, when the encoder finishes, a validation
+    // error. GPUDevice makes one such pass on purpose.
+    auto label = descriptor.label.utf8();
+
+    auto colorAttachments = WTF::map(descriptor.colorAttachments, [](auto& attachment) {
+        wgpu::RenderPassColorAttachment dawnAttachment;
+        // A slot with no attachment has no view.
+        if (!attachment)
+            return dawnAttachment;
+        dawnAttachment.view = attachmentView(attachment->view);
+        dawnAttachment.depthSlice = attachment->depthSlice.value_or(wgpu::kDepthSliceUndefined);
+        if (attachment->resolveTarget)
+            dawnAttachment.resolveTarget = attachmentView(*attachment->resolveTarget);
+        dawnAttachment.loadOp = toDawn(attachment->loadOp);
+        dawnAttachment.storeOp = toDawn(attachment->storeOp);
+        dawnAttachment.clearValue = toDawn(attachment->clearValue);
+        return dawnAttachment;
+    });
+
+    wgpu::RenderPassDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.colorAttachmentCount = colorAttachments.size();
+    dawnDescriptor.colorAttachments = colorAttachments.span().data();
+
+    wgpu::RenderPassDepthStencilAttachment depthStencilAttachment;
+    if (descriptor.depthStencilAttachment) {
+        auto& attachment = *descriptor.depthStencilAttachment;
+        depthStencilAttachment.view = attachmentView(attachment.view);
+        // The load and store operations that are std::nullopt stay undefined: the aspect is not
+        // there, or is read-only.
+        if (attachment.depthLoadOp)
+            depthStencilAttachment.depthLoadOp = toDawn(*attachment.depthLoadOp);
+        if (attachment.depthStoreOp)
+            depthStencilAttachment.depthStoreOp = toDawn(*attachment.depthStoreOp);
+        depthStencilAttachment.depthClearValue = attachment.depthClearValue;
+        depthStencilAttachment.depthReadOnly = attachment.depthReadOnly;
+        if (attachment.stencilLoadOp)
+            depthStencilAttachment.stencilLoadOp = toDawn(*attachment.stencilLoadOp);
+        if (attachment.stencilStoreOp)
+            depthStencilAttachment.stencilStoreOp = toDawn(*attachment.stencilStoreOp);
+        depthStencilAttachment.stencilClearValue = attachment.stencilClearValue;
+        depthStencilAttachment.stencilReadOnly = attachment.stencilReadOnly;
+        dawnDescriptor.depthStencilAttachment = &depthStencilAttachment;
+    }
+
+    if (descriptor.occlusionQuerySet)
+        dawnDescriptor.occlusionQuerySet = fromAPI(*descriptor.occlusionQuerySet).dawnQuerySet();
+
+    wgpu::PassTimestampWrites timestampWrites;
+    if (descriptor.timestampWrites) {
+        timestampWrites = toDawn(*descriptor.timestampWrites);
+        dawnDescriptor.timestampWrites = &timestampWrites;
+    }
+
+    wgpu::RenderPassMaxDrawCount maxDrawCount;
+    if (descriptor.maxDrawCount) {
+        maxDrawCount.maxDrawCount = *descriptor.maxDrawCount;
+        dawnDescriptor.nextInChain = &maxDrawCount;
+    }
+
+    return RenderPassEncoderImpl::create(m_encoder.BeginRenderPass(&dawnDescriptor));
+}
+
+RefPtr<ComputePassEncoder> CommandEncoderImpl::beginComputePass(const std::optional<ComputePassDescriptor>& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucommandencoder-begincomputepass
+    if (!descriptor)
+        return ComputePassEncoderImpl::create(m_encoder.BeginComputePass());
+
+    auto label = descriptor->label.utf8();
+
+    wgpu::ComputePassDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    wgpu::PassTimestampWrites timestampWrites;
+    if (descriptor->timestampWrites) {
+        timestampWrites = toDawn(*descriptor->timestampWrites);
+        dawnDescriptor.timestampWrites = &timestampWrites;
+    }
+    return ComputePassEncoderImpl::create(m_encoder.BeginComputePass(&dawnDescriptor));
+}
+
+void CommandEncoderImpl::copyBufferToBuffer(const Buffer& source, uint64_t sourceOffset, Buffer& destination, uint64_t destinationOffset, uint64_t size)
+{
+    m_encoder.CopyBufferToBuffer(fromAPI(source).dawnBuffer(), sourceOffset, fromAPI(destination).dawnBuffer(), destinationOffset, size);
+}
+
+void CommandEncoderImpl::copyBufferToTexture(const TexelCopyBufferInfo& source, const TexelCopyTextureInfo& destination, const Extent3D& copySize)
+{
+    auto dawnSource = toDawn(source);
+    auto dawnDestination = toDawn(destination);
+    auto dawnCopySize = toDawn(copySize);
+    m_encoder.CopyBufferToTexture(&dawnSource, &dawnDestination, &dawnCopySize);
+}
+
+void CommandEncoderImpl::copyTextureToBuffer(const TexelCopyTextureInfo& source, const TexelCopyBufferInfo& destination, const Extent3D& copySize)
+{
+    auto dawnSource = toDawn(source);
+    auto dawnDestination = toDawn(destination);
+    auto dawnCopySize = toDawn(copySize);
+    m_encoder.CopyTextureToBuffer(&dawnSource, &dawnDestination, &dawnCopySize);
+}
+
+void CommandEncoderImpl::copyTextureToTexture(const TexelCopyTextureInfo& source, const TexelCopyTextureInfo& destination, const Extent3D& copySize)
+{
+    auto dawnSource = toDawn(source);
+    auto dawnDestination = toDawn(destination);
+    auto dawnCopySize = toDawn(copySize);
+    m_encoder.CopyTextureToTexture(&dawnSource, &dawnDestination, &dawnCopySize);
+}
+
+void CommandEncoderImpl::clearBuffer(Buffer& buffer, uint64_t offset, std::optional<uint64_t> size)
+{
+    m_encoder.ClearBuffer(fromAPI(buffer).dawnBuffer(), offset, size.value_or(wgpu::kWholeSize));
+}
+
+void CommandEncoderImpl::pushDebugGroup(String&& groupLabel)
+{
+    auto label = groupLabel.utf8();
+    m_encoder.PushDebugGroup(definedStringView(label));
+}
+
+void CommandEncoderImpl::popDebugGroup()
+{
+    m_encoder.PopDebugGroup();
+}
+
+void CommandEncoderImpl::insertDebugMarker(String&& markerLabel)
+{
+    auto label = markerLabel.utf8();
+    m_encoder.InsertDebugMarker(definedStringView(label));
+}
+
+void CommandEncoderImpl::writeTimestamp(QuerySet& querySet, uint32_t queryIndex)
+{
+    m_encoder.WriteTimestamp(fromAPI(querySet).dawnQuerySet(), queryIndex);
+}
+
+void CommandEncoderImpl::resolveQuerySet(const QuerySet& querySet, uint32_t firstQuery, uint32_t queryCount, Buffer& destination, uint64_t destinationOffset)
+{
+    m_encoder.ResolveQuerySet(fromAPI(querySet).dawnQuerySet(), firstQuery, queryCount, fromAPI(destination).dawnBuffer(), destinationOffset);
+}
+
+RefPtr<CommandBuffer> CommandEncoderImpl::finish(const CommandBufferDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucommandencoder-finish
+    auto label = descriptor.label.utf8();
+
+    wgpu::CommandBufferDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    return CommandBufferImpl::create(m_encoder.Finish(&dawnDescriptor));
+}
+
+void CommandEncoderImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_encoder.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
