+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "Instance.h"
+
+#include "Adapter.h"
+#include "Conversions.h"
+#include "Device.h"
+#include "PresentationContext.h"
+#include <dawn/native/DawnNative.h>
+#include <wtf/Seconds.h>
+#include <wtf/SetForScope.h>
+
+namespace WebGPU {
+
+RefPtr<Instance> createInstance(InstanceDescriptor&& descriptor)
+{
+    return Dawn::InstanceImpl::create(WTF::move(descriptor));
+}
+
+} // namespace WebGPU
+
+namespace WebGPU::Dawn {
+
+// How long the pump sleeps after a round that completed nothing, so that waiting for the GPU
+// does not spin a core. The messages of the Web Process wait as long.
+static constexpr auto idlePumpInterval = 100_us;
+// See ~InstanceImpl(). With the sleep between the rounds this is a tenth of a second.
+static constexpr unsigned maximumFinalPumpRounds = 1000;
+
+RefPtr<InstanceImpl> InstanceImpl::create(InstanceDescriptor&& descriptor)
+{
+    wgpu::InstanceDescriptor instanceDescriptor;
+    auto native = makeUniqueWithoutFastMallocCheck<dawn::native::Instance>(&instanceDescriptor);
+    if (!native->Get())
+        return nullptr;
+    return adoptRef(*new InstanceImpl(WTF::move(descriptor), WTF::move(native)));
+}
+
+InstanceImpl::InstanceImpl(InstanceDescriptor&& descriptor, std::unique_ptr<dawn::native::Instance>&& native)
+    : m_scheduleWork(WTF::move(descriptor.scheduleWork))
+    , m_native(WTF::move(native))
+    , m_instance(m_native->Get())
+    , m_callbackCounts(adoptRef(*new CallbackCounts))
+{
+}
+
+InstanceImpl::~InstanceImpl()
+{
+    // Nothing pumps after this, and the Dawn instance stays for as long as a device of it does.
+    // Destroying the devices makes every callback of theirs ready: a mapping is aborted, submitted
+    // work counts as done, a pipeline that is being created is waited for. A few rounds deliver
+    // them, here, on the thread of the instance. The bound is for a callback that Dawn does not
+    // make ready after all: that one is never called.
+    for (Ref device : m_devices.values())
+        device->destroy();
+
+    for (unsigned round = 0; round < maximumFinalPumpRounds && !m_isProcessingEvents; ++round) {
+        m_instance.ProcessEvents();
+        if (!m_callbackCounts->outstanding)
+            break;
+        sleep(idlePumpInterval);
+    }
+
+    m_instance = nullptr;
+    m_native = nullptr;
+}
+
+void InstanceImpl::addDevice(DeviceImpl& device)
+{
+    m_devices.add(device);
+}
+
+void InstanceImpl::requestAdapter(const RequestAdapterOptions& options, CompletionHandler<void(RefPtr<Adapter>&&)>&& callback)
+{
+    // There is no fallback adapter.
+    if (options.forceFallbackAdapter) {
+        callback(nullptr);
+        return;
+    }
+
+    wgpu::RequestAdapterOptions adapterOptions;
+    adapterOptions.featureLevel = wgpu::FeatureLevel::Core;
+    adapterOptions.backendType = wgpu::BackendType::Vulkan;
+    if (options.powerPreference)
+        adapterOptions.powerPreference = toDawn(*options.powerPreference);
+
+    // Enumerating is synchronous, as it is in the Metal implementation. It creates the Vulkan
+    // instance the first time.
+    for (auto& nativeAdapter : m_native->EnumerateAdapters(&adapterOptions)) {
+        wgpu::Adapter adapter { nativeAdapter.Get() };
+        if (!adapter)
+            continue;
+        wgpu::AdapterInfo info;
+        if (adapter.GetInfo(&info) != wgpu::Status::Success || info.backendType != wgpu::BackendType::Vulkan)
+            continue;
+        // There is no XR compositor, so no adapter is XR compatible.
+        callback(AdapterImpl::create(WTF::move(adapter), *this));
+        return;
+    }
+
+    callback(nullptr);
+}
+
+RefPtr<PresentationContext> InstanceImpl::createPresentationContext(const PresentationContextDescriptor& descriptor)
+{
+    return PresentationContextImpl::create(descriptor, *this);
+}
+
+Ref<CallbackCounts> InstanceImpl::callbackRegistered()
+{
+    ++m_callbackCounts->outstanding;
+    pumpSoon();
+    return m_callbackCounts;
+}
+
+void InstanceImpl::pumpSoon()
+{
+    // With no scheduleWork the callbacks wait for processEvents().
+    if (m_pumpScheduled || !m_scheduleWork)
+        return;
+
+    m_pumpScheduled = true;
+    m_scheduleWork([weakThis = ThreadSafeWeakPtr { *this }] {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->pump();
+    });
+}
+
+void InstanceImpl::pump()
+{
+    m_pumpScheduled = false;
+
+    auto completedCallbacks = m_callbackCounts->completed;
+    processEvents();
+    if (!m_callbackCounts->outstanding)
+        return;
+
+    // The callbacks that are left wait for the GPU.
+    if (m_callbackCounts->completed == completedCallbacks)
+        sleep(idlePumpInterval);
+    pumpSoon();
+}
+
+void InstanceImpl::processEvents()
+{
+    // A completion handler that Dawn is calling may come back here.
+    if (m_isProcessingEvents || !m_instance)
+        return;
+
+    // A completion handler may also drop the last reference to this.
+    Ref protectedThis { *this };
+    SetForScope isProcessingEvents { m_isProcessingEvents, true };
+    m_instance.ProcessEvents();
+}
+
+} // namespace WebGPU::Dawn
