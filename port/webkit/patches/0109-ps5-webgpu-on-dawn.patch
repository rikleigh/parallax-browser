+#include "config.h"
+#include "Device.h"
+
+#include "Conversions.h"
+#include "Queue.h"
+#include "XRBinding.h"
+
+namespace WebGPU::Dawn {
+
+// More than a page that mishandles its errors needs. The rest are dropped.
+static constexpr size_t maximumPendingUncapturedErrors = 64;
+
+RefPtr<DeviceImpl> DeviceImpl::create(const wgpu::Adapter& adapter, InstanceImpl* instance, const String& label, std::span<const wgpu::FeatureName> requiredFeatures, const wgpu::Limits* requiredLimits)
+{
+    Ref callbackState = adoptRef(*new CallbackState);
+    auto labelUTF8 = label.utf8();
+
+    wgpu::DeviceDescriptor descriptor;
+    descriptor.label = stringView(labelUTF8);
+    descriptor.requiredFeatureCount = requiredFeatures.size();
+    descriptor.requiredFeatures = requiredFeatures.data();
+    descriptor.requiredLimits = requiredLimits;
+    // Dawn calls this one from inside the call that generates the error, and never once the
+    // device is lost. It may be called many times, so it cannot own anything: callbackState is
+    // kept alive by the device lost callback, which Dawn calls exactly once and last.
+    descriptor.SetUncapturedErrorCallback([](const wgpu::Device&, wgpu::ErrorType type, wgpu::StringView message, CallbackState* state) {
+        if (state->device)
+            state->device->uncapturedError(type, message);
+    }, callbackState.ptr());
+    descriptor.SetDeviceLostCallback(wgpu::CallbackMode::AllowProcessEvents, [callbackState](const wgpu::Device&, wgpu::DeviceLostReason reason, wgpu::StringView message) {
+        if (callbackState->device)
+            callbackState->device->deviceLost(reason, message);
+    });
+
+    wgpu::Device device = adapter.CreateDevice(&descriptor);
+    if (!device) {
+        // Dawn has the device lost callback, and calls it from ProcessEvents().
+        if (instance)
+            instance->pumpSoon();
+        return nullptr;
+    }
+    return adoptRef(*new DeviceImpl(WTF::move(device), instance, WTF::move(callbackState)));
+}
+
+DeviceImpl::DeviceImpl(wgpu::Device&& device, InstanceImpl* instance, Ref<CallbackState>&& callbackState)
+    : m_device(WTF::move(device))
+    , m_instance(instance)
+    , m_callbackState(WTF::move(callbackState))
+    , m_queue(QueueImpl::create(m_device.GetQueue(), instance))
+{
+    m_callbackState->device = this;
+    if (instance)
+        instance->addDevice(*this);
+
+    for (auto feature : allFeatureNames()) {
+        if (auto dawnFeature = toDawn(feature); dawnFeature && m_device.HasFeature(*dawnFeature))
+            m_features.append(feature);
+    }
+
+    wgpu::Limits limits;
+    if (m_device.GetLimits(&limits) == wgpu::Status::Success)
+        m_limits = fromDawn(limits);
+    else
+        m_limits = defaultLimits();
+}
+
+DeviceImpl::~DeviceImpl()
+{
+    m_callbackState->device = nullptr;
+
+    if (auto callback = std::exchange(m_deviceLostCallback, nullptr))
+        callback(DeviceLostReason::Destroyed, String { emptyString() });
+    if (auto callback = std::exchange(m_uncapturedErrorCallback, nullptr))
+        callback(false, std::nullopt);
+}
+
+Ref<Queue> DeviceImpl::queue()
+{
+    return *m_queue;
+}
+
+void DeviceImpl::destroy()
+{
+    // Dawn reports the loss, with the reason Destroyed, from ProcessEvents().
+    m_isLost = true;
+    m_device.Destroy();
+    if (RefPtr instance = m_instance.get())
+        instance->pumpSoon();
+}
+
+RefPtr<XRBinding> DeviceImpl::createXRBinding()
+{
+    return XRBindingImpl::create();
+}
+
+void DeviceImpl::pushPauseErrorScopes()
+{
+    // These catch the validation and out-of-memory errors of the objects that WebKit creates
+    // invalid on purpose, whether or not the page has error scopes of its own. Internal errors
+    // are left alone: they are never expected.
+    m_device.PushErrorScope(wgpu::ErrorFilter::Validation);
+    m_device.PushErrorScope(wgpu::ErrorFilter::OutOfMemory);
+}
+
+void DeviceImpl::popPauseErrorScopes()
+{
+    for (int i = 0; i < 2; ++i)
+        m_device.PopErrorScope(wgpu::CallbackMode::AllowProcessEvents, [](wgpu::PopErrorScopeStatus, wgpu::ErrorType, wgpu::StringView) { });
+    // No one waits for these, but Dawn keeps them until its events are processed.
+    if (RefPtr instance = m_instance.get())
+        instance->pumpSoon();
+}
+
+void DeviceImpl::pauseAllErrorReporting(bool pause)
+{
+    if (pause == m_errorReportingPaused)
+        return;
+
+    m_errorReportingPaused = pause;
+    if (pause)
+        pushPauseErrorScopes();
+    else
+        popPauseErrorScopes();
+}
+
+void DeviceImpl::pushErrorScope(ErrorFilter filter)
+{
+    // The scopes of the page stay below the ones that pause error reporting. WebKit pauses only
+    // around its own calls, so this does not happen in practice.
+    if (m_errorReportingPaused)
+        popPauseErrorScopes();
+
+    m_device.PushErrorScope(toDawn(filter));
+    ++m_errorScopeDepth;
+
+    if (m_errorReportingPaused)
+        pushPauseErrorScopes();
+}
+
+void DeviceImpl::popErrorScope(CompletionHandler<void(bool, std::optional<Error>&&)>&& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-poperrorscope
+    // A lost device completes as a scope without errors.
+    if (m_isLost) {
+        callback(true, std::nullopt);
+        return;
+    }
+
+    if (!m_errorScopeDepth) {
+        callback(false, std::nullopt);
+        return;
+    }
+    --m_errorScopeDepth;
+
+    // Without the instance nothing calls Dawn's callbacks. The instance destroys its devices when
+    // it goes, so this is a lost device too.
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        callback(true, std::nullopt);
+        return;
+    }
+
+    if (m_errorReportingPaused)
+        popPauseErrorScopes();
+
+    m_device.PopErrorScope(wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback))](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView message) {
+        // Anything but success is the device or the instance going away.
+        auto errorType = status == wgpu::PopErrorScopeStatus::Success ? fromDawn(type) : std::nullopt;
+        if (!errorType) {
+            pending->handler()(true, std::nullopt);
+            return;
+        }
+        pending->handler()(false, Error { *errorType, fromStringView(message) });
+    });
+
+    if (m_errorReportingPaused)
+        pushPauseErrorScopes();
+}
+
+void DeviceImpl::uncapturedError(wgpu::ErrorType type, wgpu::StringView message)
+{
+    auto errorType = fromDawn(type);
+    if (!errorType)
+        return;
+
+    // The scopes of pauseAllErrorReporting() catch what is paused before it gets here. This is
+    // for an error that Dawn reports late. An internal error is never one that WebKit caused on
+    // purpose, so it is reported whether or not reporting is paused.
+    if (m_errorReportingPaused && *errorType != ErrorType::Internal)
+        return;
+
+    Error error { *errorType, fromStringView(message) };
+    if (auto callback = std::exchange(m_uncapturedErrorCallback, nullptr)) {
+        callback(true, WTF::move(error));
+        return;
+    }
+
+    if (m_pendingUncapturedErrors.size() < maximumPendingUncapturedErrors)
+        m_pendingUncapturedErrors.append(WTF::move(error));
+}
+
+void DeviceImpl::resolveUncapturedErrorEvent(CompletionHandler<void(bool, std::optional<Error>&&)>&& callback)
+{
+    if (auto previousCallback = std::exchange(m_uncapturedErrorCallback, nullptr))
+        previousCallback(false, std::nullopt);
+
+    if (!callback)
+        return;
+
+    if (!m_pendingUncapturedErrors.isEmpty()) {
+        callback(true, m_pendingUncapturedErrors.takeFirst());
+        return;
+    }
+
+    m_uncapturedErrorCallback = WTF::move(callback);
+}
+
+void DeviceImpl::deviceLost(wgpu::DeviceLostReason reason, wgpu::StringView message)
+{
+    m_isLost = true;
+    m_lostInfo = LostInfo { fromDawn(reason), fromStringView(message) };
+    if (auto callback = std::exchange(m_deviceLostCallback, nullptr))
+        callback(m_lostInfo->reason, String { m_lostInfo->message });
+}
+
+void DeviceImpl::resolveDeviceLostPromise(CompletionHandler<void(DeviceLostReason, String&&)>&& callback)
+{
+    if (auto previousCallback = std::exchange(m_deviceLostCallback, nullptr))
+        previousCallback(DeviceLostReason::Destroyed, String { emptyString() });
+
+    if (!callback)
+        return;
+
+    if (m_lostInfo) {
+        callback(m_lostInfo->reason, String { m_lostInfo->message });
+        return;
+    }
+
+    m_deviceLostCallback = WTF::move(callback);
+}
+
+void DeviceImpl::generateAValidationError(const String& message)
+{
+    auto messageUTF8 = message.utf8();
+    m_device.InjectError(wgpu::ErrorType::Validation, stringView(messageUTF8));
+}
+
+void DeviceImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_device.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
