+#include "config.h"
+#include "Adapter.h"
+
+#include "Conversions.h"
+#include "Device.h"
+
+namespace WebGPU::Dawn {
+
+AdapterImpl::AdapterImpl(wgpu::Adapter&& adapter, InstanceImpl& instance)
+    : m_adapter(WTF::move(adapter))
+    , m_instance(instance)
+{
+    // Only the features that the C++ API can name. Dawn's own extensions stay hidden, so no page
+    // can require them.
+    for (auto feature : allFeatureNames()) {
+        if (auto dawnFeature = toDawn(feature); dawnFeature && m_adapter.HasFeature(*dawnFeature))
+            m_features.append(feature);
+    }
+
+    wgpu::Limits limits;
+    if (m_adapter.GetLimits(&limits) == wgpu::Status::Success)
+        m_limits = fromDawn(limits);
+    else
+        m_limits = defaultLimits();
+}
+
+AdapterInfo AdapterImpl::info()
+{
+    AdapterInfo result;
+    if (!m_adapter)
+        return result;
+
+    wgpu::AdapterInfo info;
+    if (m_adapter.GetInfo(&info) != wgpu::Status::Success)
+        return result;
+
+    result.name = fromStringView(info.device);
+    result.isFallbackAdapter = info.adapterType == wgpu::AdapterType::CPU;
+    if (m_features.contains(FeatureName::Subgroups)) {
+        result.subgroupMinSize = info.subgroupMinSize;
+        result.subgroupMaxSize = info.subgroupMaxSize;
+    } else {
+        // The values of an adapter without the feature: https://github.com/gpuweb/gpuweb/pull/4963
+        result.subgroupMinSize = 4;
+        result.subgroupMaxSize = 128;
+    }
+    return result;
+}
+
+void AdapterImpl::requestDevice(const DeviceDescriptor& descriptor, CompletionHandler<void(RefPtr<Device>&&)>&& callback)
+{
+    // An adapter creates one device. As in the Metal implementation, asking for another fails and
+    // makes the adapter invalid.
+    if (m_deviceRequested || !m_adapter) {
+        m_adapter = nullptr;
+        callback(nullptr);
+        return;
+    }
+
+    Vector<wgpu::FeatureName> requiredFeatures;
+    for (auto feature : descriptor.requiredFeatures) {
+        auto dawnFeature = toDawn(feature);
+        if (!dawnFeature || !m_features.contains(feature)) {
+            callback(nullptr);
+            return;
+        }
+        requiredFeatures.append(*dawnFeature);
+    }
+
+    // CreateDevice() is synchronous, and fails when a required limit is better than the adapter's.
+    wgpu::Limits requiredLimits;
+    if (descriptor.requiredLimits)
+        requiredLimits = toDawn(*descriptor.requiredLimits);
+
+    RefPtr instance = m_instance.get();
+    RefPtr device = DeviceImpl::create(m_adapter, instance.get(), descriptor.label, requiredFeatures.span(), descriptor.requiredLimits ? &requiredLimits : nullptr);
+    if (device)
+        m_deviceRequested = true;
+    callback(WTF::move(device));
+}
+
+} // namespace WebGPU::Dawn
