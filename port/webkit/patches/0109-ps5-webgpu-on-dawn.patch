+#include "config.h"
+#include "Texture.h"
+
+#include "Conversions.h"
+#include "Device.h"
+#include "PresentationContext.h"
+#include "TextureView.h"
+
+namespace WebGPU::Dawn {
+
+RefPtr<Texture> DeviceImpl::createTexture(const TextureDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createtexture
+    auto label = descriptor.label.utf8();
+    auto viewFormats = WTF::map(descriptor.viewFormats, [](auto format) {
+        return toDawn(format);
+    });
+
+    wgpu::TextureDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.usage = toDawn(descriptor.usage);
+    dawnDescriptor.dimension = toDawn(descriptor.dimension);
+    dawnDescriptor.size = toDawn(descriptor.size);
+    dawnDescriptor.format = toDawn(descriptor.format);
+    dawnDescriptor.mipLevelCount = descriptor.mipLevelCount;
+    dawnDescriptor.sampleCount = descriptor.sampleCount;
+    dawnDescriptor.viewFormatCount = viewFormats.size();
+    dawnDescriptor.viewFormats = viewFormats.span().data();
+    return TextureImpl::create(m_device.CreateTexture(&dawnDescriptor));
+}
+
+TextureImpl::TextureImpl(wgpu::Texture&& texture, PresentationContextImpl* presentationContext)
+    : m_texture(WTF::move(texture))
+    , m_presentationContext(presentationContext)
+    , m_isCanvasBacking(presentationContext)
+{
+}
+
+TextureImpl::~TextureImpl() = default;
+
+RefPtr<TextureView> TextureImpl::createView(const std::optional<TextureViewDescriptor>& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gputexture-createview
+    if (!descriptor)
+        return TextureViewImpl::create(m_texture.CreateView());
+
+    auto label = descriptor->label.utf8();
+
+    wgpu::TextureViewDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    // The members that are std::nullopt stay undefined, and Dawn resolves them from the texture.
+    if (descriptor->format)
+        dawnDescriptor.format = toDawn(*descriptor->format);
+    if (descriptor->dimension)
+        dawnDescriptor.dimension = toDawn(*descriptor->dimension);
+    dawnDescriptor.baseMipLevel = descriptor->baseMipLevel;
+    if (descriptor->mipLevelCount)
+        dawnDescriptor.mipLevelCount = *descriptor->mipLevelCount;
+    dawnDescriptor.baseArrayLayer = descriptor->baseArrayLayer;
+    if (descriptor->arrayLayerCount)
+        dawnDescriptor.arrayLayerCount = *descriptor->arrayLayerCount;
+    dawnDescriptor.aspect = toDawn(descriptor->aspect);
+    dawnDescriptor.usage = toDawn(descriptor->usage);
+
+    // Dawn validates that the device has the texture-component-swizzle feature.
+    wgpu::TextureComponentSwizzleDescriptor swizzle;
+    if (!descriptor->swizzle.isIdentity()) {
+        swizzle.swizzle = toDawn(descriptor->swizzle);
+        dawnDescriptor.nextInChain = &swizzle;
+    }
+    return TextureViewImpl::create(m_texture.CreateView(&dawnDescriptor));
+}
+
+void TextureImpl::destroy()
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gputexture-destroy
+    m_isDestroyed = true;
+    // The presentation context reads the frame of a canvas after the canvas has destroyed its
+    // texture, and hands the texture out again. Its memory is freed by releaseCanvasBacking().
+    if (m_isCanvasBacking)
+        return;
+    m_texture.Destroy();
+}
+
+void TextureImpl::undestroy()
+{
+    if (!m_isCanvasBacking)
+        return;
+
+    // A texture that its context has released stays as it is: a new configuration has new ones.
+    RefPtr presentationContext = m_presentationContext.get();
+    if (!presentationContext || !presentationContext->startFrame(*this))
+        return;
+    m_isDestroyed = false;
+}
+
+void TextureImpl::releaseCanvasBacking()
+{
+    m_presentationContext = nullptr;
+    m_isDestroyed = true;
+    m_texture.Destroy();
+}
+
+void TextureImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_texture.SetLabel(stringView(labelUTF8));
+}
+
+wgpu::TexelCopyTextureInfo toDawn(const TexelCopyTextureInfo& info)
+{
+    wgpu::TexelCopyTextureInfo result;
+    result.texture = fromAPI(info.texture.get()).dawnTexture();
+    result.mipLevel = info.mipLevel;
+    result.origin = toDawn(info.origin);
+    result.aspect = toDawn(info.aspect);
+    return result;
+}
+
+wgpu::TextureView defaultView(const Texture& texture)
+{
+    return fromAPI(texture).dawnTexture().CreateView();
+}
+
+} // namespace WebGPU::Dawn
