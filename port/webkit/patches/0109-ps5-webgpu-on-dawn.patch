+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "BindGroupLayout.h"
+
+#include "Conversions.h"
+#include "Device.h"
+
+namespace WebGPU::Dawn {
+
+RefPtr<BindGroupLayout> DeviceImpl::createBindGroupLayout(const BindGroupLayoutDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createbindgrouplayout
+    // Dawn validates that each entry has exactly one binding layout: the members that an entry
+    // does not have stay "not used".
+    auto label = descriptor.label.utf8();
+
+    Vector<wgpu::BindGroupLayoutEntry> entries;
+    entries.reserveInitialCapacity(descriptor.entries.size());
+    // Chained to the entries, so this must not reallocate.
+    Vector<wgpu::ExternalTextureBindingLayout> externalTextureLayouts;
+    externalTextureLayouts.reserveInitialCapacity(descriptor.entries.size());
+
+    for (auto& entry : descriptor.entries) {
+        wgpu::BindGroupLayoutEntry dawnEntry;
+        dawnEntry.binding = entry.binding;
+        dawnEntry.visibility = toDawn(entry.visibility);
+        if (entry.buffer) {
+            dawnEntry.buffer.type = toDawn(entry.buffer->type);
+            dawnEntry.buffer.hasDynamicOffset = entry.buffer->hasDynamicOffset;
+            dawnEntry.buffer.minBindingSize = entry.buffer->minBindingSize;
+        }
+        if (entry.sampler)
+            dawnEntry.sampler.type = toDawn(entry.sampler->type);
+        if (entry.texture) {
+            dawnEntry.texture.sampleType = toDawn(entry.texture->sampleType);
+            dawnEntry.texture.viewDimension = toDawn(entry.texture->viewDimension);
+            dawnEntry.texture.multisampled = entry.texture->multisampled;
+        }
+        if (entry.storageTexture) {
+            dawnEntry.storageTexture.access = toDawn(entry.storageTexture->access);
+            dawnEntry.storageTexture.format = toDawn(entry.storageTexture->format);
+            dawnEntry.storageTexture.viewDimension = toDawn(entry.storageTexture->viewDimension);
+        }
+        if (entry.externalTexture) {
+            // The layout is real, so that a shader with a texture_external validates against
+            // it. There is no external texture to bind to it yet: see ExternalTextureImpl.
+            externalTextureLayouts.append(wgpu::ExternalTextureBindingLayout { });
+            dawnEntry.nextInChain = &externalTextureLayouts.last();
+        }
+        entries.append(WTF::move(dawnEntry));
+    }
+
+    wgpu::BindGroupLayoutDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.entryCount = entries.size();
+    dawnDescriptor.entries = entries.span().data();
+    return BindGroupLayoutImpl::create(m_device.CreateBindGroupLayout(&dawnDescriptor));
+}
+
+void BindGroupLayoutImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_bindGroupLayout.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
