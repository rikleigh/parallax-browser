+#pragma once
+
+#include "Device.h"
+#include <WebGPU/WebGPUCpp.h>
+#include <webgpu/webgpu_cpp.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebGPU::Dawn {
+
+// https://gpuweb.github.io/gpuweb/#gpubuffer
+//
+// The Web Process never sees the memory of a buffer. It reads a mapping by taking a copy of the
+// span that getMappedRange() passes, and writes one by sending bytes that the GPU Process copies
+// into the span that getBufferContents() returns, at the offset in the buffer.
+class BufferImpl final : public Buffer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(BufferImpl);
+public:
+    static Ref<BufferImpl> create(wgpu::Buffer&& buffer, uint64_t size, bool mappedAtCreation, DeviceImpl& device)
+    {
+        return adoptRef(*new BufferImpl(WTF::move(buffer), size, mappedAtCreation, device));
+    }
+
+    void mapAsync(OptionSet<MapMode>, uint64_t offset, std::optional<uint64_t> size, CompletionHandler<void(bool)>&&) final;
+    void getMappedRange(uint64_t offset, std::optional<uint64_t> size, NOESCAPE const Function<void(std::span<uint8_t>)>&) final;
+    void unmap() final;
+    void destroy() final;
+    void generateAValidationError() final;
+    std::span<uint8_t> getBufferContents() final;
+    void copyFrom(std::span<const uint8_t>, size_t offset) final;
+    void setLabel(String&&) final;
+    bool isValid() const final { return !!m_buffer; }
+
+    const wgpu::Buffer& dawnBuffer() const { return m_buffer; }
+
+private:
+    BufferImpl(wgpu::Buffer&&, uint64_t size, bool mappedAtCreation, DeviceImpl&);
+
+    // https://gpuweb.github.io/gpuweb/#buffer-internals-state, as far as the wrapper has to know
+    // it. Dawn validates the rest.
+    enum class State : uint8_t {
+        Unmapped,
+        MappingPending,
+        MappedForReading,
+        MappedForWriting, // By mapAsync(), or at creation.
+    };
+
+    std::span<uint8_t> mappedSpan(size_t offset, size_t size);
+    void flushShadowContents();
+
+    wgpu::Buffer m_buffer;
+    const Ref<DeviceImpl> m_device;
+    const uint64_t m_size;
+    State m_state { State::Unmapped };
+    // The mapped range, while the buffer is mapped.
+    size_t m_mappingOffset { 0 };
+    size_t m_mappingSize { 0 };
+    // Counts the mappings, so that the callback of a mapAsync() that an unmap() aborted, and
+    // that another mapAsync() followed, changes nothing.
+    uint64_t m_mappingGeneration { 0 };
+    // See getBufferContents().
+    Vector<uint8_t> m_shadowContents;
+};
+
+inline BufferImpl& fromAPI(Buffer& buffer)
+{
+    return static_cast<BufferImpl&>(buffer);
+}
+
+inline const BufferImpl& fromAPI(const Buffer& buffer)
+{
+    return static_cast<const BufferImpl&>(buffer);
+}
+
+wgpu::TexelCopyBufferInfo toDawn(const TexelCopyBufferInfo&);
+
+} // namespace WebGPU::Dawn
diff --git a/Source/WebGPU/WebGPUDawn/CMakeLists.txt b/Source/WebGPU/WebGPUDawn/CMakeLists.txt
new file mode 100644
index 0000000000..08bf5783b1
--- /dev/null
+++ b/Source/WebGPU/WebGPUDawn/CMakeLists.txt
@@ -0,0 +1,69 @@
+# The Dawn implementation of the WebGPU C++ API (WebGPUCpp.h): WebGPU::createInstance() and the
+# WebGPU::Dawn classes behind it, over Dawn's Vulkan backend. Built for the PS5 only (USE_DAWN).
+#
+# Dawn is the static, monolithic library that port/deps builds into the sysroot: it defines the
+# wgpu* functions itself and needs no dawn_proc.
+
+if (NOT PS5_WPE_SYSROOT)
+    message(FATAL_ERROR "WebGPUDawn needs PS5_WPE_SYSROOT, where Dawn is installed")
+endif ()
+
+set(WebGPUDawn_SOURCES
+    Adapter.cpp
+    BindGroup.cpp
+    BindGroupLayout.cpp
+    Buffer.cpp
+    CommandBuffer.cpp
+    CommandEncoder.cpp
+    ComputePassEncoder.cpp
+    ComputePipeline.cpp
+    Conversions.cpp
+    Device.cpp
+    ExternalTexture.cpp
+    Instance.cpp
+    PipelineLayout.cpp
+    PresentationContext.cpp
+    QuerySet.cpp
+    Queue.cpp
+    RenderBundle.cpp
+    RenderBundleEncoder.cpp
+    RenderPassEncoder.cpp
+    RenderPipeline.cpp
+    Sampler.cpp
+    ShaderModule.cpp
+    Texture.cpp
+    TextureView.cpp
+    XRBinding.cpp
+    XRProjectionLayer.cpp
+    XRSubImage.cpp
+    XRView.cpp
+)
+
+add_library(WebGPUDawn STATIC ${WebGPUDawn_SOURCES})
+WEBKIT_ADD_TARGET_UNSAFE_BUFFER_WARNINGS(WebGPUDawn)
+
+# <WebGPU/WebGPUCpp.h> is the copy that WebGPU_CopyCppAPIHeaders makes, as it is for WebCore and
+# WebKit. Source/WebGPU itself must stay off the include path: on a case-insensitive file system
+# Dawn's #include "webgpu/webgpu.h" would find Source/WebGPU/WebGPU/WebGPU.h there, the C API of
+# the Metal implementation.
+target_include_directories(WebGPUDawn PRIVATE
+    "${CMAKE_BINARY_DIR}"
+    "${CMAKE_CURRENT_SOURCE_DIR}"
+    "${WebGPU_PRIVATE_FRAMEWORK_HEADERS_DIR}"
+)
+# Dawn's headers: <webgpu/webgpu_cpp.h> and <dawn/native/DawnNative.h>.
+target_include_directories(WebGPUDawn SYSTEM PRIVATE
+    "${PS5_WPE_SYSROOT}/include"
+)
+
+target_compile_definitions(WebGPUDawn PRIVATE
+    STATICALLY_LINKED_WITH_WEBGPU
+)
+
+# WTF and bmalloc headers come with WebKit::WTF. Whatever links WebGPUDawn links Dawn after it.
+target_link_libraries(WebGPUDawn
+    PRIVATE WebKit::WTF
+    PUBLIC "${PS5_WPE_SYSROOT}/lib/libwebgpu_dawn.a"
+)
+
+add_dependencies(WebGPUDawn WebGPU_CopyCppAPIHeaders)
