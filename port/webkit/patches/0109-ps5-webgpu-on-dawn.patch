+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#pragma once
+
+#include <WebGPU/WebGPUCpp.h>
+#include <memory>
+#include <webgpu/webgpu_cpp.h>
+#include <wtf/CompletionHandler.h>
+#include <wtf/Function.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/ThreadSafeWeakHashSet.h>
+#include <wtf/ThreadSafeWeakPtr.h>
+
+namespace dawn::native {
+class Instance;
+}
+
+namespace WebGPU::Dawn {
+
+class DeviceImpl;
+
+// The Dawn callbacks of an instance that are registered and not yet called. Shared with the
+// callbacks, so that one that is called late finds it.
+struct CallbackCounts : public ThreadSafeRefCounted<CallbackCounts> {
+    uint64_t outstanding { 0 };
+    uint64_t completed { 0 };
+};
+
+// The instance, and the pump for Dawn's callbacks.
+//
+// Every call arrives on one thread, and Dawn calls back only from ProcessEvents()
+// (wgpu::CallbackMode::AllowProcessEvents), which runs in a work item that
+// InstanceDescriptor::scheduleWork puts on the same thread. While a callback is outstanding one
+// such work item is scheduled, and it schedules itself again until none is. So a completion
+// handler never runs inside the call that takes it.
+//
+// The Dawn instance lives for as long as any of its devices, and it is what cancels the callbacks
+// that are still registered when it goes. So the instance destroys its devices when it is
+// destroyed, which makes their callbacks ready, and runs them: every completion handler has been
+// called by the time the instance is gone.
+class InstanceImpl final : public Instance {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(InstanceImpl);
+public:
+    static RefPtr<InstanceImpl> create(InstanceDescriptor&&);
+    ~InstanceImpl();
+
+    void requestAdapter(const RequestAdapterOptions&, CompletionHandler<void(RefPtr<Adapter>&&)>&&) final;
+    RefPtr<PresentationContext> createPresentationContext(const PresentationContextDescriptor&) final;
+    void setLabel(String&&) final { }
+    bool isValid() const final { return !!m_instance; }
+
+    // Counts a Dawn callback that is about to be registered, and keeps the pump running until it
+    // has been called. See PendingCallback.
+    Ref<CallbackCounts> callbackRegistered();
+    // Runs Dawn's callbacks in a work item, once. For the calls that can lose a device or queue
+    // an event with no callback of ours outstanding.
+    void pumpSoon();
+    // Runs the callbacks that are ready. The explicit pump for an instance with no scheduleWork.
+    void processEvents();
+    void addDevice(DeviceImpl&);
+
+private:
+    InstanceImpl(InstanceDescriptor&&, std::unique_ptr<dawn::native::Instance>&&);
+
+    void pump();
+
+    Function<void(Function<void()>&&)> m_scheduleWork;
+    std::unique_ptr<dawn::native::Instance> m_native;
+    wgpu::Instance m_instance;
+    ThreadSafeWeakHashSet<DeviceImpl> m_devices;
+    const Ref<CallbackCounts> m_callbackCounts;
+    bool m_pumpScheduled { false };
+    bool m_isProcessingEvents { false };
+};
+
+// What a Dawn callback of ours owns: the completion handler (or other state) to call, and the
+// pump, which keeps running until this is destroyed. Dawn requires its callbacks to be
+// const-callable and calls each exactly once, then destroys it, so a lambda captures a
+// std::unique_ptr to one of these.
+//
+// An operation needs the instance for its callback to ever be called. A caller that finds the
+// instance gone completes its handler at once instead of starting the operation.
+template<typename Handler>
+class PendingCallback {
+    WTF_MAKE_NONCOPYABLE(PendingCallback);
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(PendingCallback);
+public:
+    PendingCallback(InstanceImpl& instance, Handler&& handler)
+        : m_counts(instance.callbackRegistered())
+        , m_handler(WTF::move(handler))
+    {
+    }
+
+    ~PendingCallback()
+    {
+        ASSERT(m_counts->outstanding);
+        --m_counts->outstanding;
+        ++m_counts->completed;
+    }
+
+    Handler& handler() { return m_handler; }
+
+private:
+    const Ref<CallbackCounts> m_counts;
+    Handler m_handler;
+};
+
+template<typename Handler>
+std::unique_ptr<PendingCallback<Handler>> makePendingCallback(InstanceImpl& instance, Handler&& handler)
+{
+    return makeUnique<PendingCallback<Handler>>(instance, WTF::move(handler));
+}
+
+} // namespace WebGPU::Dawn
