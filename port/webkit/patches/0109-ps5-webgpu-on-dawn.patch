+#pragma once
+
+#include "Conversions.h"
+#include "PipelineLayout.h"
+#include "ShaderModule.h"
+#include <WebGPU/WebGPUCpp.h>
+#include <webgpu/webgpu_cpp.h>
+
+namespace WebGPU::Dawn {
+
+// The strings of a WebGPU::ProgrammableStage as UTF-8, for the duration of a call that creates a
+// pipeline, and views of them.
+class ProgrammableStageConverter {
+    WTF_MAKE_NONCOPYABLE(ProgrammableStageConverter);
+public:
+    explicit ProgrammableStageConverter(const ProgrammableStage& stage)
+        : m_module(fromAPI(stage.module.get()).dawnShaderModule())
+        , m_entryPoint(stage.entryPoint.utf8())
+    {
+        m_keys.reserveInitialCapacity(stage.constants.size());
+        m_constants.reserveInitialCapacity(stage.constants.size());
+        for (auto& constant : stage.constants) {
+            m_keys.append(constant.key.utf8());
+            wgpu::ConstantEntry entry;
+            entry.key = definedStringView(m_keys.last());
+            entry.value = constant.value;
+            m_constants.append(entry);
+        }
+    }
+
+    template<typename DawnStage>
+    void apply(DawnStage& dawnStage) const
+    {
+        dawnStage.module = m_module;
+        // An undefined string view (a null entry point) is the only entry point of the module for
+        // the stage.
+        dawnStage.entryPoint = stringView(m_entryPoint);
+        dawnStage.constantCount = m_constants.size();
+        dawnStage.constants = m_constants.span().data();
+    }
+
+private:
+    wgpu::ShaderModule m_module;
+    UTF8CString m_entryPoint;
+    Vector<UTF8CString> m_keys;
+    Vector<wgpu::ConstantEntry> m_constants;
+};
+
+// The layout of a pipeline descriptor: layoutOverride when there is one, or the layout of the
+// descriptor. Null is the layout that the pipeline generates from its shaders.
+inline wgpu::PipelineLayout pipelineLayout(const RefPtr<PipelineLayout>& layout, const wgpu::PipelineLayout* layoutOverride)
+{
+    if (layoutOverride)
+        return *layoutOverride;
+    if (!layout)
+        return nullptr;
+    return fromAPI(*layout).dawnPipelineLayout();
+}
+
+inline PipelineError pipelineError(wgpu::CreatePipelineAsyncStatus status, wgpu::StringView message)
+{
+    return { pipelineErrorReason(status), fromStringView(message) };
+}
+
+} // namespace WebGPU::Dawn
