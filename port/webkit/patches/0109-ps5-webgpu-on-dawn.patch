+#pragma once
+
+#include "Instance.h"
+#include <WebGPU/WebGPUCpp.h>
+#include <webgpu/webgpu_cpp.h>
+#include <wtf/CompletionHandler.h>
+#include <wtf/Deque.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/ThreadSafeRefCounted.h>
+
+namespace WebGPU::Dawn {
+
+class QueueImpl;
+
+class DeviceImpl final : public Device {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(DeviceImpl);
+public:
+    // nullptr when Dawn does not create the device.
+    static RefPtr<DeviceImpl> create(const wgpu::Adapter&, InstanceImpl*, const String& label, std::span<const wgpu::FeatureName> requiredFeatures, const wgpu::Limits* requiredLimits);
+    ~DeviceImpl();
+
+    Vector<FeatureName> features() const final { return m_features; }
+    const Limits& limits() const final { return m_limits; }
+    Ref<Queue> queue() final;
+    void destroy() final;
+
+    RefPtr<Buffer> createBuffer(const BufferDescriptor&) final;
+    RefPtr<Texture> createTexture(const TextureDescriptor&) final;
+    RefPtr<Sampler> createSampler(const SamplerDescriptor&) final;
+    RefPtr<BindGroupLayout> createBindGroupLayout(const BindGroupLayoutDescriptor&) final;
+    RefPtr<PipelineLayout> createPipelineLayout(const PipelineLayoutDescriptor&) final;
+    RefPtr<BindGroup> createBindGroup(const BindGroupDescriptor&) final;
+    RefPtr<ShaderModule> createShaderModule(const ShaderModuleDescriptor&) final;
+    RefPtr<ComputePipeline> createComputePipeline(const ComputePipelineDescriptor&) final;
+    RefPtr<RenderPipeline> createRenderPipeline(const RenderPipelineDescriptor&) final;
+    void createComputePipelineAsync(const ComputePipelineDescriptor&, CompletionHandler<void(std::expected<Ref<ComputePipeline>, PipelineError>&&)>&&) final;
+    void createRenderPipelineAsync(const RenderPipelineDescriptor&, CompletionHandler<void(std::expected<Ref<RenderPipeline>, PipelineError>&&)>&&) final;
+    void createComputePipelineWithPipelineLayoutFromPipelineAsync(const ComputePipelineDescriptor&, const ComputePipeline& pipelineToReplace, CompletionHandler<void(std::expected<Ref<ComputePipeline>, PipelineError>&&)>&&) final;
+    void createRenderPipelineWithPipelineLayoutFromPipelineAsync(const RenderPipelineDescriptor&, const RenderPipeline& pipelineToReplace, CompletionHandler<void(std::expected<Ref<RenderPipeline>, PipelineError>&&)>&&) final;
+    RefPtr<CommandEncoder> createCommandEncoder(const CommandEncoderDescriptor&) final;
+    RefPtr<RenderBundleEncoder> createRenderBundleEncoder(const RenderBundleEncoderDescriptor&) final;
+    RefPtr<QuerySet> createQuerySet(const QuerySetDescriptor&) final;
+    RefPtr<XRBinding> createXRBinding() final;
+
+    void pushErrorScope(ErrorFilter) final;
+    void popErrorScope(CompletionHandler<void(bool, std::optional<Error>&&)>&&) final;
+    void resolveUncapturedErrorEvent(CompletionHandler<void(bool, std::optional<Error>&&)>&&) final;
+    void resolveDeviceLostPromise(CompletionHandler<void(DeviceLostReason, String&&)>&&) final;
+    void pauseAllErrorReporting(bool pause) final;
+    void setLabel(String&&) final;
+    bool isValid() const final { return !!m_device; }
+
+    const wgpu::Device& dawnDevice() const { return m_device; }
+    RefPtr<InstanceImpl> instance() const { return m_instance.get(); }
+    bool hasFeature(FeatureName feature) const { return m_features.contains(feature); }
+    bool isLost() const { return m_isLost; }
+    // The error goes to the error scopes of the page, or becomes an uncaptured error, like one
+    // that Dawn's own validation generates.
+    void generateAValidationError(const String& message);
+
+private:
+    // What the callbacks of the Dawn device point to. The Dawn device can outlive the DeviceImpl,
+    // and then the callbacks find no device here.
+    struct CallbackState : public ThreadSafeRefCounted<CallbackState> {
+        DeviceImpl* device { nullptr };
+    };
+
+    DeviceImpl(wgpu::Device&&, InstanceImpl*, Ref<CallbackState>&&);
+
+    void uncapturedError(wgpu::ErrorType, wgpu::StringView message);
+    void deviceLost(wgpu::DeviceLostReason, wgpu::StringView message);
+
+    void pushPauseErrorScopes();
+    void popPauseErrorScopes();
+
+    using ComputePipelineCallback = CompletionHandler<void(std::expected<Ref<ComputePipeline>, PipelineError>&&)>;
+    using RenderPipelineCallback = CompletionHandler<void(std::expected<Ref<RenderPipeline>, PipelineError>&&)>;
+    // layoutOverride replaces the layout of the descriptor. A null wgpu::PipelineLayout in it is
+    // the layout that the pipeline generates from its shaders.
+    void createComputePipelineAsync(const ComputePipelineDescriptor&, const wgpu::PipelineLayout* layoutOverride, ComputePipelineCallback&&);
+    void createRenderPipelineAsync(const RenderPipelineDescriptor&, const wgpu::PipelineLayout* layoutOverride, RenderPipelineCallback&&);
+
+    wgpu::Device m_device;
+    ThreadSafeWeakPtr<InstanceImpl> m_instance;
+    const Ref<CallbackState> m_callbackState;
+    RefPtr<QueueImpl> m_queue;
+    Vector<FeatureName> m_features;
+    Limits m_limits;
+
+    // The error scopes that the page pushed and has not popped. Dawn keeps the scopes themselves.
+    uint64_t m_errorScopeDepth { 0 };
+    bool m_errorReportingPaused { false };
+
+    CompletionHandler<void(bool, std::optional<Error>&&)> m_uncapturedErrorCallback;
+    // Uncaptured errors that arrived while no callback was set. The Web Process sets the next
+    // callback only once it has the previous error, and errors often come several at a time.
+    Deque<Error> m_pendingUncapturedErrors;
+
+    struct LostInfo {
+        DeviceLostReason reason;
+        String message;
+    };
+    CompletionHandler<void(DeviceLostReason, String&&)> m_deviceLostCallback;
+    std::optional<LostInfo> m_lostInfo;
+    bool m_isLost { false };
+};
+
+inline DeviceImpl& fromAPI(Device& device)
+{
+    return static_cast<DeviceImpl&>(device);
+}
+
