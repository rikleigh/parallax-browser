+#pragma once
+
+#include "Device.h"
+#include "Instance.h"
+#include <WebGPU/WebGPUCpp.h>
+#include <array>
+#include <webgpu/webgpu_cpp.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebGPU::Dawn {
+
+class TextureImpl;
+
+// https://gpuweb.github.io/gpuweb/#canvas-context
+//
+// The surface of a canvas, with no texture that the compositor shares. The canvas draws each
+// frame into a texture of the configured device, in one of a few render buffers that it names
+// by index, and a presented frame is read back and handed to the embedder as pixels
+// (PresentationContextDescriptor::presentFrame).
+//
+// The life of a frame, as the canvas (GPUCanvasContext through RemotePresentationContext) drives it:
+// - getCurrentTexture(index) the first time a render buffer is used after configure(), and
+//   Texture::undestroy() on the same texture every time after that, start a frame. A frame
+//   starts cleared to transparent black.
+// - Texture::destroy() ends the frame for the page: the texture expires. Its contents stay.
+// - present(index) reads the contents back. This never waits for the GPU: at most one readback
+//   is in flight, and a frame that is presented meanwhile replaces the one that waits its turn.
+class PresentationContextImpl final : public PresentationContext {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(PresentationContextImpl);
+public:
+    static Ref<PresentationContextImpl> create(const PresentationContextDescriptor&, InstanceImpl&);
+    ~PresentationContextImpl();
+
+    void configure(const CanvasConfiguration&) final;
+    void unconfigure() final;
+    void present(uint32_t frameIndex) final;
+    RefPtr<Texture> getCurrentTexture(uint32_t frameIndex) final;
+    Seconds lastFrameGPUCost() const final { return m_lastFrameGPUCost; }
+    Seconds lastFramePresentStall() const final { return 0_s; }
+    void readPixels(uint32_t bufferIndex, CompletionHandler<void(std::span<const uint8_t>, uint32_t width, uint32_t height, TextureFormat)>&&) final;
+    void setLabel(String&&) final { }
+    bool isValid() const final { return true; }
+
+    // Starts the next frame in a texture that getCurrentTexture() returned. False when the
+    // texture is of an earlier configuration.
+    bool startFrame(TextureImpl&);
+
+private:
+    using PresentFrameFunction = Function<void(uint32_t frameIndex, std::span<const uint8_t>, uint32_t width, uint32_t height, TextureFormat, CanvasAlphaMode)>;
+
+    PresentationContextImpl(PresentFrameFunction&&, InstanceImpl&);
+
+    // As many as the Web Process keeps textures for (RemotePresentationContextProxy::textureCount).
+    // A render buffer has a texture only once the canvas uses it.
+    static constexpr size_t maximumRenderBuffers = 3;
+    // The size of the textures of a canvas is bounded by this, in addition to the limits of the
+    // device.
+    static constexpr uint64_t maximumRenderBufferBytes = 256 * MB;
+
+    struct Configuration {
+        Ref<DeviceImpl> device;
+        TextureFormat format;
+        CanvasAlphaMode alphaMode;
+        wgpu::TextureUsage usage;
+        Vector<wgpu::TextureFormat> viewFormats;
+        uint32_t width;
+        uint32_t height;
+        // Of the rows that are handed over, and of the rows of a readback buffer, which Dawn
+        // requires to be a multiple of 256 bytes.
+        uint32_t bytesPerRow;
+        uint32_t paddedBytesPerRow;
+        uint64_t readbackSize;
+    };
+
+    struct QueuedFrame {
+        uint32_t frameIndex;
+        MonotonicTime presentTime;
+    };
+
+    void releaseRenderBuffers();
+    wgpu::Texture createRenderBufferTexture();
+    wgpu::Buffer createReadbackBuffer();
+    void copyToReadbackBuffer(const wgpu::Texture&, const wgpu::Buffer&);
+    void startReadback(size_t readbackIndex, uint32_t frameIndex, MonotonicTime presentTime);
+    void readbackCompleted(uint64_t generation, size_t readbackIndex, uint32_t frameIndex, MonotonicTime presentTime, bool success);
+    // The rows of a mapped readback buffer without their padding. The result is into `mapping`
+    // or into `storage`.
+    static std::span<const uint8_t> tightlyPackedRows(std::span<const uint8_t> mapping, uint32_t bytesPerRow, uint32_t paddedBytesPerRow, uint32_t height, Vector<uint8_t>& storage);
+
+    PresentFrameFunction m_presentFrame;
+    ThreadSafeWeakPtr<InstanceImpl> m_instance;
+    std::optional<Configuration> m_configuration;
+    // Changes with every configure() and unconfigure(), so that what a readback of an earlier
+    // configuration brings is dropped.
+    uint64_t m_generation { 0 };
+    std::array<RefPtr<TextureImpl>, maximumRenderBuffers> m_renderBuffers;
+    // What getCurrentTexture() returns when the context is not configured, once it has had a device.
+    RefPtr<TextureImpl> m_invalidTexture;
+
+    // One buffer is being mapped while the other takes the frame that is presented meanwhile.
+    std::array<wgpu::Buffer, 2> m_readbackBuffers;
+    std::optional<size_t> m_readbackInFlight;
+    std::optional<QueuedFrame> m_queuedFrame;
+    Vector<uint8_t> m_rowStorage;
+    Seconds m_lastFrameGPUCost { 0_s };
+};
+
+} // namespace WebGPU::Dawn
