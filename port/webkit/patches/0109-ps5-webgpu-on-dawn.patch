+        FeatureName::Rg11b10ufloatRenderable,
+        FeatureName::Bgra8unormStorage,
+        FeatureName::Float32Filterable,
+        FeatureName::Float32Blendable,
+        FeatureName::ClipDistances,
+        FeatureName::DualSourceBlending,
+        FeatureName::Float16Renderable,
+        FeatureName::Float32Renderable,
+        FeatureName::CoreFeaturesAndLimits,
+        FeatureName::TextureFormatsTier1,
+        FeatureName::TextureFormatsTier2,
+        FeatureName::PrimitiveIndex,
+        FeatureName::Subgroups,
+        FeatureName::TextureComponentSwizzle,
+    };
+    // A feature added to WebGPUCpp.h goes in the array above as well as in toDawn(FeatureName).
+    static_assert(static_cast<size_t>(FeatureName::TextureComponentSwizzle) + 1 == names.size());
+    return names;
+}
+
+// A bit that no Dawn flag has. Dawn's validation rejects a value with it set. It has to be in the
+// low 32 bits: Dawn's flags are 64 bits wide, but its validation looks at 32 of them.
+static constexpr uint64_t unknownFlag = 1ull << 31;
+
+static wgpu::BufferUsage toDawnFlag(BufferUsage value)
+{
+    switch (value) {
+    case BufferUsage::MapRead:
+        return wgpu::BufferUsage::MapRead;
+    case BufferUsage::MapWrite:
+        return wgpu::BufferUsage::MapWrite;
+    case BufferUsage::CopySource:
+        return wgpu::BufferUsage::CopySrc;
+    case BufferUsage::CopyDestination:
+        return wgpu::BufferUsage::CopyDst;
+    case BufferUsage::Index:
+        return wgpu::BufferUsage::Index;
+    case BufferUsage::Vertex:
+        return wgpu::BufferUsage::Vertex;
+    case BufferUsage::Uniform:
+        return wgpu::BufferUsage::Uniform;
+    case BufferUsage::Storage:
+        return wgpu::BufferUsage::Storage;
+    case BufferUsage::Indirect:
+        return wgpu::BufferUsage::Indirect;
+    case BufferUsage::QueryResolve:
+        return wgpu::BufferUsage::QueryResolve;
+    case BufferUsage::Invalid:
+        return static_cast<wgpu::BufferUsage>(unknownFlag);
+    }
+    RELEASE_ASSERT_NOT_REACHED();
+}
