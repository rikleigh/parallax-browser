+    wgpu::SamplerDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.addressModeU = toDawn(descriptor.addressModeU);
+    dawnDescriptor.addressModeV = toDawn(descriptor.addressModeV);
+    dawnDescriptor.addressModeW = toDawn(descriptor.addressModeW);
+    dawnDescriptor.magFilter = toDawn(descriptor.magFilter);
+    dawnDescriptor.minFilter = toDawn(descriptor.minFilter);
