+#pragma once
+
+#include <WebGPU/WebGPUCpp.h>
+#include <webgpu/webgpu_cpp.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/ThreadSafeWeakPtr.h>
+
+namespace WebGPU::Dawn {
+
+class PresentationContextImpl;
+
+// https://gpuweb.github.io/gpuweb/#gputexture
+//
+// The texture of a canvas is one the presentation context owns and hands out again for every frame
+// that uses its render buffer. The canvas calls destroy() when the frame is over, which for such
+// a texture only ends the frame: the context still has to read the frame to present it. It
+// calls undestroy() when the next frame of the render buffer starts.
+class TextureImpl final : public Texture {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(TextureImpl);
+public:
+    static Ref<TextureImpl> create(wgpu::Texture&& texture)
+    {
+        return adoptRef(*new TextureImpl(WTF::move(texture), nullptr));
+    }
+
+    static Ref<TextureImpl> createCanvasBacking(wgpu::Texture&& texture, PresentationContextImpl& presentationContext)
+    {
+        return adoptRef(*new TextureImpl(WTF::move(texture), &presentationContext));
+    }
+
+    ~TextureImpl();
+
+    RefPtr<TextureView> createView(const std::optional<TextureViewDescriptor>&) final;
+    void destroy() final;
+    void undestroy() final;
+    void setLabel(String&&) final;
+    bool isValid() const final { return !!m_texture; }
+
+    const wgpu::Texture& dawnTexture() const { return m_texture; }
+    bool isCanvasBacking() const { return m_isCanvasBacking; }
+    bool isDestroyed() const { return m_isDestroyed; }
+    // The presentation context is done with the texture, and frees its memory.
+    void releaseCanvasBacking();
+
+private:
+    TextureImpl(wgpu::Texture&&, PresentationContextImpl*);
+
+    wgpu::Texture m_texture;
+    ThreadSafeWeakPtr<PresentationContextImpl> m_presentationContext;
+    const bool m_isCanvasBacking;
+    bool m_isDestroyed { false };
+};
+
+inline TextureImpl& fromAPI(Texture& texture)
+{
+    return static_cast<TextureImpl&>(texture);
+}
+
+inline const TextureImpl& fromAPI(const Texture& texture)
+{
+    return static_cast<const TextureImpl&>(texture);
+}
+
+wgpu::TexelCopyTextureInfo toDawn(const TexelCopyTextureInfo&);
+// The view of a render pass attachment, or of a texture that a bind group binds whole.
+wgpu::TextureView defaultView(const Texture&);
+
+} // namespace WebGPU::Dawn
