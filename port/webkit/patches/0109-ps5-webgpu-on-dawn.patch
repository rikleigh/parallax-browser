+{
+    switch (value) {
+    case MapMode::Read:
+        return wgpu::MapMode::Read;
+    case MapMode::Write:
+        return wgpu::MapMode::Write;
+    }
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+static wgpu::ShaderStage toDawnFlag(ShaderStage value)
+{
+    switch (value) {
+    case ShaderStage::Vertex:
+        return wgpu::ShaderStage::Vertex;
+    case ShaderStage::Fragment:
+        return wgpu::ShaderStage::Fragment;
+    case ShaderStage::Compute:
+        return wgpu::ShaderStage::Compute;
+    }
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+static wgpu::TextureUsage toDawnFlag(TextureUsage value)
+{
+    switch (value) {
+    case TextureUsage::CopySource:
+        return wgpu::TextureUsage::CopySrc;
+    case TextureUsage::CopyDestination:
+        return wgpu::TextureUsage::CopyDst;
+    case TextureUsage::TextureBinding:
+        return wgpu::TextureUsage::TextureBinding;
+    case TextureUsage::StorageBinding:
+        return wgpu::TextureUsage::StorageBinding;
+    case TextureUsage::RenderAttachment:
+        return wgpu::TextureUsage::RenderAttachment;
+    case TextureUsage::Transient:
+        return wgpu::TextureUsage::TransientAttachment;
+    case TextureUsage::Invalid:
+        return static_cast<wgpu::TextureUsage>(unknownFlag);
+    }
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+template<typename DawnFlags, typename Flag>
+static DawnFlags toDawnFlags(OptionSet<Flag> flags)
+{
+    DawnFlags result { };
+    for (auto flag : flags)
+        result |= toDawnFlag(flag);
+    return result;
+}
+
+wgpu::BufferUsage toDawn(OptionSet<BufferUsage> flags)
+{
+    return toDawnFlags<wgpu::BufferUsage>(flags);
+}
+
+wgpu::ColorWriteMask toDawn(OptionSet<ColorWrite> flags)
+{
+    return toDawnFlags<wgpu::ColorWriteMask>(flags);
+}
+
+wgpu::MapMode toDawn(OptionSet<MapMode> flags)
+{
+    return toDawnFlags<wgpu::MapMode>(flags);
+}
+
+wgpu::ShaderStage toDawn(OptionSet<ShaderStage> flags)
+{
+    return toDawnFlags<wgpu::ShaderStage>(flags);
+}
+
+wgpu::TextureUsage toDawn(OptionSet<TextureUsage> flags)
+{
+    return toDawnFlags<wgpu::TextureUsage>(flags);
+}
+
+CompilationMessageType fromDawn(wgpu::CompilationMessageType value)
+{
+    switch (value) {
+    case wgpu::CompilationMessageType::Error:
+        return CompilationMessageType::Error;
+    case wgpu::CompilationMessageType::Warning:
+        return CompilationMessageType::Warning;
+    case wgpu::CompilationMessageType::Info:
+        return CompilationMessageType::Info;
+    }
+    return CompilationMessageType::Error;
+}
+
+DeviceLostReason fromDawn(wgpu::DeviceLostReason value)
+{
+    switch (value) {
+    case wgpu::DeviceLostReason::Destroyed:
+    // The instance went away with the device still alive.
+    case wgpu::DeviceLostReason::CallbackCancelled:
+        return DeviceLostReason::Destroyed;
+    case wgpu::DeviceLostReason::Unknown:
+    case wgpu::DeviceLostReason::FailedCreation:
+        return DeviceLostReason::Unknown;
+    }
+    return DeviceLostReason::Unknown;
+}
+
+std::optional<ErrorType> fromDawn(wgpu::ErrorType value)
+{
+    switch (value) {
+    case wgpu::ErrorType::NoError:
+        return std::nullopt;
+    case wgpu::ErrorType::Validation:
+        return ErrorType::Validation;
+    case wgpu::ErrorType::OutOfMemory:
+        return ErrorType::OutOfMemory;
+    case wgpu::ErrorType::Internal:
+    case wgpu::ErrorType::Unknown:
+        return ErrorType::Internal;
+    }
+    return ErrorType::Internal;
+}
+
+PipelineErrorReason pipelineErrorReason(wgpu::CreatePipelineAsyncStatus value)
+{
+    switch (value) {
+    case wgpu::CreatePipelineAsyncStatus::ValidationError:
+        return PipelineErrorReason::Validation;
+    case wgpu::CreatePipelineAsyncStatus::Success:
+    case wgpu::CreatePipelineAsyncStatus::CallbackCancelled:
+    case wgpu::CreatePipelineAsyncStatus::InternalError:
+        return PipelineErrorReason::Internal;
+    }
+    return PipelineErrorReason::Internal;
+}
+
+wgpu::BlendComponent toDawn(const BlendComponent& value)
+{
+    wgpu::BlendComponent result;
+    result.operation = toDawn(value.operation);
+    result.srcFactor = toDawn(value.srcFactor);
+    result.dstFactor = toDawn(value.dstFactor);
+    return result;
+}
+
+wgpu::Color toDawn(const Color& value)
+{
+    wgpu::Color result;
+    result.r = value.r;
+    result.g = value.g;
+    result.b = value.b;
+    result.a = value.a;
+    return result;
+}
+
+wgpu::Extent3D toDawn(const Extent3D& value)
+{
+    wgpu::Extent3D result;
+    result.width = value.width;
+    result.height = value.height;
+    result.depthOrArrayLayers = value.depthOrArrayLayers;
+    return result;
+}
+
+wgpu::Origin3D toDawn(const Origin3D& value)
+{
+    wgpu::Origin3D result;
+    result.x = value.x;
+    result.y = value.y;
+    result.z = value.z;
+    return result;
+}
+
+wgpu::StencilFaceState toDawn(const StencilFaceState& value)
+{
+    wgpu::StencilFaceState result;
+    result.compare = toDawn(value.compare);
+    result.failOp = toDawn(value.failOp);
+    result.depthFailOp = toDawn(value.depthFailOp);
+    result.passOp = toDawn(value.passOp);
+    return result;
+}
+
+wgpu::TexelCopyBufferLayout toDawn(const TexelCopyBufferLayout& value)
+{
+    wgpu::TexelCopyBufferLayout result;
+    result.offset = value.offset;
+    result.bytesPerRow = value.bytesPerRow.value_or(wgpu::kCopyStrideUndefined);
+    result.rowsPerImage = value.rowsPerImage.value_or(wgpu::kCopyStrideUndefined);
+    return result;
+}
+
+wgpu::TextureComponentSwizzle toDawn(const TextureComponentSwizzle& value)
+{
+    wgpu::TextureComponentSwizzle result;
+    result.r = toDawn(value.r);
+    result.g = toDawn(value.g);
+    result.b = toDawn(value.b);
+    result.a = toDawn(value.a);
+    return result;
+}
+
+// The limits both APIs have. A limit added to WebGPU::Limits goes in this list, which both
+// conversions use, or is handled by hand in them; the static_assert below is the reminder.
+#define FOR_EACH_COMMON_LIMIT(macro) \
+    macro(maxTextureDimension1D) \
+    macro(maxTextureDimension2D) \
+    macro(maxTextureDimension3D) \
+    macro(maxTextureArrayLayers) \
+    macro(maxBindGroups) \
+    macro(maxBindGroupsPlusVertexBuffers) \
+    macro(maxBindingsPerBindGroup) \
+    macro(maxDynamicUniformBuffersPerPipelineLayout) \
+    macro(maxDynamicStorageBuffersPerPipelineLayout) \
+    macro(maxSampledTexturesPerShaderStage) \
+    macro(maxSamplersPerShaderStage) \
+    macro(maxStorageBuffersPerShaderStage) \
+    macro(maxStorageTexturesPerShaderStage) \
+    macro(maxUniformBuffersPerShaderStage) \
+    macro(maxUniformBufferBindingSize) \
+    macro(maxStorageBufferBindingSize) \
+    macro(minUniformBufferOffsetAlignment) \
+    macro(minStorageBufferOffsetAlignment) \
+    macro(maxVertexBuffers) \
+    macro(maxBufferSize) \
+    macro(maxVertexAttributes) \
+    macro(maxVertexBufferArrayStride) \
+    macro(maxInterStageShaderVariables) \
+    macro(maxColorAttachments) \
+    macro(maxColorAttachmentBytesPerSample) \
+    macro(maxComputeWorkgroupStorageSize) \
+    macro(maxComputeInvocationsPerWorkgroup) \
+    macro(maxComputeWorkgroupSizeX) \
+    macro(maxComputeWorkgroupSizeY) \
+    macro(maxComputeWorkgroupSizeZ) \
+    macro(maxComputeWorkgroupsPerDimension)
+
+// 28 32-bit and 3 64-bit common limits, and the 4 limits of the compatibility mode that are handled
+// by hand below.
+static_assert(sizeof(Limits) == 160, "WebGPU::Limits changed: update FOR_EACH_COMMON_LIMIT and the conversions");
+
+wgpu::Limits toDawn(const Limits& value)
+{
+    wgpu::Limits result;
+#define COPY_LIMIT(name) result.name = value.name;
+    FOR_EACH_COMMON_LIMIT(COPY_LIMIT)
+#undef COPY_LIMIT
+    // maxStorageBuffersInFragmentStage, maxStorageTexturesInFragmentStage,
+    // maxStorageBuffersInVertexStage and maxStorageTexturesInVertexStage are limits of the
+    // compatibility mode. A core device has no such limits apart from the per-stage ones.
+    return result;
+}
+
+Limits fromDawn(const wgpu::Limits& value)
+{
+    Limits result;
+#define COPY_LIMIT(name) result.name = value.name;
+    FOR_EACH_COMMON_LIMIT(COPY_LIMIT)
+#undef COPY_LIMIT
+    // In core mode these are the per-stage limits.
+    result.maxStorageBuffersInFragmentStage = value.maxStorageBuffersPerShaderStage;
+    result.maxStorageTexturesInFragmentStage = value.maxStorageTexturesPerShaderStage;
+    result.maxStorageBuffersInVertexStage = value.maxStorageBuffersPerShaderStage;
+    result.maxStorageTexturesInVertexStage = value.maxStorageTexturesPerShaderStage;
+    return result;
+}
+
+#undef FOR_EACH_COMMON_LIMIT
+
+uint32_t canvasBytesPerPixel(TextureFormat format)
+{
+    switch (format) {
+    case TextureFormat::Bgra8unorm:
+    case TextureFormat::Rgba8unorm:
+        return 4;
+    case TextureFormat::Rgba16float:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+std::optional<TextureFormat> srgbVariant(TextureFormat format)
+{
+    switch (format) {
+    case TextureFormat::Bgra8unorm:
+        return TextureFormat::Bgra8unormSRGB;
+    case TextureFormat::Rgba8unorm:
+        return TextureFormat::Rgba8unormSRGB;
+    default:
+        return std::nullopt;
+    }
+}
+
+String fromStringView(wgpu::StringView view)
+{
+    std::string_view string = view;
+    if (string.empty())
+        return emptyString();
+    return String::fromUTF8ReplacingInvalidSequences(byteCast<char8_t>(std::span<const char> { string }));
+}
+
+} // namespace WebGPU::Dawn
