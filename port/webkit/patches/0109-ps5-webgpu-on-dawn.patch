+#include "config.h"
+#include "WebGPUCompositorIntegrationImpl.h"
+
+// The compositor integration of a WebGPU canvas where the implementation shares no textures with
+// the compositor (PS5: Dawn on RADV, the compositor on ps5-opengl). The implementation's
+// presentation context hands each presented frame over as pixels (WebGPU::PresentationContextDescriptor);
+// this passes them to the frame sink, which shows them and keeps the newest for readback.
+#if HAVE(WEBGPU_IMPLEMENTATION) && USE(DAWN)
+
+#include <WebCore/NativeImage.h>
+#include <WebCore/WebGPUCppAPI.h>
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(WebGPUCompositorIntegrationImpl);
+
+WebGPUCompositorIntegrationImpl::WebGPUCompositorIntegrationImpl() = default;
+
+WebGPUCompositorIntegrationImpl::~WebGPUCompositorIntegrationImpl() = default;
+
+void WebGPUCompositorIntegrationImpl::prepareForDisplay(uint32_t frameIndex, CompletionHandler<void()>&& completionHandler)
+{
+    // The frame's pixels arrive later, in frameWasPresented(), once the GPU has drawn it. The page
+    // is not kept waiting for them: the implementation keeps one readback in flight and the newest
+    // frame behind it, so a page that draws faster than the GPU reads back drops frames, not time.
+    if (RefPtr presentationContext = m_presentationContext)
+        presentationContext->present(frameIndex);
+    completionHandler();
+}
+
+void WebGPUCompositorIntegrationImpl::frameWasPresented(uint32_t frameIndex, std::span<const uint8_t> pixels, uint32_t width, uint32_t height, WebGPU::TextureFormat format, WebGPU::CanvasAlphaMode alphaMode)
+{
+    if (m_frameSink)
+        m_frameSink(frameIndex, pixels, width, height, format, alphaMode);
+}
+
+Seconds WebGPUCompositorIntegrationImpl::lastFrameGPUCost() const
+{
+    if (RefPtr presentationContext = m_presentationContext)
+        return presentationContext->lastFrameGPUCost();
+    return 0_s;
+}
+
+Seconds WebGPUCompositorIntegrationImpl::lastFramePresentStall() const
+{
+    if (RefPtr presentationContext = m_presentationContext)
+        return presentationContext->lastFramePresentStall();
+    return 0_s;
+}
+
+void WebGPUCompositorIntegrationImpl::updateContentsHeadroom(float)
+{
+}
+
+void WebGPUCompositorIntegrationImpl::withDisplayBufferAsNativeImage(uint32_t, Function<void(WebCore::NativeImage*)> completion)
+{
+    // Readback is the frame sink's: it holds the newest frame's pixels (RemoteCompositorIntegration).
+    completion(nullptr);
+}
+
+void WebGPUCompositorIntegrationImpl::paintCompositedResultsToCanvas(WebCore::ImageBuffer&, uint32_t)
+{
+    ASSERT_NOT_REACHED();
+}
+
+} // namespace WebCore
