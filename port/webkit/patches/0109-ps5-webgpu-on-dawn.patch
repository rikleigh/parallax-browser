+#include "config.h"
+#include "BindGroup.h"
+
+#include "BindGroupLayout.h"
+#include "Buffer.h"
+#include "Conversions.h"
+#include "Device.h"
+#include "Sampler.h"
+#include "Texture.h"
+#include "TextureView.h"
+
+namespace WebGPU::Dawn {
+
+RefPtr<BindGroup> DeviceImpl::createBindGroup(const BindGroupDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createbindgroup
+    auto label = descriptor.label.utf8();
+
+    auto entries = WTF::map(descriptor.entries, [](auto& entry) {
+        wgpu::BindGroupEntry dawnEntry;
+        dawnEntry.binding = entry.binding;
+        WTF::switchOn(entry.resource, [&](const Ref<Sampler>& sampler) {
+            dawnEntry.sampler = fromAPI(sampler.get()).dawnSampler();
+        }, [&](const Ref<Texture>& texture) {
+            dawnEntry.textureView = defaultView(texture.get());
+        }, [&](const Ref<TextureView>& textureView) {
+            dawnEntry.textureView = fromAPI(textureView.get()).dawnTextureView();
+        }, [&](const BufferBinding& bufferBinding) {
+            dawnEntry.buffer = fromAPI(bufferBinding.buffer.get()).dawnBuffer();
+            dawnEntry.offset = bufferBinding.offset;
+            dawnEntry.size = bufferBinding.size.value_or(wgpu::kWholeSize);
+        }, [&](const Ref<ExternalTexture>&) {
+            // No external texture is valid (see ExternalTextureImpl), so the entry binds nothing
+            // and Dawn's validation rejects the bind group.
+        });
+        return dawnEntry;
+    });
+
+    wgpu::BindGroupDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.layout = fromAPI(descriptor.layout.get()).dawnBindGroupLayout();
+    dawnDescriptor.entryCount = entries.size();
+    dawnDescriptor.entries = entries.span().data();
+    return BindGroupImpl::create(m_device.CreateBindGroup(&dawnDescriptor));
+}
+
+void BindGroupImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_bindGroup.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
