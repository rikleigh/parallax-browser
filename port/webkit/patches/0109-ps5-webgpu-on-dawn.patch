+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "RenderPipeline.h"
+
+#include "BindGroupLayout.h"
+#include "Device.h"
+#include "ProgrammableStage.h"
+
+namespace WebGPU::Dawn {
+
+namespace {
+
+// A wgpu::RenderPipelineDescriptor and what it points to. It points into itself, so it stays
+// where it is made.
+struct ConvertedDescriptor {
+    WTF_MAKE_NONCOPYABLE(ConvertedDescriptor);
+public:
+    ConvertedDescriptor(const RenderPipelineDescriptor& descriptor, const wgpu::PipelineLayout* layoutOverride)
+        : label(descriptor.label.utf8())
+        , vertex(descriptor.vertex.stage)
+    {
+        dawnDescriptor.label = stringView(label);
+        dawnDescriptor.layout = pipelineLayout(descriptor.layout, layoutOverride);
+
+        // https://gpuweb.github.io/gpuweb/#dictdef-gpuvertexstate
+        vertex.apply(dawnDescriptor.vertex);
+        attributes.reserveInitialCapacity(descriptor.vertex.buffers.size());
+        buffers.reserveInitialCapacity(descriptor.vertex.buffers.size());
+        for (auto& buffer : descriptor.vertex.buffers) {
+            wgpu::VertexBufferLayout dawnBuffer;
+            // A slot with no buffer keeps the undefined step mode and has no attributes.
+            if (buffer) {
+                attributes.append(WTF::map(buffer->attributes, [](auto& attribute) {
+                    wgpu::VertexAttribute dawnAttribute;
+                    dawnAttribute.format = toDawn(attribute.format);
+                    dawnAttribute.offset = attribute.offset;
+                    dawnAttribute.shaderLocation = attribute.shaderLocation;
+                    return dawnAttribute;
+                }));
+                dawnBuffer.stepMode = toDawn(buffer->stepMode);
+                dawnBuffer.arrayStride = buffer->arrayStride;
+                dawnBuffer.attributeCount = attributes.last().size();
+                dawnBuffer.attributes = attributes.last().span().data();
+            }
+            buffers.append(dawnBuffer);
+        }
+        dawnDescriptor.vertex.bufferCount = buffers.size();
+        dawnDescriptor.vertex.buffers = buffers.span().data();
+
+        // https://gpuweb.github.io/gpuweb/#dictdef-gpuprimitivestate
+        dawnDescriptor.primitive.topology = toDawn(descriptor.primitive.topology);
+        if (descriptor.primitive.stripIndexFormat)
+            dawnDescriptor.primitive.stripIndexFormat = toDawn(*descriptor.primitive.stripIndexFormat);
+        dawnDescriptor.primitive.frontFace = toDawn(descriptor.primitive.frontFace);
+        dawnDescriptor.primitive.cullMode = toDawn(descriptor.primitive.cullMode);
+        dawnDescriptor.primitive.unclippedDepth = descriptor.primitive.unclippedDepth;
+
+        // https://gpuweb.github.io/gpuweb/#dictdef-gpudepthstencilstate
+        if (descriptor.depthStencil) {
+            auto& state = *descriptor.depthStencil;
+            depthStencil.format = toDawn(state.format);
+            if (state.depthWriteEnabled)
+                depthStencil.depthWriteEnabled = *state.depthWriteEnabled ? wgpu::OptionalBool::True : wgpu::OptionalBool::False;
+            if (state.depthCompare)
+                depthStencil.depthCompare = toDawn(*state.depthCompare);
+            depthStencil.stencilFront = toDawn(state.stencilFront);
+            depthStencil.stencilBack = toDawn(state.stencilBack);
+            depthStencil.stencilReadMask = state.stencilReadMask;
+            depthStencil.stencilWriteMask = state.stencilWriteMask;
+            depthStencil.depthBias = state.depthBias;
+            depthStencil.depthBiasSlopeScale = state.depthBiasSlopeScale;
+            depthStencil.depthBiasClamp = state.depthBiasClamp;
+            dawnDescriptor.depthStencil = &depthStencil;
+        }
+
+        // https://gpuweb.github.io/gpuweb/#dictdef-gpumultisamplestate
+        dawnDescriptor.multisample.count = descriptor.multisample.count;
+        dawnDescriptor.multisample.mask = descriptor.multisample.mask;
+        dawnDescriptor.multisample.alphaToCoverageEnabled = descriptor.multisample.alphaToCoverageEnabled;
+
+        // https://gpuweb.github.io/gpuweb/#dictdef-gpufragmentstate
+        if (descriptor.fragment) {
+            fragment.emplace(descriptor.fragment->stage);
+            fragment->apply(fragmentState);
+            // The targets point to these, so this must not reallocate.
+            blendStates.reserveInitialCapacity(descriptor.fragment->targets.size());
+            targets.reserveInitialCapacity(descriptor.fragment->targets.size());
+            for (auto& target : descriptor.fragment->targets) {
+                wgpu::ColorTargetState dawnTarget;
+                // A slot with no target keeps the undefined format.
+                if (target) {
+                    dawnTarget.format = toDawn(target->format);
+                    if (target->blend) {
+                        wgpu::BlendState blend;
+                        blend.color = toDawn(target->blend->color);
+                        blend.alpha = toDawn(target->blend->alpha);
+                        blendStates.append(blend);
+                        dawnTarget.blend = &blendStates.last();
+                    }
+                    dawnTarget.writeMask = toDawn(target->writeMask);
+                }
+                targets.append(dawnTarget);
+            }
+            fragmentState.targetCount = targets.size();
+            fragmentState.targets = targets.span().data();
+            dawnDescriptor.fragment = &fragmentState;
+        }
+    }
+
+    UTF8CString label;
+    ProgrammableStageConverter vertex;
+    Vector<Vector<wgpu::VertexAttribute>> attributes;
+    Vector<wgpu::VertexBufferLayout> buffers;
+    wgpu::DepthStencilState depthStencil;
+    std::optional<ProgrammableStageConverter> fragment;
+    Vector<wgpu::BlendState> blendStates;
+    Vector<wgpu::ColorTargetState> targets;
+    wgpu::FragmentState fragmentState;
+    wgpu::RenderPipelineDescriptor dawnDescriptor;
+};
+
+} // namespace
+
+RefPtr<RenderPipeline> DeviceImpl::createRenderPipeline(const RenderPipelineDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createrenderpipeline
+    ConvertedDescriptor converted { descriptor, nullptr };
+    return RenderPipelineImpl::create(m_device.CreateRenderPipeline(&converted.dawnDescriptor), wgpu::PipelineLayout { converted.dawnDescriptor.layout });
+}
+
+void DeviceImpl::createRenderPipelineAsync(const RenderPipelineDescriptor& descriptor, const wgpu::PipelineLayout* layoutOverride, RenderPipelineCallback&& callback)
+{
+    // Without the instance nothing calls Dawn's callbacks, and the device is destroyed.
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        callback(std::unexpected(PipelineError { PipelineErrorReason::Internal, "The device is lost."_s }));
+        return;
+    }
+
+    ConvertedDescriptor converted { descriptor, layoutOverride };
+    m_device.CreateRenderPipelineAsync(&converted.dawnDescriptor, wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback)), layout = converted.dawnDescriptor.layout](wgpu::CreatePipelineAsyncStatus status, wgpu::RenderPipeline pipeline, wgpu::StringView message) {
+        if (status != wgpu::CreatePipelineAsyncStatus::Success || !pipeline) {
+            pending->handler()(std::unexpected(pipelineError(status, message)));
+            return;
+        }
+        pending->handler()(Ref<RenderPipeline> { RenderPipelineImpl::create(WTF::move(pipeline), wgpu::PipelineLayout { layout }) });
+    });
+}
+
+void DeviceImpl::createRenderPipelineAsync(const RenderPipelineDescriptor& descriptor, CompletionHandler<void(std::expected<Ref<RenderPipeline>, PipelineError>&&)>&& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createrenderpipelineasync
+    createRenderPipelineAsync(descriptor, nullptr, WTF::move(callback));
+}
+
+void DeviceImpl::createRenderPipelineWithPipelineLayoutFromPipelineAsync(const RenderPipelineDescriptor& descriptor, const RenderPipeline& pipelineToReplace, CompletionHandler<void(std::expected<Ref<RenderPipeline>, PipelineError>&&)>&& callback)
+{
+    // See createComputePipelineWithPipelineLayoutFromPipelineAsync().
+    bool wasErrorReportingPaused = m_errorReportingPaused;
+    pauseAllErrorReporting(true);
+    createRenderPipelineAsync(descriptor, &fromAPI(pipelineToReplace).layout(), WTF::move(callback));
+    pauseAllErrorReporting(wasErrorReportingPaused);
+}
+
+Ref<BindGroupLayout> RenderPipelineImpl::getBindGroupLayout(uint32_t index)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpupipelinebase-getbindgrouplayout
+    // An index that is out of range is a validation error and an invalid layout.
+    return BindGroupLayoutImpl::create(m_pipeline.GetBindGroupLayout(index));
+}
+
+void RenderPipelineImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_pipeline.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
