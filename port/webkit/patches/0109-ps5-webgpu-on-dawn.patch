+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "ShaderModule.h"
+
+#include "Conversions.h"
+#include "Device.h"
+#include <wtf/StdLibExtras.h>
+
+namespace WebGPU::Dawn {
+
+RefPtr<ShaderModule> DeviceImpl::createShaderModule(const ShaderModuleDescriptor& descriptor)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpudevice-createshadermodule
+    // The compilation hints are only hints, and are not used.
+    auto label = descriptor.label.utf8();
+    auto code = descriptor.code.utf8();
+
+    wgpu::ShaderSourceWGSL source;
+    source.code = definedStringView(code);
+
+    wgpu::ShaderModuleDescriptor dawnDescriptor;
+    dawnDescriptor.label = stringView(label);
+    dawnDescriptor.nextInChain = &source;
+    RefPtr instance = m_instance.get();
+    return ShaderModuleImpl::create(m_device.CreateShaderModule(&dawnDescriptor), instance.get());
+}
+
+static CompilationMessage convertMessage(const wgpu::CompilationMessage& message)
+{
+    CompilationMessage result;
+    result.message = fromStringView(message.message);
+    result.type = fromDawn(message.type);
+    result.lineNum = message.lineNum;
+    // Dawn counts the position in the line, the offset and the length in UTF-8 bytes, and chains
+    // the same in UTF-16 code units, which is what GPUCompilationMessage has. The line number and
+    // the position in the line are one-based in both, and zero when the message has no position.
+    result.linePos = message.linePos;
+    result.offset = message.offset;
+    result.length = message.length;
+    for (auto* chained = message.nextInChain; chained; chained = chained->nextInChain) {
+        if (chained->sType != wgpu::SType::DawnCompilationMessageUtf16)
+            continue;
+        auto& utf16 = *static_cast<const wgpu::DawnCompilationMessageUtf16*>(chained);
+        result.linePos = utf16.linePos;
+        result.offset = utf16.offset;
+        result.length = utf16.length;
+        break;
+    }
+    return result;
+}
+
+void ShaderModuleImpl::compilationInfo(CompletionHandler<void(CompilationInfo&&)>&& callback)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpushadermodule-getcompilationinfo
+    // Without the instance nothing calls Dawn's callbacks.
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        callback({ });
+        return;
+    }
+
+    m_shaderModule.GetCompilationInfo(wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(callback))](wgpu::CompilationInfoRequestStatus status, const wgpu::CompilationInfo* info) {
+        CompilationInfo result;
+        if (status == wgpu::CompilationInfoRequestStatus::Success && info) {
+            for (auto& message : unsafeMakeSpan(info->messages, info->messageCount))
+                result.messages.append(convertMessage(message));
+        }
+        pending->handler()(WTF::move(result));
+    });
+}
+
+void ShaderModuleImpl::setLabel(String&& label)
+{
+    auto labelUTF8 = label.utf8();
+    m_shaderModule.SetLabel(stringView(labelUTF8));
+}
+
+} // namespace WebGPU::Dawn
