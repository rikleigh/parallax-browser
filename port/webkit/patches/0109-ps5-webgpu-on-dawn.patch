+#include <webgpu/webgpu_cpp.h>
+#include <wtf/OptionSet.h>
+#include <wtf/text/CString.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebGPU::Dawn {
+
+// Enums. Every switch is exhaustive and has no default, so that a new enumerator in WebGPUCpp.h
+// does not compile until it is converted.
+wgpu::AddressMode toDawn(AddressMode);
+wgpu::BlendFactor toDawn(BlendFactor);
+wgpu::BlendOperation toDawn(BlendOperation);
+wgpu::BufferBindingType toDawn(BufferBindingType);
+wgpu::CompositeAlphaMode toDawn(CanvasAlphaMode);
+wgpu::ToneMappingMode toDawn(CanvasToneMappingMode);
+wgpu::CompareFunction toDawn(CompareFunction);
+wgpu::ComponentSwizzle toDawn(ComponentSwizzle);
+wgpu::CullMode toDawn(CullMode);
+wgpu::ErrorFilter toDawn(ErrorFilter);
+wgpu::FilterMode toDawn(FilterMode);
+wgpu::FrontFace toDawn(FrontFace);
+wgpu::IndexFormat toDawn(IndexFormat);
+wgpu::LoadOp toDawn(LoadOp);
+wgpu::MipmapFilterMode toDawn(MipmapFilterMode);
+wgpu::PowerPreference toDawn(PowerPreference);
+wgpu::PrimitiveTopology toDawn(PrimitiveTopology);
+wgpu::QueryType toDawn(QueryType);
+wgpu::SamplerBindingType toDawn(SamplerBindingType);
+wgpu::StencilOperation toDawn(StencilOperation);
+wgpu::StorageTextureAccess toDawn(StorageTextureAccess);
+wgpu::StoreOp toDawn(StoreOp);
+wgpu::TextureAspect toDawn(TextureAspect);
+wgpu::TextureDimension toDawn(TextureDimension);
+wgpu::TextureFormat toDawn(TextureFormat);
+wgpu::TextureSampleType toDawn(TextureSampleType);
+wgpu::TextureViewDimension toDawn(TextureViewDimension);
+wgpu::VertexFormat toDawn(VertexFormat);
+wgpu::VertexStepMode toDawn(VertexStepMode);
+
+// std::nullopt: Dawn has no such feature, so no adapter offers it and no device can require it.
+std::optional<wgpu::FeatureName> toDawn(FeatureName);
+// Every WebGPU::FeatureName, for the code that asks Dawn about each of them in turn.
+std::span<const FeatureName> allFeatureNames();
+
+// Flags. An Invalid flag becomes a bit that Dawn does not know, which its validation rejects.
+wgpu::BufferUsage toDawn(OptionSet<BufferUsage>);
+wgpu::ColorWriteMask toDawn(OptionSet<ColorWrite>);
+wgpu::MapMode toDawn(OptionSet<MapMode>);
+wgpu::ShaderStage toDawn(OptionSet<ShaderStage>);
+wgpu::TextureUsage toDawn(OptionSet<TextureUsage>);
+
+// Enums that Dawn reports.
+CompilationMessageType fromDawn(wgpu::CompilationMessageType);
+DeviceLostReason fromDawn(wgpu::DeviceLostReason);
+// std::nullopt for wgpu::ErrorType::NoError.
+std::optional<ErrorType> fromDawn(wgpu::ErrorType);
+PipelineErrorReason pipelineErrorReason(wgpu::CreatePipelineAsyncStatus);
+
+// Structs with no pointers. The ones that point to other storage are converted where they are used.
+wgpu::BlendComponent toDawn(const BlendComponent&);
+wgpu::Color toDawn(const Color&);
+wgpu::Extent3D toDawn(const Extent3D&);
+wgpu::Limits toDawn(const Limits&);
+wgpu::Origin3D toDawn(const Origin3D&);
+wgpu::StencilFaceState toDawn(const StencilFaceState&);
+wgpu::TexelCopyBufferLayout toDawn(const TexelCopyBufferLayout&);
+wgpu::TextureComponentSwizzle toDawn(const TextureComponentSwizzle&);
+Limits fromDawn(const wgpu::Limits&);
+
+// The bytes of a texel of a format a canvas can have. Zero for any other format.
+uint32_t canvasBytesPerPixel(TextureFormat);
+// The format with -srgb appended, where there is one.
+std::optional<TextureFormat> srgbVariant(TextureFormat);
+
+// Strings. Dawn takes UTF-8 that the caller keeps alive for the call, so a call converts each
+// string with String::utf8() to a UTF8CString that it holds, and passes a view of it. A null
+// string is an undefined string view, which is what Dawn takes for no label.
+inline wgpu::StringView stringView(const CStringBase& string)
+{
+    if (string.isNull())
+        return { };
+    auto characters = string.span();
+    return { characters.data(), characters.size() };
+}
+
+// For the strings that are never undefined: WGSL source, the label of a debug group or marker,
+// the name of an override. A null string is the empty string.
+inline wgpu::StringView definedStringView(const CStringBase& string)
+{
+    auto characters = string.span();
+    return { string.isNull() ? "" : characters.data(), characters.size() };
+}
+
+String fromStringView(wgpu::StringView);
+
+} // namespace WebGPU::Dawn
