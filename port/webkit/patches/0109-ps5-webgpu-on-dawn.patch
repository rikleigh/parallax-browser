+namespace WebGPU::Dawn {
+
+// https://gpuweb.github.io/gpuweb/#gpupipelinelayout
+// A layout with no bind group layouts given is the "auto" layout, which a pipeline generates from
+// its shaders. There is no Dawn object for it: a pipeline descriptor has a null layout instead.
+class PipelineLayoutImpl final : public PipelineLayout {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(PipelineLayoutImpl);
+public:
+    static Ref<PipelineLayoutImpl> create(wgpu::PipelineLayout&& pipelineLayout)
+    {
+        return adoptRef(*new PipelineLayoutImpl(WTF::move(pipelineLayout)));
+    }
+
+    static Ref<PipelineLayoutImpl> createAuto()
+    {
+        return adoptRef(*new PipelineLayoutImpl(nullptr));
+    }
+
+    void setLabel(String&&) final;
+    bool isValid() const final { return true; }
+
+    bool isAutoLayout() const { return !m_pipelineLayout; }
+    // Null for the auto layout.
+    const wgpu::PipelineLayout& dawnPipelineLayout() const { return m_pipelineLayout; }
+
+private:
+    explicit PipelineLayoutImpl(wgpu::PipelineLayout&& pipelineLayout)
+        : m_pipelineLayout(WTF::move(pipelineLayout))
+    {
+    }
+
+    wgpu::PipelineLayout m_pipelineLayout;
+};
+
+inline const PipelineLayoutImpl& fromAPI(const PipelineLayout& pipelineLayout)
+{
+    return static_cast<const PipelineLayoutImpl&>(pipelineLayout);
+}
