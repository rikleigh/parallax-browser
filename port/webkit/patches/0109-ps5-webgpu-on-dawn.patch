+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "PresentationContext.h"
+
+#include "Conversions.h"
+#include "Texture.h"
+#include <wtf/StdLibExtras.h>
+
+namespace WebGPU::Dawn {
+
+// https://gpuweb.github.io/gpuweb/#dom-gputexelcopybufferlayout-bytesperrow
+static constexpr uint32_t bytesPerRowAlignment = 256;
+
+Ref<PresentationContextImpl> PresentationContextImpl::create(const PresentationContextDescriptor& descriptor, InstanceImpl& instance)
+{
+    // The descriptor is a call parameter that is not kept, but its function is what the context
+    // is for, and a WTF::Function cannot be copied. The callers build the descriptor for the call.
+    auto& presentFrame = const_cast<PresentationContextDescriptor&>(descriptor).presentFrame;
+    return adoptRef(*new PresentationContextImpl(WTF::move(presentFrame), instance));
+}
+
+PresentationContextImpl::PresentationContextImpl(PresentFrameFunction&& presentFrame, InstanceImpl& instance)
+    : m_presentFrame(WTF::move(presentFrame))
+    , m_instance(instance)
+{
+}
+
+PresentationContextImpl::~PresentationContextImpl()
+{
+    releaseRenderBuffers();
+}
+
+void PresentationContextImpl::releaseRenderBuffers()
+{
+    ++m_generation;
+    for (auto& renderBuffer : m_renderBuffers) {
+        if (RefPtr texture = std::exchange(renderBuffer, nullptr))
+            texture->releaseCanvasBacking();
+    }
+    // Destroying a buffer aborts its mapping, and the callback finds another generation.
+    for (auto& buffer : m_readbackBuffers) {
+        if (auto readbackBuffer = std::exchange(buffer, nullptr))
+            readbackBuffer.Destroy();
+    }
+    m_readbackInFlight = std::nullopt;
+    m_queuedFrame = std::nullopt;
+    m_rowStorage.clear();
+    m_lastFrameGPUCost = 0_s;
+}
+
+void PresentationContextImpl::configure(const CanvasConfiguration& configuration)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucanvascontext-configure
+    releaseRenderBuffers();
+    m_configuration = std::nullopt;
+
+    Ref device = fromAPI(configuration.device.get());
+
+    // An invalid texture for getCurrentTexture(), whose caller needs an object.
+    wgpu::TextureDescriptor invalidDescriptor;
+    invalidDescriptor.usage = wgpu::TextureUsage::RenderAttachment;
+    invalidDescriptor.size = { 1, 1, 1 };
+    invalidDescriptor.format = wgpu::TextureFormat::BGRA8Unorm;
+    m_invalidTexture = TextureImpl::create(device->dawnDevice().CreateErrorTexture(&invalidDescriptor));
+
+    auto fail = [&](ASCIILiteral message) {
+        if (configuration.reportValidationErrors)
+            device->generateAValidationError(message);
+    };
+
+    auto format = configuration.format;
+    auto bytesPerPixel = canvasBytesPerPixel(format);
+    if (!bytesPerPixel)
+        return fail("GPUCanvasContext.configure: the format is not a format of a canvas"_s);
+
+    auto width = configuration.width;
+    auto height = configuration.height;
+    if (!width || !height)
+        return fail("GPUCanvasContext.configure: the width or the height is zero"_s);
+
+    auto maximumDimension = device->limits().maxTextureDimension2D;
+    if (width > maximumDimension || height > maximumDimension)
+        return fail("GPUCanvasContext.configure: the canvas is larger than maxTextureDimension2D"_s);
+
+    uint64_t bytes = static_cast<uint64_t>(width) * height * bytesPerPixel;
+    if (bytes > maximumRenderBufferBytes)
+        return fail("GPUCanvasContext.configure: the canvas is too large"_s);
+
+    auto usage = configuration.usage;
+    if (usage.isEmpty() || usage.contains(TextureUsage::Invalid) || usage.contains(TextureUsage::Transient))
+        return fail("GPUCanvasContext.configure: the usage is not a usage of a canvas"_s);
+
+    if (format == TextureFormat::Bgra8unorm && usage.contains(TextureUsage::StorageBinding) && !device->hasFeature(FeatureName::Bgra8unormStorage))
+        return fail("GPUCanvasContext.configure: the usage has STORAGE_BINDING and the device does not have bgra8unorm-storage"_s);
+
+    for (auto viewFormat : configuration.viewFormats) {
+        if (viewFormat != format && viewFormat != srgbVariant(format))
+            return fail("GPUCanvasContext.configure: a view format is not compatible with the format"_s);
+    }
+
+    uint32_t bytesPerRow = width * bytesPerPixel;
+    uint32_t paddedBytesPerRow = roundUpToMultipleOf(bytesPerRowAlignment, bytesPerRow);
+    m_configuration = Configuration {
+        .device = WTF::move(device),
+        .format = format,
+        .alphaMode = configuration.compositingAlphaMode,
+        // Presenting copies from the texture, and a frame starts with a render pass that clears it.
+        .usage = toDawn(usage) | wgpu::TextureUsage::CopySrc | wgpu::TextureUsage::RenderAttachment,
+        .viewFormats = WTF::map(configuration.viewFormats, [](auto viewFormat) {
+            return toDawn(viewFormat);
+        }),
+        .width = width,
+        .height = height,
+        .bytesPerRow = bytesPerRow,
+        .paddedBytesPerRow = paddedBytesPerRow,
+        .readbackSize = static_cast<uint64_t>(paddedBytesPerRow) * height,
+    };
+}
+
+void PresentationContextImpl::unconfigure()
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucanvascontext-unconfigure
+    releaseRenderBuffers();
+    m_configuration = std::nullopt;
+}
+
+wgpu::Texture PresentationContextImpl::createRenderBufferTexture()
+{
+    auto& configuration = *m_configuration;
+
+    wgpu::TextureDescriptor descriptor;
+    descriptor.label = "canvas backing";
+    descriptor.usage = configuration.usage;
+    descriptor.dimension = wgpu::TextureDimension::e2D;
+    descriptor.size = { configuration.width, configuration.height, 1 };
+    descriptor.format = toDawn(configuration.format);
+    descriptor.viewFormatCount = configuration.viewFormats.size();
+    descriptor.viewFormats = configuration.viewFormats.span().data();
+    // Dawn clears a new texture before its first use, unless that use overwrites all of it.
+    return configuration.device->dawnDevice().CreateTexture(&descriptor);
+}
+
+RefPtr<Texture> PresentationContextImpl::getCurrentTexture(uint32_t frameIndex)
+{
+    // https://gpuweb.github.io/gpuweb/#dom-gpucanvascontext-getcurrenttexture
+    if (!m_configuration || frameIndex >= maximumRenderBuffers) {
+        if (m_configuration)
+            m_configuration->device->generateAValidationError("GPUCanvasContext.getCurrentTexture: there is no such render buffer"_s);
+        return m_invalidTexture;
+    }
+
+    auto& renderBuffer = m_renderBuffers[frameIndex];
+    if (renderBuffer) {
+        // The canvas normally sends undestroy() for a texture that it already has.
+        renderBuffer->undestroy();
+        return renderBuffer;
+    }
+
+    renderBuffer = TextureImpl::createCanvasBacking(createRenderBufferTexture(), *this);
+    return renderBuffer;
+}
+
+bool PresentationContextImpl::startFrame(TextureImpl& texture)
+{
+    bool isRenderBuffer = std::ranges::any_of(m_renderBuffers, [&](auto& renderBuffer) {
+        return renderBuffer == &texture;
+    });
+    if (!m_configuration || !isRenderBuffer)
+        return false;
+
+    // https://gpuweb.github.io/gpuweb/#abstract-opdef-replace-the-drawing-buffer
+    // The frame starts as transparent black, whatever the frame before left in the texture. A
+    // render pass that clears costs less than a new texture for every frame.
+    auto& device = m_configuration->device->dawnDevice();
+
+    wgpu::RenderPassColorAttachment attachment;
+    attachment.view = texture.dawnTexture().CreateView();
+    attachment.loadOp = wgpu::LoadOp::Clear;
+    attachment.storeOp = wgpu::StoreOp::Store;
+    attachment.clearValue = { 0, 0, 0, 0 };
+
+    wgpu::RenderPassDescriptor descriptor;
+    descriptor.label = "canvas clear";
+    descriptor.colorAttachmentCount = 1;
+    descriptor.colorAttachments = &attachment;
+
+    wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+    encoder.BeginRenderPass(&descriptor).End();
+    wgpu::CommandBuffer commands = encoder.Finish();
+    device.GetQueue().Submit(1, &commands);
+    return true;
+}
+
+wgpu::Buffer PresentationContextImpl::createReadbackBuffer()
+{
+    auto& configuration = *m_configuration;
+
+    wgpu::BufferDescriptor descriptor;
+    descriptor.label = "canvas readback";
+    descriptor.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+    descriptor.size = configuration.readbackSize;
+    return configuration.device->dawnDevice().CreateBuffer(&descriptor);
+}
+
+void PresentationContextImpl::copyToReadbackBuffer(const wgpu::Texture& texture, const wgpu::Buffer& buffer)
+{
+    auto& configuration = *m_configuration;
+    auto& device = configuration.device->dawnDevice();
+
+    wgpu::TexelCopyTextureInfo source;
+    source.texture = texture;
+    wgpu::TexelCopyBufferInfo destination;
+    destination.buffer = buffer;
+    destination.layout.bytesPerRow = configuration.paddedBytesPerRow;
+    destination.layout.rowsPerImage = configuration.height;
+    wgpu::Extent3D extent { configuration.width, configuration.height, 1 };
+
+    wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+    encoder.CopyTextureToBuffer(&source, &destination, &extent);
+    wgpu::CommandBuffer commands = encoder.Finish();
+    device.GetQueue().Submit(1, &commands);
+}
+
+void PresentationContextImpl::present(uint32_t frameIndex)
+{
+    if (!m_configuration || frameIndex >= maximumRenderBuffers)
+        return;
+
+    RefPtr texture = m_renderBuffers[frameIndex];
+    if (!texture)
+        return;
+
+    // The copy is submitted now, so that it is of the frame as it is presented. It goes to the
+    // buffer that is not being mapped. When that buffer already has a frame that waits for the
+    // one in flight, this frame replaces it.
+    size_t readbackIndex = m_readbackInFlight ? 1 - *m_readbackInFlight : 0;
+    auto& buffer = m_readbackBuffers[readbackIndex];
+    if (!buffer)
+        buffer = createReadbackBuffer();
+    copyToReadbackBuffer(texture->dawnTexture(), buffer);
+
+    auto presentTime = MonotonicTime::now();
+    if (m_readbackInFlight) {
+        m_queuedFrame = QueuedFrame { frameIndex, presentTime };
+        return;
+    }
+    startReadback(readbackIndex, frameIndex, presentTime);
+}
+
+void PresentationContextImpl::startReadback(size_t readbackIndex, uint32_t frameIndex, MonotonicTime presentTime)
+{
+    // Without the instance nothing calls Dawn's callbacks, and the frame is dropped.
+    RefPtr instance = m_instance.get();
+    if (!instance)
+        return;
+
+    m_readbackInFlight = readbackIndex;
+
+    Function<void(bool)> completed = [weakThis = ThreadSafeWeakPtr { *this }, generation = m_generation, readbackIndex, frameIndex, presentTime](bool success) {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->readbackCompleted(generation, readbackIndex, frameIndex, presentTime, success);
+    };
+    m_readbackBuffers[readbackIndex].MapAsync(wgpu::MapMode::Read, 0, static_cast<size_t>(m_configuration->readbackSize), wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(completed))](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        pending->handler()(status == wgpu::MapAsyncStatus::Success);
+    });
+}
+
+std::span<const uint8_t> PresentationContextImpl::tightlyPackedRows(std::span<const uint8_t> mapping, uint32_t bytesPerRow, uint32_t paddedBytesPerRow, uint32_t height, Vector<uint8_t>& storage)
+{
+    size_t size = static_cast<size_t>(bytesPerRow) * height;
+    if (bytesPerRow == paddedBytesPerRow)
+        return mapping.first(size);
+
+    storage.resize(size);
+    auto destination = storage.mutableSpan();
+    for (uint32_t row = 0; row < height; ++row)
+        memcpySpan(destination.subspan(static_cast<size_t>(row) * bytesPerRow, bytesPerRow), mapping.subspan(static_cast<size_t>(row) * paddedBytesPerRow, bytesPerRow));
+    return storage.span();
+}
+
+void PresentationContextImpl::readbackCompleted(uint64_t generation, size_t readbackIndex, uint32_t frameIndex, MonotonicTime presentTime, bool success)
+{
+    // The context was configured again, or unconfigured, and the buffers went with that.
+    if (generation != m_generation || !m_configuration)
+        return;
+
+    // presentFrame can do anything, including configuring the context. Until it returns the
+    // buffer counts as in flight, so that a frame presented from inside it goes to the other one.
+    Ref protectedThis { *this };
+    wgpu::Buffer buffer = m_readbackBuffers[readbackIndex];
+    if (success) {
+        auto& configuration = *m_configuration;
+        // Wall time from present() to the pixels: the GPU time of the frame, and the wait for
+        // the pump on top of it.
+        m_lastFrameGPUCost = MonotonicTime::now() - presentTime;
+
+        auto readbackSize = static_cast<size_t>(configuration.readbackSize);
+        if (auto* data = static_cast<const uint8_t*>(buffer.GetConstMappedRange(0, readbackSize)); data && m_presentFrame) {
+            auto rows = tightlyPackedRows(unsafeMakeSpan(data, readbackSize), configuration.bytesPerRow, configuration.paddedBytesPerRow, configuration.height, m_rowStorage);
+            m_presentFrame(frameIndex, rows, configuration.width, configuration.height, configuration.format, configuration.alphaMode);
+        }
+        buffer.Unmap();
+    }
+
+    if (generation != m_generation || !m_configuration)
+        return;
+
+    m_readbackInFlight = std::nullopt;
+    if (auto queuedFrame = std::exchange(m_queuedFrame, std::nullopt))
+        startReadback(1 - readbackIndex, queuedFrame->frameIndex, queuedFrame->presentTime);
+}
+
+void PresentationContextImpl::readPixels(uint32_t bufferIndex, CompletionHandler<void(std::span<const uint8_t>, uint32_t width, uint32_t height, TextureFormat)>&& completionHandler)
+{
+    RefPtr texture = m_configuration && bufferIndex < maximumRenderBuffers ? m_renderBuffers[bufferIndex] : nullptr;
+    // Without the instance nothing calls Dawn's callbacks.
+    RefPtr instance = m_instance.get();
+    if (!texture || !instance) {
+        completionHandler({ }, 0, 0, m_configuration ? m_configuration->format : TextureFormat::Bgra8unorm);
+        return;
+    }
+
+    // A buffer of its own, so that this neither waits for the frames that are being presented
+    // nor holds them up. Reading the canvas is rare.
+    auto& configuration = *m_configuration;
+    wgpu::Buffer buffer = createReadbackBuffer();
+    copyToReadbackBuffer(texture->dawnTexture(), buffer);
+
+    buffer.MapAsync(wgpu::MapMode::Read, 0, static_cast<size_t>(configuration.readbackSize), wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(completionHandler)), buffer, readbackSize = static_cast<size_t>(configuration.readbackSize), bytesPerRow = configuration.bytesPerRow, paddedBytesPerRow = configuration.paddedBytesPerRow, width = configuration.width, height = configuration.height, format = configuration.format](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        auto* data = status == wgpu::MapAsyncStatus::Success ? static_cast<const uint8_t*>(buffer.GetConstMappedRange(0, readbackSize)) : nullptr;
+        if (!data) {
+            pending->handler()({ }, 0, 0, format);
+            buffer.Destroy();
+            return;
+        }
+        Vector<uint8_t> storage;
+        pending->handler()(tightlyPackedRows(unsafeMakeSpan(data, readbackSize), bytesPerRow, paddedBytesPerRow, height, storage), width, height, format);
+        buffer.Destroy();
+    });
+}
+
+} // namespace WebGPU::Dawn
