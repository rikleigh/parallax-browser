 void RemoteCompositorIntegrationProxy::prepareForDisplay(uint32_t frameIndex, CompletionHandler<void()>&& completionHandler)
 {
+#if USE(DAWN)
+    // PS5: the frame reaches the compositor from the title (PS5WebGPUCanvas), not through this
+    // process's layer tree, so nothing here needs it to have been presented. The synchronous
+    // message kept the main thread for as long as the title took to run the frame's commands
+    // (4.4 ms a frame for a WebGPU emulator, with its worker's proxied calls waiting behind it).
+    // PS5WK_WEBGPU_SYNC_PRESENT=1 (child.env): the synchronous message, as before.
+    static const bool synchronous = [] {
+        const char* value = getenv("PS5WK_WEBGPU_SYNC_PRESENT");
+        return value && *value && *value != '0';
+    }();
+    if (!synchronous) {
+        auto sendResult = send(Messages::RemoteCompositorIntegration::PresentPS5(frameIndex));
+        UNUSED_VARIABLE(sendResult);
+        completionHandler();
+        return;
+    }
+#endif
     auto sendResult = sendSync(Messages::RemoteCompositorIntegration::PrepareForDisplay(frameIndex));
     auto [gpuFrameCost, presentStall] = sendResult.takeReplyOr(Seconds { 0 }, Seconds { 0 });
     m_lastFrameGPUCost = gpuFrameCost;
