 DrawingAreaWC::~DrawingAreaWC()
 {
     while (auto layer = m_liveGraphicsLayers.removeHead())
         layer->clearObserver();
+#if !ENABLE(GPU_PROCESS)
+    liveDrawingAreasWC().removeFirst(this);
+    m_idleDisplayRefreshTimer.stop();
+    // This drawing area drove the process's monitor (a closed or discarded
+    // tab): another page's takes it, a shown page's first, so that rAF and
+    // the rendering updates of the pages left keep their clock (without
+    // this they lost it for good: rAF only ran when something else started
+    // a rendering update).
+    if (auto* monitor = sharedDisplayRefreshMonitorWC().get(); monitor && monitor->drawingArea() == this) {
+        m_displayRefreshMonitor = nullptr;
+        monitor->setDrawingArea(nullptr);
+        DrawingAreaWC* successor = nullptr;
+        for (auto* area : liveDrawingAreasWC()) {
+            bool visible = area->isPageVisible();
+            if (!successor || visible)
+                successor = area;
+            if (visible)
+                break;
+        }
+        if (successor)
+            successor->adoptDisplayRefreshMonitor("the page that drove it went");
+    }
+#endif
