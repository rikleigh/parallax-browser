+// The process's monitor (DisplayRefreshMonitorManager keeps it for good)
+// and the drawing areas alive, for handing it on.
+static RefPtr<DrawingAreaWC::DisplayRefreshMonitorWC>& sharedDisplayRefreshMonitorWC()
+{
+    static NeverDestroyed<RefPtr<DrawingAreaWC::DisplayRefreshMonitorWC>> monitor;
+    return monitor.get();
+}
+
+static Vector<DrawingAreaWC*>& liveDrawingAreasWC()
+{
+    static NeverDestroyed<Vector<DrawingAreaWC*>> areas;
+    return areas.get();
