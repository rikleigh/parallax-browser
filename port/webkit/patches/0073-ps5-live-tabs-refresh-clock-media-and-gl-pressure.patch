+
 RefPtr<DisplayRefreshMonitor> DrawingAreaWC::createDisplayRefreshMonitor(PlatformDisplayID displayID)
 {
     m_displayRefreshMonitor = DisplayRefreshMonitorWC::create(*this, displayID);
+    sharedDisplayRefreshMonitorWC() = m_displayRefreshMonitor;
     return m_displayRefreshMonitor;
 }
 
+// This drawing area drives the process's monitor from now on (its page was
+// shown, or the one that drove it went). Raw pointers only: it also runs
+// from ~DrawingAreaWC.
+void DrawingAreaWC::adoptDisplayRefreshMonitor(const char* why)
+{
+    auto* monitor = sharedDisplayRefreshMonitorWC().get();
+    if (!monitor)
+        return;
+    DrawingAreaWC* previous = monitor->drawingArea();
+    if (previous == this)
+        return;
+    if (previous) {
+        previous->m_displayRefreshMonitor = nullptr;
+        previous->m_idleDisplayRefreshTimer.stop();
+    }
+    m_displayRefreshMonitor = monitor;
+    monitor->setDrawingArea(this);
+    WTFLogAlways("[render] refresh clock (rAF): drawing area %llu drives it now (%s; it was %s, %s)", static_cast<unsigned long long>(identifier().toUInt64()), why, // NOLINT
+        previous ? "another page's" : "nobody's", monitor->isActive() ? "a refresh asked for" : "idle");
+    // A refresh asked for while the previous one drove it (or while nobody
+    // did) still comes.
+    if (monitor->isActive())
+        displayRefreshMonitorStarted();
+}
+
+void DrawingAreaWC::activityStateDidChange(OptionSet<ActivityState> changed, ActivityStateChangeID, CompletionHandler<void()>&& completionHandler)
+{
+    // The page shown (WebPage updated WebCore's page first): rAF follows its
+    // presents, not a hidden page's.
+    if ((changed & ActivityState::IsVisible) && isPageVisible())
+        adoptDisplayRefreshMonitor("page shown");
+    completionHandler();
+}
+
+bool DrawingAreaWC::isPageVisible() const
+{
+    auto* page = m_webPage.ptrAllowingHashTableEmptyValue();
+    return page && page->activityState().contains(ActivityState::IsVisible);
+}
