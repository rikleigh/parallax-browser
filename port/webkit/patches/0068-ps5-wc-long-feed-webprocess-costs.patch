+static void ps5LogCompositingReasons(const RenderLayerCompositor& compositor, const RenderLayer& root)
+{
+    static const bool enabled = [] {
+        const char* value = getenv("PS5WK_WC_LAYER_LOG");
+        return value && strchr(value, '3');
+    }();
+    if (!enabled)
+        return;
+    static MonotonicTime lastLog;
+    static unsigned lastComposited;
+    auto now = MonotonicTime::now();
+    // Walk at most once a second; log when the count moved by 5 % or more.
+    if (now - lastLog < 1_s)
+        return;
+    lastLog = now;
+    unsigned renderLayers = 0, composited = 0, sharing = 0;
+    HashMap<String, unsigned> byReason;
+    HashMap<String, HashMap<String, unsigned>> kindsByReason;
+    Function<void(const RenderLayer&)> visit = [&](const RenderLayer& layer) {
+        renderLayers++;
+        if (layer.isComposited()) {
+            composited++;
+            auto reasons = compositor.reasonsForCompositing(layer);
+            ASCIILiteral label = "none"_s;
+            static constexpr CompositingReason order[] = {
+                CompositingReason::Root, CompositingReason::Video, CompositingReason::Canvas, CompositingReason::IFrame,
+                CompositingReason::Transform3D, CompositingReason::WillChange, CompositingReason::Animation,
+                CompositingReason::PositionFixed, CompositingReason::PositionSticky, CompositingReason::OverflowScrolling,
+                CompositingReason::Filters, CompositingReason::BackfaceVisibilityHidden, CompositingReason::Perspective,
+                CompositingReason::Preserve3D, CompositingReason::Overlap, CompositingReason::Stacking,
+                CompositingReason::ClipsCompositingDescendants, CompositingReason::OverflowScrollPositioning,
+                CompositingReason::NegativeZIndexChildren, CompositingReason::TransformWithCompositedDescendants,
+                CompositingReason::OpacityWithCompositedDescendants, CompositingReason::MaskWithCompositedDescendants,
+                CompositingReason::ReflectionWithCompositedDescendants, CompositingReason::FilterWithCompositedDescendants,
+                CompositingReason::BlendingWithCompositedDescendants, CompositingReason::IsolatesCompositedBlendingDescendants,
+                CompositingReason::BackdropRoot, CompositingReason::AnchorPositioning, CompositingReason::Plugin,
+                CompositingReason::Model, CompositingReason::SpatialPortal };
+            for (auto reason : order) {
+                if (reasons.contains(reason)) {
+                    label = compositingReasonToString(reason);
+                    break;
+                }
+            }
+            byReason.add(label, 0).iterator->value++;
+            StringBuilder kind;
+            if (RefPtr element = layer.renderer().element()) {
+                kind.append(element->localName());
+                if (element->hasClass() && element->classNames().size())
+                    kind.append('.', element->classNames()[0]);
+            } else
