+// [render] compositing lines (every 5 s while updates run, PS5WK_RENDER_LOG
+// not 0): how often the compositing layers were updated and what it cost.
+struct PS5CompositingUpdateStats {
+    unsigned updates { 0 }, requirementTraversals { 0 }, hierarchyUpdates { 0 };
+    double milliseconds { 0 }, maxMilliseconds { 0 };
+    MonotonicTime windowStart;
+};
+static PS5CompositingUpdateStats& ps5CompositingUpdateStats()
+{
+    static NeverDestroyed<PS5CompositingUpdateStats> stats; // main thread only
+    return stats.get();
+}
+static void ps5NoteCompositingUpdate(MonotonicTime start)
+{
+    static const bool enabled = !getenv("PS5WK_RENDER_LOG") || strcmp(getenv("PS5WK_RENDER_LOG"), "0");
+    if (!enabled)
+        return;
+    auto now = MonotonicTime::now();
+    auto& stats = ps5CompositingUpdateStats();
+    double ms = (now - start).milliseconds();
+    stats.updates++;
+    stats.milliseconds += ms;
+    stats.maxMilliseconds = std::max(stats.maxMilliseconds, ms);
+    if (!stats.windowStart)
+        stats.windowStart = start;
+    if (now - stats.windowStart < 5_s)
+        return;
+    WTFLogAlways("[render] compositing: %u updates in %.1f s, %.1f ms avg, %.1f max (%u with a requirements traversal, %u with a backing/hierarchy update)", // NOLINT
+        stats.updates, (now - stats.windowStart).seconds(), stats.milliseconds / stats.updates, stats.maxMilliseconds, stats.requirementTraversals, stats.hierarchyUpdates);
+    stats = { };
+    stats.windowStart = now;
+}
 #endif
 
