+    WTFLogAlways("[wc-reasons] %u render layers, %u composited, %u painting into a shared backing; by reason: %s", renderLayers, composited, sharing, line.toString().utf8().data()); // NOLINT
+    for (auto& [reason, count] : reasons) {
+        if (count < 10)
+            continue;
+        Vector<std::pair<String, unsigned>> kinds;
+        for (auto& entry : kindsByReason.get(reason))
