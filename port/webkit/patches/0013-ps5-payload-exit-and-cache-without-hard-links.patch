diff --git a/Source/WebKit/Shared/AuxiliaryProcess.cpp b/Source/WebKit/Shared/AuxiliaryProcess.cpp
index 3dd33d679e..208672c552 100644
--- a/Source/WebKit/Shared/AuxiliaryProcess.cpp
