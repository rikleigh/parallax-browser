+// PS5: printing a console argument must not run page code. toWTFString calls
+// an object's toString/valueOf/Symbol.toPrimitive and reads Symbol.toStringTag,
+// all of which a page can define, so a page can tell that its console is being
+// read; challenge pages (Cloudflare Turnstile) log such objects and fail the
+// check. Primitives convert without page code (a Symbol throws, which the
+// caller clears); an object prints its internal class name, and an Error its
+// own message when that is a plain string data property.
+static String consoleArgumentString(JSGlobalObject* globalObject, JSValue value)
+{
+    if (!value.isObject())
+        return value.toWTFString(globalObject);
+    JSObject* object = asObject(value);
+    String className = String(object->classInfo()->className);
+    if (auto* error = dynamicDowncast<ErrorInstance>(object)) {
+        VM& vm = globalObject->vm();
+        unsigned attributes = 0;
+        JSValue message = error->getDirect(vm, vm.propertyNames->message, attributes);
+        if (message && message.isString() && !(attributes & PropertyAttribute::Accessor))
+            return makeString("[object "_s, className, "] "_s, message.toWTFString(globalObject));
+    }
+    return makeString("[object "_s, className, ']');
+}
