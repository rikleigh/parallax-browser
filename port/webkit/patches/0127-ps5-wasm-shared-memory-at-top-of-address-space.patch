+// PS5 (13.60, measured with payloads): a process's address space ends at 0xFC00000000. mmap refuses
+// every address from there up, MAP_FIXED included, and an access there is a SIGSEGV with the address.
+// An inaccessible reservation costs CPU page tables like any mapping (one per 2 MB, of 8192 for the
+// whole console) and MAP_GUARD is not supported, so upstream's fast memory (4 GiB + redzone reserved)
+// cannot be had. A memory that ends at the top needs none of it: memory32 code reaches at most
+// base + 4 GiB + redzone, and everything past the mapping is the kernel's own hole.
+// /data/ps5webkit/no-wasm-top-memory turns this off.
+static constexpr uintptr_t ps5AddressSpaceTop = 0xFC00000000ull;
+
+static bool ps5TopOfAddressSpaceIsUnmappable()
+{
+    static bool result = false;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        if (!access("/data/ps5webkit/no-wasm-top-memory", F_OK)) {
+            dataLogLn("[wasm] no memory at the top of the address space (/data/ps5webkit/no-wasm-top-memory)");
+            return;
+        }
+        if (!Options::useWasmFaultSignalHandler())
+            return;
+        // The whole range that code without bounds checks can reach past a memory ending at the top
+        // must be refused, or this firmware is not laid out as measured. By hint, never MAP_FIXED: where
+        // the kernel does allow a mapping, MAP_FIXED would replace whatever is there.
+        constexpr size_t step = 64 * 1024 * 1024;
+        size_t reach = BufferMemoryHandle::fastMappedBytes() + step;
+        size_t pageSize = WTF::pageSize();
+        for (size_t offset = 0; offset <= reach; offset += step) {
+            for (size_t probe : { offset, offset + step - pageSize }) {
+                void* address = std::bit_cast<void*>(ps5AddressSpaceTop + probe);
+                void* mapped = mmap(address, pageSize, PROT_NONE, MAP_PRIVATE | MAP_ANON, -1, 0);
+                if (mapped != MAP_FAILED) {
+                    munmap(mapped, pageSize);
+                    dataLogLn("[wasm] no memory at the top of the address space: the kernel mapped ", RawPointer(mapped), " for a hint of ", RawPointer(address));
+                    return;
+                }
+            }
+        }
+        result = true;
+    });
+    return result;
+}
