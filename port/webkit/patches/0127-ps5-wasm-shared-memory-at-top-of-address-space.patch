+void* BufferMemoryManager::ps5TryAllocateTopSlot(size_t mappedCapacity)
+{
+    size_t pageSize = WTF::pageSize();
+    if (!mappedCapacity || mappedCapacity % pageSize || mappedCapacity > PageCount::maxMemory32Bytes)
