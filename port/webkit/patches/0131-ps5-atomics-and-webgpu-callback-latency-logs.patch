 // See ~InstanceImpl(). With the sleep between the rounds this is a tenth of a second.
 static constexpr unsigned maximumFinalPumpRounds = 1000;
 
+void noteCallbackLatency(LatencyKind kind, MonotonicTime registered)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        // open(), as MemoryBudget.cpp: this runs in the title.
+        int fd = open("/data/ps5webkit/webgpu-latency-log", O_RDONLY);
+        enabled = fd >= 0;
+        if (fd >= 0)
+            close(fd);
+        WTFLogAlways("[webgpu] title: latency log %s (/data/ps5webkit/webgpu-latency-log)", enabled ? "on" : "off");
+    }
+    if (!enabled)
+        return;
+    // One thread registers and is called back (the pump's).
+    static constexpr unsigned bucketCount = 8;
+    static constexpr double limitsUS[bucketCount] = { 200, 500, 1000, 2000, 4000, 8000, 16000, 1e18 };
+    struct Histogram { uint64_t count { 0 }; double totalUS { 0 }; uint64_t buckets[bucketCount] { }; };
+    static Histogram histograms[3];
+    static MonotonicTime lastDump = MonotonicTime::now();
+    auto now = MonotonicTime::now();
+    double us = (now - registered).microseconds();
+    auto& histogram = histograms[static_cast<unsigned>(kind)];
+    histogram.count++;
+    histogram.totalUS += us;
+    unsigned bucket = 0;
+    while (us >= limitsUS[bucket])
+        bucket++;
+    histogram.buckets[bucket]++;
+    double seconds = (now - lastDump).seconds();
+    if (seconds < 5)
+        return;
+    lastDump = now;
+    static constexpr const char* names[3] = { "mapAsync", "onSubmittedWorkDone", "canvas readback" };
+    for (unsigned i = 0; i < 3; ++i) {
+        auto& h = histograms[i];
+        if (h.count)
+            WTFLogAlways("[webgpu] title: latency %s: %.0f/s, %.0f us avg; under 200 us %llu, 500 %llu, 1 ms %llu, 2 ms %llu, 4 ms %llu, 8 ms %llu, 16 ms %llu, more %llu", names[i], h.count / seconds, h.totalUS / h.count,
+                static_cast<unsigned long long>(h.buckets[0]), static_cast<unsigned long long>(h.buckets[1]), static_cast<unsigned long long>(h.buckets[2]), static_cast<unsigned long long>(h.buckets[3]),
+                static_cast<unsigned long long>(h.buckets[4]), static_cast<unsigned long long>(h.buckets[5]), static_cast<unsigned long long>(h.buckets[6]), static_cast<unsigned long long>(h.buckets[7]));
+        h = { };
+    }
+}
