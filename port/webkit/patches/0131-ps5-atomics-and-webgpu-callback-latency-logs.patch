 namespace JSC {
 
+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// PS5, PS5WK_ATOMICS_LOG=1 (child.env): how long Atomics.wait blocks and how long a notified
+// Atomics.waitAsync takes to run its task, every 5 s. An Emscripten pthreads page proxies calls
+// to its main thread with this pair, and the round trips are what such a page waits for.
+namespace PS5AtomicsLog {
+static constexpr unsigned bucketCount = 8;
+static constexpr double bucketLimitsUS[bucketCount] = { 50, 100, 200, 500, 1000, 2000, 5000, 1e18 };
+struct Histogram {
+    std::atomic<uint64_t> count { 0 };
+    std::atomic<uint64_t> totalUS { 0 };
+    std::atomic<uint64_t> buckets[bucketCount] { };
+    void add(Seconds duration)
+    {
+        double us = duration.microseconds();
+        count++;
+        totalUS += static_cast<uint64_t>(us);
+        unsigned bucket = 0;
+        while (us >= bucketLimitsUS[bucket])
+            bucket++;
+        buckets[bucket]++;
+    }
+    void dumpAndReset(const char* name, double seconds)
+    {
+        uint64_t n = count.exchange(0), total = totalUS.exchange(0);
+        uint64_t b[bucketCount];
+        for (unsigned i = 0; i < bucketCount; ++i)
+            b[i] = buckets[i].exchange(0);
+        if (!n)
+            return;
+        dataLogLn("[atomics] ", name, ": ", static_cast<uint64_t>(n / seconds), "/s, ", total / n, " us avg, ", static_cast<uint64_t>(total / seconds / 1000), " ms/s; under 50 us ", b[0], ", 100 ", b[1], ", 200 ", b[2], ", 500 ", b[3], ", 1 ms ", b[4], ", 2 ms ", b[5], ", 5 ms ", b[6], ", more ", b[7]);
+    }
+};
+static Histogram syncWaitNotified, syncWaitTimedOut, asyncNotifyToTask;
+static std::atomic<uint64_t> syncNotEqual { 0 };
+static std::atomic<double> lastDump { 0 };
+static bool enabled()
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* value = getenv("PS5WK_ATOMICS_LOG");
+        on = value && *value && *value != '0';
+    }
+    return on;
+}
+static void maybeDump()
+{
+    double now = MonotonicTime::now().secondsSinceEpoch().seconds();
+    double last = lastDump.load();
+    if (now - last < 5 || !lastDump.compare_exchange_strong(last, now))
+        return;
+    if (!last)
+        return;
+    double seconds = now - last;
+    syncWaitNotified.dumpAndReset("wait, notified", seconds);
+    syncWaitTimedOut.dumpAndReset("wait, timed out", seconds);
+    asyncNotifyToTask.dumpAndReset("waitAsync, notify to task", seconds);
+    if (uint64_t n = syncNotEqual.exchange(0))
+        dataLogLn("[atomics] wait, not-equal at once: ", static_cast<uint64_t>(n / seconds), "/s");
+}
+}
+#endif
