+class WCScene::VideoLayer final : public WebCore::TextureMapperPlatformLayer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(WCScene::VideoLayer);
+public:
+    VideoLayer(uint64_t key, unsigned& count)
+        : key(key)
+        , m_count(count)
+    {
+        m_count++;
+    }
+    ~VideoLayer() { m_count--; }
+
+    // What the stream has now: its texture (0: no frame) and how many
+    // frames were converted into it.
+    unsigned current(uint32_t* frames) const
+    {
+        int width = 0, height = 0;
+        *frames = 0;
+        return s_videoTexture ? s_videoTexture(key, &width, &height, frames) : 0;
+    }
