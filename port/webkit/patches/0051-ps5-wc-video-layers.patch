+            textureMapper.drawTexture(texture, { }, target, modelViewMatrix, opacity); // row 0 = the picture's top, as tiles
+    }
+
+    const uint64_t key;
+    unsigned seenTexture { 0 };
+    uint32_t seenFrames { 0 };
+
+private:
+    unsigned& m_count;
+};
