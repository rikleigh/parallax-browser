+bool PS5WCScrollingTree::wheelGestureDidEnd()
+{
+    if (m_frameLockedStick) {
+        Locker locker { m_stickLock };
+        if (!m_stickPending.isZero())
+            return false;
+    }
+    {
+        Locker locker { treeLock() };
+        auto nodeID = std::exchange(m_wheelScrolledNode, std::nullopt);
+        auto event = std::exchange(m_wheelScrolledEvent, std::nullopt);
+        if (!nodeID || !event || !m_snapAfterWheel)
+            return true;
+        RefPtr node = dynamicDowncast<ScrollingTreeScrollingNode>(nodeForID(*nodeID));
+        if (!node || node->snapOffsetsInfo().isEmpty())
+            return true;
+        // ScrollingEffectsController: the gesture is over, the node is
+        // snapping, so it animates to the nearest snap position.
+        WheelGestureEndEvent endEvent { *event };
+        handleWheelEventWithNode(endEvent, { WheelEventProcessingSteps::AsyncScrolling }, node.get(), EventTargeting::NodeOnly);
+    }
+    PS5WCHost::noteScrollEvent(PS5WCHost::ScrollNote::SnapAfterWheel);
+    PS5WCHost::requestFrame();
+    return true;
 }
 
