+String PS5WCScrollingTree::describeSubScrollerRects()
+{
+    Locker locker { m_routingLock };
+    StringBuilder builder;
+    builder.append(m_subScrollerRects.size(), " sub-scroller rects"_s);
+    unsigned shown = 0;
+    for (auto& [nodeID, rect] : m_subScrollerRects) {
+        if (shown++ == 8) {
+            builder.append(" ..."_s);
+            break;
+        }
+        builder.append(shown == 1 ? ": "_s : ", "_s, static_cast<int>(rect.x()), ',', static_cast<int>(rect.y()), ' ', static_cast<int>(rect.width()), 'x', static_cast<int>(rect.height()));
+    }
+    return builder.toString();
+}
