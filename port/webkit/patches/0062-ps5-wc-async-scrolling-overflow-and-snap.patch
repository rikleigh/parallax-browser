+bool PS5WCScrollingTree::rootCanScrollForEvent(const PlatformWheelEvent& wheelEvent)
+{
+    Locker locker { treeLock() };
+    RefPtr root = rootNode();
+    return !root || root->eventCanScrollContents(wheelEvent);
+}
+
+bool PS5WCScrollingTree::subScrollerTakesEvent(ScrollingNodeID nodeID, const PlatformWheelEvent& wheelEvent)
+{
+    Locker locker { treeLock() };
+    auto delta = wheelEvent.delta();
+    for (RefPtr node = nodeForID(nodeID); node && !node->isRootNode(); node = node->parent()) {
+        RefPtr scrollingNode = dynamicDowncast<ScrollingTreeScrollingNode>(*node);
+        if (!scrollingNode)
+            continue;
+        if (scrollingNode->eventCanScrollContents(wheelEvent))
+            return true;
+        if ((delta.width() && scrollingNode->horizontalOverscrollBehavior() != OverscrollBehavior::Auto)
+            || (delta.height() && scrollingNode->verticalOverscrollBehavior() != OverscrollBehavior::Auto))
+            return true;
+    }
+    return false;
+}
