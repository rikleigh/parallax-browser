+#if !ENABLE(GPU_PROCESS)
+class DrawingAreaWC::DisplayRefreshMonitorWC final : public DisplayRefreshMonitor {
+public:
+    static Ref<DisplayRefreshMonitorWC> create(DrawingAreaWC& drawingArea, PlatformDisplayID displayID)
+    {
+        return adoptRef(*new DisplayRefreshMonitorWC(drawingArea, displayID));
+    }
+
+    bool isActive() const { return m_active; }
+
+    void fire()
+    {
+        if (!m_active)
+            return;
+        m_update = m_update.nextUpdate();
+        displayLinkFired(m_update);
+    }
+
+    std::optional<FramesPerSecond> displayNominalFramesPerSecond() final { return FullSpeedFramesPerSecond; }
+
+private:
+    DisplayRefreshMonitorWC(DrawingAreaWC& drawingArea, PlatformDisplayID displayID)
+        : DisplayRefreshMonitor(displayID)
+        , m_drawingArea(drawingArea)
+    {
+        Locker locker { lock() };
+        setMaxUnscheduledFireCount(1);
+    }
+
+    bool startNotificationMechanism() final
+    {
+        RefPtr drawingArea = m_drawingArea.get();
+        if (!drawingArea)
+            return false; // RenderingUpdateScheduler falls back to its timer
+        if (!m_active) {
+            m_active = true;
+            drawingArea->displayRefreshMonitorStarted();
+        }
+        return true;
+    }
+
+    void stopNotificationMechanism() final { m_active = false; }
+
+    WeakPtr<DrawingAreaWC> m_drawingArea;
+    bool m_active { false };
+    DisplayUpdate m_update { 0, FullSpeedFramesPerSecond };
+};
+
+RefPtr<DisplayRefreshMonitor> DrawingAreaWC::createDisplayRefreshMonitor(PlatformDisplayID displayID)
+{
+    m_displayRefreshMonitor = DisplayRefreshMonitorWC::create(*this, displayID);
+    return m_displayRefreshMonitor;
+}
+
+void DrawingAreaWC::displayRefreshMonitorStarted()
+{
+    // Called with the monitor's lock held: only start a timer here. With an
+    // update in flight its reply fires the monitor.
+    if (m_waitDidUpdate || m_idleDisplayRefreshTimer.isActive())
+        return;
+    auto delay = std::max(0_s, m_lastDisplayRefresh + Seconds(1.0 / FullSpeedFramesPerSecond) - MonotonicTime::now());
+    m_idleDisplayRefreshTimer.startOneShot(delay);
+}
+
+void DrawingAreaWC::idleDisplayRefreshTimerFired()
+{
+    if (m_waitDidUpdate)
+        return;
+#if defined(PS5_PAYLOAD_SDK)
+    wcRenderStats().idleFires++;
+#endif
+    fireDisplayRefreshMonitor();
+}
+
+void DrawingAreaWC::fireDisplayRefreshMonitor()
+{
+    RefPtr monitor = m_displayRefreshMonitor;
+    if (!monitor || !monitor->isActive())
+        return;
+    m_lastDisplayRefresh = MonotonicTime::now();
+#if defined(PS5_PAYLOAD_SDK)
+    wcRenderStats().monitorFires++;
+#endif
+    monitor->fire();
+    // A client that didn't start a rendering update (or the scheduler
+    // rescheduling) still needs the next tick.
+    if (monitor->isActive() && !m_waitDidUpdate && !m_updateRenderingTimer.isActive() && !m_idleDisplayRefreshTimer.isActive())
+        m_idleDisplayRefreshTimer.startOneShot(Seconds(1.0 / FullSpeedFramesPerSecond));
+}
+#endif // !ENABLE(GPU_PROCESS)
