+#if defined(PS5_PAYLOAD_SDK)
+// [render] lines for the composited path, in the CPU path's format
+// (NonCompositedFrameRenderer; test/paint/paint-ab-summary.py reads
+// [render1]): PS5WK_RENDER_LOG=0 off, 1 (default) every 5 s, 2 also one
+// [render1] line per update. "update" = style, layout, rAF and JavaScript;
+// "paint" = tiles painted on this thread; "copy" = the rest (layer commit,
+// sending the update); "frame done" = sent until the UI process presented it.
+static unsigned wcRenderLog()
+{
+    static unsigned level = [] {
+        const char* text = getenv("PS5WK_RENDER_LOG");
+        if (!text || !*text)
+            return 1u;
+        auto value = parseInteger<unsigned>(StringView::fromLatin1(text));
+        return value ? std::min(*value, 3u) : 1u;
+    }();
+    return level;
+}
+
+struct WCRenderStats {
+    Vector<float> totalMS, paintMS;
+    double updateMS { 0 }, megapixels { 0 }, frameDoneMS { 0 };
+    unsigned tiles { 0 }, frameDones { 0 }, monitorFires { 0 }, idleFires { 0 };
+    MonotonicTime windowStart;
+
+    static float percentile(Vector<float>& values, double fraction)
+    {
+        if (values.isEmpty())
+            return 0;
+        std::sort(values.begin(), values.end());
+        return values[std::min<size_t>(values.size() - 1, static_cast<size_t>(fraction * values.size()))];
+    }
+
+    void add(MonotonicTime end, double total, double update, double paint, double pixels, unsigned tileCount)
+    {
+        if (!windowStart)
+            windowStart = end;
+        totalMS.append(total);
+        paintMS.append(paint);
+        updateMS += update;
+        megapixels += pixels / 1e6;
+        tiles += tileCount;
+        if (wcRenderLog() >= 2)
+            WTFLogAlways("[render1] %.1f ms: update %.1f, paint %.1f (%.2f Mpx, %u tiles), copy %.1f", total, update, paint, pixels / 1e6, tileCount, std::max(0.0, total - update - paint)); // NOLINT
+        if (end - windowStart < 5_s)
+            return;
+        unsigned count = totalMS.size();
+        if (count >= 5 && wcRenderLog()) {
+            double seconds = (end - windowStart).seconds();
+            double total = 0, paint = 0;
+            for (auto value : totalMS)
+                total += value;
+            for (auto value : paintMS)
+                paint += value;
+            WTFLogAlways("[render] wc: %u updates in %.1f s (%.1f/s), %.1f ms average, p50 %.1f, p95 %.1f, %.1f ms max; update %.1f avg; paint %.1f avg %.1f p95 (%.2f Mpx, %.1f tiles avg); frame done %.1f ms avg; rAF clock %.1f/s (%u idle)", // NOLINT
+                count, seconds, count / seconds, total / count, percentile(totalMS, 0.5), percentile(totalMS, 0.95), percentile(totalMS, 1),
+                updateMS / count, paint / count, percentile(paintMS, 0.95), megapixels / count, static_cast<double>(tiles) / count,
+                frameDones ? frameDoneMS / frameDones : 0.0, (monitorFires + idleFires) / seconds, idleFires);
+        }
+        totalMS.shrink(0);
+        paintMS.shrink(0);
+        updateMS = megapixels = frameDoneMS = 0;
+        tiles = frameDones = monitorFires = idleFires = 0;
+        windowStart = end;
+    }
+};
+
+static WCRenderStats& wcRenderStats()
+{
+    static NeverDestroyed<WCRenderStats> stats; // main thread only
+    return stats.get();
+}
+#endif
