diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.cpp b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.cpp
new file mode 100644
index 0000000000..e37b40bd7e
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.cpp
@@ -0,0 +1,126 @@
+/*
+ * PS5: remote WebGL contexts as WC contents layers (PS5WebGLLayers.h).
+ */
+
+#include "config.h"
+#include "PS5WebGLLayers.h"
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/CoordinatedPlatformLayerBuffer.h>
+#include <WebCore/TextureMapper.h>
+#include <wtf/HashMap.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Vector.h>
+
+namespace WebKit {
+using namespace WebCore;
+
+namespace {
+
+using Key = std::pair<uint64_t, uint64_t>; // WebProcess, context
+
+Lock s_lock;
+HashMap<Key, RefPtr<PS5WebGLLayer>>& layers() WTF_REQUIRES_LOCK(s_lock)
+{
+    static NeverDestroyed<HashMap<Key, RefPtr<PS5WebGLLayer>>> map;
+    return map;
+}
+
+Lock s_garbageLock;
+Vector<std::unique_ptr<CoordinatedPlatformLayerBuffer>>& garbage() WTF_REQUIRES_LOCK(s_garbageLock)
+{
+    static NeverDestroyed<Vector<std::unique_ptr<CoordinatedPlatformLayerBuffer>>> buffers;
+    return buffers;
+}
+
+void retire(std::unique_ptr<CoordinatedPlatformLayerBuffer>&& buffer)
+{
+    if (!buffer)
+        return;
+    Locker locker { s_garbageLock };
+    garbage().append(WTF::move(buffer));
+}
+
+} // namespace
+
+PS5WebGLLayer::~PS5WebGLLayer()
+{
+    Locker locker { m_lock };
+    retire(WTF::move(m_pending));
+    retire(WTF::move(m_shown));
+}
+
+void PS5WebGLLayer::setBuffer(std::unique_ptr<CoordinatedPlatformLayerBuffer>&& buffer)
+{
+    std::unique_ptr<CoordinatedPlatformLayerBuffer> unshown;
+    {
+        Locker locker { m_lock };
+        if (m_detached) {
+            unshown = WTF::move(buffer);
+        } else
+            unshown = std::exchange(m_pending, WTF::move(buffer));
+    }
+    // A frame the compositor never drew (the page drew faster than it shows).
+    retire(WTF::move(unshown));
+}
+
+void PS5WebGLLayer::detach()
+{
+    Locker locker { m_lock };
+    m_detached = true;
+    retire(WTF::move(m_pending));
+    retire(WTF::move(m_shown));
+}
+
+void PS5WebGLLayer::paintToTextureMapper(TextureMapper& textureMapper, const FloatRect& target, const TransformationMatrix& modelViewMatrix, float opacity)
+{
+    // Held while the draw is issued: the context can't delete the texture
+    // between this check and the draw (detach() takes the lock first).
+    Locker locker { m_lock };
+    if (m_detached)
+        return;
+    if (m_pending)
+        retire(std::exchange(m_shown, WTF::move(m_pending)));
+    if (m_shown)
+        m_shown->paintToTextureMapper(textureMapper, target, modelViewMatrix, opacity); // waits on the frame's fence (GPU side)
+}
+
+namespace PS5WebGLLayers {
+
+void add(ProcessIdentifier process, uint64_t key, PS5WebGLLayer& layer)
+{
+    Locker locker { s_lock };
+    layers().set({ process.toUInt64(), key }, &layer);
+}
+
+void remove(ProcessIdentifier process, uint64_t key)
+{
+    RefPtr<PS5WebGLLayer> layer;
+    {
+        Locker locker { s_lock };
+        layer = layers().take({ process.toUInt64(), key });
+    }
+}
+
+RefPtr<PS5WebGLLayer> find(ProcessIdentifier process, uint64_t key)
+{
+    Locker locker { s_lock };
+    return layers().get({ process.toUInt64(), key });
+}
+
+void collectGarbage()
+{
+    Vector<std::unique_ptr<CoordinatedPlatformLayerBuffer>> buffers;
+    {
+        Locker locker { s_garbageLock };
+        buffers = std::exchange(garbage(), { });
+    }
+    // Destroyed here, with the compositor's context current (their GL syncs).
+}
+
+} // namespace PS5WebGLLayers
+
+} // namespace WebKit
+
+#endif
diff --git a/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.h b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.h
new file mode 100644
index 0000000000..799656e24e
--- /dev/null
+++ b/Source/WebKit/GPUProcess/graphics/ps5/PS5WebGLLayers.h
@@ -0,0 +1,66 @@
+/*
+ * PS5: remote WebGL contexts as WC contents layers (spikes/11-webgl, M2).
+ *
+ * Each context in the title (RemoteGraphicsContextGLPS5.cpp) draws with
+ * ANGLE into drawing buffers that share GL names with the compositor's
+ * context (PS5GPUProcessInTitle.cpp sets the share group up). After each
+ * prepareForDisplay() the context hands its newest buffer (texture, size,
+ * fence) to its PS5WebGLLayer. The canvas's GraphicsLayerWC names the
+ * context by its RemoteGraphicsContextGLIdentifier (WCUpdateInfo's
+ * webGLLayerKey); WCScene finds the layer here by that key and the scene's
+ * WebProcess, and draws it on the render thread like a video layer.
+ *
+ * Threads: the context's work queue adds, sets buffers and detaches; the
+ * render thread finds and paints. Buffers (their GL fences) are only ever
+ * destroyed on the render thread, with the compositor's context current:
+ * collectGarbage() at each frame.
+ */
+
+#pragma once
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK)
+
+#include <WebCore/CoordinatedPlatformLayerBuffer.h>
+#include <WebCore/ProcessIdentifier.h>
+#include <WebCore/TextureMapperPlatformLayer.h>
+#include <memory>
+#include <wtf/Lock.h>
+#include <wtf/ThreadSafeRefCounted.h>
+
+namespace WebKit {
+
+class PS5WebGLLayer final : public ThreadSafeRefCounted<PS5WebGLLayer>, public WebCore::TextureMapperPlatformLayer {
+public:
+    static Ref<PS5WebGLLayer> create() { return adoptRef(*new PS5WebGLLayer); }
+    ~PS5WebGLLayer();
+
+    // Work queue: the frame just finished (prepareForDisplay).
+    void setBuffer(std::unique_ptr<WebCore::CoordinatedPlatformLayerBuffer>&&);
+    // Work queue: the context is going (its textures next): draw nothing more.
+    void detach();
+
+    // Render thread (TextureMapperPlatformLayer): the newest buffer.
+    void paintToTextureMapper(WebCore::TextureMapper&, const WebCore::FloatRect&, const WebCore::TransformationMatrix& modelViewMatrix, float opacity) final;
+
+private:
+    PS5WebGLLayer() = default;
+
+    Lock m_lock;
+    std::unique_ptr<WebCore::CoordinatedPlatformLayerBuffer> m_pending WTF_GUARDED_BY_LOCK(m_lock);
+    std::unique_ptr<WebCore::CoordinatedPlatformLayerBuffer> m_shown WTF_GUARDED_BY_LOCK(m_lock);
+    bool m_detached WTF_GUARDED_BY_LOCK(m_lock) { false };
+};
+
+namespace PS5WebGLLayers {
+
+void add(WebCore::ProcessIdentifier, uint64_t key, PS5WebGLLayer&);
+void remove(WebCore::ProcessIdentifier, uint64_t key);
+RefPtr<PS5WebGLLayer> find(WebCore::ProcessIdentifier, uint64_t key);
+// Render thread, compositor context current: destroys retired buffers.
+void collectGarbage();
+
+} // namespace PS5WebGLLayers
+
+} // namespace WebKit
+
+#endif
