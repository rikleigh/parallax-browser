--- /dev/null
+++ b/Source/WebKit/WebProcess/wpe/ps5/PS5WebProcessInTitle.cpp
@@ -0,0 +1,126 @@
+/*
+ * PS5: one WebProcess in the browser title (spikes/14-webprocess-in-title,
+ * stage 1, behind /data/ps5webkit/inprocess-web).
+ *
+ * As an elfldr payload the WebProcess gets CPUs 9, 11, 13, 14 and 15, of
+ * which only one physical core (14/15) runs while a title does; the title
+ * has CPUs 0-12. Stage 0 measured an emulator-shaped WebAssembly kernel 1.41x
+ * faster in the title.
+ *
+ * The UI process side is unchanged: ProcessLauncher makes the socket pair
+ * and gives the client end to the PS5 process manager
+ * (wpe-ps5/WPEProcessManagerPS5.cpp), which, for the first WebProcess when
+ * the switch is on, calls ps5wk_web_process_in_title_start() on the main
+ * run loop instead of sending ps5wk-child.elf to elfldr. That makes
+ * WebKit's WebProcess object in the title, the way
+ * UIProcess/wpe/ps5/PS5GPUProcessInTitle.cpp makes the GPU process's.
+ *
+ * What a payload's WebProcessMain does and this does not: WTF, JSC and
+ * GLib are started by the UI process already, and RunLoop::run() is the
+ * title's main loop. WebKit has one main thread per process, so the page's
+ * main-thread work runs on the title's (1.1% of a core in a fight, stage 1).
+ * AuxiliaryProcess::ps5InitializeWebProcessInTitle lists the other
+ * differences. The JSC options (JIT, WebAssembly) and the executable pool
+ * come from the title (apps/title/ps5browser.c, titlemem.c).
+ */
+
+#include "config.h"
+
+#if defined(PS5_PAYLOAD_SDK)
+
+#include "AuxiliaryProcess.h"
+#include "WebProcess.h"
+#include <skia/core/SkGraphics.h>
+#include <wtf/RunLoop.h>
+#include <wtf/RuntimeApplicationChecks.h>
+#include <wtf/unix/UnixFileDescriptor.h>
+#include <fontconfig/fontconfig.h>
+#include <stdio.h>
+#include <string.h>
+#include <wtf/MonotonicTime.h>
+
+#if USE(GCRYPT)
+#include <pal/crypto/gcrypt/Initialization.h>
+#endif
+
+#if USE(SKIA_OPENTYPE_SVG)
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
+#include <skia/modules/svg/SkSVGOpenTypeSVGDecoder.h>
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
+#endif
+
+// A title can't list directories (opendir of /data/ps5webkit/fonts: EPERM,
+// 2026-11-15), so fontconfig's scan of its font folder finds nothing and
+// pages paint without text. stat, open and FreeType work: add the fonts
+// one by one, from the title's runtime file list (runtime.c installs them
+// in /data/ps5webkit/fonts). They are application fonts of the current
+// configuration, which WebCore's Skia font manager uses.
+static void addFontsWithoutScanning()
+{
+    auto start = MonotonicTime::now();
+    FcConfig* config = FcConfigGetCurrent();
+    FcFontSet* system = config ? FcConfigGetFonts(config, FcSetSystem) : nullptr;
+    if (!config || (system && system->nfont)) {
+        WTFLogAlways("[web-in-title] fonts: fontconfig has %d system fonts already", system ? system->nfont : -1);
+        return;
+    }
+    FILE* list = fopen("/app0/runtime/runtime-files.txt", "r");
+    if (!list) {
+        WTFLogAlways("[web-in-title] fonts: no /app0/runtime/runtime-files.txt (errno %d): pages will have no text", errno);
+        return;
+    }
+    unsigned added = 0, failed = 0;
+    char line[512];
+    while (fgets(line, sizeof line, list)) {
+        line[strcspn(line, "\r\n")] = 0;
+        if (strncmp(line, "fonts/", 6))
+            continue;
+        char path[600];
+        snprintf(path, sizeof path, "/data/ps5webkit/%s", line);
+        if (FcConfigAppFontAddFile(config, reinterpret_cast<const FcChar8*>(path)))
+            added++;
+        else
+            failed++;
+    }
+    fclose(list);
+    FcFontSet* application = FcConfigGetFonts(config, FcSetApplication);
+    WTFLogAlways("[web-in-title] fonts: %u files added one by one (%u failed), %d faces, in %.0f ms (a title can't list /data/ps5webkit/fonts)",
+        added, failed, application ? application->nfont : 0, (MonotonicTime::now() - start).milliseconds());
+}
+
+// 0: started, and the WebProcess owns fd. -1: not started (already one, or
+// bad arguments); fd is still the caller's. Main run loop.
+extern "C" int ps5wk_web_process_in_title_start(int fd, uint64_t processIdentifier)
+{
+    using namespace WebKit;
+    RELEASE_ASSERT(RunLoop::isMain());
+    static bool started;
+    if (started || fd < 0 || !ObjectIdentifier<WebCore::ProcessIdentifierType>::isValidIdentifier(processIdentifier)) {
+        WTFLogAlways("[web-in-title] not starting WebProcess %" PRIu64 " in the title (%s)", processIdentifier, started ? "one runs already" : "bad arguments");
+        return -1;
+    }
+    started = true;
+
+    // WebProcessMainWPE::platformInitialize, minus g_set_prgname (the
+    // title's name stays).
+#if USE(GCRYPT)
+    PAL::GCrypt::initialize();
+#endif
+    SkGraphics::Init();
+#if USE(SKIA_OPENTYPE_SVG)
+    SkGraphics::SetOpenTypeSVGDecoderFactory(SkSVGOpenTypeSVGDecoder::Make);
+#endif
+
+    addFontsWithoutScanning();
+
+    AuxiliaryProcessInitializationParameters parameters;
+    parameters.processType = WTF::AuxiliaryProcessType::WebContent;
+    parameters.processIdentifier = ObjectIdentifier<WebCore::ProcessIdentifierType>(processIdentifier);
+    parameters.connectionIdentifier = IPC::Connection::Identifier { { fd, UnixFileDescriptor::Adopt } };
+    WTFLogAlways("[web-in-title] starting WebProcess %" PRIu64 " in the title (IPC fd %d)", processIdentifier, fd);
+    WebProcess::singleton().ps5InitializeWebProcessInTitle(WTF::move(parameters));
+    WTFLogAlways("[web-in-title] WebProcess %" PRIu64 " initialized; its messages run on the title's main loop", processIdentifier);
+    return 0;
+}
+
+#endif // defined(PS5_PAYLOAD_SDK)
