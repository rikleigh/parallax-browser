+// FreeBSD (the PS5): no memfd or seals; the state page is anonymous POSIX
+// shared memory, as SharedMemoryUnix.cpp makes it, and futex(2) becomes
+// _umtx_op(2)'s shared (not _PRIVATE) wait and wake, which key on the page
+// rather than the address, so they work across processes.
+using FutexTimespec = struct timespec;
+
+static void futexWakeOne(Atomic<uint32_t>& word)
+{
+    _umtx_op(&word, UMTX_OP_WAKE, 1, nullptr, nullptr);
+}
+
+static bool futexWaitWhileZero(Atomic<uint32_t>& word, const FutexTimespec* relativeTimeout)
+{
+    void* size = relativeTimeout ? reinterpret_cast<void*>(sizeof(*relativeTimeout)) : nullptr;
+    if (!_umtx_op(&word, UMTX_OP_WAIT_UINT, 0, size, const_cast<FutexTimespec*>(relativeTimeout)))
+        return true;
+    return errno == EINTR || errno == ETIMEDOUT;
+}
+
+static SemaphoreState* mapSemaphoreState(int fd)
+{
+    if (fd < 0)
+        return nullptr;
+    struct stat status;
+    if (fstat(fd, &status) == -1 || static_cast<size_t>(status.st_size) < semaphoreStateSize)
+        return nullptr;
+    void* mapping = mmap(nullptr, semaphoreStateSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (mapping == MAP_FAILED)
+        return nullptr;
+    return static_cast<SemaphoreState*>(mapping);
+}
