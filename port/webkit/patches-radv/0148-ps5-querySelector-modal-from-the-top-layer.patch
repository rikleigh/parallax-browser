+// PS5: a selector whose rightmost compound has :modal can match only a modal dialog or a fullscreen
+// element (matchesModalPseudoClass), and both are in the top layer while they match: a dialog is
+// added to it in showModal() and loses isModal() when it leaves (close(), removal), and the
+// fullscreen flag is set just before an element enters the top layer and cleared before it
+// leaves. So for a connected root, the document's top layer is the whole candidate set, instead of
+// every element under the root. A page asking for "dialog[open]:modal" 900 times a second spent
+// 40% of the title's main thread walking its 6000 elements (nfsu2.xyz, 2026-11-24). A
+// disconnected root keeps the walk: a disconnected element can keep the fullscreen flag until
+// fullscreen is exited.
+static bool rightmostCompoundHasModal(const CSSSelector& rightmost)
+{
+    for (const CSSSelector* selector = &rightmost; selector; selector = selector->followingInCompound()) {
+        if (selector->match() == CSSSelector::Match::PseudoClass && selector->pseudoClass() == CSSSelector::PseudoClass::Modal)
+            return true;
+    }
+    return false;
+}
