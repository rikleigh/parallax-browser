+#if defined(PS5_PAYLOAD_SDK)
+// The title with its WebProcess: the tile arena's chunks are shm objects
+// that the WebProcess half makes and the drawing-area proxy half maps, and a
+// title pays for shm from its flexible memory (~260 MB, shared with the video
+// decoders and the libc heap): each 8 MB chunk took 8 MB of it, the 64 MB
+// arena a quarter, and the tiles painted the old way past it (one shm object
+// each) the rest (2026-11-27). An anonymous mapping is the title's direct
+// memory instead (apps/title/titlemem.c). The handle still needs a file
+// descriptor for IPC: an empty shm object (no pages), whose inode names the
+// region here; map() looks it up and returns the same pages. The region
+// keeps its own descriptor open while it lives, so no other object can get
+// its inode, and goes when the last SharedMemory on it does. A handle that
+// arrives after that (or in another process) finds nothing, and its empty
+// object maps nothing (the size check below).
+extern "C" int ps5wk_title_web_in_process __attribute__((weak)); // apps/title/titlemem.c
+extern "C" int ps5wk_title_mem_is_direct(const void*, size_t) __attribute__((weak)); // apps/title/titlemem.c
+
+namespace {
+struct InProcessRegion {
+    uint64_t device;
+    uint64_t inode;
+    void* data;
+    size_t size;
+    size_t mappedSize;
+    unsigned references;
+    UnixFileDescriptor token;
+};
+}
+
+static Lock inProcessLock;
+static Vector<InProcessRegion>& inProcessRegions() WTF_REQUIRES_LOCK(inProcessLock)
+{
+    static NeverDestroyed<Vector<InProcessRegion>> regions;
+    return regions;
+}
+
+RefPtr<SharedMemory> SharedMemory::allocateInProcess(size_t size)
+{
+    if (!&ps5wk_title_web_in_process || !ps5wk_title_web_in_process || !size)
+        return allocate(size);
+    auto token = createSharedMemory();
+    struct stat status;
+    if (!token || fstat(token.value(), &status) || !status.st_ino)
+        return allocate(size);
+    UnixFileDescriptor kept { token.value(), UnixFileDescriptor::Duplicate };
+    if (!kept)
+        return allocate(size);
+    // titlemem.c maps in 64 KiB units and releases what munmap is given.
+    const size_t mappedSize = (size + 0xffff) & ~static_cast<size_t>(0xffff);
+    void* data = mmap(nullptr, mappedSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (data == MAP_FAILED)
+        return nullptr;
+    // No direct memory left: titlemem.c mapped flexible memory, which costs
+    // the same as shm, so it may as well be shm (and say so in the log).
+    if (ps5wk_title_mem_is_direct && !ps5wk_title_mem_is_direct(data, mappedSize)) {
+        munmap(data, mappedSize);
+        return allocate(size);
+    }
+    {
+        Locker locker { inProcessLock };
+        auto& regions = inProcessRegions();
+        if (regions.containsIf([&](auto& region) { return region.device == static_cast<uint64_t>(status.st_dev) && region.inode == static_cast<uint64_t>(status.st_ino); })) {
+            munmap(data, mappedSize);
+            return allocate(size);
+        }
+        regions.append({ static_cast<uint64_t>(status.st_dev), static_cast<uint64_t>(status.st_ino), data, size, mappedSize, 1, WTF::move(kept) });
+    }
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_fileDescriptor = WTF::move(token);
+    instance->m_size = size;
+    instance->m_isInProcess = true;
+    return instance;
+}
+
+// The pages of the region the descriptor names, with a reference taken for
+// the caller, if it is one of ours and holds size bytes; else null.
+static void* takeInProcessRegion(int fileDescriptor, size_t size)
+{
+    Locker locker { inProcessLock };
+    auto& regions = inProcessRegions();
+    if (regions.isEmpty())
+        return nullptr;
+    // Our tokens are empty; a real shm object a handle names never is.
+    struct stat status;
+    if (fstat(fileDescriptor, &status) || !status.st_ino || status.st_size)
+        return nullptr;
+    auto index = regions.findIf([&](auto& region) { return region.device == static_cast<uint64_t>(status.st_dev) && region.inode == static_cast<uint64_t>(status.st_ino); });
+    if (index == notFound || size > regions[index].size)
+        return nullptr;
+    regions[index].references++;
+    return regions[index].data;
+}
+
+static void releaseInProcess(void* data)
+{
+    void* unmap = nullptr;
+    size_t unmapSize = 0;
+    UnixFileDescriptor token;
+    {
+        Locker locker { inProcessLock };
+        auto& regions = inProcessRegions();
+        auto index = regions.findIf([&](auto& region) { return region.data == data; });
+        if (index == notFound)
+            return;
+        if (--regions[index].references)
+            return;
+        unmap = regions[index].data;
+        unmapSize = regions[index].mappedSize;
+        token = WTF::move(regions[index].token);
+        regions.removeAt(index);
+    }
+    munmap(unmap, unmapSize);
+}
+#endif
