 }
 
+// GPU=radv: WebGL's contexts are on the compositor's ANGLE display (the
+// title's PS5GPUProcessInTitle.cpp), whose EGL version names ANGLE.
+static bool currentDisplayIsANGLE()
+{
+    static int angle = -1;
+    if (angle < 0) {
+        const char* version = eglQueryString(eglGetCurrentDisplay(), EGL_VERSION);
+        angle = version && strstr(version, "ANGLE");
+    }
+    return angle;
+}
+
 bool copyVideoFrameNative(uint64_t key, unsigned nativeTexture, bool flipY)
 {
     auto copy = copyVideoFrameFunction();
+    if (copy && eglGetCurrentContext() != EGL_NO_CONTEXT && currentDisplayIsANGLE()) {
+        // GPU=radv: WebGL's own context is in the compositor's share group, so
+        // the copy runs in it. Making another ANGLE context current in the
+        // middle of WebGL's frame and back crashed ANGLE's Vulkan backend (its
+        // render pass commands lost their allocator; 2026-11-19). The copy
+        // binds framebuffers of its own; WebGL's bindings and scissor test are
+        // put back.
+        GLint readFramebuffer = 0, drawFramebuffer = 0;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFramebuffer);
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFramebuffer);
+        const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+        if (scissor)
+            glDisable(GL_SCISSOR_TEST);
+        void* done = copy(key, nativeTexture, flipY);
+        if (scissor)
+            glEnable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, readFramebuffer);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFramebuffer);
+        if (!done)
+            return false;
+        glDeleteSync(static_cast<GLsync>(done)); // same context: already in order
+        return true;
+    }
     EGLContext helper = copy ? copyContext() : EGL_NO_CONTEXT;
     if (helper == EGL_NO_CONTEXT)
         return false;
