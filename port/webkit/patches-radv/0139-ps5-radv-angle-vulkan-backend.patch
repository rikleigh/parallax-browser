 endif ()
+
+if (PS5WK_GPU_RADV)
+    # GPU=radv (ps5webkit HANDOVER-radv.md Phase 2, spikes/15-radv-only): the
+    # Vulkan backend next to the GL one, on RADV (linked into the title), with
+    # ANGLE's "simple" display (VK_KHR_display on VideoOut). The title's
+    # compositor asks for EGL_PLATFORM_ANGLE_TYPE_VULKAN_ANGLE; WebGL keeps
+    # the GL backend until Phase 3. Source lists as spike 15a's build
+    # (spikes/15-radv-only/angle/CMakeLists.txt); Vulkan.cmake is generated
+    # from vulkan_backend.gni by spikes/15-radv-only/angle/gen-vulkan-cmake.py.
+    foreach (v PS5WK_VULKAN_INCLUDE PS5WK_SPIRV_HEADERS_INCLUDE PS5WK_SPIRV_TOOLS_INCLUDE PS5WK_VMA_DIR)
+        if (NOT ${v})
+            message(FATAL_ERROR "PS5WK_GPU_RADV needs ${v}")
+        endif ()
+    endforeach ()
+    include(Vulkan.cmake)
+    list(APPEND ANGLE_SOURCES
+        ${angle_translator_lib_spirv_sources}
+        ${vulkan_backend_sources}
+        ${vulkan_backend_dma_buf_sources}
+        src/libANGLE/renderer/vulkan/vk_mem_alloc_wrapper.cpp
+        src/common/vulkan/libvulkan_loader.cpp
+        src/common/vulkan/vulkan_icd.cpp
+        src/common/spirv/spirv_instruction_builder_autogen.cpp
+        src/common/spirv/spirv_instruction_parser_autogen.cpp
+        src/third_party/volk/volk.c
+        ${libangle_gpu_info_util_vulkan_sources}
+        # angle_spirv_utils.cpp needs SPIRV-Tools' libraries (asserts only)
+        src/libANGLE/renderer/vulkan/ps5/ps5_spirv_utils.cpp
+        # VMA's implementation, as its BUILD.gn compiles it
+        ${PS5WK_VMA_DIR}/vma.cpp
+    )
+    list(FILTER ANGLE_SOURCES EXCLUDE REGEX "\\.(h|inc|inl)$")
+    list(REMOVE_DUPLICATES ANGLE_SOURCES)
+    list(APPEND ANGLE_DEFINITIONS
+        ANGLE_ENABLE_VULKAN
+        ANGLE_USE_VULKAN_DISPLAY
+        ANGLE_VULKAN_DISPLAY_MODE_SIMPLE
+    )
+    list(APPEND ANGLE_PRIVATE_INCLUDE_DIRECTORIES
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/common/spirv"
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/third_party/volk"
+        "${PS5WK_VULKAN_INCLUDE}"
+        "${PS5WK_SPIRV_HEADERS_INCLUDE}"
+        "${PS5WK_SPIRV_TOOLS_INCLUDE}"
+        "${PS5WK_VMA_DIR}/include"
+    )
+    # Only ANGLE's own targets (this directory): WebCore and the title's code
+    # keep their Vulkan prototypes.
+    set_property(DIRECTORY APPEND PROPERTY COMPILE_DEFINITIONS
+        # The title uses contexts of one share group from several threads at
+        # once (the compositor's render thread, WebGL's and WebGPU's work
+        # queues). ANGLE's GN default outside Chromium is this lock; without
+        # it the Vulkan backend raced (WebGL video textures crashed in
+        # ContextVk's command recording, 2026-11-19).
+        ANGLE_ENABLE_SHARE_CONTEXT_LOCK=1
+        ANGLE_SHARED_LIBVULKAN=1
+        ANGLE_USE_CUSTOM_VULKAN_OUTSIDE_RENDER_PASS_CMD_BUFFERS=1
+        ANGLE_USE_CUSTOM_VULKAN_RENDER_PASS_CMD_BUFFERS=1
+        ANGLE_VULKAN_API_PERF_COUNTERS_MODE=0
+        ANGLE_ENABLE_CRC_FOR_PIPELINE_CACHE
+        ANGLE_VK_MOCK_ICD_JSON="VkICD_mock_icd.json"
+        ANGLE_VK_LAYERS_DIR="."
+        VMA_DYNAMIC_VULKAN_FUNCTIONS=0
+        VMA_STATIC_VULKAN_FUNCTIONS=0
+        VMA_USE_STL_CONTAINERS=1
+        VK_NO_PROTOTYPES
+    )
+endif ()
