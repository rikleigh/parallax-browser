diff --git a/CMakeLists.txt b/CMakeLists.txt
index 21cd467d94..de53625f7b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -137,6 +137,23 @@ if (PS5 AND PS5_PORT_DIR)
     add_subdirectory(${PS5_PORT_DIR}/apps ${CMAKE_BINARY_DIR}/ps5-apps)
 endif ()
 
+# PS5: PS5WKDebugBuild.h defines PS5WK_DEBUG_BUILD, 1 in a development build and 0 in a release.
+# A development build is one with a log host (PS5WK_LOG_HOST, the cache variable of
+# port/webkit/apps/CMakeLists.txt, which tells the two apart the same way for the title);
+# tools/make-release.sh configures the release with none. The WebKit sources whose PS5
+# diagnostics are for development only (logs, histograms, environment knobs) include it. A header
+# and not a compile definition, so that switching between the two rebuilds only those files:
+# file(CONFIGURE) rewrites it only when its content changes.
+if (PS5)
+    if (PS5WK_LOG_HOST)
+        set(PS5WK_DEBUG_BUILD_VALUE 1)
+    else ()
+        set(PS5WK_DEBUG_BUILD_VALUE 0)
+    endif ()
+    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/PS5WKDebugBuild.h"
+        CONTENT "// Generated by CMakeLists.txt from PS5WK_LOG_HOST: 1 in a development build, 0 in a release.\n#define PS5WK_DEBUG_BUILD @PS5WK_DEBUG_BUILD_VALUE@\n" @ONLY)
+endif ()
+
 if (DEVELOPER_MODE)
     if (EXISTS "${CMAKE_SOURCE_DIR}/PerformanceTests")
         add_subdirectory(PerformanceTests)
