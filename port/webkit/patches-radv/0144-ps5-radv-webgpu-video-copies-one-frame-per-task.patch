+// token (GPUQueue.cpp): later copies of the same stream at the same size with the same token come
+// from this image, so the copies of one task are of one frame, whatever the title converted
+// meanwhile. The image stays Dawn's while it is kept or any copy from it is in flight; Dawn's
+// copies run in order on its queue, each from the layout the one before left.
+struct RemoteQueue::PS5VideoCopy : ThreadSafeRefCounted<RemoteQueue::PS5VideoCopy> {
+    uint64_t streamKey { 0 };
+    uint64_t taskToken { 0 };
+    uint32_t videoWidth { 0 };
+    uint32_t videoHeight { 0 };
+    RefPtr<PS5SharedImageSlot> slot;
+    uint32_t vkLayout { 0 }; // the image's layout for the next copy
+
+    void started()
+    {
+        Locker locker { lock };
+        inFlight++;
+    }
+    // A copy is done on the GPU (Dawn's callback, any thread).
+    void finished()
+    {
+        Locker locker { lock };
+        inFlight--;
+        freeIfDone();
+    }
+    // Not kept any more (a new frame, or the queue is going).
+    void letGo()
+    {
+        Locker locker { lock };
+        kept = false;
+        freeIfDone();
+    }
+
+private:
+    void freeIfDone() WTF_REQUIRES_LOCK(lock)
+    {
+        if (kept || inFlight || !slot)
+            return;
+        slot->state = PS5SharedImageSlot::State::Free;
+        slot = nullptr;
+    }
+    Lock lock;
+    unsigned inFlight WTF_GUARDED_BY_LOCK(lock) { 0 };
+    bool kept WTF_GUARDED_BY_LOCK(lock) { true };
+};
+#endif
