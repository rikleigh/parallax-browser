+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// PS5: a thread that waits outside its GMainContext is told when its run loop gets something to run.
+// A worker's run loop (WebCore's WorkerDedicatedRunLoop) waits on its message queue, not in the
+// context, so a wakeUp() or a timer started from another thread reached it only when the next
+// message or DOM timer came (a 20 ms Atomics.waitAsync timeout in a worker took 1 to 2 s beside a
+// 1 s interval: nfsu2.xyz's reads, 2026-11-25). Kept out of RunLoop.h, which everything includes.
+static Lock ps5WakeUpObserversLock;
+static std::atomic<unsigned> ps5WakeUpObserverCount { 0 };
+struct PS5WakeUpObserver {
+    RunLoop* runLoop;
+    RefPtr<SharedTask<void()>> task;
+};
+static Vector<PS5WakeUpObserver>& ps5WakeUpObservers() WTF_REQUIRES_LOCK(ps5WakeUpObserversLock)
+{
+    static NeverDestroyed<Vector<PS5WakeUpObserver>> observers;
+    return observers;
+}
+
+WTF_EXPORT_PRIVATE void ps5SetRunLoopWakeUpObserver(RunLoop&, RefPtr<SharedTask<void()>>&&);
+void ps5SetRunLoopWakeUpObserver(RunLoop& runLoop, RefPtr<SharedTask<void()>>&& task)
+{
+    Locker locker { ps5WakeUpObserversLock };
+    auto& observers = ps5WakeUpObservers();
+    observers.removeAllMatching([&](auto& observer) { return observer.runLoop == &runLoop; });
+    if (task)
+        observers.append({ &runLoop, WTF::move(task) });
+    ps5WakeUpObserverCount.store(observers.size());
+}
+
+static void ps5NotifyWakeUpObserver(RunLoop& runLoop)
+{
+    Locker locker { ps5WakeUpObserversLock };
+    for (auto& observer : ps5WakeUpObservers()) {
+        if (observer.runLoop == &runLoop) {
+            observer.task->run();
+            return;
+        }
+    }
+}
+#endif
