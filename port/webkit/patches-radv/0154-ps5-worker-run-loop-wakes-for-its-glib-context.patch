+// PS5: a thread that waits outside its GMainContext is told when its run loop gets something to run.
+// A worker's run loop (WebCore's WorkerDedicatedRunLoop) waits on its message queue, not in the
+// context, so a wakeUp() or a timer started from another thread reached it only when the next
+// message or DOM timer came (a 20 ms Atomics.waitAsync timeout in a worker took 1 to 2 s beside a
+// 1 s interval: nfsu2.xyz's reads, 2026-11-25). Kept out of RunLoop.h, which everything includes.
+//
+// wakeUp() and TimerBase::start() run on every thread all the time, so what they check is one
+// atomic flag in their run loop's own source (the observer lives just after RunLoopSource in the
+// same allocation): no global lock, no list, and only a run loop whose thread is waiting this way
+// takes its own lock. The task runs under that lock, and clearing takes it too, so once
+// ps5SetRunLoopWakeUpObserver(runLoop, nullptr) returns the task is not running and will not run
+// (it holds a raw pointer to the WorkerDedicatedRunLoop). No wake-up is lost between the waiting
+// thread's look at its context and its wait: it sets the flag before it takes the context's lock
+// to look, and wakeUp() and start() set the ready time under that lock before they read the flag,
+// so either the look sees the ready time or the notifier sees the flag and posts the task.
+// The setter, which runs only on the waiting thread, finds the observer by run loop in a small
+// map (it cannot reach m_source from outside RunLoop).
+struct PS5WakeUpObserver {
+    std::atomic<bool> isSet { false };
+    Lock lock;
+    RefPtr<SharedTask<void()>> task WTF_GUARDED_BY_LOCK(lock);
+};
+
+struct PS5RunLoopWorkSource {
+    RunLoopSource runLoopSource;
+    PS5WakeUpObserver wakeUpObserver;
+};
+
+static PS5WakeUpObserver& ps5WakeUpObserver(GSource* runLoopWorkSource)
+{
+    return reinterpret_cast<PS5RunLoopWorkSource*>(runLoopWorkSource)->wakeUpObserver;
+}
+
+static Lock ps5WakeUpObserversLock;
+static HashMap<const RunLoop*, PS5WakeUpObserver*>& ps5WakeUpObservers() WTF_REQUIRES_LOCK(ps5WakeUpObserversLock)
+{
+    static NeverDestroyed<HashMap<const RunLoop*, PS5WakeUpObserver*>> observers;
+    return observers;
+}
+
+WTF_EXPORT_PRIVATE void ps5SetRunLoopWakeUpObserver(RunLoop&, RefPtr<SharedTask<void()>>&&);
+void ps5SetRunLoopWakeUpObserver(RunLoop& runLoop, RefPtr<SharedTask<void()>>&& task)
+{
+    PS5WakeUpObserver* observer;
+    {
+        Locker locker { ps5WakeUpObserversLock };
+        observer = ps5WakeUpObservers().get(&runLoop);
+    }
+    if (!observer)
+        return;
+    RefPtr<SharedTask<void()>> previous;
+    {
+        Locker locker { observer->lock };
+        previous = std::exchange(observer->task, WTF::move(task));
+        observer->isSet.store(!!observer->task);
+    }
+}
+
+static void ps5NotifyWakeUpObserver(GSource* runLoopWorkSource)
+{
+    auto& observer = ps5WakeUpObserver(runLoopWorkSource);
+    if (!observer.isSet.load()) [[likely]]
+        return;
+    Locker locker { observer.lock };
+    if (observer.task)
+        observer.task->run();
+}
