+    auto memoryProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(vk_icdGetInstanceProcAddr(vkInstance, "vkGetPhysicalDeviceMemoryProperties"));
+    auto properties2 = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(vk_icdGetInstanceProcAddr(vkInstance, "vkGetPhysicalDeviceProperties2"));
+    if (!getDeviceProc || !memoryProperties || !properties2)
