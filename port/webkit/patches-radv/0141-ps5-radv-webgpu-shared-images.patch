+#if PS5WK_GPU_RADV
+// How many aliases a device keeps: a canvas's few images and a video's few, for some of each.
+static constexpr size_t maximumSharedImageAliases = 16;
+
+wgpu::Texture DeviceImpl::ps5SharedImageAlias(PS5SharedImage& image)
+{
+    for (size_t i = 0; i < m_sharedImageAliases.size(); ++i) {
+        if (m_sharedImageAliases[i].identifier == image.identifier) {
+            auto alias = WTF::move(m_sharedImageAliases[i]);
+            m_sharedImageAliases.removeAt(i);
+            m_sharedImageAliases.append(WTF::move(alias));
+            return m_sharedImageAliases.last().texture;
+        }
+    }
+
+    wgpu::TextureDescriptor textureDescriptor;
+    textureDescriptor.label = "shared image";
+    textureDescriptor.size = { image.width, image.height, 1 };
+    textureDescriptor.format = image.format == TextureFormat::Bgra8unorm ? wgpu::TextureFormat::BGRA8Unorm : wgpu::TextureFormat::RGBA8Unorm;
+    // Sampled as a video frame, copied into as a canvas frame (and out of, for a later copy).
+    textureDescriptor.usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopySrc | wgpu::TextureUsage::CopyDst;
+    dawn::native::vulkan::HostPointerTextureDescriptorPS5 descriptor;
+    descriptor.textureDescriptor = reinterpret_cast<const WGPUTextureDescriptor*>(&textureDescriptor);
+    descriptor.imageCreateInfo = static_cast<const VkImageCreateInfo*>(image.vkImageCreateInfo);
+    descriptor.pointer = image.address;
+    descriptor.size = image.size;
+    // Its errors are the title's, not the page's.
+    m_device.PushErrorScope(wgpu::ErrorFilter::Validation);
+    wgpu::Texture texture = wgpu::Texture::Acquire(dawn::native::vulkan::CreateHostPointerTexturePS5(m_device.Get(), &descriptor));
+    m_device.PopErrorScope(wgpu::CallbackMode::AllowProcessEvents, [this, protectedThis = Ref { *this }](wgpu::PopErrorScopeStatus, wgpu::ErrorType type, wgpu::StringView message) {
+        if (type != wgpu::ErrorType::NoError && !std::exchange(m_loggedSharedImageFailure, true))
+            WTFLogAlways("[webgpu] title: Dawn could not alias an image shared with the compositor: %.*s", static_cast<int>(message.length), message.data);
+    });
+    if (RefPtr instance = m_instance.get())
+        instance->pumpSoon();
+    if (!texture)
+        return nullptr;
+    if (m_sharedImageAliases.size() >= maximumSharedImageAliases) {
+        m_sharedImageAliases.first().texture.Destroy();
+        m_sharedImageAliases.removeAt(0);
+    }
+    m_sharedImageAliases.append({ image.identifier, texture });
+    return texture;
+}
+
+void DeviceImpl::ps5EndSharedImageAccess(const wgpu::Texture& alias, Function<void(uint32_t vkLayout)>&& done)
+{
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    dawn::native::vulkan::EndAccessHostPointerTexturePS5(alias.Get(), &layout);
+    RefPtr instance = m_instance.get();
+    if (!instance) {
+        // Nothing pumps Dawn's callbacks any more: the device is going, and Dawn waits for its GPU
+        // work as it goes.
+        done(layout);
+        return;
+    }
+    // Called once the work submitted until now is done, or with an error once the device is lost
+    // or destroyed: either way Dawn is done with the image.
+    m_device.GetQueue().OnSubmittedWorkDone(wgpu::CallbackMode::AllowProcessEvents, [pending = makePendingCallback(*instance, WTF::move(done)), layout](wgpu::QueueWorkDoneStatus, wgpu::StringView) {
+        pending->handler()(layout);
+    });
+}
+
+// https://gpuweb.github.io/gpuweb/#dom-gpudevice-importexternaltexture, for a video frame the
+// title copied into a shared image on the GPU: Dawn's alias of the image is the external texture's
+// only plane, sampled as it is (identity transfer functions and gamut matrix, as the pixel way).
+RefPtr<ExternalTexture> DeviceImpl::ps5ImportSharedImage(PS5SharedImage& image, uint32_t vkLayout, Function<void(uint32_t vkLayout)>&& released)
+{
+    wgpu::Texture alias = ps5SharedImageAlias(image);
+    if (!alias)
+        return nullptr;
+    if (!dawn::native::vulkan::BeginAccessHostPointerTexturePS5(alias.Get(), static_cast<VkImageLayout>(vkLayout), true))
+        return nullptr;
+
+    static const float identityTransfer[7] = { 1, 1, 0, 1, 0, 0, 0 }; // g, a, b, c, d, e, f: x
+    static const float identityGamut[9] = { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
+    wgpu::ExternalTextureDescriptor descriptor;
+    descriptor.plane0 = alias.CreateView();
+    descriptor.cropSize = { image.width, image.height };
+    descriptor.apparentSize = { image.width, image.height };
+    descriptor.srcTransferFunctionParameters = identityTransfer;
+    descriptor.dstTransferFunctionParameters = identityTransfer;
+    descriptor.gamutConversionMatrix = identityGamut;
+    wgpu::ExternalTexture externalTexture = m_device.CreateExternalTexture(&descriptor);
+    if (!externalTexture) {
+        // Nothing was recorded with the alias: the image can be given back at once.
+        VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+        dawn::native::vulkan::EndAccessHostPointerTexturePS5(alias.Get(), &layout);
+        released(layout);
+        return ExternalTextureImpl::create();
+    }
+    // The texture expires when the task that imported it ends; Dawn's work with it is submitted by
+    // then. The image goes back to the title once that work is done.
+    return ExternalTextureImpl::createShared(WTF::move(externalTexture), [weakThis = ThreadSafeWeakPtr { *this }, alias, released = WTF::move(released)]() mutable {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis) {
+            released(VK_IMAGE_LAYOUT_UNDEFINED);
+            return;
+        }
+        protectedThis->ps5EndSharedImageAccess(alias, WTF::move(released));
+    });
+}
+#endif
+
 } // namespace WebGPU::Dawn
