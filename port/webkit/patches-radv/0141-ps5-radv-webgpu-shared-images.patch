+{
+    auto& vk = s_vulkan;
+    if (vk.tried)
+        return vk.ready;
+    vk.tried = true;
+    auto fail = [](const char* why) {
+        WTFLogAlways("[webgpu] title: no images shared with the compositor (%s): WebGPU video and canvases go through the CPU", why);
+        return false;
+    };
+    vk.display = WebCore::PlatformDisplay::sharedDisplay().eglDisplay();
+    typedef EGLBoolean (*QueryDisplayAttrib)(EGLDisplay, EGLint, EGLAttrib*);
+    typedef EGLBoolean (*QueryDeviceAttrib)(void*, EGLint, EGLAttrib*);
+    auto queryDisplay = reinterpret_cast<QueryDisplayAttrib>(eglGetProcAddress("eglQueryDisplayAttribEXT"));
+    auto queryDevice = reinterpret_cast<QueryDeviceAttrib>(eglGetProcAddress("eglQueryDeviceAttribEXT"));
+    EGLAttrib eglDevice = 0, instance = 0, physical = 0, device = 0;
+    if (!queryDisplay || !queryDevice || !queryDisplay(vk.display, kEGLDeviceEXT, &eglDevice)
+        || !queryDevice(reinterpret_cast<void*>(eglDevice), kEGLVulkanInstanceANGLE, &instance)
+        || !queryDevice(reinterpret_cast<void*>(eglDevice), kEGLVulkanPhysicalDeviceANGLE, &physical)
+        || !queryDevice(reinterpret_cast<void*>(eglDevice), kEGLVulkanDeviceANGLE, &device))
+        return fail("the compositor's display is not ANGLE on Vulkan");
