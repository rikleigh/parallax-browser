+    memoryProperties(vkPhysical, &vk.memory);
+    VkPhysicalDeviceExternalMemoryHostPropertiesEXT host = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT };
+    VkPhysicalDeviceProperties2 properties = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &host };
+    properties2(vkPhysical, &properties);
+    // What Dawn's import needs, and the 64 KiB tiles of the GPU's own layouts.
+    vk.hostAlignment = std::max<uint64_t>(host.minImportedHostPointerAlignment, 0x10000);
+#define DEVICE_PROC(field, name) vk.field = reinterpret_cast<PFN_##name>(getDeviceProc(vk.device, #name))
+    DEVICE_PROC(createImage, vkCreateImage);
+    DEVICE_PROC(destroyImage, vkDestroyImage);
+    DEVICE_PROC(imageRequirements, vkGetImageMemoryRequirements);
+    DEVICE_PROC(allocate, vkAllocateMemory);
+    DEVICE_PROC(freeMemory, vkFreeMemory);
+    DEVICE_PROC(bind, vkBindImageMemory);
+    DEVICE_PROC(map, vkMapMemory);
+#undef DEVICE_PROC
+    vk.createEGLImage = reinterpret_cast<decltype(vk.createEGLImage)>(eglGetProcAddress("eglCreateImageKHR"));
+    vk.destroyEGLImage = reinterpret_cast<decltype(vk.destroyEGLImage)>(eglGetProcAddress("eglDestroyImageKHR"));
+    vk.acquireTextures = reinterpret_cast<decltype(vk.acquireTextures)>(eglGetProcAddress("glAcquireTexturesANGLE"));
+    vk.releaseTextures = reinterpret_cast<decltype(vk.releaseTextures)>(eglGetProcAddress("glReleaseTexturesANGLE"));
+    vk.ready = vk.createImage && vk.destroyImage && vk.imageRequirements && vk.allocate && vk.freeMemory && vk.bind && vk.map
+        && vk.createEGLImage && vk.destroyEGLImage && vk.acquireTextures && vk.releaseTextures && host.minImportedHostPointerAlignment;
+    if (!vk.ready)
+        return fail("missing Vulkan, EGL image or ANGLE texture entry points, or VK_EXT_external_memory_host");
+    WTFLogAlways("[webgpu] title: images shared with the compositor (host-pointer import, alignment %llu)", static_cast<unsigned long long>(host.minImportedHostPointerAlignment));
+    return true;
+}
+
+GLenum glLayout(uint32_t vkLayout)
+{
+    switch (static_cast<VkImageLayout>(vkLayout)) {
+    case VK_IMAGE_LAYOUT_GENERAL: return GL_LAYOUT_GENERAL_EXT;
+    case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL: return GL_LAYOUT_COLOR_ATTACHMENT_EXT;
+    case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL: return GL_LAYOUT_SHADER_READ_ONLY_EXT;
+    case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL: return GL_LAYOUT_TRANSFER_SRC_EXT;
+    case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL: return GL_LAYOUT_TRANSFER_DST_EXT;
+    default: return GL_NONE;
+    }
+}
+
+uint32_t vkLayout(GLenum layout)
+{
+    switch (layout) {
+    case GL_LAYOUT_GENERAL_EXT: return VK_IMAGE_LAYOUT_GENERAL;
+    case GL_LAYOUT_COLOR_ATTACHMENT_EXT: return VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    case GL_LAYOUT_SHADER_READ_ONLY_EXT: return VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    case GL_LAYOUT_TRANSFER_SRC_EXT: return VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    case GL_LAYOUT_TRANSFER_DST_EXT: return VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    default: return VK_IMAGE_LAYOUT_UNDEFINED;
+    }
+}
+
+} // namespace
+
+struct PS5SharedImageSlot::Objects {
+    VkExternalMemoryImageCreateInfo external { VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO };
+    VkImageCreateInfo info { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    VkImage image { VK_NULL_HANDLE };
+    VkDeviceMemory memory { VK_NULL_HANDLE };
+    EGLImageKHR eglImage { EGL_NO_IMAGE_KHR };
+    GLuint texture { 0 };
+    bool acquired { false };
+    uint64_t bytes { 0 };
+    // Garbage: past this fence (after the texture's deletion) ANGLE is done with the image.
+    GLsync freed { nullptr };
+};
+
+namespace {
+
+// The objects of slots no one has any more, and slots given back; render thread.
+Lock s_garbageLock;
+Vector<PS5SharedImageSlot::Objects*>& garbage() WTF_REQUIRES_LOCK(s_garbageLock)
+{
+    static NeverDestroyed<Vector<PS5SharedImageSlot::Objects*>> objects;
+    return objects;
+}
+struct Returning {
+    Ref<PS5SharedImageSlot> slot;
+    GLsync fence;
+};
+Vector<Returning>& returning() WTF_REQUIRES_LOCK(s_garbageLock)
+{
+    static NeverDestroyed<Vector<Returning>> slots;
+    return slots;
+}
+
+void destroyObjects(PS5SharedImageSlot::Objects* objects)
+{
+    Locker locker { s_vulkanLock };
+    auto& vk = s_vulkan;
+    if (objects->eglImage != EGL_NO_IMAGE_KHR)
+        vk.destroyEGLImage(vk.display, objects->eglImage);
+    if (objects->image)
+        vk.destroyImage(vk.device, objects->image, nullptr);
+    if (objects->memory)
+        vk.freeMemory(vk.device, objects->memory, nullptr);
+    s_bytes -= objects->bytes;
+    delete objects;
+}
+
+} // namespace
+
+RefPtr<PS5SharedImageSlot> PS5SharedImageSlot::create(uint32_t width, uint32_t height, ::WebGPU::TextureFormat format)
+{
+    if (!width || !height || width > 8192 || height > 8192)
+        return nullptr;
+    VkFormat vkFormat;
+    switch (format) {
+    case ::WebGPU::TextureFormat::Rgba8unorm:
+        vkFormat = VK_FORMAT_R8G8B8A8_UNORM;
+        break;
+    case ::WebGPU::TextureFormat::Bgra8unorm:
+        vkFormat = VK_FORMAT_B8G8R8A8_UNORM;
+        break;
+    default:
+        return nullptr;
+    }
+
+    Locker locker { s_vulkanLock };
+    if (!setUp())
+        return nullptr;
+    auto& vk = s_vulkan;
+    static bool loggedFailure;
+    auto fail = [&](const char* what, int result, Objects* objects) -> RefPtr<PS5SharedImageSlot> {
+        if (!std::exchange(loggedFailure, true))
+            WTFLogAlways("[webgpu] title: a %ux%u image shared with the compositor could not be made (%s %d)", width, height, what, result);
+        if (objects->memory)
+            vk.freeMemory(vk.device, objects->memory, nullptr);
+        if (objects->image)
+            vk.destroyImage(vk.device, objects->image, nullptr);
+        delete objects;
+        return nullptr;
+    };
+
+    auto* objects = new Objects;
+    objects->external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+    auto& info = objects->info;
+    // With the external-memory struct: RADV then gives it no DCC or HTILE, and Dawn's image of
+    // the same create info has the same layout (15e: without it the two differ).
+    info.pNext = &objects->external;
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = vkFormat;
+    info.extent = { width, height, 1 };
+    info.mipLevels = 1;
+    info.arrayLayers = 1;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkResult result = vk.createImage(vk.device, &info, nullptr, &objects->image);
+    if (result != VK_SUCCESS)
+        return fail("vkCreateImage", result, objects);
+    VkMemoryRequirements requirements;
+    vk.imageRequirements(vk.device, objects->image, &requirements);
+    // Host-visible (it must be mapped: the mapping is the address), device-local if there is one.
+    int type = -1;
+    const VkMemoryPropertyFlags need = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    for (int pass = 0; pass < 2 && type < 0; pass++) {
+        for (uint32_t i = 0; i < vk.memory.memoryTypeCount && type < 0; i++) {
+            VkMemoryPropertyFlags flags = vk.memory.memoryTypes[i].propertyFlags;
+            if ((requirements.memoryTypeBits & (1u << i)) && (flags & need) == need && (pass || (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)))
+                type = static_cast<int>(i);
+        }
+    }
+    if (type < 0)
+        return fail("no host-visible memory type", static_cast<int>(requirements.memoryTypeBits), objects);
+    // Whole import granules, so that Dawn can import all of it.
+    objects->bytes = (requirements.size + vk.hostAlignment - 1) & ~(vk.hostAlignment - 1);
+    VkMemoryDedicatedAllocateInfo dedicated = { VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO };
+    dedicated.image = objects->image;
+    VkMemoryAllocateInfo allocation = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &dedicated };
+    allocation.allocationSize = objects->bytes;
+    allocation.memoryTypeIndex = static_cast<uint32_t>(type);
+    result = vk.allocate(vk.device, &allocation, nullptr, &objects->memory);
+    if (result != VK_SUCCESS)
+        return fail("vkAllocateMemory", result, objects);
+    result = vk.bind(vk.device, objects->image, objects->memory, 0);
+    if (result != VK_SUCCESS)
+        return fail("vkBindImageMemory", result, objects);
+    void* address = nullptr;
+    result = vk.map(vk.device, objects->memory, 0, VK_WHOLE_SIZE, 0, &address);
+    if (result != VK_SUCCESS || !address || (reinterpret_cast<uintptr_t>(address) & (vk.hostAlignment - 1)))
+        return fail("vkMapMemory (or the address is not aligned)", result, objects);
+
+    const uint64_t infoAddress = reinterpret_cast<uintptr_t>(&objects->info);
+    const EGLint attributes[] = {
+        kEGLVulkanImageCreateInfoHiANGLE, static_cast<EGLint>(infoAddress >> 32),
+        kEGLVulkanImageCreateInfoLoANGLE, static_cast<EGLint>(infoAddress & 0xffffffffu),
+        EGL_NONE
+    };
+    objects->eglImage = vk.createEGLImage(vk.display, EGL_NO_CONTEXT, kEGLVulkanImageANGLE, reinterpret_cast<EGLClientBuffer>(&objects->image), attributes);
+    if (objects->eglImage == EGL_NO_IMAGE_KHR)
+        return fail("eglCreateImageKHR(EGL_VULKAN_IMAGE_ANGLE)", eglGetError(), objects);
+
+    s_bytes += objects->bytes;
+    RefPtr slot = adoptRef(*new PS5SharedImageSlot);
+    slot->m_objects = objects;
+    slot->identifier = s_nextIdentifier++;
+    slot->address = address;
+    slot->size = objects->bytes;
+    slot->vkImageCreateInfo = &objects->info;
+    slot->width = width;
+    slot->height = height;
+    slot->format = format;
+    return slot;
+}
+
+PS5SharedImageSlot::~PS5SharedImageSlot()
+{
+    if (!m_objects)
+        return;
+    Locker locker { s_garbageLock };
+    garbage().append(std::exchange(m_objects, nullptr));
+}
+
+unsigned PS5SharedImageSlot::glTexture()
+{
+    if (!m_objects->texture) {
+        GLint previous = 0;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+        glGenTextures(1, &m_objects->texture);
+        glBindTexture(GL_TEXTURE_2D, m_objects->texture);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, m_objects->eglImage);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, previous);
+    }
+    return m_objects->texture;
+}
+
+void PS5SharedImageSlot::acquireForGL(uint32_t layout)
+{
+    GLuint texture = glTexture();
+    const GLenum gl = glLayout(layout);
+    void (*acquire)(GLuint, const GLuint*, const GLenum*);
+    {
+        Locker locker { s_vulkanLock };
+        acquire = s_vulkan.acquireTextures;
+    }
+    acquire(1, &texture, &gl);
+    m_objects->acquired = true;
+}
+
+uint32_t PS5SharedImageSlot::releaseFromGL()
+{
+    if (!m_objects->acquired)
+        return VK_IMAGE_LAYOUT_UNDEFINED;
+    GLuint texture = glTexture();
+    GLenum layout = GL_NONE;
+    void (*release)(GLuint, const GLuint*, GLenum*);
+    {
+        Locker locker { s_vulkanLock };
+        release = s_vulkan.releaseTextures;
+    }
+    release(1, &texture, &layout);
+    m_objects->acquired = false;
+    return vkLayout(layout);
+}
+
+namespace PS5SharedImages {
+
+bool available()
+{
+    Locker locker { s_vulkanLock };
+    return setUp();
+}
+
+void giveBack(PS5SharedImageSlot& slot)
+{
+    slot.releaseFromGL();
+    GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+    slot.state = PS5SharedImageSlot::State::Returning;
+    Locker locker { s_garbageLock };
+    returning().append({ Ref { slot }, fence });
+}
+
+void collectGarbage()
+{
+    Vector<Returning> back;
+    Vector<PS5SharedImageSlot::Objects*> objects;
+    {
+        Locker locker { s_garbageLock };
+        back = std::exchange(returning(), { });
+        objects = std::exchange(garbage(), { });
+    }
+    Vector<Returning> stillReturning;
+    for (auto& entry : back) {
+        GLenum status = entry.fence ? glClientWaitSync(entry.fence, 0, 0) : GL_ALREADY_SIGNALED;
+        if (status == GL_ALREADY_SIGNALED || status == GL_CONDITION_SATISFIED || status == GL_WAIT_FAILED) {
+            if (entry.fence)
+                glDeleteSync(entry.fence);
+            entry.slot->state = PS5SharedImageSlot::State::Free;
+        } else
+            stillReturning.append(WTF::move(entry));
+    }
+    // Dropped outside the lock: the last reference to a slot puts its objects in the garbage.
+    back.clear();
+
+    Vector<PS5SharedImageSlot::Objects*> stillGarbage;
+    for (auto* object : objects) {
+        if (!object->freed) {
+            if (object->texture) {
+                if (object->acquired) {
+                    GLenum layout = GL_NONE;
+                    void (*release)(GLuint, const GLuint*, GLenum*);
+                    {
+                        Locker locker { s_vulkanLock };
+                        release = s_vulkan.releaseTextures;
+                    }
+                    release(1, &object->texture, &layout);
+                }
+                glDeleteTextures(1, &object->texture);
+                object->texture = 0;
+            }
+            object->freed = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+            glFlush();
+            stillGarbage.append(object);
+            continue;
+        }
+        GLenum status = glClientWaitSync(object->freed, 0, 0);
+        if (status == GL_TIMEOUT_EXPIRED) {
+            stillGarbage.append(object);
+            continue;
+        }
+        glDeleteSync(object->freed);
+        destroyObjects(object);
+    }
+
+    if (stillReturning.isEmpty() && stillGarbage.isEmpty())
+        return;
+    Locker locker { s_garbageLock };
+    returning().appendVector(WTF::move(stillReturning));
+    garbage().appendVector(stillGarbage);
+}
+
+uint64_t bytes()
+{
+    return s_bytes.load();
+}
+
+} // namespace PS5SharedImages
+
+} // namespace WebKit
+
+#endif
