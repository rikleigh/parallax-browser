+#if PS5WK_GPU_RADV
+bool RemoteQueueProxy::ps5CopyVideoStreamFrameToTexture(uint64_t streamKey, uint32_t videoWidth, uint32_t videoHeight, const ::WebGPU::TexelCopyTextureInfo& destination, const ::WebGPU::Extent3D& copySize, bool flipY)
+{
+    auto convertedDestination = m_convertToBackingContext->convertToBacking(destination);
+    if (!convertedDestination)
+        return false;
+    // On the stream, in order with the page's other calls (its readback of the texture after it).
+    auto sendResult = send(Messages::RemoteQueue::CopyVideoStreamFrameToTexturePS5(streamKey, videoWidth, videoHeight, *convertedDestination, copySize, flipY));
+    return sendResult == IPC::Error::NoError;
+}
+#endif
