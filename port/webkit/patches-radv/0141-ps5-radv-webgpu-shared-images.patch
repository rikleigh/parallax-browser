@@ -0,0 +1,86 @@
+/*
+ * PS5, GPU=radv: images Dawn and the compositor share (HANDOVER-radv.md Phase 4).
+ * Copyright (C) 2026 Parallax Browser contributors. BSD-2-Clause, as WebKit.
+ *
+ * The compositor (ANGLE on Vulkan) and Dawn are two VkDevices on one RADV in
+ * one process. A PS5 RADV buffer's GPU address is its CPU mapping, and Dawn's
+ * host-pointer import of that memory reaches it at the same address, so an
+ * image made here and an image Dawn makes from the same create info (both with
+ * VkExternalMemoryImageCreateInfo { HOST_ALLOCATION }) are one image
+ * (spikes/15-radv-only 15e; Dawn's side: port/deps/patches/dawn-radv). There
+ * are no shared semaphores: whoever hands the image over has waited for its
+ * own GPU work first (glFinish or a GL fence here, OnSubmittedWorkDone there).
+ *
+ * Two users:
+ * - video into WebGPU (PS5WebGPUVideoRead.cpp): the video stream's frame is
+ *   copied into one with GL on RemoteGPU's work queue, and Dawn samples it as
+ *   an external texture;
+ * - canvas frames out of WebGPU (PS5WebGPUCanvas.cpp): Dawn copies a presented
+ *   frame into one, and the WC scene draws it.
+ */
+
+#pragma once
+
+#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL) && USE(DAWN) && USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS) && defined(PS5_PAYLOAD_SDK) && PS5WK_GPU_RADV
+
+#include <WebCore/WebGPUCppAPI.h>
+#include <atomic>
+#include <wtf/RefPtr.h>
+
+namespace WebKit {
+
+class PS5SharedImageSlot final : public ::WebGPU::PS5SharedImage {
+public:
+    // Who has the image. Free: whoever takes it next. Dawn: Dawn is copying into or reading it.
+    // Compositor: GL has it (acquired). Returning: GL let it go and its fence has not passed.
+    enum class State : uint8_t { Free, Dawn, Compositor, Returning };
+
+    // Any thread: an RGBA8 or BGRA8 image of the compositor's VkDevice, in host-visible memory,
+    // with its EGL image. Null when the compositor is not ANGLE on Vulkan or memory is short
+    // (logged once).
+    static RefPtr<PS5SharedImageSlot> create(uint32_t width, uint32_t height, ::WebGPU::TextureFormat);
+    // Its objects go to PS5SharedImages::collectGarbage().
+    ~PS5SharedImageSlot();
+
+    // A thread with a context of the compositor's share group current. The GL texture over the
+    // image, made by the first call.
+    unsigned glTexture();
+    // GL takes the image: its contents are kept when `vkLayout` (a VkImageLayout) is not
+    // UNDEFINED. Then gives it back, with the layout GL left it in.
+    void acquireForGL(uint32_t vkLayout);
+    uint32_t releaseFromGL();
+
+    std::atomic<State> state { State::Free };
+    uint64_t bytes() const { return size; }
+
+    // Its Vulkan, EGL and GL objects (PS5SharedImages.cpp).
+    struct Objects;
+
+private:
+    PS5SharedImageSlot() = default;
+
+    Objects* m_objects { nullptr };
+};
+
+namespace PS5SharedImages {
+
+// The compositor is ANGLE on Vulkan over RADV, and images can be made (set up on first call).
+bool available();
+
+// Render thread, with the compositor's context current (the canvas's frame is no longer
+// shown): GL lets the slot go, and it is Free once the GPU is past that. Takes a reference.
+void giveBack(PS5SharedImageSlot&);
+
+// Render thread, compositor context current, every frame (PS5WebGLLayers::collectGarbage):
+// slots given back whose fence has passed become Free; images no one has any more are freed
+// once the GPU is done with them.
+void collectGarbage();
+
+// How much memory the images take, for the [mem] line.
+uint64_t bytes();
+
+} // namespace PS5SharedImages
+
+} // namespace WebKit
+
+#endif
