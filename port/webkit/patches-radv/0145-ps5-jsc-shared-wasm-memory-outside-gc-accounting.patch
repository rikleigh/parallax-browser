@@ -40,6 +40,25 @@ namespace JSC {
 
 const ClassInfo JSWebAssemblyMemory::s_info = { "WebAssembly.Memory"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(JSWebAssemblyMemory) };
 
+// PS5: a shared memory (WebAssembly threads) is wrapped by a JSWebAssemblyMemory in every worker
+// it is posted to, and each wrapper counted the whole memory as its heap's extra memory: a game's
+// 2 GB shared memory made each of its ~20 workers' heaps look 2-4 GB, so each collected only after
+// close to 1 GB of its own garbage (MarkedBlocks), and the title's heap grew ~400 MB a minute
+// (nfsu2.xyz, 2026-11-24). Counted nowhere, a page that keeps making and dropping shared memories
+// gave no heap a reason to collect them. Now one wrapper or buffer in the process counts it, the
+// one that claimed its contents (SharedArrayBufferContents::claimGCAccounting()): the creator's
+// wrapper, which claims them in adopt(), before the memory can be posted. A wrapper that comes
+// later takes the claim over when it visits the memory after the claimer is destroyed. The
+// memory's own buffers do not count it again. Non-shared memories are counted as before.
+static bool countsAsExtraMemory(JSWebAssemblyMemory* wrapper)
+{
+    auto& memory = wrapper->memory();
+    if (memory.sharingMode() != MemorySharingMode::Shared)
+        return true;
+    auto* shared = memory.shared();
+    return !shared || shared->claimGCAccounting(wrapper);
+}
