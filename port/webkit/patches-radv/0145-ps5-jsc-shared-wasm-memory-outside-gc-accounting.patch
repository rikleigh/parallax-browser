+    // PS5: the creator of a shared memory adopts it before anything can post it, so it claims the
+    // contents and its heap is told of the whole memory now (countsAsExtraMemory() above). Every
+    // later adopter of the same contents finds them claimed and reports nothing.
+    if (m_memory->sharingMode() == MemorySharingMode::Shared && m_memory->shared() && countsAsExtraMemory(this))
+        heap()->reportExtraMemoryAllocated(this, m_memory->size());
 }
 
