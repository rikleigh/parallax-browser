     BufferMemoryHandle* memoryHandle() const { return m_memoryHandle.get(); }
 
+    // PS5: which one object counts these bytes as its heap's extra memory. Every agent a shared
+    // buffer or shared WebAssembly memory is posted to wraps it in objects of its own heap, and
+    // when each of them counted it a game's 2 GB shared memory weighed 2 GB in each of ~20 worker
+    // heaps (nfsu2.xyz, 2026-11-24); when none did, a page that keeps making and dropping large
+    // shared buffers gave no heap a reason to collect them. So the first object to report them
+    // claims them: the creator's, since nothing else can see the contents before it does (a shared
+    // WebAssembly memory claims them when it adopts its memory, a SharedArrayBuffer when its
+    // buffer is first referenced from its heap). The others count only themselves. The claimer
+    // gives the claim back when it is destroyed, and one of the others takes it over the next time
+    // its heap measures it (a full collection, or a visit of the memory), so the bytes stay counted
+    // in one heap after the creator's goes away. The owner is only compared, never followed.
+    bool claimGCAccounting(const void* owner)
+    {
+        const void* current = m_gcAccountingOwner.load(std::memory_order_relaxed);
+        if (current == owner)
+            return true;
+        if (current)
+            return false;
+        return m_gcAccountingOwner.compare_exchange_strong(current, owner);
+    }
+    void releaseGCAccounting(const void* owner)
+    {
+        const void* expected = owner;
+        m_gcAccountingOwner.compare_exchange_strong(expected, nullptr);
+    }
+
     static constexpr ptrdiff_t offsetOfSizeInBytes() { return OBJECT_OFFSETOF(SharedArrayBufferContents, m_sizeInBytes); }
     
 private:
