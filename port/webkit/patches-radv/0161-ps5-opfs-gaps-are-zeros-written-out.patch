+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// PS5: the console's file system does not zero what a file is given and
+// nothing has written: past the end of the file, the rest of the disk block
+// its old end was in and the start of the block a write past the end begins
+// in read back as whatever that disk block held (about 49,000 bytes around a
+// gap; README, "Bytes a file never had written"). So no gap is left to it: a
+// file grows past its end only by zeros written out. The space is the
+// page's already (requestSpaceForNewSize). Where the page's writes go to the
+// backend (pages in the browser process, whose own writes the console holds
+// back) the backend writes the zeros too, in steps, each a write of no bytes
+// at the step's end.
+bool FileSystemSyncAccessHandle::extendWithZeros(uint64_t newSize)
+{
+    auto size = m_file.size();
+    if (!size)
+        return false;
+    if (newSize <= *size)
+        return true;
+
+    if (m_source->minimumSizeOfSyncAccessHandleWriteThroughBackend()) {
+        static constexpr uint64_t step = 64 * MB;
+        for (uint64_t end = *size; end < newSize;) {
+            end = std::min(newSize, end + step);
+            if (!m_source->writeForSyncAccessHandle(m_identifier, end, { }))
+                return false;
+        }
+        return true;
+    }
+
+    return m_file.extendWithZeros(newSize);
+}
+#endif
