+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+bool FileHandle::extendWithZeros(uint64_t newSize)
+{
+    if (!m_handle)
+        return false;
+
+    struct stat fileInfo;
+    if (fstat(*m_handle, &fileInfo) || fileInfo.st_size < 0)
+        return false;
+
+    uint64_t offset = fileInfo.st_size;
+    if (offset >= newSize)
+        return true;
+
+    // Up to 4 MB at a time: each write() costs the disk about a millisecond
+    // on the console, so small ones are slow (README, "The title's own file
+    // writes").
+    static constexpr uint64_t maximumBufferSize = 4 * 1024 * 1024;
+    size_t bufferSize = static_cast<size_t>(std::min(newSize - offset, maximumBufferSize));
+    auto* zeros = static_cast<uint8_t*>(calloc(1, bufferSize));
+    if (!zeros)
+        return false;
+    bool succeeded = true;
+    while (offset < newSize) {
+        size_t length = static_cast<size_t>(std::min<uint64_t>(newSize - offset, bufferSize));
+        auto written = ::pwrite(*m_handle, zeros, length, static_cast<off_t>(offset));
+        if (written < 0 && errno == EINTR)
+            continue;
+        if (written <= 0) {
+            succeeded = false;
+            break;
+        }
+        offset += written;
+    }
+    free(zeros);
+    return succeeded;
+}
+#endif
