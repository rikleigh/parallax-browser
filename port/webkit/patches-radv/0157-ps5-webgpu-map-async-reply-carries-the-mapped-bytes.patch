+// buffer every frame and has already submitted the next frame's work waited there for as long as
+// the GPU took (a PS2 emulator's drawing thread: 38% of its time, 2026-11-25). The contents cannot
+// change between here and unmap(): a mapped buffer is not used by the GPU.
+static constexpr size_t maximumMappedRangeInReply = 4 * 1024 * 1024;
+
+void RemoteBuffer::mapAsync(OptionSet<::WebGPU::MapMode> mapModeFlags, uint64_t offset, std::optional<uint64_t> size, CompletionHandler<void(bool, std::optional<Vector<uint8_t>>&&)>&& callback)
