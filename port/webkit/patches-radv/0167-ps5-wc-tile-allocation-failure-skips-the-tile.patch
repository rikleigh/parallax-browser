+// The browser title's flexible memory left (apps/title/titlemem.c): tile
+// images and arena chunks are shared memory, which a title maps from it. Not
+// defined in a payload, whose memory is not the title's.
+extern "C" size_t dmem_flexible_free(void) __attribute__((weak));
+
+namespace {
+struct WCTileMemoryCounts {
+    unsigned arenaFull { 0 };
+    unsigned imagesFailed { 0 };
+    unsigned chunksFailed { 0 };
+    uint64_t failedBytes { 0 };
+    MonotonicTime lastLine;
+    bool lineScheduled { false };
+};
+}
+
+static WCTileMemoryCounts& wcTileMemoryCounts()
+{
+    static WCTileMemoryCounts counts; // main thread only
+    return counts;
+}
+
+static void wcLogTileMemory()
+{
+    auto& counts = wcTileMemoryCounts();
+    if (!counts.arenaFull && !counts.imagesFailed && !counts.chunksFailed)
+        return;
+    char flexible[64] = "";
+    if (dmem_flexible_free)
+        snprintf(flexible, sizeof flexible, "; the title's flexible memory free: %.0f MB", dmem_flexible_free() / 1048576.0);
+    WTFLogAlways("[wc] tile memory: %u tile part(s) painted the old way (tile arena full); %u tile image(s) and %u arena chunk(s) could not be allocated (%.1f MB), those tiles wait for the next update%s", // NOLINT
+        counts.arenaFull, counts.imagesFailed, counts.chunksFailed, counts.failedBytes / 1048576.0, flexible);
+    counts.arenaFull = counts.imagesFailed = counts.chunksFailed = 0;
+    counts.failedBytes = 0;
+    counts.lastLine = MonotonicTime::now();
+}
+
+void wcNoteTileMemory(WCTileMemoryEvent event, unsigned count, uint64_t bytes)
+{
+    auto& counts = wcTileMemoryCounts();
+    switch (event) {
+    case WCTileMemoryEvent::ArenaFull:
+        counts.arenaFull += count;
+        break;
+    case WCTileMemoryEvent::ImageFailed:
+        counts.imagesFailed += count;
+        counts.failedBytes += bytes;
+        break;
+    case WCTileMemoryEvent::ChunkFailed:
+        counts.chunksFailed += count;
+        counts.failedBytes += bytes;
+        break;
+    }
+    auto sinceLine = MonotonicTime::now() - counts.lastLine;
+    if (!counts.lastLine || sinceLine >= 5_s) {
+        wcLogTileMemory();
+        return;
+    }
+    // Within 5 s of the last line: these counts go in one line when the 5 s
+    // are up, whether or not anything else happens by then.
+    if (counts.lineScheduled)
+        return;
+    counts.lineScheduled = true;
+    RunLoop::mainSingleton().dispatchAfter(5_s - sinceLine, [] {
+        wcTileMemoryCounts().lineScheduled = false;
+        wcLogTileMemory();
+    });
+}
+
+bool wcTestAllocationFails()
+{
+#if PS5WK_DEBUG_BUILD
+    static unsigned percent = [] {
+        const char* text = getenv("PS5WK_WC_TEST_ALLOC_FAIL");
+        return text ? std::min(100u, static_cast<unsigned>(strtoul(text, nullptr, 10))) : 0u;
+    }();
+    static unsigned counter; // main thread only
+    return percent && (counter++ % 100) < percent;
+#else
+    return false;
+#endif
+}
