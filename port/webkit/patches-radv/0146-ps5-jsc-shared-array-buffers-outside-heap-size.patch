 namespace JSC {
 
+// PS5: what an object adds to this heap's extra memory. A shared buffer (a SharedArrayBuffer, or a
+// shared WebAssembly memory's buffer) is referenced from every worker it is posted to, and counting
+// its whole length in each of their heaps made a game's 2 GB shared memory a 2 GB "allocation" in
+// each of ~20 workers: each then collected only after close to 1 GB of its own garbage (nfsu2.xyz,
+// 2026-11-24). Its bytes count in one heap only, that of the object that claimed them (usually the
+// creator's, see SharedArrayBufferContents::claimGCAccounting()); elsewhere it counts as its object.
+// A buffer that was not the claimer takes the claim over here once the claimer is gone, at its
+// heap's next full collection (sweep() measures every buffer again then).
+template<typename T>
+inline size_t gcIncomingSizeEstimateInBytes(const T* object)
+{
+    if constexpr (requires { object->countsItsBytesInGCAccounting(); }) {
+        if (!object->countsItsBytesInGCAccounting())
+            return sizeof(T);
+    }
+    return object->gcSizeEstimateInBytes();
+}
