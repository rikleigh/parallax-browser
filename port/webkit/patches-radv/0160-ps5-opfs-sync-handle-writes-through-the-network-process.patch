+void WebFileSystemStorageConnection::writeForSyncAccessHandle(WebCore::FileSystemHandleIdentifier identifier, WebCore::FileSystemSyncAccessHandleIdentifier accessHandleIdentifier, uint64_t offset, std::span<const uint8_t> dataBytes, WriteForSyncAccessHandleCallback&& completionHandler)
+{
+    RefPtr connection = m_connection;
+    if (!connection)
+        return completionHandler(std::nullopt);
+
+    connection->sendWithAsyncReply(Messages::NetworkStorageManager::WriteForSyncAccessHandle(identifier, accessHandleIdentifier, offset, dataBytes), WTF::move(completionHandler));
+}
+#endif
