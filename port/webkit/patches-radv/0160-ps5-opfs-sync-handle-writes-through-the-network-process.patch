+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+// Pages in the browser process (PS5WebProcessInTitle.cpp): this process is
+// the title, whose own file writes the console holds back; the
+// NetworkProcess, a payload, writes at the disk's speed. Every write goes to
+// it, small ones too: the console counts each write() call of the title as
+// about 64 KB more than its bytes, and a write costs the disk about a
+// millisecond in either process, more than the round trip.
+// Called on worker threads too: a flag set once at start.
+uint64_t WebFileSystemStorageConnection::minimumSizeOfSyncAccessHandleWriteThroughBackend() const
+{
+    if (!AuxiliaryProcess::ps5WebProcessIsInTitle())
+        return 0;
+#if PS5WK_DEBUG_BUILD
+    // Development builds, for measuring both ways: /data/ps5webkit/opfs-backend-write-min
+    // holds another size in bytes (0: the title writes everything itself). Read once.
+    static const uint64_t minimumSize = [] {
+        unsigned long long size = 1;
+        if (FILE* file = fopen("/data/ps5webkit/opfs-backend-write-min", "r")) {
+            if (fscanf(file, "%llu", &size) != 1)
+                size = 1;
+            fclose(file);
+            WTFLogAlways("[storage] opfs-backend-write-min: sync access handle writes of %llu bytes or more go to the NetworkProcess (0: none)", size);
+        }
+        return static_cast<uint64_t>(size);
+    }();
+    return minimumSize;
+#else
+    return 1;
+#endif
+}
