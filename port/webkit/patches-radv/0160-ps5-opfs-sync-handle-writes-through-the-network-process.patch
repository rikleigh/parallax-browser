+// PS5: the page's process is the title, whose own writes the console holds
+// back; this process (a payload) writes them for it. Only inside what the
+// page may write: the capacity it was granted (the quota) or the size the
+// file had. The descriptor is this process's own (the page has the one made
+// with the handle), opened at the first such write.
+std::optional<uint64_t> FileSystemStorageHandle::writeForSyncAccessHandle(WebCore::FileSystemSyncAccessHandleIdentifier accessHandleIdentifier, uint64_t offset, std::span<const uint8_t> dataBytes)
+{
+    if (!isActiveSyncAccessHandle(accessHandleIdentifier))
+        return std::nullopt;
+
+    CheckedUint64 end = offset;
+    end += dataBytes.size();
+    if (end.hasOverflowed() || end.value() > std::max(m_activeSyncAccessHandle->capacity, m_activeSyncAccessHandle->initialSize))
+        return std::nullopt;
+
+    auto& handle = m_activeSyncAccessHandle->writeHandle;
+    if (!handle) {
+        handle = FileSystem::openFile(m_path, FileSystem::FileOpenMode::ReadWrite);
+        if (!handle)
+            return std::nullopt;
+    }
+
+    if (!handle.seek(offset, FileSystem::FileSeekOrigin::Beginning))
+        return std::nullopt;
+
+    return handle.write(dataBytes);
+}
