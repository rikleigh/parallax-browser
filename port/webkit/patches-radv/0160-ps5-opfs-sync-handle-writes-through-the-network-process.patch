+void NetworkStorageManager::writeForSyncAccessHandle(IPC::Connection& connection, WebCore::FileSystemHandleIdentifier identifier, WebCore::FileSystemSyncAccessHandleIdentifier accessHandleIdentifier, uint64_t offset, std::span<const uint8_t> dataBytes, CompletionHandler<void(std::optional<uint64_t>)>&& completionHandler)
