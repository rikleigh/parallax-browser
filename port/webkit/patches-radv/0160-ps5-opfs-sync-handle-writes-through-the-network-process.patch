+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+uint64_t WorkerFileSystemStorageConnection::minimumSizeOfSyncAccessHandleWriteThroughBackend() const
+{
+    // On the worker thread: the main thread's connection answers from a flag
+    // set once at start.
+    return m_mainThreadConnection ? m_mainThreadConnection->minimumSizeOfSyncAccessHandleWriteThroughBackend() : 0;
+}
+
+// As requestNewCapacityForSyncAccessHandle: the main thread sends, this
+// thread waits for the answer. data stays the caller's until then. In pieces:
+// each goes to the backend as one IPC message, copied on the way.
+std::optional<uint64_t> WorkerFileSystemStorageConnection::writeForSyncAccessHandle(FileSystemHandleIdentifier identifier, FileSystemSyncAccessHandleIdentifier accessHandleIdentifier, uint64_t offset, std::span<const uint8_t> data)
+{
+    RefPtr scope = m_scope.get();
+    if (!scope)
+        return std::nullopt;
+
+    if (!m_mainThreadConnection)
+        return std::nullopt;
+
+    static constexpr size_t maximumPieceSize = 16 * MB;
+    uint64_t written = 0;
+    while (written < data.size()) {
+        auto piece = data.subspan(written, std::min<size_t>(data.size() - written, maximumPieceSize));
+        BinarySemaphore semaphore;
+        std::optional<uint64_t> pieceWritten;
+        callOnMainThread([mainThreadConnection = m_mainThreadConnection, identifier, accessHandleIdentifier, pieceOffset = offset + written, piece, &pieceWritten, &semaphore]() {
+            auto mainThreadCallback = [&pieceWritten, &semaphore](auto result) {
+                pieceWritten = result;
+                semaphore.signal();
+            };
+            mainThreadConnection->writeForSyncAccessHandle(identifier, accessHandleIdentifier, pieceOffset, piece, WTF::move(mainThreadCallback));
+        });
+        {
+            JSC::VMBlockingScope blockingScope(scope->vm());
+            semaphore.wait();
+        }
+        if (!pieceWritten) {
+            if (!written)
+                return std::nullopt;
+            break;
+        }
+        written += *pieceWritten;
+        if (*pieceWritten < piece.size())
+            break;
+    }
+    return written;
+}
+
+void WorkerFileSystemStorageConnection::writeForSyncAccessHandle(FileSystemHandleIdentifier, FileSystemSyncAccessHandleIdentifier, uint64_t, std::span<const uint8_t>, WriteForSyncAccessHandleCallback&& callback)
+{
+    ASSERT_NOT_REACHED();
+    return callback(std::nullopt);
+}
+#endif
