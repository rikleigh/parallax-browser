@@ -79,8 +79,10 @@ RefPtr<DrawingArea> DrawingArea::create(WebPage& webPage, const WebPageCreationP
 #elif PLATFORM(IOS_FAMILY)
     return RemoteLayerTreeDrawingArea::create(webPage, parameters);
 #elif USE(GRAPHICS_LAYER_WC) && USE(COORDINATED_GRAPHICS)
-    // WPE (PS5): the WC compositor only with accelerated compositing on (off
-    // by default on PS5, WebPreferencesWPE.cpp); otherwise the CPU path.
+    // WPE (PS5): the WC compositor when accelerated compositing is on, which
+    // it is by default (WebPreferencesWPE.cpp; the UI process settles it for
+    // each new WebProcess, DrawingAreaProxyWCPS5::configurePreferencesForNewPage);
+    // otherwise the CPU path.
     if (parameters.store.getBoolValueForKey(WebPreferencesKey::acceleratedCompositingEnabledKey()))
         return DrawingAreaWC::create(webPage, parameters);
     return DrawingAreaCoordinatedGraphics::create(webPage, parameters);
