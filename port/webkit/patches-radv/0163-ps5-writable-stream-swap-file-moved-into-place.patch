+#if OS(FREEBSD) && defined(PS5_PAYLOAD_SDK)
+static const char* posixPath(const UTF8CString& path)
+{
+    return reinterpret_cast<const char*>(path.data());
+}
+
+// PS5: FileSystem::copyFile (std::filesystem::copy_file) has no system call
+// to copy with here, and libc++ copies through an fstream, a few KB per
+// write(): 1 GB took 62 s on the console. 8 MB reads and writes instead. As
+// copy_file: an existing target keeps its permissions, a new one gets the
+// source's.
+static bool copyFileQuickly(const String& targetPath, const String& sourcePath)
+{
+    auto sourceRepresentation = FileSystem::fileSystemRepresentation(sourcePath);
+    auto targetRepresentation = FileSystem::fileSystemRepresentation(targetPath);
+    if (sourceRepresentation.isNull() || targetRepresentation.isNull())
+        return false;
+    int source = open(posixPath(sourceRepresentation), O_RDONLY | O_CLOEXEC);
+    if (source < 0)
+        return false;
+    struct stat sourceInfo;
+    if (fstat(source, &sourceInfo)) {
+        close(source);
+        return false;
+    }
+    int target = open(posixPath(targetRepresentation), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, sourceInfo.st_mode & 0777);
+    if (target < 0) {
+        close(source);
+        return false;
+    }
+    static constexpr size_t bufferSize = 8 * MB;
+    auto* buffer = static_cast<uint8_t*>(malloc(bufferSize));
+    bool succeeded = buffer;
+    while (succeeded) {
+        auto bytesRead = read(source, buffer, bufferSize);
+        if (bytesRead < 0 && errno == EINTR)
+            continue;
+        if (bytesRead <= 0) {
+            succeeded = !bytesRead;
+            break;
+        }
+        for (ssize_t done = 0; done < bytesRead;) {
+            auto written = write(target, buffer + done, bytesRead - done);
+            if (written < 0 && errno == EINTR)
+                continue;
+            if (written <= 0) {
+                succeeded = false;
+                break;
+            }
+            done += written;
+        }
+    }
+    free(buffer);
+    close(source);
+    succeeded = !close(target) && succeeded;
+    return succeeded;
+}
+
+// PS5: a closed writable stream's swap file becomes the file by a rename (the
+// temporary folder, TMPDIR of ps5wk-child, is on /data with the website data),
+// with the file's permissions; else by a copy. Upstream copies it into place
+// and leaves it, until the next NetworkProcess (ps5wk-child's
+// removeStaleWritableStreams): it is removed here either way. A rename also
+// replaces the file in one step: what reads it by path sees the old bytes or
+// the new ones, not a mix.
+static bool moveSwapFileIntoPlace(const String& swapPath, const String& path)
+{
+#if PS5WK_DEBUG_BUILD
+    auto start = MonotonicTime::now();
+    auto size = FileSystem::fileSize(swapPath);
+#endif
+    auto swapRepresentation = FileSystem::fileSystemRepresentation(swapPath);
+    auto pathRepresentation = FileSystem::fileSystemRepresentation(path);
+    if (swapRepresentation.isNull() || pathRepresentation.isNull())
+        return false;
+    struct stat fileInfo;
+    if (!stat(posixPath(pathRepresentation), &fileInfo))
+        chmod(posixPath(swapRepresentation), fileInfo.st_mode & 07777);
+    bool renamed = !rename(posixPath(swapRepresentation), posixPath(pathRepresentation));
+    bool succeeded = renamed || copyFileQuickly(path, swapPath);
+    if (!renamed)
+        unlink(posixPath(swapRepresentation));
+#if PS5WK_DEBUG_BUILD
+    WTFLogAlways("[storage] writable stream closed: %.1f MB %s in %.3f s", valueOrDefault(size) / 1048576.0,
+        renamed ? "moved into place" : succeeded ? "copied into place (no rename)" : "NOT copied into place", (MonotonicTime::now() - start).value());
+#endif
+    return succeeded;
+}
+#endif
