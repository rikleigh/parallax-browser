@@ -102,6 +102,8 @@ private:
     const Ref<CallbackCounts> m_callbackCounts;
     bool m_pumpScheduled { false };
     bool m_isProcessingEvents { false };
+    // Until then the pump does not sleep between its rounds. See quickPumpTime in Instance.cpp.
+    MonotonicTime m_quickPumpUntil;
 };
 
