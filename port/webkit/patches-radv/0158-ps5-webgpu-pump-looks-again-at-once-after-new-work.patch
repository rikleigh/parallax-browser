diff --git a/Source/WebGPU/WebGPUDawn/Instance.cpp b/Source/WebGPU/WebGPUDawn/Instance.cpp
index 7aa4cb6d58..a75fc805ac 100644
--- a/Source/WebGPU/WebGPUDawn/Instance.cpp
+++ b/Source/WebGPU/WebGPUDawn/Instance.cpp
@@ -50,6 +50,14 @@ namespace WebGPU::Dawn {
 // How long the pump sleeps after a round that completed nothing, so that waiting for the GPU
 // does not spin a core. The messages of the Web Process wait as long.
 static constexpr auto idlePumpInterval = 100_us;
+// For this long after a callback is registered the pump does not sleep between its rounds: it
+// looks again as soon as the work queue has taken what else is waiting. Most of what a page waits
+// for is done within tens of microseconds (a small copy and its mapAsync, an empty
+// onSubmittedWorkDone), and the sleep, which really takes about 200 us on the console, was most
+// of the time such a round trip took. A renderer that reads back several times a frame pays it
+// each time. Work that takes longer than this falls back to the sleep, so a long GPU job does
+// not spin the thread.
+static constexpr auto quickPumpTime = 150_us;
 // See ~InstanceImpl(). With the sleep between the rounds this is a tenth of a second.
 static constexpr unsigned maximumFinalPumpRounds = 1000;
 
@@ -178,6 +186,7 @@ RefPtr<PresentationContext> InstanceImpl::createPresentationContext(const Presen
 Ref<CallbackCounts> InstanceImpl::callbackRegistered()
 {
     ++m_callbackCounts->outstanding;
+    m_quickPumpUntil = MonotonicTime::now() + quickPumpTime;
     pumpSoon();
     return m_callbackCounts;
 }
@@ -205,7 +214,7 @@ void InstanceImpl::pump()
         return;
 
     // The callbacks that are left wait for the GPU.
-    if (m_callbackCounts->completed == completedCallbacks)
+    if (m_callbackCounts->completed == completedCallbacks && MonotonicTime::now() >= m_quickPumpUntil)
         sleep(idlePumpInterval);
     pumpSoon();
 }
