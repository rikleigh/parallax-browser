 typedef struct {
 	char *filename;
 	sqlite3 *db;
+	/* PS5: what the database holds per host (host -> StoredPolicy), so
+	 * that only real changes are written; see should_store(). */
+	GHashTable *stored;
 } SoupHSTSEnforcerDBPrivate;
 
+typedef struct {
+	gint64 expiry;
+	gboolean include_subdomains;
+} StoredPolicy;
+
+/* PS5: every response with a Strict-Transport-Security header renews its
+ * host's policy, so the expiry moves by the seconds since the last one, and
+ * upstream wrote an SQLite transaction (journal created, written, deleted)
+ * for each such response, on the thread that runs all network I/O. Only
+ * real changes are written now: a new host, a removed policy (max-age=0 or
+ * expired), includeSubDomains changed, or the expiry moved by more than a
+ * day (or half the max-age, when that is shorter). The in-memory policy is
+ * always the current one, so enforcement is unchanged; after a restart a
+ * policy can expire at most that much earlier than it would have. */
+#define STORE_EXPIRY_SLACK_SECONDS (24 * 60 * 60)
+
 G_DEFINE_FINAL_TYPE_WITH_CODE (SoupHSTSEnforcerDB, soup_hsts_enforcer_db, SOUP_TYPE_HSTS_ENFORCER,
 			       G_ADD_PRIVATE(SoupHSTSEnforcerDB))
 
@@ -53,7 +72,40 @@
 
 static void
 soup_hsts_enforcer_db_init (SoupHSTSEnforcerDB *db)
+{
+        SoupHSTSEnforcerDBPrivate *priv = soup_hsts_enforcer_db_get_instance_private (db);
+
+	priv->stored = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+}
+
+static void
+remember_stored (SoupHSTSEnforcerDBPrivate *priv, const char *host,
+		 gint64 expiry, gboolean include_subdomains)
+{
+	StoredPolicy *stored = g_new (StoredPolicy, 1);
+
+	stored->expiry = expiry;
+	stored->include_subdomains = include_subdomains;
+	g_hash_table_replace (priv->stored, g_strdup (host), stored);
+}
+
+/* TRUE when the database's row for the policy's host differs from it by
+ * more than an expiry refresh. */
+static gboolean
+should_store (SoupHSTSEnforcerDBPrivate *priv, SoupHSTSPolicy *policy, gint64 expiry)
 {
+	StoredPolicy *stored = g_hash_table_lookup (priv->stored, soup_hsts_policy_get_domain (policy));
+	gint64 slack = STORE_EXPIRY_SLACK_SECONDS;
+	gint64 delta;
+
+	if (!stored)
+		return TRUE;
+	if (!stored->include_subdomains != !soup_hsts_policy_includes_subdomains (policy))
+		return TRUE;
+	if ((gint64)(soup_hsts_policy_get_max_age (policy) / 2) < slack)
+		slack = (gint64)(soup_hsts_policy_get_max_age (policy) / 2);
+	delta = expiry - stored->expiry;
+	return delta > slack || delta < -slack;
 }
 
