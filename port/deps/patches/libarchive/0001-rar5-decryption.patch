+#define RAR_CRYPTO_OPENSSL 1
+#include <openssl/evp.h>
+#endif
+
+void
+__archive_rar_wipe(void *p, size_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+
+	while (n--)
+		*v++ = 0;
+}
+
+#ifdef RAR_CRYPTO_OPENSSL
+
+struct rar_aes {
+	EVP_CIPHER_CTX *ctx;
+};
+
+int
+__archive_rar_crypto_available(void)
+{
+	return 1;
+}
+
+struct rar_aes *
+__archive_rar_aes_new(void)
+{
+	struct rar_aes *c = calloc(1, sizeof(*c));
+
+	if (c == NULL)
+		return NULL;
+	c->ctx = EVP_CIPHER_CTX_new();
+	if (c->ctx == NULL) {
+		free(c);
+		return NULL;
+	}
+	return c;
+}
+
+void
+__archive_rar_aes_free(struct rar_aes *c)
+{
+	if (c == NULL)
+		return;
+	EVP_CIPHER_CTX_free(c->ctx);
+	free(c);
+}
+
+int
+__archive_rar_aes_init(struct rar_aes *c, const uint8_t *key,
+    unsigned key_bits, const uint8_t iv[RAR_AES_BLOCK])
+{
+	const EVP_CIPHER *cipher = key_bits == 256 ? EVP_aes_256_cbc()
+	    : key_bits == 128 ? EVP_aes_128_cbc() : NULL;
+
+	if (c == NULL || cipher == NULL ||
+	    EVP_CIPHER_CTX_reset(c->ctx) != 1 ||
+	    EVP_DecryptInit_ex(c->ctx, cipher, NULL, key, iv) != 1 ||
+	    EVP_CIPHER_CTX_set_padding(c->ctx, 0) != 1)
+		return -1;
+	return 0;
+}
+
+int
+__archive_rar_aes_decrypt(struct rar_aes *c, const uint8_t *in,
+    uint8_t *out, size_t length)
+{
+	if (length % RAR_AES_BLOCK)
+		return -1;
+	while (length) {
+		/* EVP takes an int; padding is off, so it returns every
+		 * whole block at once. */
+		int n = length > (1u << 30) ? (1 << 30) : (int)length, got = 0;
+
+		if (EVP_DecryptUpdate(c->ctx, out, &got, in, n) != 1 ||
+		    got != n)
+			return -1;
+		in += n;
+		out += n;
+		length -= n;
+	}
+	return 0;
+}
+
+int
+__archive_rar_sha256(const void *data, size_t length, uint8_t out[32])
+{
+	unsigned int n = 0;
+
+	return EVP_Digest(data, length, out, &n, EVP_sha256(), NULL) == 1 &&
+	    n == 32 ? 0 : -1;
+}
+
+/* HMAC-SHA256 with the key's padded blocks hashed once (PBKDF2 runs it
+ * 2^15 times and more with one key). */
+struct hmac {
+	EVP_MD_CTX *inner, *outer, *work;
+};
+
+static void
+hmac_free(struct hmac *h)
+{
+	EVP_MD_CTX_free(h->inner);
+	EVP_MD_CTX_free(h->outer);
+	EVP_MD_CTX_free(h->work);
+}
+
+static int
+hmac_init(struct hmac *h, const void *key, size_t key_length)
+{
+	uint8_t hashed[32], pad[64];
+	size_t i;
+	int ok;
+
+	h->inner = EVP_MD_CTX_new();
+	h->outer = EVP_MD_CTX_new();
+	h->work = EVP_MD_CTX_new();
+	if (h->inner == NULL || h->outer == NULL || h->work == NULL)
+		return -1;
+	if (key_length > 64) {
+		if (__archive_rar_sha256(key, key_length, hashed))
+			return -1;
+		key = hashed;
+		key_length = 32;
+	}
+	for (i = 0; i < 64; i++)
+		pad[i] = (i < key_length ? ((const uint8_t *)key)[i] : 0) ^ 0x36;
+	ok = EVP_DigestInit_ex(h->inner, EVP_sha256(), NULL) == 1 &&
+	    EVP_DigestUpdate(h->inner, pad, 64) == 1;
+	for (i = 0; i < 64; i++)
+		pad[i] ^= 0x36 ^ 0x5c;
+	ok = ok && EVP_DigestInit_ex(h->outer, EVP_sha256(), NULL) == 1 &&
+	    EVP_DigestUpdate(h->outer, pad, 64) == 1;
+	__archive_rar_wipe(pad, sizeof(pad));
+	__archive_rar_wipe(hashed, sizeof(hashed));
+	return ok ? 0 : -1;
+}
+
+static int
+hmac_run(struct hmac *h, const void *data, size_t length, uint8_t out[32])
+{
+	uint8_t inner[32];
+	unsigned int n = 0;
+	int ok;
+
+	ok = EVP_MD_CTX_copy_ex(h->work, h->inner) == 1 &&
+	    EVP_DigestUpdate(h->work, data, length) == 1 &&
+	    EVP_DigestFinal_ex(h->work, inner, &n) == 1 && n == 32 &&
+	    EVP_MD_CTX_copy_ex(h->work, h->outer) == 1 &&
+	    EVP_DigestUpdate(h->work, inner, 32) == 1 &&
+	    EVP_DigestFinal_ex(h->work, out, &n) == 1 && n == 32;
+	return ok ? 0 : -1;
+}
+
+int
+__archive_rar_hmac_sha256(const void *key, size_t key_length,
+    const void *data, size_t length, uint8_t out[32])
+{
+	struct hmac h;
+	int r;
+
+	memset(&h, 0, sizeof(h));
+	r = hmac_init(&h, key, key_length) || hmac_run(&h, data, length, out)
+	    ? -1 : 0;
+	hmac_free(&h);
+	return r;
+}
+
+int
+__archive_rar5_kdf(const char *password, size_t password_length,
+    const uint8_t salt[16], unsigned lg2, uint8_t key[32],
+    uint8_t hash_key[32], uint8_t check[8])
+{
+	/* One PBKDF2 chain: the key after 2^lg2 rounds, then 16 more for the
+	 * hash key and 16 more for the password check. */
+	uint8_t block[20], u[32], fn[32], extra[32];
+	uint8_t *out[3];
+	uint32_t rounds[3];
+	struct hmac h;
+	unsigned i, j, k;
+	int r = -1;
+
+	if (lg2 > RAR5_KDF_LG2_MAX)
+		return -1;
+	memset(&h, 0, sizeof(h));
+	out[0] = key;
+	out[1] = hash_key;
+	out[2] = extra;
+	rounds[0] = (1u << lg2) - 1;
+	rounds[1] = 16;
+	rounds[2] = 16;
+	memcpy(block, salt, 16);
+	block[16] = 0;
+	block[17] = 0;
+	block[18] = 0;
+	block[19] = 1;
+	if (hmac_init(&h, password, password_length) ||
+	    hmac_run(&h, block, sizeof(block), u))
+		goto done;
+	memcpy(fn, u, 32);
+	for (i = 0; i < 3; i++) {
+		for (j = 0; j < rounds[i]; j++) {
+			if (hmac_run(&h, u, 32, u))
+				goto done;
+			for (k = 0; k < 32; k++)
+				fn[k] ^= u[k];
+		}
+		memcpy(out[i], fn, 32);
+	}
+	memset(check, 0, 8);
+	for (k = 0; k < 32; k++)
+		check[k % 8] ^= extra[k];
+	r = 0;
+done:
+	hmac_free(&h);
+	__archive_rar_wipe(u, sizeof(u));
+	__archive_rar_wipe(fn, sizeof(fn));
+	__archive_rar_wipe(extra, sizeof(extra));
+	return r;
+}
+
+#else /* no crypto library */
+
+int
+__archive_rar_crypto_available(void)
+{
+	return 0;
+}
+
+struct rar_aes *
+__archive_rar_aes_new(void)
+{
+	return NULL;
+}
+
+void
+__archive_rar_aes_free(struct rar_aes *c)
+{
+	(void)c;
+}
+
+int
+__archive_rar_aes_init(struct rar_aes *c, const uint8_t *key,
+    unsigned key_bits, const uint8_t iv[RAR_AES_BLOCK])
+{
+	(void)c; (void)key; (void)key_bits; (void)iv;
+	return -1;
+}
+
+int
+__archive_rar_aes_decrypt(struct rar_aes *c, const uint8_t *in,
+    uint8_t *out, size_t length)
+{
+	(void)c; (void)in; (void)out; (void)length;
+	return -1;
+}
+
+int
+__archive_rar_sha256(const void *data, size_t length, uint8_t out[32])
+{
+	(void)data; (void)length; (void)out;
+	return -1;
+}
+
+int
+__archive_rar_hmac_sha256(const void *key, size_t key_length,
+    const void *data, size_t length, uint8_t out[32])
+{
+	(void)key; (void)key_length; (void)data; (void)length; (void)out;
+	return -1;
+}
+
+int
+__archive_rar5_kdf(const char *password, size_t password_length,
+    const uint8_t salt[16], unsigned lg2, uint8_t key[32],
+    uint8_t hash_key[32], uint8_t check[8])
+{
+	(void)password; (void)password_length; (void)salt; (void)lg2;
+	(void)key; (void)hash_key; (void)check;
+	return -1;
+}
