+/* With encrypted headers: decrypts the next one (IV, then the header
+ * padded to 16 bytes) into hbuf, which then serves read_ahead()/consume(). */
+static int read_encrypted_header(struct archive_read* a, struct rar5* rar) {
+	struct rar5_crypt* c = &rar->crypt;
+	uint8_t first[16];
+	uint64_t size = 0;
+	size_t total, i, shift;
+	const uint8_t* p;
+
+	p = __archive_read_ahead(a, 32, NULL);
+	if(p == NULL)
+		return ARCHIVE_EOF;
+	if(__archive_rar_aes_init(c->haes, c->header_key, 256, p) ||
+	    __archive_rar_aes_decrypt(c->haes, p + 16, first, 16)) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Can't decrypt a header");
+		return ARCHIVE_FATAL;
+	}
+
+	/* CRC32, then the header size (up to 2 MB: at most 3 bytes). */
+	for(i = 4, shift = 0; i < 16; i++, shift += 7) {
+		size |= (uint64_t) (first[i] & 0x7F) << shift;
+		if(!(first[i] & 0x80))
+			break;
