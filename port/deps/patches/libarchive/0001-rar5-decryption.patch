+/*
+ * SHA-1 as RAR 2.9 and 3.x compute it for their key: when a whole 64-byte
+ * block is hashed straight from the caller's data (not through the
+ * context's buffer), the block's final 16 message schedule words are
+ * written back over it, little-endian. The key derivation hashes the same
+ * buffer 2^18 times, so passwords of 29 characters and more depend on it.
+ */
+struct rar_sha1 {
+	uint32_t state[5];
+	uint64_t count;
+	uint8_t buffer[64];
+};
+
+#define ROL32(v, n) (((v) << (n)) | ((v) >> (32 - (n))))
+
+static void
+sha1_block(uint32_t state[5], uint32_t w[16], const uint8_t *data)
+{
+	uint32_t a = state[0], b = state[1], c = state[2], d = state[3];
+	uint32_t e = state[4], f, k, t;
+	unsigned i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = (uint32_t)data[4 * i] << 24 |
+		    (uint32_t)data[4 * i + 1] << 16 |
+		    (uint32_t)data[4 * i + 2] << 8 | data[4 * i + 3];
+	for (i = 0; i < 80; i++) {
+		if (i >= 16)
+			w[i & 15] = ROL32(w[(i + 13) & 15] ^ w[(i + 8) & 15] ^
+			    w[(i + 2) & 15] ^ w[i & 15], 1);
+		if (i < 20) {
+			f = (b & (c ^ d)) ^ d;
+			k = 0x5A827999;
+		} else if (i < 40) {
+			f = b ^ c ^ d;
+			k = 0x6ED9EBA1;
+		} else if (i < 60) {
+			f = ((b | c) & d) | (b & c);
+			k = 0x8F1BBCDC;
+		} else {
+			f = b ^ c ^ d;
+			k = 0xCA62C1D6;
+		}
+		t = ROL32(a, 5) + f + e + k + w[i & 15];
+		e = d;
+		d = c;
+		c = ROL32(b, 30);
+		b = a;
+		a = t;
+	}
+	state[0] += a;
+	state[1] += b;
+	state[2] += c;
+	state[3] += d;
+	state[4] += e;
+}
+
+static void
+sha1_init(struct rar_sha1 *s)
+{
+	s->count = 0;
+	s->state[0] = 0x67452301;
+	s->state[1] = 0xEFCDAB89;
+	s->state[2] = 0x98BADCFE;
+	s->state[3] = 0x10325476;
+	s->state[4] = 0xC3D2E1F0;
+}
+
+/* quirk: write the schedule back into whole blocks taken from data. */
+static void
+sha1_update(struct rar_sha1 *s, uint8_t *data, size_t length, int quirk)
+{
+	size_t i = 0, j = (size_t)(s->count & 63), k;
+	uint32_t w[16];
+
+	s->count += length;
+	if (j + length > 63) {
+		i = 64 - j;
+		memcpy(s->buffer + j, data, i);
+		sha1_block(s->state, w, s->buffer);
+		for (; i + 63 < length; i += 64) {
+			sha1_block(s->state, w, data + i);
+			if (quirk)
+				for (k = 0; k < 16; k++) {
+					data[i + 4 * k] = (uint8_t)w[k];
+					data[i + 4 * k + 1] = (uint8_t)(w[k] >> 8);
+					data[i + 4 * k + 2] = (uint8_t)(w[k] >> 16);
+					data[i + 4 * k + 3] = (uint8_t)(w[k] >> 24);
+				}
+		}
+		j = 0;
+	}
+	if (length > i)
+		memcpy(s->buffer + j, data + i, length - i);
+	__archive_rar_wipe(w, sizeof(w));
+}
+
+static void
+sha1_final(const struct rar_sha1 *in, uint32_t digest[5])
+{
+	struct rar_sha1 s = *in;
+	uint8_t pad[72];
+	uint64_t bits = s.count * 8;
+	size_t n = 64 - (size_t)(s.count & 63), i;
+
+	if (n < 9)
+		n += 64;
+	memset(pad, 0, sizeof(pad));
+	pad[0] = 0x80;
+	for (i = 0; i < 8; i++)
+		pad[n - 1 - i] = (uint8_t)(bits >> (8 * i));
+	sha1_update(&s, pad, n, 0);
+	memcpy(digest, s.state, sizeof(s.state));
+	__archive_rar_wipe(&s, sizeof(s));
+}
+
+void
+__archive_rar3_kdf(const uint8_t *password_utf16le, size_t length,
+    const uint8_t *salt, uint8_t key[16], uint8_t iv[16])
+{
+	enum { ROUNDS = 0x40000 };
+	uint8_t raw[2 * 128 + 8], number[3];
+	uint32_t digest[5];
+	struct rar_sha1 s;
+	size_t n;
+	unsigned i, j;
+
+	if (length > 2 * 128)
+		length = 2 * 128;
+	memcpy(raw, password_utf16le, length);
+	n = length;
+	if (salt != NULL) {
+		memcpy(raw + n, salt, 8);
+		n += 8;
+	}
+	sha1_init(&s);
+	for (i = 0; i < ROUNDS; i++) {
+		sha1_update(&s, raw, n, 1);
+		number[0] = (uint8_t)i;
+		number[1] = (uint8_t)(i >> 8);
+		number[2] = (uint8_t)(i >> 16);
+		sha1_update(&s, number, 3, 0);
+		if (i % (ROUNDS / 16) == 0) {
+			sha1_final(&s, digest);
+			iv[i / (ROUNDS / 16)] = (uint8_t)digest[4];
+		}
+	}
+	sha1_final(&s, digest);
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 4; j++)
+			key[i * 4 + j] = (uint8_t)(digest[i] >> (j * 8));
+	__archive_rar_wipe(raw, sizeof(raw));
+	__archive_rar_wipe(digest, sizeof(digest));
+	__archive_rar_wipe(&s, sizeof(s));
+}
