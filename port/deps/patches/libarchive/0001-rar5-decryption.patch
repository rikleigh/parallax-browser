+	if(c->raw_left > 0) {
+		const uint8_t* p = __archive_read_ahead(a,
+		    (size_t) c->raw_left, NULL);
+		if(p == NULL)
+			return ARCHIVE_FATAL;
+		memcpy(c->carry + c->carry_len, p, (size_t) c->raw_left);
+		c->carry_len += (size_t) c->raw_left;
+		__archive_read_consume(a, c->raw_left);
+		c->raw_done += c->raw_left;
+		c->raw_left = 0;
+	}
