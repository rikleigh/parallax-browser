+		return ret;
+
+	if(c->aes == NULL)
+		c->aes = __archive_rar_aes_new();
+	if(c->aes == NULL ||
+	    __archive_rar_aes_init(c->aes, key, 256, c->iv)) {
+		__archive_rar_wipe(key, sizeof(key));
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't set up decryption");
+		return ARCHIVE_FATAL;
+	}
+
+	__archive_rar_wipe(key, sizeof(key));
+	c->keyed = 1;
+	return ARCHIVE_OK;
