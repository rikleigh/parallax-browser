+/* Tries the passphrases (archive_read_add_passphrase, or the callback)
+ * against a check value, or takes the first without one. ARCHIVE_OK with
+ * key and hash_key set; ARCHIVE_FAILED with the error set: none given, or
+ * none right; ARCHIVE_FATAL: no crypto, no memory. */
+static int rar5_find_key(struct archive_read* a, struct rar5* rar,
+    const uint8_t salt[16], unsigned lg2, int has_check,
+    const uint8_t want[8], uint8_t key[32], uint8_t hash_key[32])
+{
+	const char* password;
+	uint8_t check[8];
+	int tried = 0;
+
+	if(!__archive_rar_crypto_available()) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Decryption is not supported: this libarchive has no "
+		    "crypto library");
+		return ARCHIVE_FATAL;
+	}
+
+	__archive_read_reset_passphrase(a);
+	while((password = __archive_read_next_passphrase(a)) != NULL) {
+		tried++;
+		if(rar5_derive(rar, password, salt, lg2, key, hash_key,
+		    check)) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "Can't derive the decryption key");
+			return ARCHIVE_FATAL;
+		}
+		if(!has_check || !memcmp(check, want, 8))
+			return ARCHIVE_OK;
+	}
+
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, tried
+	    ? "Incorrect passphrase" : "Passphrase required for this entry");
+	return ARCHIVE_FAILED;
+}
