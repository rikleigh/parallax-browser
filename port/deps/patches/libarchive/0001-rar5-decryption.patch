+/* A file header's encryption record. */
+static int parse_file_extra_crypt(struct archive_read* a, struct rar5* rar,
+    int64_t* extra_data_size, uint64_t field_size)
+{
+	struct rar5_crypt* c = &rar->crypt;
+	uint64_t version = 0, flags = 0, len = 0, used = 0;
+	uint8_t sum[32];
+	const uint8_t* p;
+	size_t need;
+
+	enum { CRYPT_PSWCHECK = 0x01, CRYPT_HASHMAC = 0x02 };
+
+	if(!read_var(a, &version, &len) || ARCHIVE_OK != consume(a, len))
+		return ARCHIVE_EOF;
+	used += len;
+	if(!read_var(a, &flags, &len) || ARCHIVE_OK != consume(a, len))
+		return ARCHIVE_EOF;
+	used += len;
+
+	if(version != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Unsupported encryption version (%ju)",
+		    (uintmax_t) version);
+		return ARCHIVE_FATAL;
+	}
+
+	need = 1 + 16 + 16 + ((flags & CRYPT_PSWCHECK) ? 12 : 0);
+	if(used + need > field_size) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Truncated encryption record");
+		return ARCHIVE_FATAL;
+	}
+	if(!read_ahead(a, need, &p))
+		return ARCHIVE_EOF;
+
+	if(!c->service) {
+		if(p[0] > RAR5_KDF_LG2_MAX) {
+			archive_set_error(&a->archive,
+			    ARCHIVE_ERRNO_FILE_FORMAT,
+			    "Unsupported key derivation count (2^%u)",
+			    (unsigned) p[0]);
+			return ARCHIVE_FATAL;
+		}
+		c->file = 1;
+		c->lg2 = p[0];
+		memcpy(c->salt, p + 1, 16);
+		memcpy(c->iv, p + 17, 16);
+		c->mac = (flags & CRYPT_HASHMAC) != 0;
+		c->has_check = 0;
+		if(flags & CRYPT_PSWCHECK) {
+			/* Use the check value only when its own checksum
+			 * holds (a damaged one would refuse a right
+			 * password). */
+			memcpy(c->check, p + 33, 8);
+			c->has_check =
+			    !__archive_rar_sha256(c->check, 8, sum) &&
+			    !memcmp(sum, p + 41, 4);
+		}
+	}
+
+	if(ARCHIVE_OK != consume(a, need))
+		return ARCHIVE_EOF;
+	used += need;
+
+	/* Anything a later version adds to the record. */
+	if(field_size > used && ARCHIVE_OK != consume(a, field_size - used))
+		return ARCHIVE_EOF;
+
+	*extra_data_size -= field_size;
+	return ARCHIVE_OK;
+}
