+/* The archive encryption header (rar -hp): every header after it in this
+ * volume is encrypted. */
+static int process_head_crypt(struct archive_read* a, struct rar5* rar,
+    struct archive_entry* entry)
+{
+	struct rar5_crypt* c = &rar->crypt;
+	uint64_t version = 0, flags = 0;
+	uint8_t hash_key[32], salt[16], check[8], sum[32];
+	const uint8_t* p;
+	unsigned lg2;
+	int has_check = 0, ret;
+
+	archive_entry_set_is_metadata_encrypted(entry, 1);
+	archive_entry_set_is_data_encrypted(entry, 1);
+	rar->has_encrypted_entries = 1;
+	rar->headers_are_encrypted = 1;
+
+	if(!read_var(a, &version, NULL) || !read_var(a, &flags, NULL))
+		return ARCHIVE_EOF;
+	if(version != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Unsupported encryption version (%ju)",
+		    (uintmax_t) version);
+		return ARCHIVE_FATAL;
+	}
+
+	if(!read_ahead(a, 1 + 16 + ((flags & 1) ? 12 : 0), &p))
+		return ARCHIVE_EOF;
+	lg2 = p[0];
+	if(lg2 > RAR5_KDF_LG2_MAX) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Unsupported key derivation count (2^%u)", lg2);
+		return ARCHIVE_FATAL;
+	}
+	memcpy(salt, p + 1, 16);
+	if(flags & 1) {
+		memcpy(check, p + 17, 8);
+		has_check = !__archive_rar_sha256(check, 8, sum) &&
+		    !memcmp(sum, p + 25, 4);
+	}
+	if(ARCHIVE_OK != consume(a, 1 + 16 + ((flags & 1) ? 12 : 0)))
+		return ARCHIVE_EOF;
+
+	ret = rar5_find_key(a, rar, salt, lg2, has_check, check,
+	    c->header_key, hash_key);
+	__archive_rar_wipe(hash_key, sizeof(hash_key));
+	if(ret != ARCHIVE_OK)
+		return ARCHIVE_FATAL;
+
+	if(c->haes == NULL)
+		c->haes = __archive_rar_aes_new();
+	if(c->haes == NULL) {
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't set up decryption");
+		return ARCHIVE_FATAL;
+	}
+
+	c->headers = 1;
+	return ARCHIVE_OK;
+}
