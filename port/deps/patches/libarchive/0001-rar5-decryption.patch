+/*
+ * Decryption for the RAR readers: AES in CBC mode, SHA-256 and HMAC-SHA256
+ * (OpenSSL's EVP), and the two RAR key derivations: RAR5's PBKDF2-HMAC-SHA256
+ * with its two extra values, and RAR 3.x's 2^18 rounds of SHA-1 (with the
+ * quirk of RAR 2.9/3.x's SHA-1, which writes its message schedule back into
+ * the data it hashes).
+ */
+
+#ifndef ARCHIVE_RAR_CRYPTO_PRIVATE_H_INCLUDED
+#define ARCHIVE_RAR_CRYPTO_PRIVATE_H_INCLUDED
+
+#ifndef __LIBARCHIVE_BUILD
+#error This header is only to be used internally to libarchive.
+#endif
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define RAR_AES_BLOCK 16
+#define RAR5_KDF_LG2_MAX 24
+
+struct rar_aes;
+
+/* 1 when this libarchive was built with a crypto library, else 0 (and
+ * every function below fails). */
+int __archive_rar_crypto_available(void);
+
+/* A decryptor; NULL without memory or crypto. */
+struct rar_aes *__archive_rar_aes_new(void);
+void __archive_rar_aes_free(struct rar_aes *);
+/* key_bits 128 or 256. 0, or -1. */
+int __archive_rar_aes_init(struct rar_aes *, const uint8_t *key,
+    unsigned key_bits, const uint8_t iv[RAR_AES_BLOCK]);
+/* length a multiple of 16; in and out the same or apart. Chains on from
+ * the last call. 0, or -1. */
+int __archive_rar_aes_decrypt(struct rar_aes *, const uint8_t *in,
+    uint8_t *out, size_t length);
+
+/* 0, or -1. */
+int __archive_rar_sha256(const void *data, size_t length, uint8_t out[32]);
+int __archive_rar_hmac_sha256(const void *key, size_t key_length,
+    const void *data, size_t length, uint8_t out[32]);
+
+/* RAR5: key from PBKDF2-HMAC-SHA256(password, salt, 2^lg2), hash_key the
+ * same after 16 more rounds, check the 8-byte password check folded from
+ * the value after 16 more. 0, or -1 (lg2 over RAR5_KDF_LG2_MAX, no
+ * crypto). */
+int __archive_rar5_kdf(const char *password, size_t password_length,
+    const uint8_t salt[16], unsigned lg2, uint8_t key[32],
+    uint8_t hash_key[32], uint8_t check[8]);
+
+/* RAR 3.x (RAR4 archives): AES-128 key and IV from the password as
+ * UTF-16LE and the 8-byte salt (NULL: none). */
