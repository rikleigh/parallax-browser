+/* Key, hash key and check for a password, salt and count: derived once
+ * (RAR uses one salt for a whole archive). 0, or -1. */
+static int rar5_derive(struct rar5* rar, const char* password,
+    const uint8_t salt[16], unsigned lg2, uint8_t key[32],
+    uint8_t hash_key[32], uint8_t check[8])
+{
+	struct rar5_crypt* c = &rar->crypt;
+	struct rar5_kdf_cache* k;
+	uint8_t id[32];
+	size_t length = strlen(password);
+	int i;
+
+	if(__archive_rar_sha256(password, length, id))
+		return -1;
+
+	for(i = 0; i < RAR5_KDF_CACHE; i++) {
+		k = &c->kdf[i];
+		if(k->used && k->lg2 == lg2 && !memcmp(k->salt, salt, 16) &&
+		    !memcmp(k->password, id, 32)) {
+			memcpy(key, k->key, 32);
+			memcpy(hash_key, k->hash_key, 32);
+			memcpy(check, k->check, 8);
+			return 0;
+		}
+	}
+
+	if(__archive_rar5_kdf(password, length, salt, lg2, key, hash_key,
+	    check))
+		return -1;
+
+	k = &c->kdf[c->kdf_next++ % RAR5_KDF_CACHE];
+	k->used = 1;
+	k->lg2 = (uint8_t) lg2;
+	memcpy(k->salt, salt, 16);
+	memcpy(k->password, id, 32);
+	memcpy(k->key, key, 32);
+	memcpy(k->hash_key, hash_key, 32);
+	memcpy(k->check, check, 8);
+	return 0;
+}
