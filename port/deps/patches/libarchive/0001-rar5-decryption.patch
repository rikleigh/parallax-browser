+
+static int dview_consume(struct archive_read* a, struct rar5* rar,
+    int64_t how_many)
+{
+	struct rar5_crypt* c = &rar->crypt;
+	uint64_t n = (uint64_t) how_many, have = c->dlen - c->dpos, rest;
+
+	if(how_many < 0)
+		return ARCHIVE_FATAL;
+
+	if(n <= have) {
+		c->dpos += (size_t) n;
+		return dview_settle(a, rar);
+	}
+
+	n -= have;
+	c->dpos = c->dlen;
+	rest = ((c->carry_len + c->raw_left) / 16) * 16;
+	if(n > rest)
+		return ARCHIVE_FATAL;
+
+	if(n == rest) {
+		/* All of it (skipping a file): drop the cipher text without
+		 * decrypting it. Its stream can't be decrypted after this. */
+		if(c->raw_left > 0 &&
+		    __archive_read_consume(a, c->raw_left) != c->raw_left)
+			return ARCHIVE_FATAL;
+		c->raw_done += c->raw_left;
+		c->carry_len = (size_t) ((c->carry_len + c->raw_left) % 16);
+		c->raw_left = 0;
+		c->broken = 1;
+		c->dactive = 0;
+		return ARCHIVE_OK;
+	}
