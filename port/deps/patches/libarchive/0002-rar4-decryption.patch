+  struct rar4_crypt {
+    char headers;             /* the headers are encrypted (this volume) */
+    char *password;           /* the one that decrypts them */
+    struct rar_aes *haes, *aes;
+    char hactive;
+    uint8_t *hbuf, *combo;
+    size_t hcap, combocap, hlen, hpos;
+    char file;                /* this file's data is encrypted */
+    char old;                 /* ... with RAR 1.5/2.0's cipher: not read */
+    char keyed, broken;
+    char dactive;
+    int64_t raw_left, raw_done;
+    uint8_t carry[16];
+    size_t carry_len;
+    uint8_t *dbuf;
+    size_t dcap, dlen, dpos;
+    struct rar4_kdf {
