@@ -455,6 +487,471 @@
 static inline void vm_write_32(struct rar_virtual_machine*, size_t, uint32_t);
 static inline uint32_t vm_read_32(struct rar_virtual_machine*, size_t);
 
+/* ---- decryption (ps5webkit) ---- */
+
+#define RAR4_SLACK 64
+#ifndef RAR4_CHUNK
+#define RAR4_CHUNK (64 * 1024) /* decrypted at a time */
+#endif
+
+static struct rar *
+rar4_state(struct archive_read *a)
+{
+  return a->format ? (struct rar *)a->format->data : NULL;
+}
+
+/* Decrypts this volume's cipher text until want bytes of plain text are
+ * in dbuf (or there is no more in this volume). 1, or 0. */
+static int
+rar4_fill(struct archive_read *a, struct rar *rar, size_t want)
+{
+  struct rar4_crypt *c = &rar->crypt;
+  size_t have = c->dlen - c->dpos;
+
+  if (have >= want)
+    return 1;
+  if (!c->keyed || c->broken || want > SIZE_MAX - 2 * RAR4_CHUNK)
+    return 0;
+  if (c->dpos > 0) {
+    memmove(c->dbuf, c->dbuf + c->dpos, have);
+    c->dlen = have;
+    c->dpos = 0;
+  }
+  if (c->dcap < want + RAR4_CHUNK + RAR4_SLACK) {
+    size_t cap = want + RAR4_CHUNK + RAR4_SLACK;
+    uint8_t *d = realloc(c->dbuf, cap);
+    if (d == NULL)
+      return 0;
+    c->dbuf = d;
+    c->dcap = cap;
+  }
+  while (c->dlen < want && c->raw_left > 0) {
+    size_t space = ((c->dcap - RAR4_SLACK - c->dlen) / 16) * 16;
+    size_t t = space - c->carry_len, used = 0, whole;
+    ssize_t avail = 0;
+    const uint8_t *p;
+
+    if ((int64_t)t > c->raw_left)
+      t = (size_t)c->raw_left;
+    p = __archive_read_ahead(a, t, &avail);
+    if (p == NULL) {
+      if (avail <= 0)
+        return 0;
+      t = (size_t)avail;
+      if ((p = __archive_read_ahead(a, t, &avail)) == NULL)
+        return 0;
+    }
+    if (c->carry_len > 0) {
+      size_t n = 16 - c->carry_len;
+      if (n > t)
+        n = t;
+      memcpy(c->carry + c->carry_len, p, n);
+      c->carry_len += n;
+      used = n;
+      if (c->carry_len == 16) {
+        if (__archive_rar_aes_decrypt(c->aes, c->carry, c->dbuf + c->dlen, 16))
+          return 0;
+        c->dlen += 16;
+        c->carry_len = 0;
+      }
+    }
+    whole = ((t - used) / 16) * 16;
+    if (whole > 0) {
+      if (__archive_rar_aes_decrypt(c->aes, p + used, c->dbuf + c->dlen, whole))
+        return 0;
+      c->dlen += whole;
+      used += whole;
+    }
+    if (t > used) {
+      memcpy(c->carry + c->carry_len, p + used, t - used);
+      c->carry_len += t - used;
+    }
+    __archive_read_consume(a, t);
+    c->raw_left -= t;
+    c->raw_done += t;
+  }
+  memset(c->dbuf + c->dlen, 0, RAR4_SLACK);
+  return c->dlen - c->dpos >= want;
+}
+
+/* No whole block left in this volume: its last bytes wait in carry for the
+ * next volume, and reads go back to the raw stream. */
+static int
+rar4_settle(struct archive_read *a, struct rar *rar)
+{
+  struct rar4_crypt *c = &rar->crypt;
+
+  if (!c->dactive || c->dpos < c->dlen || (int64_t)c->carry_len + c->raw_left >= 16)
+    return 0;
+  if (c->raw_left > 0) {
+    const uint8_t *p = __archive_read_ahead(a, (size_t)c->raw_left, NULL);
+    if (p == NULL)
+      return -1;
+    memcpy(c->carry + c->carry_len, p, (size_t)c->raw_left);
+    c->carry_len += (size_t)c->raw_left;
+    __archive_read_consume(a, c->raw_left);
+    c->raw_done += c->raw_left;
+    c->raw_left = 0;
+  }
+  c->dactive = 0;
+  return 0;
+}
+
+static const void *
+rar4_ahead(struct archive_read *a, size_t min, ssize_t *avail)
+{
+  struct rar *rar = rar4_state(a);
+  struct rar4_crypt *c;
+
+  if (rar == NULL || (!rar->crypt.hactive && !rar->crypt.dactive))
+    return __archive_read_ahead(a, min, avail);
+  c = &rar->crypt;
+  if (c->hactive) {
+    size_t have = c->hlen - c->hpos;
+    ssize_t ravail = 0;
+    const uint8_t *r;
+
+    if (min <= have) {
+      if (avail)
+        *avail = (ssize_t)have;
+      return c->hbuf + c->hpos;
+    }
+    /* Past the header: its data follows in the raw stream. */
+    r = __archive_read_ahead(a, min - have, &ravail);
+    if (r == NULL || c->combocap < min) {
+      uint8_t *b = r ? realloc(c->combo, min) : NULL;
+      if (b == NULL) {
+        if (avail)
+          *avail = (ssize_t)have + (ravail > 0 ? ravail : 0);
+        return NULL;
+      }
+      c->combo = b;
+      c->combocap = min;
+    }
+    memcpy(c->combo, c->hbuf + c->hpos, have);
+    memcpy(c->combo + have, r, min - have);
+    if (avail)
+      *avail = (ssize_t)min;
+    return c->combo;
+  }
+  if (!rar4_fill(a, rar, min ? min : 1) && c->dlen - c->dpos < min) {
+    if (avail)
+      *avail = (ssize_t)(c->dlen - c->dpos);
+    return NULL;
+  }
+  if (avail)
+    *avail = (ssize_t)(c->dlen - c->dpos);
+  return c->dbuf + c->dpos;
+}
+
+static int64_t
+rar4_consume(struct archive_read *a, int64_t n)
+{
+  struct rar *rar = rar4_state(a);
+  struct rar4_crypt *c;
+  int64_t r;
+
+  if (rar == NULL || (!rar->crypt.hactive && !rar->crypt.dactive) || n < 0)
+    return __archive_read_consume(a, n);
+  c = &rar->crypt;
+  if (c->hactive) {
+    size_t have = c->hlen - c->hpos;
+    if ((uint64_t)n <= have) {
+      c->hpos += (size_t)n;
+      if (c->hpos == c->hlen)
+        c->hactive = 0;
+      return n;
+    }
+    c->hpos = c->hlen;
+    c->hactive = 0;
+    r = __archive_read_consume(a, n - (int64_t)have);
+    return r < 0 ? r : (int64_t)have + r;
+  } else {
+    uint64_t have = c->dlen - c->dpos, left = (uint64_t)n, rest;
+
+    if (left <= have) {
+      c->dpos += (size_t)left;
+      return rar4_settle(a, rar) ? -1 : n;
+    }
+    left -= have;
+    c->dpos = c->dlen;
+    rest = (((uint64_t)c->carry_len + (uint64_t)c->raw_left) / 16) * 16;
+    if (left > rest)
+      return -1;
+    if (left == rest) {
+      /* All of it (skipping): the cipher text is dropped undecrypted,
+       * and its stream can't be decrypted after this. */
+      if (c->raw_left > 0 && __archive_read_consume(a, c->raw_left) != c->raw_left)
+        return -1;
+      c->raw_done += c->raw_left;
+      c->carry_len = (size_t)(((int64_t)c->carry_len + c->raw_left) % 16);
+      c->raw_left = 0;
+      c->broken = 1;
+      c->dactive = 0;
+      return n;
+    }
+    while (left > 0) {
+      size_t step = left > RAR4_CHUNK ? RAR4_CHUNK : (size_t)left;
+      if (!rar4_fill(a, rar, step))
+        return -1;
+      c->dpos += step;
+      left -= step;
+    }
+    return rar4_settle(a, rar) ? -1 : n;
+  }
+}
+
+/* The password as RAR 3.x hashes it: UTF-16LE, at most 128 characters. */
+static size_t
+rar4_utf16le(const char *s, uint8_t *out, size_t size)
+{
+  const unsigned char *u = (const unsigned char *)s;
+  size_t n = 0;
+
+  while (*u && n + 4 <= size) {
+    uint32_t cp;
+    int more;
+    if (*u < 0x80) { cp = *u++; more = 0; }
+    else if ((*u & 0xE0) == 0xC0) { cp = *u++ & 0x1F; more = 1; }
+    else if ((*u & 0xF0) == 0xE0) { cp = *u++ & 0x0F; more = 2; }
+    else if ((*u & 0xF8) == 0xF0) { cp = *u++ & 0x07; more = 3; }
+    else { u++; cp = 0xFFFD; more = 0; }
+    while (more-- > 0) {
+      if ((*u & 0xC0) != 0x80) { cp = 0xFFFD; break; }
+      cp = (cp << 6) | (*u++ & 0x3F);
+    }
+    if (cp >= 0x10000) {
+      cp -= 0x10000;
+      out[n++] = (uint8_t)(0xD800 + (cp >> 10));
+      out[n++] = (uint8_t)((0xD800 + (cp >> 10)) >> 8);
+      cp = 0xDC00 + (cp & 0x3FF);
+    }
+    out[n++] = (uint8_t)cp;
+    out[n++] = (uint8_t)(cp >> 8);
+  }
+  return n;
+}
+
+/* Key and IV for a password and salt (NULL: none), derived once. */
+static int
+rar4_derive(struct rar *rar, const char *password, const uint8_t *salt,
+    uint8_t key[16], uint8_t iv[16])
+{
+  struct rar4_crypt *c = &rar->crypt;
+  struct rar4_kdf *k;
+  uint8_t id[32], wide[2 * 128 + 4];
+  size_t n;
+  int i;
+
+  if (__archive_rar_sha256(password, strlen(password), id))
+    return -1;
+  for (i = 0; i < 4; i++) {
+    k = &c->kdf[i];
+    if (k->used && k->salted == (salt != NULL) &&
+        (!salt || !memcmp(k->salt, salt, 8)) && !memcmp(k->password, id, 32)) {
+      memcpy(key, k->key, 16);
+      memcpy(iv, k->iv, 16);
+      return 0;
+    }
+  }
+  n = rar4_utf16le(password, wide, 2 * 128);
+  __archive_rar3_kdf(wide, n, salt, key, iv);
+  __archive_rar_wipe(wide, sizeof(wide));
+  k = &c->kdf[c->kdf_next++ % 4];
+  k->used = 1;
+  k->salted = salt != NULL;
+  if (salt)
+    memcpy(k->salt, salt, 8);
+  memcpy(k->password, id, 32);
+  memcpy(k->key, key, 16);
+  memcpy(k->iv, iv, 16);
+  return 0;
+}
+
+/* One encrypted header with password: ARCHIVE_OK (in hbuf), ARCHIVE_FAILED
+ * (its CRC says it's the wrong one), ARCHIVE_EOF, ARCHIVE_FATAL. */
+static int
+rar4_try_header(struct archive_read *a, struct rar *rar, const char *password,
+    const uint8_t salt[8])
+{
+  struct rar4_crypt *c = &rar->crypt;
+  uint8_t key[16], iv[16], first[16];
+  const uint8_t *p;
+  size_t size, total;
+
+  if (rar4_derive(rar, password, salt, key, iv))
+    return ARCHIVE_FATAL;
+  if ((p = __archive_read_ahead(a, 8 + 16, NULL)) == NULL)
+    return ARCHIVE_EOF;
+  if (__archive_rar_aes_init(c->haes, key, 128, iv) ||
+      __archive_rar_aes_decrypt(c->haes, p + 8, first, 16))
+    return ARCHIVE_FATAL;
+  size = archive_le16dec(first + 5);
+  if (size < 7)
+    return ARCHIVE_FAILED;
+  total = (size + 15) & ~(size_t)15;
+  if (c->hcap < total + RAR4_SLACK) {
+    uint8_t *b = realloc(c->hbuf, total + RAR4_SLACK);
+    if (b == NULL)
+      return ARCHIVE_FATAL;
+    c->hbuf = b;
+    c->hcap = total + RAR4_SLACK;
+  }
+  if ((p = __archive_read_ahead(a, 8 + total, NULL)) == NULL)
+    return ARCHIVE_FAILED; /* a size past the end: most likely the wrong key */
+  if (__archive_rar_aes_init(c->haes, key, 128, iv) ||
+      __archive_rar_aes_decrypt(c->haes, p + 8, c->hbuf, total))
+    return ARCHIVE_FATAL;
+  __archive_rar_wipe(key, sizeof(key));
+  if ((crc32(0, c->hbuf + 2, (unsigned)size - 2) & 0xffff) !=
+      archive_le16dec(c->hbuf))
+    return ARCHIVE_FAILED;
+  memset(c->hbuf + total, 0, RAR4_SLACK);
+  __archive_read_consume(a, 8 + total);
+  c->hlen = size;
+  c->hpos = 0;
+  c->hactive = 1;
+  return ARCHIVE_OK;
+}
+
+/* Before each header of a volume whose headers are encrypted: decrypts it
+ * into hbuf (the next volume's signature ends that). */
+static int
+rar4_next_header(struct archive_read *a, struct rar *rar)
+{
+  struct rar4_crypt *c = &rar->crypt;
+  const char *password;
+  uint8_t salt[8];
+  const uint8_t *p;
+  int ret, tried = 0;
+
+  if (!c->headers || c->hactive)
+    return ARCHIVE_OK;
+  if ((p = __archive_read_ahead(a, 8 + 16, NULL)) == NULL)
+    return ARCHIVE_EOF;
+  if (!memcmp(p, RAR_SIGNATURE, 7)) {
+    c->headers = 0;
+    return ARCHIVE_OK;
+  }
+  memcpy(salt, p, 8);
+  if (c->haes == NULL && (c->haes = __archive_rar_aes_new()) == NULL) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, __archive_rar_crypto_available()
+        ? "Can't set up decryption" : "Decryption is not supported: this libarchive has no crypto library");
+    return ARCHIVE_FATAL;
+  }
+  if (c->password) {
+    ret = rar4_try_header(a, rar, c->password, salt);
+    if (ret == ARCHIVE_FAILED) {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+          "Header CRC error (an incorrect passphrase, or a damaged archive)");
+      return ARCHIVE_FATAL;
+    }
+    return ret;
+  }
+  __archive_read_reset_passphrase(a);
+  while ((password = __archive_read_next_passphrase(a)) != NULL) {
+    tried++;
+    ret = rar4_try_header(a, rar, password, salt);
+    if (ret == ARCHIVE_OK) {
+      if ((c->password = strdup(password)) == NULL) {
+        archive_set_error(&a->archive, ENOMEM, "Out of memory");
+        return ARCHIVE_FATAL;
+      }
+      return ARCHIVE_OK;
+    }
+    if (ret != ARCHIVE_FAILED)
+      return ret;
+  }
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+      tried ? "Incorrect passphrase" : "Passphrase required for this entry");
+  return ARCHIVE_FATAL;
+}
+
+/* A file header is read: its data goes through the plain text view.
+ * continued: this is the next volume's part of the same file. */
+static int
+rar4_start_data(struct archive_read *a, struct rar *rar, int continued,
+    unsigned unp_ver)
+{
+  struct rar4_crypt *c = &rar->crypt;
+  int64_t end, start;
+
+  if (!continued) {
+    c->file = 0;
+    c->keyed = 0;
+    c->broken = 0;
+    c->raw_done = 0;
+    c->carry_len = 0;
+    c->old = 0;
+  }
+  c->dactive = 0;
+  c->dlen = 0;
+  c->dpos = 0;
+  if (!(rar->file_flags & FHD_PASSWORD))
+    return 0;
+  c->file = 1;
+  if (!continued)
+    c->old = unp_ver < 29;
+  end = (c->raw_done + rar->packed_size) & ~(int64_t)15;
+  start = c->raw_done & ~(int64_t)15;
+  c->raw_left = rar->packed_size;
+  c->dactive = rar->packed_size > 0;
+  rar->bytes_remaining = end - start;
+  return rar4_settle(a, rar);
+}
+
+/* Before the file's first read. No check value in RAR 3.x: the password
+ * that opened the headers, else the first one given; a wrong one shows as
+ * a CRC (or decompression) error. */
+static int
+rar4_file_key(struct archive_read *a, struct rar *rar)
+{
+  struct rar4_crypt *c = &rar->crypt;
+  const char *password = c->password;
+  uint8_t key[16], iv[16];
+
+  if (c->keyed)
+    return ARCHIVE_OK;
+  if (c->old) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        "RAR 1.5 and 2.x encryption isn't supported");
+    return ARCHIVE_FATAL;
+  }
+  if (!__archive_rar_crypto_available()) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        "Decryption is not supported: this libarchive has no crypto library");
+    return ARCHIVE_FATAL;
+  }
+  if (c->broken) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        "Can't decrypt the rest of an entry that was skipped");
+    return ARCHIVE_FATAL;
+  }
+  if (password == NULL) {
+    __archive_read_reset_passphrase(a);
+    password = __archive_read_next_passphrase(a);
+  }
+  if (password == NULL) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        "Passphrase required for this entry");
+    return ARCHIVE_FAILED;
+  }
+  if (rar4_derive(rar, password, (rar->file_flags & FHD_SALT) ?
+      (const uint8_t *)rar->salt : NULL, key, iv) ||
+      (c->aes == NULL && (c->aes = __archive_rar_aes_new()) == NULL) ||
+      __archive_rar_aes_init(c->aes, key, 128, iv)) {
+    __archive_rar_wipe(key, sizeof(key));
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, "Can't set up decryption");
+    return ARCHIVE_FATAL;
+  }
+  __archive_rar_wipe(key, sizeof(key));
+  c->keyed = 1;
+  return ARCHIVE_OK;
+}
