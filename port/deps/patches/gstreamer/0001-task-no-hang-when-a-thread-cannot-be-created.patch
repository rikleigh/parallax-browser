@@ -740,6 +740,17 @@
     g_warning ("failed to create thread: %s", error->message);
     g_error_free (error);
     res = FALSE;
+    /* PS5: the default pool queues nothing when it can't start a thread (see
+     * gsttaskpool.c), so gst_task_func will never run: undo the start, or a
+     * join waits for it forever. Stopped, the task can be started again. */
+    if (G_OBJECT_TYPE (priv->pool_id) == GST_TYPE_TASK_POOL) {
