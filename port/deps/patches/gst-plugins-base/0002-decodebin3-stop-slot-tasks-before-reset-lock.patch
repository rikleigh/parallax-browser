--- a/gst/playback/gstdecodebin3.c
+++ b/gst/playback/gstdecodebin3.c
@@ -750,10 +750,40 @@
 gst_decodebin3_reset (GstDecodebin3 * dbin)
 {
   GList *tmp;
+  guint attempts;
 
   GST_DEBUG_OBJECT (dbin, "Resetting");
 
+  /* Stop the slots' streaming threads before freeing them under the
+   * SELECTION_LOCK. mq_slot_free() releases the multiqueue pads, which joins
+   * the source pad's task, and that task can be waiting for the
+   * SELECTION_LOCK in multiqueue_src_probe() (stream-start, caps, EOS): the
+   * reset never returned. The multiqueue's own PAUSED->READY stops its tasks,
+   * but a slot made after that (a pad an upstream streaming thread added
+   * during the state change) gets an active pad and a running task, the
+   * multiqueue activates new pads in READY. Slots are only made with the
+   * SELECTION_LOCK held, so once no slot has an active source pad while it is
+   * held, releasing the pads below doesn't wait for a streaming thread. */
   SELECTION_LOCK (dbin);
+  for (attempts = 0; attempts < 8; attempts++) {
+    GList *active = NULL;
+
+    for (tmp = dbin->slots; tmp; tmp = tmp->next) {
+      MultiQueueSlot *slot = (MultiQueueSlot *) tmp->data;
+      if (slot->src_pad && GST_PAD_IS_ACTIVE (slot->src_pad))
+        active = g_list_prepend (active, gst_object_ref (slot->src_pad));
+    }
+    if (!active)
+      break;
+    SELECTION_UNLOCK (dbin);
+    for (tmp = active; tmp; tmp = tmp->next) {
+      GST_DEBUG_OBJECT (tmp->data, "Stopping multiqueue task before reset");
+      gst_pad_set_active (GST_PAD_CAST (tmp->data), FALSE);
+    }
+    g_list_free_full (active, gst_object_unref);
+    SELECTION_LOCK (dbin);
+  }
+
   /* Free output streams */
   g_list_free_full (dbin->output_streams,
       (GDestroyNotify) db_output_stream_free);
