#!/usr/bin/env bash
# Open a link in the PS5 browser (title PPSA99020) from the Mac.
#   ps5open <url>          bare hosts get https://, other words a search
#   ps5open                the front Safari or Chrome tab
#   ps5open -s | -c        the front tab of Safari (-s) or Chrome (-c)
#   ps5open --status       what the PS5 browser is showing
#   ps5open --cookies [url] copy Chrome's cookies for the site first (logged
#                          in on the PS5 too), then open it; no url: the
#                          front Chrome tab. PS5_CHROME_PROFILE picks a profile
# Sends it to the browser's link server (http://$PS5_HOST:9040/open). If the
# browser isn't running, starts it with the link through the launcher payload
# (tools/launch.sh PPSA99020 <url>); it never closes another title.
# PS5_HOST comes from env.sh next to this script, or the environment;
# PS5_PIN if the console has /data/ps5webkit/push-pin.txt.
set -uo pipefail
# Shortcuts and Quick Actions run with a minimal PATH (socat, curl for launch.sh).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
SELF="$0"
while [[ -L "$SELF" ]]; do
    link="$(readlink "$SELF")"
    [[ $link == /* ]] && SELF="$link" || SELF="$(dirname "$SELF")/$link"
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
if [[ -z "${PS5_HOST:-}" && -f "$ROOT/env.sh" ]]; then
    . "$ROOT/env.sh" >/dev/null 2>&1
fi
HOST="${PS5_HOST:-192.168.1.50}"
PORT="${PS5_PUSH_PORT:-9040}"
BASE="http://$HOST:$PORT"
TITLE=PPSA99020

die() { echo "ps5open: $*" >&2; exit 1; }

# The URL of the front tab of a running browser (never starts one).
front_tab() {
    local app="$1" script
    case "$app" in
        Safari) script='tell application "Safari" to if (count of windows) > 0 then return URL of current tab of front window' ;;
        *) script="tell application \"$app\" to if (count of windows) > 0 then return URL of active tab of front window" ;;
    esac
    [[ "$(osascript -e "application \"$app\" is running" 2>/dev/null)" == true ]] || return 1
    osascript -e "$script" 2>/dev/null
}

pick_tab() {
    local front url app
    if [[ -n "${1:-}" ]]; then
        front_tab "$1"
        return
    fi
    # The frontmost app if it is a browser (a Quick Action or a shortcut
    # key), else Safari, then Chrome.
    front="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
    for app in "$front" Safari "Google Chrome"; do
        case "$app" in Safari|"Google Chrome") ;; *) continue ;; esac
        url="$(front_tab "$app")" && [[ -n "$url" ]] && { echo "$url"; return 0; }
    done
    return 1
}

# The browser's link server: 0 sent, 1 refused (prints why), 2 no server.
send_link() {
    local reply code
    local pin=()
    [[ -n "${PS5_PIN:-}" ]] && pin=(--data-urlencode "pin=$PS5_PIN")
    reply="$(curl -sS --max-time 6 -H 'Accept: text/plain' --data-urlencode "url=$1" ${pin[@]+"${pin[@]}"} "$BASE/open" -w '\n%{http_code}' 2>/dev/null)"
    [[ $? -ne 0 || -z "$reply" ]] && return 2
    code="${reply##*$'\n'}"
    reply="${reply%$'\n'*}"
    echo "$reply"
    [[ "$code" == 200 ]]
}

wait_for_server() {
    for _ in $(seq "${1:-60}"); do
        curl -s --max-time 2 "$BASE/status" >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

# Copy Chrome's cookies for the site of $1 to the PS5 browser (running).
send_cookies() {
    local cookies reply key=()
    [[ -f "$ROOT/tools/chrome-cookies.py" ]] || { echo "tools/chrome-cookies.py is a local tool, not in the repo" >&2; return 1; }
    cookies="$(python3 -I "$ROOT/tools/chrome-cookies.py" "$1" ${PS5_CHROME_PROFILE:+--profile "$PS5_CHROME_PROFILE"})" || return 1
    [[ -n "${PS5_COOKIE_KEY:-}" ]] && key=(-H "X-PS5-Key: $PS5_COOKIE_KEY")
    [[ -n "${PS5_PIN:-}" ]] && key+=(-H "X-PS5-PIN: $PS5_PIN")
    reply="$(printf '%s\n' "$cookies" | curl -sS --max-time 10 -H 'Content-Type: text/plain' ${key[@]+"${key[@]}"} \
        --data-binary @- "$BASE/cookies" 2>&1)"
    echo "$reply"
    [[ "$reply" == OK* ]]
}

browser=""
cookies=0
case "${1:-}" in
    --cookies) cookies=1; browser="Google Chrome"; shift ;;
    -h|--help) sed -n "2,15p" "$0"; exit 0 ;;
    --status) curl -sS --max-time 5 ${PS5_PIN:+-H "X-PS5-PIN: $PS5_PIN"} "$BASE/status" || die "no answer from $BASE (browser not running?)"; exit ;;
    -s) browser=Safari; shift ;;
    -c) browser="Google Chrome"; shift ;;
esac
url="${*:-}"
if [[ -z "$url" ]]; then
    url="$(pick_tab "$browser")" || true
    [[ -n "$url" ]] || die "no URL given and no Safari or Chrome tab found"
fi
# The title adds https:// too; done here so a launch argument is a full URL.
if [[ "$url" != *://* && "$url" != *" "* && "$url" == *.* ]]; then
    url="https://$url"
fi

if [[ $cookies == 1 ]]; then
    # Cookies need the browser running: start it on its home page first.
    if ! curl -s --max-time 3 "$BASE/status" >/dev/null 2>&1; then
        status="$("$ROOT/tools/launch.sh" --status 2>&1 | tail -1)"
        case "$status" in
            "OK none") echo "browser not running: starting $TITLE"
                "$ROOT/tools/launch.sh" "$TITLE" >/dev/null || die "launch failed" ;;
            "OK "*" $TITLE") ;;
            "OK "*) die "another title is running (${status#OK }); not closing it. Close it on the PS5 first." ;;
            *) die "no answer from the browser ($BASE) or the launcher: $status" ;;
        esac
        wait_for_server 60 || die "the link server did not answer within 60 s"
        # Cookies sent before the first page has loaded can miss the saved
        # cookie store (seen once): wait for the home page.
        for _ in $(seq 30); do
            [[ "$(curl -s --max-time 3 "$BASE/status")" == *'"uri":"'[!\"]* ]] && break
            sleep 1
        done
    fi
    send_cookies "$url" || die "cookies not sent"
fi

send_link "$url"
case $? in
    0) exit 0 ;;
    1) exit 1 ;;
esac

# No server: is the browser running at all?
status="$("$ROOT/tools/launch.sh" --status 2>&1 | tail -1)"
case "$status" in
    "OK none")
        echo "browser not running: starting $TITLE with the link"
        if [[ ${#url} -le 200 && "$url" != *" "* ]]; then
            "$ROOT/tools/launch.sh" "$TITLE" "$url" || die "launch failed"
        else
            # Too long for the launcher's 256-byte command line: the title
            # reads (and deletes) this file once at startup instead.
            tmp="$(mktemp)"; printf '%s\n' "$url" >"$tmp"
            curl -sS --max-time 10 -T "$tmp" "ftp://$HOST:${PS5_FTP_PORT:-2121}/data/ps5webkit/open-url.txt" >/dev/null 2>&1
            rc=$?; rm -f "$tmp"
            [[ $rc == 0 ]] || die "could not write the link file for the launch (FTP on port ${PS5_FTP_PORT:-2121})"
            "$ROOT/tools/launch.sh" "$TITLE" || die "launch failed"
        fi
        if wait_for_server 60; then
            for _ in $(seq 20); do   # until the first page has committed
                st="$(curl -s --max-time 3 "$BASE/status")"
                [[ -n "$st" && "$st" != *'"uri":""'* ]] && break
                sleep 1
            done
            echo "OK started; $st"
        else
            echo "started, but the link server did not answer within 60 s"
        fi ;;
    "OK "*" $TITLE")
        # Starting up, or busy: give it a moment.
        echo "browser running but its link server isn't answering yet; waiting"
        wait_for_server 30 || die "no answer from $BASE"
        send_link "$url" ;;
    "OK "*)
        die "another title is running (${status#OK }); not closing it. Close it on the PS5 first." ;;
    *)
        die "no answer from the browser ($BASE) or the launcher: $status" ;;
esac
