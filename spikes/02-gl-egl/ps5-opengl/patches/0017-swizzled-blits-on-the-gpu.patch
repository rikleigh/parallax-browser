+   /* ps5webkit: a swizzled blit samples through a view with that swizzle,
+    * as u_blitter's own util_blitter_blit does. Mesa adds one when the base
+    * formats differ: {X,Y,Z,1} from an RGBA texture into a GL_RGB one (this
+    * driver has no RGBX format, so both are stored as R8G8B8A8). Before: the
+    * CPU fallback, ~550 ms for a 2160x1080 video frame into a WebGL 1 RGB
+    * texture. Only selectors the texture descriptor has (X..W, 0, 1). */
+   if (info->swizzle_enable &&
+       (resolve || info->swizzle[0] > PIPE_SWIZZLE_1 ||
+        info->swizzle[1] > PIPE_SWIZZLE_1 || info->swizzle[2] > PIPE_SWIZZLE_1 ||
+        info->swizzle[3] > PIPE_SWIZZLE_1))
+      return false;
