+#ifdef RUNTIME_REPEAT_DRAWS
+/* A batched draw normally carries its whole state: render target, shader,
+ * depth, blend, viewport and rasterizer register tables, rebuilt by the CPU
+ * for every draw (~10% of the WebGL thread at 2000 draws per frame). In one
+ * group the draws run as one stream, and context, SH and UC registers keep
+ * the last written values, so a draw whose state equals the draw before it
+ * in that stream needs only its own commands: the upload acquire, its user
+ * data, the draw and its completion. The state compared is everything the
+ * full path builds those tables from (all of runtime_draw_inputs but the
+ * per-draw values, the backend draw state, the NGG control and the shader
+ * bytes), and the draw must join the previous draw's group. Anything else
+ * takes the full path. */
+static uint64_t runtime_repeat_lookups, runtime_repeat_hits;
+
+static void runtime_repeat_record(const struct runtime_shader_pair *pair)
+{
+    runtime_repeat.valid = pair && !runtime_hs_package;
+    if (!runtime_repeat.valid)
+        return;
+    runtime_repeat.queued = runtime_batch_count;
+    runtime_repeat.pair = pair;
+    runtime_repeat.draw = runtime_draw_state;
+    runtime_repeat.backend = ps5_agc_draw_state;
+    runtime_repeat.ngg_valid = runtime_ngg_ge_pc_alloc_valid;
+    runtime_repeat.ngg_value = runtime_ngg_ge_pc_alloc;
+}
+
+_Static_assert(offsetof(struct runtime_draw_inputs, framebuffer_size) <
+                   offsetof(struct runtime_draw_inputs, vertex_user_data) &&
+               offsetof(struct runtime_draw_inputs, index_size) <
+                   offsetof(struct runtime_draw_inputs, primitive_type) &&
+               offsetof(struct runtime_draw_inputs, primitive_type) <
+                   offsetof(struct runtime_draw_inputs, draw_count) &&
+               offsetof(struct runtime_draw_inputs, draw_count) <
+                   offsetof(struct runtime_draw_inputs, depth_buffer),
+               "runtime_repeat_matches skips the per-draw fields by position");
+
+static int runtime_repeat_matches(void)
+{
+    enum {
+        USER = offsetof(struct runtime_draw_inputs, vertex_user_data),
+        PRIMITIVE = offsetof(struct runtime_draw_inputs, primitive_type),
+        COUNT = offsetof(struct runtime_draw_inputs, draw_count),
+        DEPTH = offsetof(struct runtime_draw_inputs, depth_buffer),
+    };
+    const uint8_t *previous = (const uint8_t *)&runtime_repeat.draw;
+    const uint8_t *current = (const uint8_t *)&runtime_draw_state;
+    const struct runtime_shader_pair *pair = runtime_repeat.pair;
+
+    if (++runtime_repeat_lookups % 100000 == 0)
+        printf("[ps5-repeat-draws] lookups=%" PRIu64 " repeated=%" PRIu64 "\n",
+               runtime_repeat_lookups, runtime_repeat_hits);
+    if (!runtime_repeat.valid || !runtime_batch_active ||
+        runtime_batch_count != runtime_repeat.queued || runtime_hs_package ||
+        runtime_ngg_ge_pc_alloc_valid != runtime_repeat.ngg_valid ||
+        runtime_ngg_ge_pc_alloc != runtime_repeat.ngg_value)
+        return 0;
+    /* Also compares the package addresses and sizes, the pair's key. */
+    if (!ps5_memeq(previous, current, USER) ||
+        !ps5_memeq(previous + PRIMITIVE, current + PRIMITIVE, COUNT - PRIMITIVE) ||
+        !ps5_memeq(previous + DEPTH, current + DEPTH, sizeof(runtime_draw_state) - DEPTH) ||
+        !ps5_memeq(&runtime_repeat.backend, &ps5_agc_draw_state, sizeof(ps5_agc_draw_state)))
+        return 0;
+    /* A package address can be reused for different bytecode. */
+    return ps5_memeq(pair->source, runtime_vs_package, pair->vs_size) &&
+           ps5_memeq(pair->source + pair->vs_size, runtime_ps_package, pair->ps_size);
+}
