+    subprocess.run([str(exe)], check=True)
+
+# The repeated draw's per-draw commands are the full path's, in its order.
+repeat = between("static int runtime_repeat_draw(void)\n{", "\n#endif\n\nint main(void)")
+main = source[source.index("\nint main(void)\n{"):]
+
+
+def normal(text):
+    return re.sub(r"\s+", " ", text).strip()
+
+
+def block(text, start, end):
+    a = text.index(start)
+    return normal(text[a:text.index(end, a) + len(end)])
+
+
+user_data = ("    if (runtime_vertex_user_data_count)", "runtime_pixel_user_data_count);")
+assert block(repeat, *user_data) == block(main, *user_data)
+draw = ("    if (runtime_index_buffer) {", "agc.draw_auto(&command, runtime_draw_count, 2);\n    }")
+assert block(repeat, *draw) == block(main, *draw)
+for call in ("release_mem(&command, 45, 12, 1, 0, NULL, 0, 0,",
+             "release_mem(&command, 43, 12, 1, 0, NULL, 0, 0,",
+             "runtime_release_completion(&agc, &command, completion_marker,"):
+    assert call in repeat and call in main, call
+# Prepared draws (all a repeat follows) use the WORK_BYTES layout.
+assert "runtime_acquire_cpu_uploads(&command, memory, work_bytes)" in main
+assert "work_bytes = WORK_BYTES;" in main[:main.index("runtime_acquire_cpu_uploads(")]
+assert "runtime_acquire_cpu_uploads(&command, memory, WORK_BYTES)" in repeat
+order = [repeat.index(s) for s in ("runtime_acquire_cpu_uploads(", "runtime_vertex_user_data_count)",
+                                   "if (runtime_index_buffer)", "release_mem(&command, 45",
+                                   "release_mem(&command, 43", "runtime_release_completion(",
+                                   "validate_indirect_register_tables(", "runtime_batch_would_join(",
+                                   "runtime_prepared_work_publish(", "runtime_batch_queue(")]
+assert order == sorted(order)
+assert "RUNTIME_PRESENT_TAIL_WORDS" in repeat and "entry.repeat = 1;" in repeat
+# The full path tries the repeat first and records the state of what it queued.
+assert main.index("if (!runtime_repeat_draw())") < main.index("shader_sections(")
+queued = main.index("if (runtime_batch_queue(&agc, &entry) != 0)")
+assert main.index("runtime_repeat_record(prepared);", queued) < main.index("memory = NULL;", queued)
+print("PASS: repeated draws emit the full path's user data, draw, releases and completion in order")
