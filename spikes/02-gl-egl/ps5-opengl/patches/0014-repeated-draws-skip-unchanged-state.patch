+    if (runtime_batch_fixed_framebuffer &&
+        PS5_AGC_POST_DRAW_BARRIER_WORDS < draw_words)
+        completion_offset = draw_words - PS5_AGC_POST_DRAW_BARRIER_WORDS;
+    if (!agc.release_mem(&command, 45, 12, 1, 0, NULL, 0, 0,
