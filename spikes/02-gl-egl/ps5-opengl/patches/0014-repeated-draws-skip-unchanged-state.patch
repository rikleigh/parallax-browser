+#!/usr/bin/env python3
+"""A repeated draw (runtime_repeat_draw) must match every input of the state it
+skips and nothing per-draw, and must emit the full path's per-draw commands."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/platform/ps5_agc_native_runtime.c").read_text()
+
+
+def between(start, end, at=0):
+    a = source.index(start, at)
+    return source[a:source.index(end, a)]
+
+
+inputs = between("#define RUNTIME_MAX_VIEWPORTS 16", "\nint ps5_agc_gate2_set_packages")
+state = between("#ifdef RUNTIME_REPEAT_DRAWS\n/* The last queued draw's state",
+                "\n#endif\n") + "\n#endif\n"
+functions = between("static uint64_t runtime_repeat_lookups", "\n/* 0: queued.")
+
+code = r'''
+#define RUNTIME_REPEAT_DRAWS 1
+#define AGC_RUNTIME_PACKAGES 1
+#include <assert.h>
+#include <inttypes.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "%s"
+struct runtime_shader_pair { uint8_t *source; size_t vs_size, ps_size; };
+struct ps5_agc_backend_draw_state { uint32_t instance_count; void *targets[8]; uint32_t mask; };
+static _Thread_local struct ps5_agc_backend_draw_state ps5_agc_draw_state;
+static _Thread_local uint32_t runtime_ngg_ge_pc_alloc, runtime_ngg_ge_pc_alloc_valid;
+static int runtime_batch_active;
+static unsigned runtime_batch_count;
+''' % (root / "src/platform/ps5_memeq.h") + inputs + state + functions + r'''
+static uint8_t vs[96] = {1}, ps[64] = {2};
+static uint8_t pair_source[160];
+static struct runtime_shader_pair pair = {pair_source, sizeof(vs), sizeof(ps)};
+static void base(void) {
+    runtime_vs_package = vs; runtime_vs_package_len = sizeof(vs);
+    runtime_ps_package = ps; runtime_ps_package_len = sizeof(ps);
+    memcpy(pair_source, vs, sizeof(vs)); memcpy(pair_source + sizeof(vs), ps, sizeof(ps));
+    runtime_batch_active = 1; runtime_batch_count = 7;
+    runtime_ngg_ge_pc_alloc_valid = 1; runtime_ngg_ge_pc_alloc = 9;
+    ps5_agc_draw_state.mask = 0xf;
+    runtime_repeat_record(&pair);
+    assert(runtime_repeat.valid && runtime_repeat.queued == 7 && runtime_repeat_matches());
+}
+int main(void) {
+    const size_t user = offsetof(struct runtime_draw_inputs, vertex_user_data);
+    const size_t per_draw_end = offsetof(struct runtime_draw_inputs, index_size) + sizeof(unsigned);
+    const size_t count = offsetof(struct runtime_draw_inputs, draw_count);
+    base();
+    /* Every byte: only the per-draw values may differ. */
+    for (size_t i = 0; i < sizeof(runtime_draw_state); ++i) {
+        uint8_t *byte = (uint8_t *)&runtime_draw_state + i;
+        int per_draw = (i >= user && i < per_draw_end) || (i >= count && i < count + sizeof(unsigned));
+        *byte ^= 0x40;
+        if (i < offsetof(struct runtime_draw_inputs, framebuffer)) {
+            /* Package pointers and sizes: never read through when they differ. */
+            assert(!runtime_repeat_matches());
+        } else
+            assert(runtime_repeat_matches() == per_draw);
+        *byte ^= 0x40;
+        assert(runtime_repeat_matches());
+    }
+    for (size_t i = 0; i < sizeof(ps5_agc_draw_state); ++i) {
+        ((uint8_t *)&ps5_agc_draw_state)[i] ^= 1;
+        assert(!runtime_repeat_matches());
+        ((uint8_t *)&ps5_agc_draw_state)[i] ^= 1;
+    }
+    runtime_ngg_ge_pc_alloc = 8; assert(!runtime_repeat_matches()); runtime_ngg_ge_pc_alloc = 9;
+    runtime_ngg_ge_pc_alloc_valid = 0; assert(!runtime_repeat_matches()); runtime_ngg_ge_pc_alloc_valid = 1;
+    /* Same addresses and sizes, new bytecode. */
+    vs[95] = 5; assert(!runtime_repeat_matches()); vs[95] = 0;
+    ps[0] = 7; assert(!runtime_repeat_matches()); ps[0] = 2;
+    assert(runtime_repeat_matches());
+    /* Only directly after the recorded draw, in an open batch. */
+    runtime_batch_count = 8; assert(!runtime_repeat_matches()); runtime_batch_count = 7;
+    runtime_batch_active = 0; assert(!runtime_repeat_matches()); runtime_batch_active = 1;
+    /* Tessellation and unprepared draws are never recorded. */
+    static uint8_t hs[4];
+    runtime_hs_package = hs; assert(!runtime_repeat_matches());
+    runtime_repeat_record(&pair); assert(!runtime_repeat.valid);
+    runtime_hs_package = NULL; assert(!runtime_repeat_matches());
+    base();
+    runtime_repeat_record(NULL); assert(!runtime_repeat.valid && !runtime_repeat_matches());
+    puts("PASS: repeated draws match all skipped state (each byte), shader bytes and batch position, and no per-draw value");
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    exe = Path(tmp) / "repeat-draws"
+    subprocess.run(["cc", "-std=c11", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+                    "-fsanitize=address,undefined", "-x", "c", "-o", str(exe), "-"],
