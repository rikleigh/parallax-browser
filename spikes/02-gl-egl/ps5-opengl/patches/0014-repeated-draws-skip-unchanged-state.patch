+        runtime_framebuffer != runtime_video_framebuffer ||
+        pool > runtime_video_framebuffer_size ||
+        load_apis(NULL, NULL, NULL, &agc, &video) != 0 ||
+        runtime_video_prepare_draw() != 0)
