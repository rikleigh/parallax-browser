+/* 0: queued. 1: not a repeat (or it could not be queued as one); nothing was
+ * queued and the caller builds the full draw. The per-draw commands are the
+ * full path's (main), in the same order. */
+static int runtime_repeat_draw(void)
+{
+    agc_api_t agc = {0};
+    video_api_t video = {0};
+    uint8_t *memory = NULL;
+    int64_t work_start = -1;
+    agc_command_buffer_t command = {0};
+    struct runtime_batch_entry entry = {0};
+    uint32_t *words, draw_words, final_words, completion_offset = 0;
+    uint32_t bad_packet, bad_opcode, bad_count;
+    uint64_t bad_address;
+    volatile uint64_t *completion_marker;
+    int64_t render_marker;
+    const size_t pool = runtime_framebuffer_size < FRAMEBUFFER_POOL_BYTES
+                            ? FRAMEBUFFER_BYTES : FRAMEBUFFER_POOL_BYTES;
