 #endif
 }
 
+/* sceAgcGetRegisterDefaults returns the same table every call, but the call
+ * itself cost a third of the WebGL thread in a 1000-draw scene (every draw
+ * builds its target state from it). Fetch it once; every 4096th use calls it
+ * again and, should the pointer ever differ, logs that and stops caching. */
+static void *runtime_register_defaults(void *(*get_defaults)(void))
+{
+    static void *cached;
+    static unsigned uses;
+    static int disabled;
+    void *defaults = __atomic_load_n(&cached, __ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&disabled, __ATOMIC_RELAXED))
+        return get_defaults();
+    if (!defaults) {
+        defaults = get_defaults();
+        __atomic_store_n(&cached, defaults, __ATOMIC_RELEASE);
+        return defaults;
+    }
+    if (!(__atomic_fetch_add(&uses, 1, __ATOMIC_RELAXED) & 4095)) {
+        void *fresh = get_defaults();
+        if (fresh != defaults) {
+            fprintf(stderr, "[ps5-agc] register defaults moved (%p -> %p): no longer cached\n",
+                   defaults, fresh);
+            __atomic_store_n(&disabled, 1, __ATOMIC_RELAXED);
+            return fresh;
+        }
+    }
+    return defaults;
+}
+
 static int append_target_state(agc_register_t *cx, uint32_t *cx_count,
                                void *defaults, void *target)
 {
