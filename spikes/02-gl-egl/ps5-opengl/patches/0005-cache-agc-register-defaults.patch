     words = (uint32_t *)(memory + 0x8000);
-    if (append_target_state(cx, &cx_count, agc.get_defaults(),
+    if (append_target_state(cx, &cx_count, runtime_register_defaults(agc.get_defaults),
 #ifdef AGC_OFFSCREEN_COLOR_VARIANT
                             offscreen) != 0 ||
