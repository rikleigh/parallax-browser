diff --git a/tests/ps5/test_vao_fast_path.py b/tests/ps5/test_vao_fast_path.py
new file mode 100644
index 0000000..be50c38
--- /dev/null
+++ b/tests/ps5/test_vao_fast_path.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""The screen allows Mesa's VAO fast path (one vertex buffer per enabled
+attribute), and has a vertex buffer for every vertex input it reports."""
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[2]
+screen = (root / "src/gallium/ps5/ps5_screen.c").read_text()
+mesa = (root / "third_party/mesa-26.2.0/src/mesa/state_tracker/st_extensions.c").read_text()
+
+assert screen.count("caps->allow_dynamic_vao_fastpath = true;") == 1
+assert "c->UseVAOFastPath =\n         screen->caps.allow_dynamic_vao_fastpath;" in mesa
+buffers = int(re.search(r"caps->max_vertex_buffers = (\d+);", screen).group(1))
+inputs = int(re.search(r"vs_caps->max_inputs = (\d+);", screen).group(1))
+assert buffers >= inputs, (buffers, inputs)
+# The fast path fills vertex buffers and elements up to these limits.
+for decl in ("struct pipe_vertex_buffer vertex_buffers[PIPE_MAX_ATTRIBS];",
+             "struct pipe_vertex_element elements[PIPE_MAX_ATTRIBS];"):
+    assert decl in screen, decl
+print(f"PASS: VAO fast path allowed; {buffers} vertex buffers for {inputs} vertex inputs")
