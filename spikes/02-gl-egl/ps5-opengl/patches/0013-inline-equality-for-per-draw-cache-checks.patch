diff --git a/tests/ps5/test_memeq.py b/tests/ps5/test_memeq.py
new file mode 100644
index 0000000..918eeb3
--- /dev/null
+++ b/tests/ps5/test_memeq.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""ps5_memeq agrees with memcmp == 0 for every length, offset and difference position.
+
+Builds natively and, where the host can run it, as x86_64 so the SSE2 path
+(the one the title uses) is exercised too.
+"""
+from pathlib import Path
+import platform
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+header = root / 'src/platform/ps5_memeq.h'
+code = '#include "%s"\n' % header + r'''
+#include <assert.h>
+#include <stdio.h>
+static unsigned char a[512 + 32], b[512 + 32];
+int main(void) {
+ unsigned long cases = 0;
+ for (unsigned i = 0; i < sizeof(a); ++i) a[i] = b[i] = (unsigned char)(i * 37 + 11);
+ for (unsigned oa = 0; oa < 17; ++oa)
+  for (unsigned ob = 0; ob < 17; ob += 4)
+   for (unsigned n = 0; n <= 300; ++n) {
+    memcpy(b + ob, a + oa, n);
+    assert(ps5_memeq(a + oa, b + ob, n));
+    ++cases;
+    for (unsigned at = 0; at < n; ++at) {
+     unsigned char saved = b[ob + at];
+     for (unsigned bit = 0; bit < 8; bit += 7) {
+      b[ob + at] = saved ^ (unsigned char)(1u << bit);
+      assert(!ps5_memeq(a + oa, b + ob, n));
+      ++cases;
+     }
+     b[ob + at] = saved;
+    }
+    // Bytes just outside the range never matter.
+    b[ob + n] ^= 0xff;
+    if (ob) b[ob - 1] ^= 0xff;
+    assert(ps5_memeq(a + oa, b + ob, n));
+    b[ob + n] ^= 0xff;
+    if (ob) b[ob - 1] ^= 0xff;
+   }
+ printf("%lu\n", cases);
+}
+'''
+runs = []
+with tempfile.TemporaryDirectory() as directory:
+    targets = [('native', [])]
+    if platform.system() == 'Darwin' and platform.machine() == 'arm64':
+        targets.append(('x86_64', ['-arch', 'x86_64']))
+    elif platform.machine() in ('x86_64', 'AMD64'):
+        targets[0] = ('x86_64', [])
+    for name, flags in targets:
+        exe = str(Path(directory) / name)
+        sanitize = ['-fsanitize=address,undefined', '-fno-sanitize-recover=all'] if not flags else []
+        subprocess.run(['cc', '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', *sanitize, *flags,
+                        '-x', 'c', '-', '-o', exe], input=code, text=True, check=True)
+        try:
+            out = subprocess.run([exe], check=True, timeout=60, capture_output=True, text=True).stdout.strip()
+        except OSError:
+            print(f'skip {name}: cannot run on this host')
+            continue
+        runs.append(f'{name} {out}')
+print('PASS memeq vs memcmp: lengths 0-300, offsets, every byte position; ' + ', '.join(runs))
