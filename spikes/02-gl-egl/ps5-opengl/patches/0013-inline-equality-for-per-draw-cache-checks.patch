diff --git a/src/platform/ps5_memeq.h b/src/platform/ps5_memeq.h
new file mode 100644
index 0000000..cd33001
--- /dev/null
+++ b/src/platform/ps5_memeq.h
@@ -0,0 +1,72 @@
+/*
+ * PS5 OpenGL - OpenGL implementation for PlayStation 5.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Inline byte equality for per-draw cache checks. The system libc memcmp
+ * is an out-of-module call and showed up at ~7% of the WebGL thread for
+ * compares of a few hundred bytes to a few KiB that almost always match;
+ * this compares 64 bytes per step with SSE2 (8 without it) and stops at the first
+ * difference. Equality only: no ordering.
+ */
+#ifndef PS5_MEMEQ_H
+#define PS5_MEMEQ_H
+
+#if defined(__SSE2__)
+#include <emmintrin.h>
+#endif
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline bool
+ps5_memeq(const void *a, const void *b, size_t bytes)
+{
+   const uint8_t *x = (const uint8_t *)a;
+   const uint8_t *y = (const uint8_t *)b;
+
+#if defined(__SSE2__)
+   while (bytes >= 64) {
+      __m128i d = _mm_xor_si128(_mm_loadu_si128((const __m128i *)x),
+                                _mm_loadu_si128((const __m128i *)y));
+      d = _mm_or_si128(d, _mm_xor_si128(_mm_loadu_si128((const __m128i *)(x + 16)),
+                                        _mm_loadu_si128((const __m128i *)(y + 16))));
+      d = _mm_or_si128(d, _mm_xor_si128(_mm_loadu_si128((const __m128i *)(x + 32)),
+                                        _mm_loadu_si128((const __m128i *)(y + 32))));
+      d = _mm_or_si128(d, _mm_xor_si128(_mm_loadu_si128((const __m128i *)(x + 48)),
+                                        _mm_loadu_si128((const __m128i *)(y + 48))));
+      if (_mm_movemask_epi8(_mm_cmpeq_epi8(d, _mm_setzero_si128())) != 0xffff)
+         return false;
+      x += 64;
+      y += 64;
+      bytes -= 64;
+   }
+   while (bytes >= 16) {
+      __m128i d = _mm_xor_si128(_mm_loadu_si128((const __m128i *)x),
+                                _mm_loadu_si128((const __m128i *)y));
+      if (_mm_movemask_epi8(_mm_cmpeq_epi8(d, _mm_setzero_si128())) != 0xffff)
+         return false;
+      x += 16;
+      y += 16;
+      bytes -= 16;
+   }
+#endif
+   while (bytes >= 8) {
+      uint64_t u, v;
+      memcpy(&u, x, 8);
+      memcpy(&v, y, 8);
+      if (u != v)
+         return false;
+      x += 8;
+      y += 8;
+      bytes -= 8;
+   }
+   while (bytes) {
+      if (*x++ != *y++)
+         return false;
+      --bytes;
+   }
+   return true;
+}
+
+#endif
