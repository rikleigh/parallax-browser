+/* Whether any index of these draws equals info->restart_index. True (convert
+ * as before) when the indices are not in a CPU-visible buffer or a range is
+ * out of bounds. */
+static bool
+ps5_draws_contain_restart_index(const struct pipe_draw_info *info,
+                                const struct pipe_draw_start_count_bias *draws,
+                                unsigned num_draws)
+{
+   const struct ps5_resource *resource =
+      (const struct ps5_resource *)info->index.resource;
+   const unsigned size = info->index_size;
+   const uint32_t restart = info->restart_index;
+
+   if (info->has_user_indices || !resource || !resource->data ||
+       resource->base.target != PIPE_BUFFER ||
+       (size != 1 && size != 2 && size != 4))
+      return true;
+   if ((size == 1 && restart > UINT8_MAX) || (size == 2 && restart > UINT16_MAX))
+      return false; /* no index of this size can equal it */
+   for (unsigned d = 0; d < num_draws; ++d) {
+      const uint64_t offset = (uint64_t)draws[d].start * size;
+      const uint64_t bytes = (uint64_t)draws[d].count * size;
+      if (offset > resource->size || bytes > resource->size - offset)
+         return true;
+      const uint8_t *indices = (const uint8_t *)resource->data + offset;
+      const unsigned count = draws[d].count;
+      if (size == 1) {
+         if (memchr(indices, (int)restart, count))
+            return true;
+      } else if (size == 2) {
+         const uint16_t *v = (const uint16_t *)indices;
+         for (unsigned i = 0; i < count; ++i)
+            if (v[i] == restart)
+               return true;
+      } else {
+         const uint32_t *v = (const uint32_t *)indices;
+         for (unsigned i = 0; i < count; ++i)
+            if (v[i] == restart)
+               return true;
+      }
+   }
+   return false;
+}
