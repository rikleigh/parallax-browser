+def without_draw_caches(text):
+    """struct ps5_resource is followed by patch 0018's draw-cache helpers
+    (tested in test_draw_cache.py); they need state this test doesn't have."""
+    if "#define PS5_INDEX_RANGE_ENTRIES" not in text:
+        return text
+    a = text.index("#define PS5_INDEX_RANGE_ENTRIES")
+    b = text.index("\n}\n", text.index("ps5_draw_cache_index_entry(struct ps5_resource *resource")) + 3
+    return text[:a] + text[b:]
+
+
