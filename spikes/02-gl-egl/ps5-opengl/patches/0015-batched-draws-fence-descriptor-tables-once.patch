 #endif
 
+/* A batched draw (flush_cache set) flushes its vertex-buffer and vertex
+ * descriptor tables without a fence each and marks *pending; the fragment
+ * table's flush, where the draw has always fenced last, then fences once for
+ * all three (a fence waits for every older flush on this thread), or fences
+ * alone if that table is empty. Each fence waits for the flushes before it:
+ * three per draw were ~10% of the WebGL thread at 2000 draws per frame. */
+static void
+ps5_flush_draw_table(const void *address, size_t bytes, bool *pending)
+{
+   if (!pending) {
+      ps5_flush_gpu_data(address, bytes);
+      return;
+   }
+   if (!bytes)
+      return;
+   util_flush_range_no_fence((void *)address, bytes);
+   *pending = true;
+}
+
