diff --git a/tests/ps5/test_batched_draw_fences.py b/tests/ps5/test_batched_draw_fences.py
new file mode 100644
index 0000000..ace3bda
--- /dev/null
+++ b/tests/ps5/test_batched_draw_fences.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""A batched draw flushes its first two descriptor tables without a fence
+each; the fragment table's flush, where the draw always fenced last, fences
+once for all three, and fences alone when that table is empty."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+screen = (root / "src/gallium/ps5/ps5_screen.c").read_text()
+
+a = screen.index("static void\nps5_flush_draw_table(")
+helper = screen[a:screen.index("\n}\n", a) + 3]
+code = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+static unsigned unfenced, fenced;
+static void util_flush_range_no_fence(void *p, size_t n) { assert(p && n); ++unfenced; }
+static void ps5_flush_gpu_data(const void *p, size_t n) { assert(p); (void)n; ++fenced; }
+''' + helper + r'''
+int main(void) {
+    char table[64];
+    bool pending = false;
+    ps5_flush_draw_table(table, 0, &pending); /* Nothing to flush. */
+    assert(!unfenced && !fenced && !pending);
+    ps5_flush_draw_table(table, 64, &pending);
+    assert(unfenced == 1 && !fenced && pending);
+    ps5_flush_draw_table(table, 64, NULL); /* Unbatched: fenced as before. */
+    assert(unfenced == 1 && fenced == 1);
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    exe = Path(tmp) / "draw-fences"
+    subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-x", "c",
+                    "-o", str(exe), "-"], input=code, text=True, check=True)
+    subprocess.run([str(exe)], check=True)
+
+draw = screen[screen.index("\nps5_draw_vbo_locked(struct pipe_context *base,"):]
+draw = draw[:draw.index("\n}\n")]
+flat = re.sub(r"\s+", " ", draw)
+# Deferred only for batched draws (the deferred queue and multi-draw chunks).
+assert "bool table_fence_pending = false;" in flat
+assert "bool *defer_table_fence = flush_cache ? &table_fence_pending : NULL;" in flat
+sites = re.findall(r"ps5_flush_draw_table\((.*?)\);", flat)
+assert len(sites) == 2, sites
+assert sites[0].startswith("descriptor_resource->data, descriptor_index * 16,"), sites
+assert "descriptor_storage[0])->data" in sites[1], sites
+assert all(s.endswith(", defer_table_fence") for s in sites), sites
+# The fragment table keeps its fenced flush; without one, a lone fence.
+last = ("if (descriptor_bytes[1]) ps5_flush_gpu_data(((struct ps5_resource *)"
+        "context->descriptor_storage[1])->data, descriptor_bytes[1]); "
+        "else if (table_fence_pending) __builtin_ia32_mfence();")
+assert flat.count(last) == 1, "fragment-table fence"
+# Nothing between the first unfenced flush and that fence submits work or
+# leaves the draw except by dropping it.
+first = flat.index("ps5_flush_draw_table(")
+span = flat[first:flat.index(last)]
+assert "ps5_agc_gate2_run" not in span and "submit" not in span.lower(), "submission"
+for ret in re.finditer(r"return\b[^;]*;", span):
+    before = span[max(0, ret.start() - 60):ret.start()]
+    assert "last_draw_status = -" in before, before
+callers = [re.sub(r"\s+", " ", c) for c in re.findall(r"ps5_draw_vbo_locked\(base,[^;]*;", screen)]
+flush_args = sorted({re.search(r", ([^,]+), [^,]+\);$", c).group(1) for c in callers})
+assert flush_args == ["&flush_cache", "&ps5_deferred.flush_cache", "NULL"], flush_args
+print("PASS: batched draws fence their descriptor tables once, at the fragment table")
