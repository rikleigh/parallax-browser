+   bool draw_cache_off;
+   struct ps5_flushed_range { uint64_t writes, generation; size_t begin, end; } vertex_flushed, index_flushed;
+   struct ps5_index_range_entry *index_ranges;
+};
+''' + helpers + r'''
+static bool flushed(struct ps5_resource *r, size_t begin, size_t end) {
+   uint64_t w = 0, g = 0;
+   if (ps5_draw_cache_flushed(r, &r->vertex_flushed, begin, end, &w, &g))
+      return true;
+   ps5_draw_cache_note_flush(r, &r->vertex_flushed, begin, end, w, g);
+   return false;
+}
+int main(void) {
+   struct ps5_resource r = {{PIPE_BUFFER}};
+   assert(!flushed(&r, 0, 64));            /* first draw flushes */
+   assert(flushed(&r, 0, 64));             /* unchanged: skipped */
+   assert(flushed(&r, 16, 32));            /* inside the flushed range */
+   assert(!flushed(&r, 32, 128));          /* extends it */
+   assert(flushed(&r, 0, 128));            /* merged */
+   assert(!flushed(&r, 512, 600));         /* disjoint: replaced */
+   assert(flushed(&r, 512, 600) && !flushed(&r, 0, 64));
+   ps5_draw_cache_note_write(&r);          /* a CPU write */
+   assert(!flushed(&r, 0, 64));
+   assert(flushed(&r, 0, 64));
+   ps5_draw_cache_note_write(NULL);        /* an access to an unknown buffer */
+   assert(!flushed(&r, 0, 64));
+   assert(!flushed(&r, 8, 8));             /* empty ranges are never cached */
+   assert(!flushed(&r, 8, 8));
+
+   struct ps5_resource persistent = {{PIPE_BUFFER}, true};
+   assert(!flushed(&persistent, 0, 64) && !flushed(&persistent, 0, 64));
+   struct ps5_resource written = {{PIPE_BUFFER}};
+   ps5_draw_cache_mark_gpu_writable(&written.base);
+   assert(!flushed(&written, 0, 64) && !flushed(&written, 0, 64));
+   struct ps5_resource texture = {{PIPE_TEXTURE_2D}};
+   ps5_draw_cache_mark_gpu_writable(&texture.base);
+   assert(!texture.draw_cache_off);
+   assert(!ps5_draw_cache_usable(&texture));
+
+   /* Index-range entries: kept for the same range and contents, reset otherwise. */
+   uint64_t w, g;
+   ps5_draw_cache_stamp(&r, &w, &g);
+   simple_mtx_lock(&ps5_draw_cache_mutex);
+   struct ps5_index_range_entry *e = ps5_draw_cache_index_entry(&r, 10, 300, 2, w, g);
+   assert(e && !e->bounds_valid && !e->restart_valid);
+   e->bounds_valid = true; e->minimum = 3; e->maximum = 99;
+   e = ps5_draw_cache_index_entry(&r, 10, 300, 2, w, g);
+   assert(e->bounds_valid && e->minimum == 3 && e->maximum == 99);
+   assert(!ps5_draw_cache_index_entry(&r, 10, 300, 4, w, g)->bounds_valid); /* other size */
+   simple_mtx_unlock(&ps5_draw_cache_mutex);
+   ps5_draw_cache_note_write(&r);
+   ps5_draw_cache_stamp(&r, &w, &g);
+   simple_mtx_lock(&ps5_draw_cache_mutex);
+   assert(!ps5_draw_cache_index_entry(&r, 10, 300, 2, w, g)->bounds_valid);
+   simple_mtx_unlock(&ps5_draw_cache_mutex);
+   free(r.index_ranges);
+   return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+    p = Path(d)
+    (p / 'test.c').write_text(code)
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-function', '-Wno-missing-field-initializers',
+                    '-fsanitize=address,undefined', str(p / 'test.c'), '-o', str(p / 'test')], check=True)
+    subprocess.run([str(p / 'test')], check=True)
+print('draw caches: PASS')
