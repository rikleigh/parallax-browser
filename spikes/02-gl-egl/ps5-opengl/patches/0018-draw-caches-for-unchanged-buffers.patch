+/* Patch 0018: draw caches for unchanged vertex and index buffers.
+ *
+ * Engines upload their meshes once and draw them every frame, but each indexed
+ * draw used to scan its indices on the CPU (the vertex range it reads, and
+ * whether it holds the restart index) and flush the CPU cache lines of its
+ * vertex and index data. CPU writes to a buffer are published where they are
+ * made (buffer_subdata, transfer flush/unmap), so data no CPU write has touched
+ * since the last flush needs no new one, and a scan of unchanged indices gives
+ * the same answer. Every CPU access hook bumps the buffer's write count
+ * (ps5_draw_cache_note_write); a buffer the GPU may write (stream output,
+ * shader storage, images, compute) or the CPU writes without a callback
+ * (persistent mappings, exports) is never cached. /data/ps5webkit/no-gl-draw-cache
+ * turns the caches off. */
+#define PS5_INDEX_RANGE_ENTRIES 32u
+struct ps5_index_range_entry {
+   uint64_t writes, generation; /* writes + 1 when valid */
+   uint32_t start, count;
+   uint8_t size;
+   bool bounds_valid, bounds_ok;
+   bool restart_valid, restart_contains;
+   int32_t bias;
+   uint32_t restart_index;
+   unsigned minimum, maximum, effective_minimum, effective_maximum;
+};
+
+static uint64_t ps5_draw_cache_generation = 1;
+static simple_mtx_t ps5_draw_cache_mutex = SIMPLE_MTX_INITIALIZER;
+
+static bool
+ps5_draw_cache_on(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      /* open(), not access(): in a title, access() reports existing files
+       * as missing. */
+      int fd = open("/data/ps5webkit/no-gl-draw-cache", O_RDONLY);
+      if (fd >= 0)
+         close(fd);
+      enabled = fd < 0;
+   }
+   return enabled;
+}
+
+/* A CPU access to the buffer (NULL: to an unknown one). */
+static inline void
+ps5_draw_cache_note_write(struct ps5_resource *resource)
+{
+   if (resource)
+      __atomic_fetch_add(&resource->draw_cache_writes, 1, __ATOMIC_RELAXED);
+   else
+      __atomic_fetch_add(&ps5_draw_cache_generation, 1, __ATOMIC_RELAXED);
+}
+
+static inline void
+ps5_draw_cache_mark_gpu_writable(struct pipe_resource *base)
+{
+   if (base && base->target == PIPE_BUFFER)
+      ((struct ps5_resource *)base)->draw_cache_off = true;
+}
+
+static inline bool
+ps5_draw_cache_usable(const struct ps5_resource *resource)
+{
+   return resource && resource->base.target == PIPE_BUFFER &&
+          !resource->external_cpu_access && !resource->draw_cache_off &&
+          !resource->gpu_written && ps5_draw_cache_on();
+}
+
+/* The buffer's write count + 1 and the generation, read before the data is used. */
+static inline void
+ps5_draw_cache_stamp(const struct ps5_resource *resource, uint64_t *writes, uint64_t *generation)
+{
+   *writes = __atomic_load_n(&resource->draw_cache_writes, __ATOMIC_RELAXED) + 1;
+   *generation = __atomic_load_n(&ps5_draw_cache_generation, __ATOMIC_RELAXED);
+}
+
+/* Flushes [begin, end) of the buffer's data unless it was flushed since its last write. */
+static bool
+ps5_draw_cache_flushed(struct ps5_resource *resource, struct ps5_flushed_range *range,
+                       size_t begin, size_t end, uint64_t *writes, uint64_t *generation)
+{
+   if (!ps5_draw_cache_usable(resource) || end <= begin)
+      return false;
+   ps5_draw_cache_stamp(resource, writes, generation);
+   simple_mtx_lock(&ps5_draw_cache_mutex);
+   const bool flushed = range->writes == *writes && range->generation == *generation &&
+                        begin >= range->begin && end <= range->end;
+   simple_mtx_unlock(&ps5_draw_cache_mutex);
+   return flushed;
+}
+
+static void
+ps5_draw_cache_note_flush(struct ps5_resource *resource, struct ps5_flushed_range *range,
+                          size_t begin, size_t end, uint64_t writes, uint64_t generation)
+{
+   if (!writes || !ps5_draw_cache_usable(resource) || end <= begin)
+      return;
+   simple_mtx_lock(&ps5_draw_cache_mutex);
+   if (range->writes == writes && range->generation == generation &&
+       begin <= range->end && end >= range->begin) {
+      range->begin = MIN2(range->begin, begin);
+      range->end = MAX2(range->end, end);
+   } else {
+      range->writes = writes;
+      range->generation = generation;
+      range->begin = begin;
+      range->end = end;
+   }
+   simple_mtx_unlock(&ps5_draw_cache_mutex);
+}
+
+/* The cache entry for indices [start, start + count) of size `size`, already
+ * matching the buffer's current contents or reset for them; NULL when the
+ * buffer is not cached. Call with ps5_draw_cache_mutex held. */
+static struct ps5_index_range_entry *
+ps5_draw_cache_index_entry(struct ps5_resource *resource, uint32_t start, uint32_t count,
+                           uint8_t size, uint64_t writes, uint64_t generation)
+{
+   if (!resource->index_ranges) {
+      resource->index_ranges = calloc(PS5_INDEX_RANGE_ENTRIES, sizeof(*resource->index_ranges));
+      if (!resource->index_ranges)
+         return NULL;
+   }
+   uint32_t hash = start * 2654435761u ^ count * 40503u ^ size;
+   struct ps5_index_range_entry *entry =
+      &resource->index_ranges[(hash >> 7) % PS5_INDEX_RANGE_ENTRIES];
+   if (entry->writes != writes || entry->generation != generation ||
+       entry->start != start || entry->count != count || entry->size != size) {
+      memset(entry, 0, sizeof(*entry));
+      entry->writes = writes;
+      entry->generation = generation;
+      entry->start = start;
+      entry->count = count;
+      entry->size = size;
+   }
+   return entry;
+}
