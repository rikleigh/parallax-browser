+#!/usr/bin/env python3
+"""Patch 0018's draw caches: the helpers from ps5_screen.c, compiled on the host.
+
+A buffer's cached flush range and index-range entries hold only until its next
+CPU write (or any access to an unknown buffer); buffers the GPU may write or
+the CPU writes without a callback are never cached.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+s = (root / 'src/gallium/ps5/ps5_screen.c').read_text()
+a = s.index('#define PS5_INDEX_RANGE_ENTRIES')
+b = s.index('\n}\n', s.index('ps5_draw_cache_index_entry(struct ps5_resource *resource')) + 3
+helpers = s[a:b]
+# Every write path bumps the count; the GPU-write bindings mark the buffer.
+for needle in ('ps5_draw_cache_note_write(resource);\n   if (!resource || !resource->gpu_written)',
+               'ps5_draw_cache_note_write(buffer);\n   simple_mtx_lock(&ps5_deferred_mutex);',
+               'memcpy(buffer->data + offset, data, size);\n   ps5_draw_cache_note_write(buffer);',
+               'ps5_draw_cache_mark_gpu_writable(targets[index]->buffer);',
+               'ps5_draw_cache_mark_gpu_writable(b->buffer);',
+               'ps5_draw_cache_mark_gpu_writable(v->resource);',
+               'free(resource->index_ranges);'):
+    assert needle in s, needle
+assert s.count('ps5_draw_cache_mark_gpu_writable(written[i]);') == 2
+assert s.count('if (transfer->usage & PIPE_MAP_WRITE)\n      ps5_draw_cache_note_write(resource);') == 1
+assert s.count('ps5_draw_cache_note_write((struct ps5_resource *)transfer->resource);') == 1
