@@ -3419,6 +3419,31 @@ ps5_metadata_has_indirect_ubo(const PsbcShaderMetadata *metadata,
    return false;
 }
 
+/* Recycled descriptor storage holds the previous draw's descriptors. Constant
+ * preparation runs first on this prefix, so clear every slot the shader can
+ * address before the per-type writers fill theirs; bytes outside the shader's
+ * bindings are never read. Merged stages, or a binding outside the prefix,
+ * keep the whole clear. */
+static void
+ps5_clear_descriptor_prefix(uint8_t *data, const PsbcShaderMetadata *metadata,
+                            bool whole)
+{
+   for (unsigned i = 0; !whole && i < metadata->descriptor_binding_count; ++i) {
+      const PsbcDescriptorBinding *binding = &metadata->descriptor_bindings[i];
+      whole = binding->set ||
+         (uint64_t)binding->offset + (uint64_t)binding->array_size * binding->stride >
+            PS5_CONSTANT_DATA_OFFSET;
+   }
+   if (whole) {
+      memset(data, 0, PS5_CONSTANT_DATA_OFFSET);
+      return;
+   }
+   for (unsigned i = 0; i < metadata->descriptor_binding_count; ++i) {
+      const PsbcDescriptorBinding *binding = &metadata->descriptor_bindings[i];
+      memset(data + binding->offset, 0, (size_t)binding->array_size * binding->stride);
+   }
+}
+
 static bool
 ps5_prepare_constant(struct ps5_context *context,
                      const struct ps5_shader *shader, unsigned slot,
@@ -3490,7 +3515,8 @@ ps5_prepare_constant(struct ps5_context *context,
       return false;
 
