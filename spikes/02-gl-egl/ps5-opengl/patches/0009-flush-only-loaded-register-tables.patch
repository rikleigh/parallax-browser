+static void runtime_prepared_work_flush_tables(uint8_t *memory,
+                                               const uint32_t *words,
+                                               uint32_t word_count)
+{
+    enum { MAX_TABLES = 32 };
+    const uint64_t begin = (uint64_t)(uintptr_t)memory;
+    const uint64_t end = begin + 0x10000u;
+    uint64_t address[MAX_TABLES], bytes[MAX_TABLES];
+    unsigned tables = 0;
+    uint32_t at = 0;
+
+    while (at < word_count) {
+        const uint32_t header = words[at];
+        const uint32_t type = header >> 30;
+        uint32_t packet_words;
+
+        if (type == 2)
+            packet_words = 1;
+        else if (type == 0 || type == 3)
